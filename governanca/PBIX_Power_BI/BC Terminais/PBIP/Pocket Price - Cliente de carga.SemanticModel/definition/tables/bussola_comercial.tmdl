	column periodo4 = ```
			
			
			VAR _DIAS_P1_REALIZADO = 
			    IF(bussola_comercial[volume] > bussola_comercial[periodo1_contrato],
			        bussola_comercial[periodo1_contrato], 
			        bussola_comercial[volume])
			
			VAR _SALDO_VOLUME1_REALIZADO = bussola_comercial[volume] - _DIAS_P1_REALIZADO
			
			VAR _DIAS_P2_REALIZADO = 
			    IF(bussola_comercial[volume] <= bussola_comercial[periodo1_contrato],
			        0, 
			            IF(bussola_comercial[periodo2_contrato] < _SALDO_VOLUME1_REALIZADO, 
			                bussola_comercial[periodo2_contrato], _SALDO_VOLUME1_REALIZADO))
			
			VAR _SALDO_VOLUME2_REALIZADO = bussola_comercial[volume] - _DIAS_P1_REALIZADO - _DIAS_P2_REALIZADO
			
			
			
			VAR _DIAS_P3_REALIZADO = 
			    IF(_SALDO_VOLUME2_REALIZADO <= 0, 
			        0, 
			            IF(_SALDO_VOLUME2_REALIZADO < bussola_comercial[periodo3_contrato],
			                _SALDO_VOLUME2_REALIZADO, bussola_comercial[periodo3_contrato]))
			                
			VAR _SALDO_VOLUME3_REALIZADO = bussola_comercial[volume] - _DIAS_P1_REALIZADO - _DIAS_P2_REALIZADO - _DIAS_P3_REALIZADO
			
			var _is_trg_armador = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			
			var _is_trg_carga = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "IMP") && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga"
			
			var _is_tsv = bussola_comercial[un] = "TSV"
			
			RETURN 
			
			    SWITCH(
			        TRUE(),
			
			        //TRG CARGA
			        _is_trg_carga, ROUNDUP(IF(_SALDO_VOLUME3_REALIZADO <= 0, 0, _SALDO_VOLUME3_REALIZADO),0),
			
			        0)
			```
		lineageTag: 09379cd5-9d8d-4140-9304-602bc31352a7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column dias_portas_p1 =
			
			IF ( bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"}
			   , LOOKUPVALUE
			     ( contratos[dias_portas]
			     , contratos[id_periodo]
			     , bussola_comercial[id_p1]
			     ),
			IF(bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"},
			LOOKUPVALUE('Tabela Pública'[dias_periodo],
			'Tabela Pública'[id_periodo],
			bussola_comercial[id_p1],
			BLANK()
			)
			))
		lineageTag: e2acff6e-4cb5-483c-89e6-5db779ab1d3d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column dias_portas_p2 = ```
			
			IF ( bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"}
			   , IF ( ISBLANK(bussola_comercial[periodo2_contrato])
			        , BLANK()
			        , COALESCE
			          ( LOOKUPVALUE
			            ( contratos[dias_portas]
			            , contratos[id_periodo]
			            , bussola_comercial[id_p2]
			            )
			          , bussola_comercial[dias_portas_p1]
			          )
			        )
			   , BLANK()
			   )
			
			```
