	measure Media_Tempo_de_Servico_BaseBC = ```
			
			VAR TempoTotalSegundos = 
			    AVERAGEX(
			        'aws_bussola_comercial_mar',  // Substitua 'hml_bussola_comercial_mar_daily' pelo nome da sua tabela
			        DATEDIFF('aws_bussola_comercial_mar'[data_do_inicio_do_evento], 'aws_bussola_comercial_mar'[data_do_fim_do_evento], SECOND)
			    )
			VAR Dias = INT(TempoTotalSegundos / (24 * 3600))
			VAR SegundosRestantes = TempoTotalSegundos - (Dias * 24 * 3600)
			VAR Horas = INT(SegundosRestantes / 3600)
			RETURN
			    Dias & " dias e " & Horas & " horas"
			```
		lineageTag: 93ce5b60-9991-4d57-9f6c-42ef02490085

	measure Media_Tempo_de_Servico_T_BaseBC = ```
			
			VAR TempoTotalSegundos = 
			    AVERAGEX(
			        'aws_bussola_comercial_mar',  // Substitua 'hml_bussola_comercial_mar_daily' pelo nome da sua tabela
			        DATEDIFF('aws_bussola_comercial_mar'[data_do_inicio_do_evento_tratado], 'aws_bussola_comercial_mar'[data_do_fim_do_evento_tratado], SECOND)
			    )
			VAR Dias = INT(TempoTotalSegundos / (24 * 3600))
			VAR SegundosRestantes = TempoTotalSegundos - (Dias * 24 * 3600)
			VAR Horas = INT(SegundosRestantes / 3600)
			RETURN
			    Dias & " dias e " & Horas & " horas"
			```
		lineageTag: 313740b1-b047-4bfe-a682-bc8aa787a8cc

	measure PrecoMedia_YTD_BaseBC =
			
			VAR vUltimoAno = YEAR(MAX(aws_bussola_comercial_mar[competencia]))
			VAR vUltimoMesContexto = MONTH(MAXX(ALL(aws_bussola_comercial_mar), aws_bussola_comercial_mar[competencia]))-1
			VAR vDia = DAY(MAXX(ALL(aws_bussola_comercial_mar), aws_bussola_comercial_mar[competencia]))
			
			RETURN
			    CALCULATE(
			        [PrecoMedio_BaseBC],
			        FILTER(
			            Dim_calendario,
			            Dim_calendario[data] <= DATE(vUltimoAno,vUltimoMesContexto,vDia)
			        )
			    )
		lineageTag: 8eb3b9cf-b06a-4c9c-8021-894b116d80b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

