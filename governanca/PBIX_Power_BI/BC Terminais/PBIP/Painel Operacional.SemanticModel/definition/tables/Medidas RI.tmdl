	measure FiltroTresAnos = ```
			
			VAR DataMaxima = CALCULATE(MAX(Movimentacao_CNTR[Data]), ALL(Calendario1))
			VAR AnoAtual = YEAR(DataMaxima)
			VAR AnoDaLinha = MAX(Calendario1[Year]) -- Ou sua coluna de ano correspondente
			
			RETURN
			IF(
			    AnoDaLinha >= AnoAtual - 2 && AnoDaLinha <= AnoAtual, 
			    1, 
			    0
			)
			```
