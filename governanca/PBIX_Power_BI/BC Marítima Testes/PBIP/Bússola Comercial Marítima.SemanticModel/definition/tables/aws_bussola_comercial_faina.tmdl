	column data_do_inicio_do_evento =
			
			CALCULATE(
			    MIN('aws_bussola_comercial_mar'[data_do_inicio_do_evento]),
			    -- Remove todos os filtros da tabela Fainas
			    ALL('aws_bussola_comercial_mar'),
			    -- Aplica o filtro da chave, mantendo qualquer filtro externo (opcional)
			    KEEPFILTERS(
			        FILTER(
			            ALL('aws_bussola_comercial_mar'[os]),
			            'aws_bussola_comercial_mar'[os] = 'aws_bussola_comercial_faina'[evento]
			        )
			    )
			)
		formatString: General Date
		lineageTag: edca08dc-dc38-427b-bdc3-4a5006fd1fd6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column data_do_fim_do_evento =
			
			CALCULATE(
			    MAX('aws_bussola_comercial_mar'[data_do_fim_do_evento]),
			    -- Remove todos os filtros da tabela Fainas
			    ALL('aws_bussola_comercial_mar'),
			    -- Aplica o filtro da chave, mantendo qualquer filtro externo (opcional)
			    KEEPFILTERS(
			        FILTER(
			            ALL('aws_bussola_comercial_mar'[os]),
			            'aws_bussola_comercial_mar'[os] = 'aws_bussola_comercial_faina'[evento]
			        )
			    )
			)
		formatString: General Date
		lineageTag: cb534e6a-254c-4240-9439-b139e331f88f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

