expression 'DirectQuery para AS – Modelo Rebocadores' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/REB%20MS", "Modelo Rebocadores"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 904e4b98-9ea2-41ca-b708-46321927fef8

	annotation PBI_IncludeFutureArtifacts = True

