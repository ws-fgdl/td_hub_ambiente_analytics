	column CATEGORIA_VENCIMENTO =
			
			VAR DataReferencia = MAXX(ALL(aws_aging), aws_aging[dat_incl_reg])
			VAR Dias = DATEDIFF(aws_aging[dat_vencimento], DataReferencia, DAY)
			
			RETURN
			    SWITCH( TRUE(),
			        Dias <= 0, "A Vencer",
			        Dias <= 5, "0 a 5 Dias",
			        Dias <= 30, "6 a 30 Dias",
			        Dias <= 90, "31 a 90 Dias",
			        Dias <= 180, "91 a 180 Dias",
			        "+ de 180 Dias"
			    )
		lineageTag: 7e7736c9-7d12-4d38-a130-fc891501a195
		summarizeBy: none
		sortByColumn: CATEGORIA_VENCIMENTO_ORDEM

		changedProperty = Name

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column ORDENAR_CATEGORIA_VENCIMENTO = ```
			
			VAR Dias = 
			DATEDIFF(
			    aws_aging[dat_vencimento],
			    TODAY(),
			    DAY
			)
			RETURN 
			SWITCH(
			    TRUE(),
			    Dias >= 0 && Dias <= 5, 5,
			    Dias >= 6 && Dias <= 30, 6,
			    Dias >= 31 && Dias <= 90, 30,
			    Dias >= 91 && Dias <= 180, 90,
			    188
			)
			
			```
		formatString: 0
		lineageTag: 4540a7c7-05d0-4c4a-9450-9cb3e4b1a005
		summarizeBy: sum

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column CATEGORIA_VENCIMENTO_ORDEM =
			
			-- Captura a maior data de registro da tabela inteira como referência
			VAR DataReferencia = MAXX(ALL(aws_aging), aws_aging[dat_incl_reg])
			VAR Dias = DATEDIFF(aws_aging[dat_vencimento], DataReferencia, DAY)
			
			RETURN
			    SWITCH( TRUE(),
			        Dias <= 0, 0, -- Caso queira tratar faturas a vencer ou no dia
			        Dias <= 5, 1,
			        Dias <= 30, 2,
			        Dias <= 90, 3,
			        Dias <= 180, 4,
			        5
			    )
		formatString: 0
		lineageTag: 49d5ceec-62b1-4b47-8533-75d383d2b384
		summarizeBy: sum

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column CATEGORIA_VENCIMENTO_ING =
			
			VAR DataReferencia = MAXX(ALL(aws_aging), aws_aging[dat_incl_reg])
			VAR Dias = DATEDIFF(aws_aging[dat_vencimento], DataReferencia, DAY)
			
			RETURN
			    SWITCH( TRUE(),
			        Dias <= 0, "A Vencer",
			        Dias <= 5, "0 to 5 Days",
			        Dias <= 30, "6 to 30 Days",
			        Dias <= 90, "31 to 90 Days",
			        Dias <= 180, "91 to 180 Days",
			        "+ 180 Days"
			    )
		lineageTag: 00bcf25e-5795-42d8-89d4-919d8e0e6f5f
		summarizeBy: none
		sortByColumn: CATEGORIA_VENCIMENTO_ORDEM

		changedProperty = Name

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

