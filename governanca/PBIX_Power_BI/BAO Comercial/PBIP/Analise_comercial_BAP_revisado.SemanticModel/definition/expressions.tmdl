		    #"Changed Type" = Table.TransformColumnTypes(#"Colunas Renomeadas", {
		        {"ID Ocorrência", Int64.Type}, {"ID Disparo", Int64.Type}, {"Natureza", type text}, 
		        {"Nome", type text}, {"Descrição", type text}, {"Tipo", type text}, {"Tipo Abreviado", type text},
		        {"Tipo específico do alarme", type text}, {"Pré-Zona", type text}, 
		         {"Entrada/Saída", type text},
		          {"Embarcação", type text},
		        {"IMO", Int64.Type}, {"Enviado pelo(a)", type text}, {"Situação", type text}, {"Disparo", type datetime},
		        {"Operador", type text}, {"Tempo de Atuação (min)", type number}, {"Timer (min)", Int64.Type},
		        {"Justificativa", type text}, {"Justificativa Padrão", type text}
		    })
		
		// {"Alarm Reg. Min Vel", type text}, LOCALIZACAO
		
		// {"Localização", type text},
		,
		    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([Natureza] = "Cerca") and ([Tipo específico do alarme] = "alarme")),
		    #"Replaced Value1" = Table.ReplaceValue(#"Filtered Rows", "Teste Triunfo (rafael)", "Triunfo", Replacer.ReplaceText, {"Nome"}),
		    #"Removed Columns" = Table.RemoveColumns(#"Replaced Value1", {"Tipo",   "Enviado pelo(a)", "Situação", "Operador", "Tempo de Atuação (min)", "Timer (min)", "Justificativa", "Justificativa Padrão", "Pré-Zona"}),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Removed Columns", {{"IMO", type text}, {"ID Disparo", type text}, {"ID Ocorrência", type text}}),
		    #"Sorted Rows" = Table.Sort(#"Changed Type1", {{"Disparo", Order.Ascending}}),
		    #"Filtered Rows2" = Table.SelectRows(#"Sorted Rows", each ([Nome] <> "teste") ),
		
		    // Passo 1: remover disparos com menos de X min (mantém menor para Entrou e maior para Saiu)
		    #"Removed Close Disparos" =
		        Table.Group(
		            #"Filtered Rows2",
		            {"Embarcação", "Nome"},
		            {
		                {
		                    "Data",
		                    (tbl) =>
		                        let
		                            Sorted =
		                                Table.Sort(tbl, {{"Disparo", Order.Ascending}}),
		                                
		                            AddedIndex = Table.AddIndexColumn(Sorted, "Idx", 0, 1, Int64.Type),
		                            Kept =
		                                List.Accumulate(
		                                    Table.ToRecords(AddedIndex),
		                                    {},
		                                    (state, current) =>
		                                        if List.IsEmpty(state) then
		                                            state & {current}
		                                        else
		                                            let
		                                                lastTime = state{List.Count(state) - 1}[Disparo],
		                                                diffMin = Duration.TotalMinutes(current[Disparo] - lastTime)
		                                            in
		                                                if Number.Abs(diffMin) >= 30 then
		                                                    state & {current}
		                                                else
		                                                    state
		                                ),
		                            BackToTable = Table.FromRecords(Kept),
		                            RemovedIdx = Table.RemoveColumns(BackToTable, {"Idx"})
		                        in
		                            RemovedIdx,
		                    type table
		                        [ID Ocorrência = nullable number, ID Disparo = nullable number, Natureza = nullable text,
		                         Localização = nullable text, Nome = nullable text, Descrição = nullable text,
