			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Outros", [Valor #Vol Outros],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "ISPS", [Valor #Vol ISPS],
			                
			                //Básicos Transbordo
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Armazenagem Cntr Cheio BT", [Valor Armazenagem Cntr Cheio BT],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Armazenagem Cntr Vazios BT", [Valor #Vol Armazenagem Cntr Vazio BT],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Cheio TRA BT", [Valor #Vol Box Rate Cheio TRA BT],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Vazio TRA BT", [Valor #Vol Box Rate Vazio TRA BT],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Bundle BT", [Valor #Vol Bundle BT],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Out of Gauge Cargo BT", [Valor #Vol Out od Gauge Cargo BT]
			                )
			                
			        )
			
			        - 
			            SWITCH (TRUE (),
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Fornecimento de Energia Cntr Reefer", [Valor Fornec. Energia - Dias Isenção],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Monitoramento Cntr Reefer", [Valor Monit. Energia - Dias Isenção],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Armazenagem Cntr Cheio", [Valor Arm. Cheio Exp - Isenção],
			
			        0
			) 
			)
			
			RETURN
			IF(vVolume<0,0,vVolume)
			    
			```
		displayFolder: Outras medidas
		lineageTag: 31608db3-cc85-4add-9ba3-bbcd90a00a14

