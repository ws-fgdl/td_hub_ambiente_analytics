				            Prefixo & "#,##0,.0 ""K"";-" & Prefixo & "#,##0,.0 ""K""",
				        
				        -- Para valores entre -999 e 999
				        Prefixo & "#,##0;-" & Prefixo & "#,##0"
				    )
				```

	column Faturamento
		lineageTag: 3c66872f-b772-4e41-90cd-3bc726d2ad59
		summarizeBy: none
		isNameInferred
		sourceColumn: [Faturamento]

		annotation SummarizationSetBy = Automatic

	partition Flag_faturamento = calculated
		mode: import
		source =
				UNION(
				    ROW("Faturamento", "US$"),
				    ROW("Faturamento", "R$"),
				    ROW("Faturamento", "PTAX")
				)

	annotation PBI_Id = baf7275a53374327b5d09fe416ee9348

