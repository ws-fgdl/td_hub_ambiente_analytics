table 'Medidas EfeitoReajuste'
	lineageTag: 325f7394-da19-4d8e-85ad-0055b436d106

	measure Filtro_Volume_Ambos_Periodos =
			
			IF(
			    [PMedio_P1] > 0 && [PMedio_P2] > 0,
			    1,
			    BLANK()
			)
		formatString: 0
		lineageTag: 6fcb4ff3-8994-4828-a2b3-f904b9641e24

	measure Fat_P1 =
			// Novo Faturamento para o Período 1
			VAR Periodo1_Selecionado = VALUES('Calendario P1'[Data])
			RETURN
			CALCULATE(
			    Flag_faturamento[Flag_Faturamento_BaseBC], --[Faturamento_TipoData], // Ou a medida [Faturamento Válido] se preferir
			    KEEPFILTERS('Dim_calendario'[data] IN Periodo1_Selecionado)
			)
		lineageTag: 290d225b-f5db-4891-a761-49953a7ac12b

		formatStringDefinition = ```
				VAR Valor = SELECTEDMEASURE()
				VAR ValorAbs = ABS(Valor) -- Analisamos o "tamanho" do número independente do sinal
				VAR Selecao = SELECTEDVALUE(Flag_faturamento[Faturamento])
				VAR Prefixo = IF(Selecao = "R$", "R$ ", "$ ")
				
				RETURN
				    SWITCH( TRUE(),
				        ValorAbs >= 1000000000, 
				            Prefixo & "#,##0,,,.0 ""B"";-" & Prefixo & "#,##0,,,.0 ""B""",
				        
				        ValorAbs >= 1000000,    
				            Prefixo & "#,##0,,.0 ""M"";-" & Prefixo & "#,##0,,.0 ""M""",
				        
				        ValorAbs >= 1000,       
				            Prefixo & "#,##0,.0 ""K"";-" & Prefixo & "#,##0,.0 ""K""",
				        
				        -- Para valores entre -999 e 999
				        Prefixo & "#,##0;-" & Prefixo & "#,##0"
				    )
				```

