			    dataliner_consolidado[PORTO EMBARQUE/DESCARGA] IN {"PECEM"}, "PEC",
			    dataliner_consolidado[PORTO EMBARQUE/DESCARGA] IN {"PORTOCEL"}, "RCH",
			    dataliner_consolidado[PORTO EMBARQUE/DESCARGA] IN {"RIO DE JANEIRO"}, "RIO",
