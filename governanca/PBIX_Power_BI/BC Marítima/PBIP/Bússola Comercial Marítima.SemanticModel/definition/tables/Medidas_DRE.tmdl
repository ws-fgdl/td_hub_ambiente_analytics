				        "$ #,##0;-$ #,##0" -- Para valores menores que 1000
				    )

	measure Sinal_Resultado_Volume = ```
			
			VAR vResultadoAtual = [Lucro_Por_Manobra_Volume]
			
			VAR vMediaGeral = 
			    CALCULATE(
			        [Lucro_Por_Manobra_Volume],
			        ALLSELECTED(Dim_Cliente) 
			    )
			    
			RETURN
			IF(
			    NOT ISBLANK(vResultadoAtual),
			    SWITCH(
			        TRUE(),
			        vResultadoAtual > vMediaGeral, "▲",
			        vResultadoAtual < vMediaGeral, "▼",
			        "▬"
			    )
			)
			```
		lineageTag: 187a0323-b983-42f1-841a-374fb17040ba

	measure Sinal_Resultado_Volume_Cor = ```
			
			VAR vResultadoAtual = [Lucro_Por_Manobra_Volume]
			
			VAR vMediaGeral = 
			    CALCULATE(
			        [Lucro_Por_Manobra_Volume],
			        ALLSELECTED(Dim_Cliente)
			    )
			    
			RETURN
			IF(
			    NOT ISBLANK(vResultadoAtual),
			    SWITCH(
			        TRUE(),
			        vResultadoAtual > vMediaGeral, "#118D57", // Verde
			        vResultadoAtual < vMediaGeral, "#D93644", // Vermelho
			        "#DAA520" // Amarelo
			    )
			)
			```
		lineageTag: ffd71bdc-0350-41f7-a0ec-ae538b42c192

