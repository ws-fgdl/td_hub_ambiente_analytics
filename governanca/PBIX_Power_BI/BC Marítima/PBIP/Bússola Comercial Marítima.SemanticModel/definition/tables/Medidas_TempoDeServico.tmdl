			        VAR _DataCompetencia = aws_bussola_comercial_mar[competencia]
			        
			        -- Junta Data + Hora para formar o campo Data/Hora completo
			        VAR _DataInicioOperacao = _DataInicio + _HoraInicio
			        VAR _DataFimOperacao = _DataFim + _HoraFim
			        
			        RETURN
			            IF(
			                -- Verifica se as datas de início e fim NÃO estão em branco
			                NOT ISBLANK(_DataInicio) && NOT ISBLANK(_DataFim) &&
			                -- E verifica se o evento terminou no seu mês/ano de competência
			                YEAR(_DataFim) = YEAR(_DataCompetencia) &&
			                MONTH(_DataFim) = MONTH(_DataCompetencia),
			                
			                -- Se TODAS as condições forem VERDADEIRAS, calcula a duração em minutos
			                DATEDIFF(
			                    _DataInicioOperacao, 
			                    _DataFimOperacao, 
			                    MINUTE
			                ),                 
			                -- Se alguma condição for FALSA, retorna 0
			                0 
			            )
			    )    
			RETURN
			    -- Converte o total de minutos para horas
			    MinutosTotais / 60
