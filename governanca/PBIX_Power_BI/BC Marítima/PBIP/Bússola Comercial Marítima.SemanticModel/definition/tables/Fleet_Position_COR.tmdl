	column 'Port / Terminal'
		dataType: string
		lineageTag: 85570fdb-0f88-4dd2-b4b4-f0104b7d5e5e
		summarizeBy: none
		sourceColumn: Port / Terminal

		annotation SummarizationSetBy = Automatic

	column Filial_Tratada = ```
			
			VAR TermoOriginal = [Port / Terminal]
			RETURN
			SWITCH( TRUE(),
			    -- Casos com acentuação ou grafia diferente
			    TermoOriginal = "BELÉM", "BELEM",
			    TermoOriginal = "SANTARÉM", "SANTAREM",
			    TermoOriginal = "SÃO SEBASTIÃO", "SAO SEBASTIAO",
			    TermoOriginal = "PORTO DO AÇU", "PORTO DO ACU",
			    
			    -- Casos de Portos que pertencem a uma Filial Agrupadora específica
			    TermoOriginal = "ANGRA DOS REIS-TEBIG", "SEPETIBA",
			    TermoOriginal = "ILHA GUAIBA", "SEPETIBA",
			    TermoOriginal = "ITAGUAI", "SEPETIBA",
			    TermoOriginal = "PONTA DA MADEIRA", "SAO LUIS",
			    TermoOriginal = "BARRA DO RIACHO", "VITORIA",
			    TermoOriginal = "PONTA UBU", "VITORIA",
			    TermoOriginal = "PORTO TROMBETAS", "TROMBETAS",
			    
			    
			    -- Casos de Cidades que respondem por outra sede
			    TermoOriginal = "FORTALEZA/MUCURIPE", "FORTALEZA",
			    TermoOriginal = "FORTALEZA/PECEM", "PECEM",
			    TermoOriginal = "AREIA BRANCA", "NATAL",
			    TermoOriginal = "PORTO ALEGRE", "RIO GRANDE",
			    TermoOriginal = "SUAPE", "IPOJUCA",
			    
			    -- Se não cair em nenhuma regra, mantém o original (ou limpa espaços)
			    TRIM(TermoOriginal)
			)
			```
		lineageTag: b213a9f2-4da1-4a25-81c8-235f5ba0981f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

