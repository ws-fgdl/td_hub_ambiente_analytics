table TabelaComparativa2
	lineageTag: 2662b368-59bb-410f-bd0c-46ba01617b84

	measure Grupo_2 = SELECTEDVALUE(TabelaComparativa2[Grupo Econômico])
		lineageTag: 3634e5b5-45ee-4762-98e0-bb891485c23b

	column 'Grupo Econômico'
		lineageTag: dd39456b-f8bf-471b-86c7-09f7996031ca
		summarizeBy: none
		isNameInferred
		sourceColumn: Dim_Cliente[Grupo Econômico]

		annotation SummarizationSetBy = Automatic

	partition TabelaComparativa2 = calculated
		mode: import
		source = ```
				
				SUMMARIZE(
				    FILTER(
				        aws_bussola_comercial_mar, 
				        aws_bussola_comercial_mar[manobra_especial] = "NAO" &&
				        NOT(ISBLANK([PrecoMedio_BaseBC]))
				    ),
				    Dim_Cliente[Grupo Econômico]
				)
				```

	annotation PBI_Id = 7560f718ce14420bace1a1a3e629d206

