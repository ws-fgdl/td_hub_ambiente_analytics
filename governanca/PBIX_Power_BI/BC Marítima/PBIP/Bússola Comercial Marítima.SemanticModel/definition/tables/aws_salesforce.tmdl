	column Filtro_Local = IF(AND(aws_salesforce[cpf]="",aws_salesforce[cnpj]=""),"Estrangeiro","BR")
		lineageTag: 8f85c3a8-bddb-44ac-85f6-f1fd03335add
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Nova Categoria Cliente' = ```
			
			SWITCH( 
			    TRUE(),
			    -- Condição para Estrangeiros
			    'aws_salesforce'[tipo_cliente] IN {"ZAE1", "ZES1"}, "Cliente Estrangeiro",
			    
			    -- Condição para Nacional PF
			    --'aws_salesforce'[tipo_cliente] = "ZPF1", "Cliente Nacional PF",
			    
			    -- Condição para Nacional PJ (incluindo os códigos específicos e os vazios/blank)
			    'aws_salesforce'[tipo_cliente] IN {"ZPF1", "ZAN1", "ZOG1", "ZPJ1"} || ISBLANK('aws_salesforce'[tipo_cliente]), "Cliente Nacional",
			    
			    -- Caso apareça algum código novo que não mapeamos acima
			    "Outros" 
			)
			```
		lineageTag: 4bcc2a49-2c5e-41fc-98fa-e714dcfe7d8c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

