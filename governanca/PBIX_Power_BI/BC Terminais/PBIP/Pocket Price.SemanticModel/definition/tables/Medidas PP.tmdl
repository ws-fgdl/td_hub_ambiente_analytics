	measure 'Teste Sinalizador' = ```
			
			  VAR _servico               = SELECTEDVALUE(bussola_comercial[servico])
			  VAR _sub_grupo_princing    = SELECTEDVALUE(bussola_comercial[Agrupamento Subgrupo Princing])
			  VAR _sinalizador_cheio     = _sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT" }
			  VAR _sinalizador_vazio     = _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			  VAR _sinalizador_vazio_imp = _sinalizador_vazio && CONTAINSSTRING(_servico, "IMP")
			  VAR _sinalizador_vazio_exp = _sinalizador_vazio && CONTAINSSTRING(_servico, "EXP")
			RETURN _sinalizador_vazio
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Backup/Teste
		lineageTag: 3f3bc716-14be-4d25-b07c-98a4c84cfc80

	measure 'Volume Simulado Teste' =
			
			// Parâmetros de isenção
			VAR _dias_isencao_param_default   = [#Param Dias Isenção (selecionado)]
			VAR _dias_isencao_param_vazio_imp = [#Param Dias Isenção Vazio Imp (selecionado)]
			VAR _dias_isencao_param_vazio_exp = [#Param Dias Isenção Vazio Exp (selecionado)]
			
			RETURN
			SUMX
			( bussola_comercial
			, VAR _servico               = bussola_comercial[servico]
			  VAR _sub_grupo_princing    = bussola_comercial[Agrupamento Subgrupo Princing]
			  // Variáveis do tipo "flag"
			  VAR _sinalizador_cheio     = _sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT" }
			  VAR _sinalizador_vazio     = _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			  VAR _sinalizador_vazio_imp = _sinalizador_vazio && CONTAINSSTRING(_servico, "IMP")
			  VAR _sinalizador_vazio_exp = _sinalizador_vazio && CONTAINSSTRING(_servico, "EXP")
			  // Para freetime e isenção: se parâmetro estiver em branco, considerar o realizado.
			  VAR _dias_isencao_param =
			    SWITCH
			    ( TRUE()
			    , _sinalizador_vazio_imp, 1 // _dias_isencao_param_vazio_imp
			    , _sinalizador_vazio_exp, -1 // _dias_isencao_param_vazio_exp
			    , 0 // _dias_isencao_param_default
			    )
			
			  RETURN
			  _dias_isencao_param
			)
		formatString: 0
		displayFolder: Backup/Teste
		lineageTag: 13fd9185-14f8-4673-b369-ef4691b34fc8

	measure 'Faturamento Realizado Carga' = ```
			
			
			SUMX
			( bussola_comercial
			, // Valores dos campos
			
			  VAR _dias_portas_p1        = bussola_comercial[dias_portas_p1]
			  VAR _dias_portas_p2        = bussola_comercial[dias_portas_p2]
			  VAR _un                    = bussola_comercial[un]
			  VAR _valor_cif             = bussola_comercial[cif]
			  VAR _imo                   = bussola_comercial[imo]
			  VAR _oog                   = bussola_comercial[oog]
			  VAR _sub_grupo_princing    = bussola_comercial[Agrupamento Subgrupo Princing]
			  VAR _periodo1_contrato     = bussola_comercial[periodo1_contrato]
			  VAR _periodo2_contrato     = bussola_comercial[periodo2_contrato]
			  VAR _periodo3_contrato     = bussola_comercial[periodo3_contrato]
			  VAR _dias_servico          = bussola_comercial[dias_servico]
			  VAR _servico               = bussola_comercial[servico]
			  VAR _perc_cif_1            = bussola_comercial[perc_cif_periodo1]
			  VAR _perc_cif_2            = bussola_comercial[perc_cif_periodo2]
			  VAR _perc_cif_3            = bussola_comercial[perc_cif_periodo3]
			  VAR _perc_cif_4            = bussola_comercial[perc_cif_periodo4]
			  VAR _freetime              = bussola_comercial[dias_free_time]
			  VAR _dias_isencao          = bussola_comercial[dias_isencao]
			  VAR _volume                = bussola_comercial[volume]
			  VAR _valor_min_1           = bussola_comercial[valor_minimo_periodo1]
			  VAR _valor_min_2           = bussola_comercial[valor_minimo_periodo2]
			  VAR _valor_min_3           = bussola_comercial[valor_minimo_periodo3]
			  VAR _valor_min_4           = bussola_comercial[valor_minimo_periodo4]
			  VAR _periodo1              = bussola_comercial[periodo1]
			  VAR _periodo2              = bussola_comercial[periodo2]
			  VAR _periodo3              = bussola_comercial[periodo3]
			  VAR _periodo4              = bussola_comercial[periodo4]
			
			  VAR _saldo_volume_p3 = _volume - bussola_comercial[periodo1_contrato] - bussola_comercial[periodo2_contrato]
			
			  VAR _saldo_volume_TSVCarga = _saldo_volume_p3-bussola_comercial[dias_portas_p2]
			
			
			  //Parâmetro de dias simulado
			
			  VAR _saldo_volume = _volume - bussola_comercial[periodo1_contrato]
			
			  VAR _is_trg_armador = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			  VAR _is_trg_carga = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "IMP")
			 
			  VAR _is_trg_vazio = bussola_comercial[un] = "TRG" && _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			 
			  VAR _is_tsv_armador = bussola_comercial[un] = "TSV" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			  VAR _is_tsv_carga = bussola_comercial[un] = "TSV" && CONTAINSSTRING(bussola_comercial[servico], "IMP")
			
			  VAR _dias_servico_ajustado =
			    IF ( _dias_servico <= _freetime
			        , 0
			        , IF ( _dias_isencao > _dias_servico
			            , 0
			            , _dias_servico - _dias_isencao
			
			            )
			    )
			
			    //TRG
			  VAR _saldo_volume_TRG = [volume] -_periodo1_contrato - _periodo2_contrato - _periodo3_contrato
			
			    //TSV
			  VAR _saldo_volume_p2 = [volume] - _periodo1_contrato - _periodo2_contrato - _dias_portas_p2
			
			  VAR _volume_simulado = _dias_servico_ajustado 
			
			  
			  VAR _dias_p1_realizado = 
			    SWITCH(
			      TRUE(),
			          //Filtro TSV Armador e TSV Carga
			          _is_tsv_armador || _is_tsv_carga || _is_trg_vazio, 1,
			
			          //Filtro TRG vazio
			          //_is_trg_vazio && _is_trg_armador,1,
			
			          _is_trg_carga,IF(_volume_simulado > _periodo1_contrato, _periodo1_contrato, _volume_simulado),
			
			          //Filtro TRG Cheio e TRG Carga   
			          _is_trg_armador ,IF(_volume_simulado > _periodo1_contrato, _periodo1_contrato, _volume_simulado),
			
			          //ELSE
			          0
			  )
			
			
			  VAR _dias_p2_realizado = 
			    SWITCH(
			                TRUE(),
			 
			                    //Filtro TSV Armador
			                    _is_tsv_armador && _saldo_volume > 0, 1,
			 
			                    //Filtro TRG vazio
			                    _is_trg_vazio,  if(_saldo_volume > 0, ROUNDUP(DIVIDE(_saldo_volume,_periodo2_contrato),0),0),
			 
			                    //Filtro TRG Carga
			                    _is_trg_carga, IF(_saldo_volume > _periodo2_contrato, _periodo2_contrato, _saldo_volume),
			 
			                    //Filtro TRG Cheio
			                    _is_trg_armador && _saldo_volume > 0, _saldo_volume,
			                   
			                    //Filtro de TSV Carga
			                     _is_tsv_carga && _saldo_volume > bussola_comercial[periodo1_contrato] + bussola_comercial[dias_portas_p1],1,0)
			             
			
			
			  VAR _dias_p3_realizado = 
			  
			    SWITCH(
			      TRUE(),
			
			      //Filtro TRG Carga
			      _is_trg_carga, IF(_saldo_volume_p3 > _periodo3_contrato, _periodo3_contrato, 0),
			
			      //Filtro de TSV Carga
			        _is_tsv_carga && _saldo_volume_TSVCarga > 0,ROUNDUP(DIVIDE(_saldo_volume_TSVCarga,_periodo3_contrato),0))
			
			  //Foi criada ontem 02/02/2025
			
			  VAR _dias_p4_realizado = IF(_saldo_volume_TRG > 0, _saldo_volume_TRG, 0)
			
			  VAR _min_contrato = IF(_periodo4 > 0, _valor_min_4, IF(_periodo3 > 0 , _valor_min_3, IF(_periodo2 > 0, _valor_min_2, _valor_min_1)))
			
			  // Variáveis do tipo "flag"
			  
			  VAR _sinalizador_cheio     = _sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT" }
			  VAR _sinalizador_vazio     = _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			  VAR _sinalizador_vazio_imp = _sinalizador_vazio && CONTAINSSTRING(_servico, "EXP")
			  VAR _sinalizador_vazio_exp = _sinalizador_vazio && CONTAINSSTRING(_servico, "EXP")
			  // Para freetime e isenção: se parâmetro estiver em branco, considerar o realizado.
			  VAR _freetime_     = bussola_comercial[dias_free_time]
			  VAR _dias_isencao_ = bussola_comercial[dias_isencao]
			  // Calcular dias de serviço considerando freetime e isenção
			
			    VAR _cif_total_realizado = _valor_cif * ((_perc_cif_1 * _dias_p1_realizado) + (_perc_cif_2 * _dias_p2_realizado) + (_perc_cif_3 * _dias_p3_realizado) + (_perc_cif_4 * _dias_p4_realizado))
			
			    VAR _cif_realizado_add = _cif_total_realizado * (1 + IF(_oog = "SIM", bussola_comercial[Adic_oog],0) + IF( _imo = "SIM", bussola_comercial[Adic_carga_especial],0))
			
			  RETURN
			 
			IF(_cif_realizado_add > _min_contrato, _cif_realizado_add, _min_contrato))
			```
		displayFolder: Faturamento
		lineageTag: edc996be-10a4-4afb-b7d9-ca4867797190

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Faturamento Simulado Carga' = ```
			
			// Parâmetros de freetime
			VAR _freetime_param_default           = [#Param Dias Freetime (selecionado)]
			VAR _freetime_param_vazio_imp         = [#Param Dias Freetime Vazio Imp (selecionado)]
			VAR _freetime_param_vazio_exp         = [#Param Dias Freetime Vazio Exp (selecionado)]
			// Parâmetros de isenção
			VAR _dias_isencao_param_default       = [#Param Dias Isenção (selecionado)]
			VAR _dias_isencao_param_vazio_imp     = [#Param Dias Isenção Vazio Imp (selecionado)]
			VAR _dias_isencao_param_vazio_exp     = [#Param Dias Isenção Vazio Exp (selecionado)]
			// Parâmetros de ajuste de volume
			VAR _perc_ajuste_volume_cheio         = [#Param % ajuste volume Arm Cntr Cheio (selecionado)]
			VAR _perc_ajuste_volume_vazio         = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			VAR _perc_ajuste_cif                  = [Valor #Param % ajuste CIF Cheio Imp (selecionado)]
			VAR _perc_ajuste_gris                 = [Valor Param % GRIS (selecionado)]
			
			// Parâmetros de valor mínimo
			VAR _param_valor_min_p1               = [Valor #Param Valor Mínimo Contrato P1 (selecionado)]
			VAR _param_valor_min_p2               = [Valor #Param Valor Mínimo Contrato P2 (selecionado)]
			VAR _param_valor_min_p3               = [Valor #Param Valor Mínimo Contrato P3 (selecionado)]
			VAR _param_valor_min_p4               = [Valor #Param Valor Mínimo Contrato P4 (selecionado)]
			
			
			// Parâmetros de cif
			VAR _param_cif_p1                     = [Valor Param % CIF por dia P1 (selecionado)]
			VAR _param_cif_p2                     = [Valor Param % CIF por dia P2 (selecionado)]
			VAR _param_cif_p3                     = [Valor Param % CIF por dia P3 (selecionado)]
			VAR _param_cif_p4                     = [Valor Param % CIF por dia P4 (selecionado)]
			
			
			// Outros parâmetros de ajuste de preços
			VAR _param_valor_ad_ogg               = [Valor Arm. Cheio Imp - Adicional OOG]
			VAR _param_valor_arm_cheio_imp_ad_carg_especial = [Valor Arm. Cheio Imp - Adicional Carga Especial (selecionado)] 
			
			
			
			RETURN
			SUMX
			( bussola_comercial
			, // Valores dos campos
			  VAR _un                    = bussola_comercial[un]
			  VAR _tam_container         = bussola_comercial[tamanho_container]
			  VAR _cif                   = bussola_comercial[cif]
			  VAR _imo                   = bussola_comercial[imo]
			  VAR _oog                   = bussola_comercial[oog]
			  VAR _sub_grupo_princing    = bussola_comercial[Agrupamento Subgrupo Princing]
			  VAR _tabela_publica        = bussola_comercial[tabela_publica]
			  VAR _periodo1_contrato     = bussola_comercial[periodo1_contrato]
			  VAR _periodo2_contrato     = bussola_comercial[periodo2_contrato]
			  VAR _periodo3_contrato     = bussola_comercial[periodo3_contrato]
			  VAR _preco1                = COALESCE(bussola_comercial[price_p1], _tabela_publica, 0)
			  VAR _preco2                = COALESCE(bussola_comercial[price_p2], _tabela_publica, 0)
			  VAR _preco3                = COALESCE(bussola_comercial[price_p3], _tabela_publica, 0)
			  VAR _dias_servico          = bussola_comercial[dias_servico]
			  VAR _servico               = bussola_comercial[servico]
			  VAR _volume                = bussola_comercial[volume]
			  VAR _perc_cif_1            = bussola_comercial[perc_cif_periodo1]
			  VAR _perc_cif_2            = bussola_comercial[perc_cif_periodo2]
			  VAR _perc_cif_3            = bussola_comercial[perc_cif_periodo3]
			  VAR _perc_cif_4            = bussola_comercial[perc_cif_periodo4]
			
			  //calculo de contrato_min
			  VAR _valor_min_1           = if(ISBLANK(_param_valor_min_p1), bussola_comercial[valor_minimo_periodo1],_param_valor_min_p1)
			  VAR _valor_min_2           = if(ISBLANK(_param_valor_min_p2), bussola_comercial[valor_minimo_periodo2],_param_valor_min_p2)
			  VAR _valor_min_3           = if(ISBLANK(_param_valor_min_p3), bussola_comercial[valor_minimo_periodo3],_param_valor_min_p3)
			  VAR _valor_min_4           = if(ISBLANK(_param_valor_min_p4), bussola_comercial[valor_minimo_periodo4],_param_valor_min_p4)
			  VAR _periodo1              = bussola_comercial[periodo1]
			  VAR _periodo2              = bussola_comercial[periodo2]
			  VAR _periodo3              = bussola_comercial[periodo3]
			  VAR _periodo4              = bussola_comercial[periodo4]
			  // Variáveis do tipo "flag"
			  VAR _sinalizador_cheio     = _sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT" }
			  VAR _sinalizador_vazio     = _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			  VAR _sinalizador_vazio_imp = _sinalizador_vazio && CONTAINSSTRING(_servico, "IMP")
			  VAR _sinalizador_vazio_exp = _sinalizador_vazio && CONTAINSSTRING(_servico, "EXP")
			
			  // Para freetime e isenção: se parâmetro estiver em branco, considerar o realizado.
			  VAR _freetime_param = _freetime_param_default
			    // SWITCH
			    // ( TRUE()
			    // , _sinalizador_vazio_imp, _freetime_param_vazio_imp
			    // , _sinalizador_vazio_exp, _freetime_param_vazio_exp
			    // , _freetime_param_default
			    // )
			  
			  VAR _dias_isencao_param = _dias_isencao_param_default
			    // SWITCH
			    // ( TRUE()
			    // , _sinalizador_vazio_imp, _dias_isencao_param_vazio_imp
			    // , _sinalizador_vazio_exp, _dias_isencao_param_vazio_exp
			    // , _dias_isencao_param_default
			    // )
			  
			  VAR _freetime     = IF(ISBLANK(_freetime_param)    , bussola_comercial[dias_free_time], _freetime_param)
			  
			  VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao]  , _dias_isencao_param)
			
			  VAR _saldo_volume_p3 = _volume - bussola_comercial[periodo1_contrato] - bussola_comercial[periodo2_contrato]
			
			  VAR _saldo_volume_TSVCarga = _saldo_volume_p3-bussola_comercial[dias_portas_p2]
			
			  //Parâmetro de dias simulado
			 
			  VAR _is_trg_armador = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			  VAR _is_trg_carga = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "IMP")
			 
			  VAR _is_trg_vazio = bussola_comercial[un] = "TRG" && _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			 
			  VAR _is_tsv_armador = bussola_comercial[un] = "TSV" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			  VAR _is_tsv_carga = bussola_comercial[un] = "TSV" && CONTAINSSTRING(bussola_comercial[servico], "IMP")
			
			  // Calcular dias de serviço considerando freetime e isenção
			  VAR _dias_servico_ajustado =
			    IF ( _dias_servico <= _freetime
			        , 0
			        , IF ( _dias_isencao > _dias_servico
			            , 0
			            , _dias_servico - _dias_isencao
			            )
			        )
			  // Aplicar ajuste de volume
			  VAR _perc_ajuste_volume = _perc_ajuste_volume_cheio
			  //   SWITCH
			  //   ( TRUE()
			  //   , (_sinalizador_vazio), _perc_ajuste_volume_vazio
			  //   , (_sinalizador_cheio), _perc_ajuste_volume_cheio
			  //   , 0
			  //   )
			  
			  
			  //VAR _volume_simulado =  _dias_servico_ajustado
			  VAR _volume_simulado = ROUND(_dias_servico_ajustado * (1 + _perc_ajuste_volume), 0)
			  
			  VAR _saldo_volume = _volume - bussola_comercial[periodo1_contrato]
			
			
			VAR _dias_p1_simulado =
			
			SWITCH(
			    TRUE(),
			        //Filtro TSV Armador e TSV Carga
			         _is_tsv_carga, 1,
			
			        //Filtro TRG Cheio e TRG Carga   
			        _is_trg_carga ,IF(_volume_simulado > _periodo1_contrato, _periodo1_contrato, _volume_simulado),
			
			        //ELSE
			        0)
			
			
			  VAR _dias_p2_simulado =
			    
			    SWITCH(
			      TRUE(),
			
			        //Filtro TRG Carga
			        _is_trg_carga, IF(_saldo_volume > _periodo2_contrato, _periodo2_contrato, _saldo_volume),
			     
			        //Filtro de TSV Carga
			          _is_tsv_carga && _saldo_volume > bussola_comercial[periodo1_contrato] + bussola_comercial[dias_portas_p1],1,0)
			
			  VAR _dias_p3_simulado =
			
			    SWITCH(
			      TRUE(),
			
			      //Filtro TRG Carga
			      _is_trg_carga, IF(_saldo_volume_p3 > _periodo3_contrato, _periodo3_contrato, 0),
			
			      //Filtro de TSV Carga
			        _is_tsv_carga && _saldo_volume_TSVCarga > 0,ROUNDUP(DIVIDE(_saldo_volume_TSVCarga,_periodo3_contrato),0))
			
			  VAR _saldo_volume_TRG = [volume] -_periodo1_contrato - _periodo2_contrato - _periodo3_contrato
			
			//Foi criada ontem 02/02/2025
			
			    VAR _dias_p4_simulado = IF(_saldo_volume_TRG > 0, _saldo_volume_TRG, 0)
			  
			    VAR _cif_simulado = _cif * (1 + _perc_ajuste_cif + _perc_ajuste_gris)
			
			    VAR _min_contrato_simulado =    
			       IF(_periodo4 > 0, _valor_min_4, IF(_periodo3 > 0 , _valor_min_3, IF(_periodo2 > 0, _valor_min_2, _valor_min_1)))
			
			       VAR _cif_total_simulado = _cif_simulado  * ((_dias_p1_simulado * IF(ISBLANK(_param_cif_p1), _perc_cif_1,_param_cif_p1)) + (_dias_p2_simulado * IF(ISBLANK(_param_cif_p2),_perc_cif_2,_param_cif_p2)) + (_dias_p3_simulado * IF(ISBLANK(_param_cif_p3),_perc_cif_3,_param_cif_p3)) + ( _dias_p4_simulado * IF(ISBLANK(_param_cif_p4),_perc_cif_4,_param_cif_p4)))
			
			    VAR _cif_simu_add = _cif_total_simulado * (1 + IF(_oog = "SIM", COALESCE(_param_valor_ad_ogg,bussola_comercial[Adic_oog]), 0) + IF( _imo = "SIM", COALESCE(_param_valor_arm_cheio_imp_ad_carg_especial,bussola_comercial[Adic_carga_especial]),0))
			
			 
			  RETURN
			
			IF(_cif_simu_add > _min_contrato_simulado, _cif_simu_add, _min_contrato_simulado))
			
			
			```
		displayFolder: Faturamento
		lineageTag: 6a839d43-53a3-4efc-a546-138247406872

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Δ Fat. Armazenagem Carga' = [Faturamento Simulado Carga] - [Faturamento Realizado Carga]
		lineageTag: c609b0d1-1ac4-4275-814a-eeaa55a26c6f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dias P4 Simulado' = ```
			
			// Premissas consideradas para obter os valores dos parâmetros; o percentual retorna zero quando nada foi informado; os outros retornam BLANK().
			VAR _freetime_param     = [#Param Dias Freetime (selecionado)]
			VAR _dias_isencao_param = [#Param Dias Isenção (selecionado)]
			VAR _perc_ajuste_volume_cheio = [#Param % ajuste volume Arm Cntr Cheio (selecionado)]
			VAR _perc_ajuste_volume_vazio = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			
			RETURN
			SUMX
			( bussola_comercial
			//, IF ( bussola_comercial[un] = "TRG"
			//     , BLANK()
			     , VAR _periodo4_contrato = bussola_comercial[periodo4_contrato]
			       RETURN
			       IF ( ISBLANK(_periodo4_contrato)
			          , BLANK()
			          , // Verificar a quantidade de dias em freetime. Se o parâmetro estiver em branco, considerar o realizado.
			            VAR _freetime = IF(ISBLANK(_freetime_param), bussola_comercial[dias_free_time], _freetime_param)
			            VAR _dias_servico = bussola_comercial[dias_servico]
			            VAR _sub_grupo_princing = bussola_comercial[Agrupamento Subgrupo Princing]
			            VAR _perc_ajuste_volume =
			              SWITCH
			              ( TRUE()
			              , (_sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}), _perc_ajuste_volume_vazio
			              , (_sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT" }), _perc_ajuste_volume_cheio
			              , 0
			              )
			            // Se dias de serviço for menor que freetime, retornar zero; caso contrário, calcular os dias de serviço considerando os de isenção.
			            VAR _dias_servico_ajustado =
			                IF ( _dias_servico <= _freetime
			                   , 0
			                   , VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao], _dias_isencao_param)
			                     RETURN
			                     IF ( _dias_isencao > _dias_servico
			                        , 0
			                        , _dias_servico - _dias_isencao
			                        )
			                   )
			            RETURN
			            IF ( _dias_servico_ajustado = 0
			               , 0
			               , VAR _volume_simulado = ROUND(_dias_servico_ajustado * (1 + _perc_ajuste_volume), 0)
			                 VAR _saldo_volume = _volume_simulado - bussola_comercial[periodo1_contrato] - bussola_comercial[periodo2_contrato] - bussola_comercial[periodo3_contrato]
			                 VAR _saldo_volume_TSVCarga = _saldo_volume-bussola_comercial[dias_portas_p2]
			            
			            var _is_trg_carga = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "IMP") && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga"
			
			                 RETURN
			
			SWITCH(
			                TRUE(),
			
			                   
			
			                    //Filtro TRG Carga
			                    _is_trg_carga,  if(_saldo_volume > 0,_saldo_volume,0), 0)
			
			                    
			               
			
			
			                    // bussola_comercial[un] = "TSV" && _saldo_volume > 0, 1,
			
			                    // //Filtro TRG Armador (esse filtro está fazendo o cálculo de CARGA)
			                    // bussola_comercial[un] = "TRG" && (_sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}), _saldo_volume - (bussola_comercial[periodo1_contrato] + bussola_comercial[periodo2_contrato]),
			                    
			                    // //formula original que já estava
			                    // _saldo_volume > 0, ROUNDUP(DIVIDE(_saldo_volume, bussola_comercial[periodo3_contrato]),0)
			                    
			                    //ELSE
			                    //,0
			             
			          )
			     )
			)         
			
			```
		displayFolder: Dias Simulado
		lineageTag: 4a901b55-6f40-46e5-9606-fa7b454f65db

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure price_p4 = ```
			
			var ultPrice = CALCULATE(
			    LASTNONBLANK(
			        bussola_comercial[price_p4],
			        MAX(bussola_comercial[data_do_inicio_do_evento])
			    ),
			    FILTER(
			        'bussola_comercial',
			        bussola_comercial[data_do_inicio_do_evento] = MAX(bussola_comercial[data_do_inicio_do_evento])
			    )
			)
			
			var ultTP = CALCULATE(
			    LASTNONBLANK(
			        bussola_comercial[tabela_publica],
			        MAX(bussola_comercial[data_do_inicio_do_evento])
			    ),
			    FILTER(
			        'bussola_comercial',
			        bussola_comercial[data_do_inicio_do_evento] = MAX(bussola_comercial[data_do_inicio_do_evento])
			    )
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    
			    -- Para o nível de serviço, retorna o último valor negociado com base na data mais recente
			    ISINSCOPE('bussola_comercial'[servico]),
			    IF(ultPrice = BLANK(),
			    ultTP,
			    ultPrice)
			    ,
			
			    -- Para os níveis de "Agrupamento Serviço" e "Agrupamento Subgrupo Princing", retorna a média do valor negociado
			    AVERAGE(bussola_comercial[price_p4])
			
			)
			```
		displayFolder: Preço
		lineageTag: 729f317a-fd38-456f-9d5c-74a62883dce9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

