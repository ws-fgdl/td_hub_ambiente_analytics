	measure %Variacao_VolumeManobra_YTM_BaseBC = ```
			
			VAR AnoAtual = MAX(Dim_calendario[ano_calendario])
			VAR PrimeiroAnoSelecionado =
			    CALCULATE(
			        MIN(Dim_calendario[ano_calendario]),
			        ALLSELECTED(Dim_calendario)
			    )
			VAR VolAtual = [VolumeManobra_YTM_Competenia]
			VAR VolAnterior =
			    IF(
			        AnoAtual > PrimeiroAnoSelecionado,
			        CALCULATE(
			            [VolumeManobra_YTM_Competenia],
			            FILTER(
			                ALL(Dim_calendario),
			                Dim_calendario[ano_calendario] = AnoAtual - 1
			            )
			        )
			    )
			RETURN
			    IF(
			        ISBLANK(VolAnterior) || ISBLANK(VolAtual),
			        BLANK(),
			        DIVIDE(VolAtual - VolAnterior, VolAnterior, 0)
			    )
			
			```
		lineageTag: af9089a7-8f69-444d-a7fd-9ccae2ca5835

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Variacao_Faturamenrto_YTM_BaseBC = ```
			
			-- 1. Identificamos o mês limite do YTM (Com alta performance)
			VAR vDataMax = CALCULATE(MAX(aws_bussola_comercial_mar[competencia]), ALLSELECTED(aws_bussola_comercial_mar))
			VAR vMesLimite = MONTH(vDataMax)
			
			-- 2. Pegamos o valor YTM do ano atual (da barra do gráfico)
			VAR FatAtual = [Faturamento_YTM_BaseBC]
			
			-- 3. Calculamos o ano anterior com o "Passe Livre"
			VAR FatAnterior = 
			    CALCULATE(
			        [Flag_Faturamento_BaseBC], 
			        REMOVEFILTERS(Dim_calendario), -- A MÁGICA: Ignora o segmentador da tela para conseguir ler 2022
			        DATEADD(Dim_calendario[data], -1, YEAR), -- Puxa os dias exatos do ano anterior
			        Dim_calendario[numero_mes] <= vMesLimite -- Trava no mês limite
			    )
			
			-- 4. O retorno faz a divisão. Se não tiver ano anterior na base (Ex: 2021), fica em branco naturalmente!
			RETURN
			    IF(
			        ISBLANK(FatAnterior) || FatAnterior = 0, 
			        BLANK(), 
			        DIVIDE(FatAtual - FatAnterior, FatAnterior)
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 217fda92-0773-459a-8ec5-c9fc8b2c2c3c

