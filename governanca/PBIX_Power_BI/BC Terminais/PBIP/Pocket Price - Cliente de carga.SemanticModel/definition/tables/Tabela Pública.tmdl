	column id_serv_contrato =
			
			// Fausto - 2025-08-26
			'Tabela Pública'[cod_contrato] & 'Tabela Pública'[cd_tipo_servico] & 'Tabela Pública'[un]
		lineageTag: dac979cb-e819-4b74-bbce-7913a1995190
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Qtd_Repeticoes =
			
			CALCULATE(
			    COUNTROWS('Tabela Pública'),
			    FILTER(
			        'Tabela Pública',
			        'Tabela Pública'[id_periodo] = EARLIER('Tabela Pública'[id_periodo])
			    )
			)
		formatString: 0
		lineageTag: 7d449a6e-b1f4-46eb-b061-987f0341c153
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Sequencial =
			
			RANKX(
			    FILTER(
			        ALL('Tabela Pública'),
			        'Tabela Pública'[id_periodo] = EARLIER('Tabela Pública'[id_periodo])
			    ),
			    'Tabela Pública'[data_criacao_tabela],
			    ,
			    ASC,
			    DENSE
			)
		formatString: 0
		lineageTag: a752b678-b6c5-4b75-af63-55ea76e98186
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

