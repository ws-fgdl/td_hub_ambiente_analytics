table Estadia
	lineageTag: 7a3dfc85-7094-4f46-8094-1f24567a3d5f

	measure 'Estadia Média' = AVERAGE( Estadia[Tempo Estadia] ) *24
		displayFolder: _Medidas
		lineageTag: a4652da6-c3b9-483a-9aff-f6ee059c6b12

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _Yaxis_gantt = ROUNDDOWN(MIN( Estadia[Custom]) , 0)
		displayFolder: _Medidas
		lineageTag: bb7a2327-35be-44c8-815d-58b8097e8980

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _text_label_local = ```
			ROUND( Estadia[Estadia Média] , 2 ) & " horas" 
			```
		displayFolder: _Medidas
		lineageTag: 73ac01e8-a6ab-4bb2-88c3-ea0523f686a2

	measure #_entradas = COUNT(Estadia[Custom] )
		formatString: 0
		displayFolder: _Medidas
		lineageTag: 40b89075-60aa-4573-878d-4a530139cbc2

	measure _text_label_local2 = [#_entradas] & " emb."
		displayFolder: _Medidas
		lineageTag: 198bdd1a-d645-4ec5-a413-a8e0dc20bb6f

	measure _x_axis_gantt_start = ```
			SWITCH( TRUE(),  
			SELECTEDVALUE( Estadia[DisparoSaida]) = BLANK() , BLANK(), 
			MIN( Estadia[Custom])
			)
			
			```
		displayFolder: _Medidas
		lineageTag: ae6d12a5-f5cf-4fdf-bb8e-b0a1fa4ee303

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _color_local = ```
			SWITCH( TRUE(),
			                        SELECTEDVALUE(Estadia[Custom.Nome]) = "Triunfo"  , "#6A90B6",
			                        SELECTEDVALUE(Estadia[Custom.Nome]) = "Nitshore" , "#D6C672	",
			                        SELECTEDVALUE(Estadia[Custom.Nome]) = "Mac Laren P.A" , "#8DAA87",
			                        SELECTEDVALUE(Estadia[Custom.Nome]) = "Mac Laren I.C" , "#BCA58E"   
			)
			
			```
		displayFolder: _Medidas
		lineageTag: 9b82a19b-416f-4c28-b559-ef72083d8796

	measure _text_estadia_table = IF( Estadia[Estadia Média]=BLANK(), "⚓" , Estadia[Estadia Média])
		displayFolder: _Medidas
		lineageTag: e3acbb1c-5072-4595-937c-e4c3b11100c2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Cumulativo = ```
			
			
			VAR B = SELECTEDVALUE( Estadia[Total Hours (bins)] )
			
			RETURN
			SUMX(
			    FILTER(
			        SUMMARIZE( ALL( Estadia ), Estadia[Total Hours (bins)], 
			        "Fat" , CALCULATE([#_entradas], Estadia[DisparoSaida]<>0)),
			        Estadia[Total Hours (bins)] <= B),
			    [Fat] /* Somatoria para fazer o cumulativo */
			    )
			```
		formatString: 0
		displayFolder: _Medidas
		lineageTag: e7323189-4e09-4066-8079-815b0735db94

	measure 'Cumulativo %' =
			/* Calcula o % sobre o total cumulativo */
			VAR A= [Cumulativo]
			VAR B=CALCULATE( [#_entradas] , FILTER(ALL(Estadia), Estadia[DisparoSaida]<>0))
			RETURN
			DIVIDE(A,B)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _Medidas
		lineageTag: 86c90aa3-480e-446c-b855-5704fc09fdfe

