			    NOT(ISBLANK(LOOKUPVALUE('dim_carteira_comercial'[grupo_economico], 'dim_carteira_comercial'[codigo_sap], 'salesforce'[sap]))),
			    LOOKUPVALUE('dim_carteira_comercial'[grupo_economico], 'dim_carteira_comercial'[codigo_sap], 'salesforce'[sap]), IF('salesforce'[Grupo Economico] = BLANK(), 'salesforce'[Razão Social], 
