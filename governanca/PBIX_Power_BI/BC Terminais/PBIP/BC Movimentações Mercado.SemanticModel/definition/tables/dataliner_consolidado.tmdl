	column CATEGORIA =
			
			SWITCH(
			    TRUE(),
			    'dataliner_consolidado'[PORTO EMBARQUE/DESCARGA] = 'dataliner_consolidado'[PORTO ORIGEM/DESTINO], 'dataliner_consolidado'[MODALIDADE],
			    'dataliner_consolidado'[MODALIDADE] = "EXPORTAÇÃO", "EMBARQUE TRANSBORDO",
			    "DESCARGA TRANSBORDO"
			)
		lineageTag: ae0eb66f-800e-43a2-aec5-e330d8aa200f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'MARKET SHARE' =
			
			SWITCH(
			    TRUE(),
			    dataliner_consolidado[PORTO ORIGEM/DEST. SIGLA] IN {"RIG"}, "RIG",
			    "CONCORRENTES"
			)
		lineageTag: e23b60f5-9258-4f61-8958-9805e112362f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dataliner_consolidado = calculated
		mode: import
		source = ```
				
				FILTER(
				    UNION(
				        SELECTCOLUMNS(
				            dataliner_exp,
				            "ANO", dataliner_exp[dates_long_haul_yyyy],
				            "MÊS", IF(
				                dataliner_exp[dates_long_haul_mm] > 0, 
				                FORMAT(DATE(dataliner_exp[dates_long_haul_yyyy], dataliner_exp[dates_long_haul_mm], 1), "Mmm"), 
				                BLANK()
				            ),
				            "MÊS_NUM", IF(
				                dataliner_exp[dates_long_haul_mm] > 0, 
				                dataliner_exp[dates_long_haul_mm], 
				                BLANK()
				            ),
				            "PORTO EMBARQUE/DESCARGA", dataliner_exp[place_and_ports_pol_name],
				            "PORTO ORIGEM/DESTINO", dataliner_exp[place_and_ports_pomo_name],
				            "TIPO EXPORTADOR/IMPORTADOR", dataliner_exp[company_shipper_type],
				            "EXPORTADOR/IMPORTADOR", dataliner_exp[company_shipper_shipper_name],
				            "UF EXPORTADOR/IMPORTADOR", dataliner_exp[company_shipper_state],
				            "CIDADE EXPORTADOR/IMPORTADOR", dataliner_exp[company_shipper_city],
				            "LINHA", dataliner_exp[service_service_name],
				            "ARMADOR", dataliner_exp[carrier_carrier_name],
				            "TEU", dataliner_exp[TEUS],
				            "CNTR", dataliner_exp[CNTR],
				            "MODALIDADE", "EXPORTAÇÃO"
				        ),
				        SELECTCOLUMNS(
				            dataliner_imp,
				            "ANO", dataliner_imp[dates_long_haul_yyyy],
				            "MÊS", IF(
				                dataliner_imp[dates_long_haul_mm] > 0, 
				                FORMAT(DATE(dataliner_imp[dates_long_haul_yyyy], dataliner_imp[dates_long_haul_mm], 1), "Mmm"), 
				                BLANK()
				            ),
				            "MÊS_NUM", IF(
				                dataliner_imp[dates_long_haul_mm] > 0, 
				                dataliner_imp[dates_long_haul_mm], 
				                BLANK()
				            ),
				            "PORTO EMBARQUE/DESCARGA", dataliner_imp[place_and_ports_pod_name],
				            "PORTO ORIGEM/DESTINO", dataliner_imp[place_and_ports_pomd_name],
				            "TIPO EXPORTADOR/IMPORTADOR", dataliner_imp[company_consignee_type],
				            "EXPORTADOR/IMPORTADOR", dataliner_imp[company_consignee_consignee_name],
				            "UF EXPORTADOR/IMPORTADOR", dataliner_imp[company_consignee_state],
				            "CIDADE EXPORTADOR/IMPORTADOR", dataliner_imp[company_consignee_city],
				            "LINHA", dataliner_imp[service_service_name],
				            "ARMADOR", dataliner_imp[carrier_carrier_name],
				            "TEU", dataliner_imp[TEUS],
				            "CNTR", dataliner_imp[CNTR],
