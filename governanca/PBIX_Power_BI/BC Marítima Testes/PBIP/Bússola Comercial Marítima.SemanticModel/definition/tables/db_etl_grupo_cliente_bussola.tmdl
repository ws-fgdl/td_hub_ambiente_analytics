	column GRUPO_CLIENTE =
			// Peagdos dados da bussola 'bussola e movport' e com a agencia da movport
			// Guardamos os valores em variáveis para a linha atual
			VAR vCliente = 'db_etl_grupo_cliente_bussola'[GRUPO_CLIENTE_CONDICAO]
			VAR vPagador = 'db_etl_grupo_cliente_bussola'[GRUPO_PAGADOR_CONDICAO]
			VAR vAgencia = LOOKUPVALUE('Dim_Agencia_Movport'[AGENCIA], 'Dim_Agencia_Movport'[ORIGEM_ID], 'db_etl_grupo_cliente_bussola'[ORIGEM_ID])
			
			// Fazemos o teste lógico à prova de falhas
			RETURN
			IF(vCliente <> BLANK() && vCliente <> "", vCliente,
			    IF(vPagador <> BLANK() && vPagador <> "", vPagador,
			        vAgencia
			    )
			)
		lineageTag: 972d6a00-409b-43e3-bc55-bdef7c08c046
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column GRUPO_PAGADOR_TRATADO = ```
			
			VAR vPagador = 'db_etl_grupo_cliente_bussola'[GRUPO_PAGADOR_CONDICAO]
			VAR vAgencia = LOOKUPVALUE('Dim_Agencia_Movport'[AGENCIA], 'Dim_Agencia_Movport'[ORIGEM_ID], 'db_etl_grupo_cliente_bussola'[ORIGEM_ID])
			
			RETURN
			IF(
			    vPagador <> BLANK() && vPagador <> "", 
			    vPagador, 
