	measure Efeito_Preco_Cartao = ```
			
			SUMX(
			    FILTER(
			        SUMMARIZE(
			            'aws_bussola_comercial_mar',
			            'Dim_Cliente'[Grupo Econômico],
			            aws_bussola_comercial_mar[grupo_acordo],
			            Dim_Filial[Filial_agrupado],
			            Dim_Divisao[divisao],
			            aws_bussola_comercial_mar[FAIXA_DWT_2025]
			        ),
			        -- CONDIÇÃO DE FILTRO ORIGINAL
			        [PMedio_P1] > 0 && 
			        [PMedio_P2] > 0 && 
			        NOT ISBLANK('Dim_Cliente'[Grupo Econômico])
			    ),
			    -- EXPRESSÃO: O SUMX vai calcular a medida abaixo para cada linha da tabela virtual acima e somar tudo
			    [Efeito Preço Ajustado]
			)
			// CALCULATE(
			//     [Efeito Preço Ajustado],
			//     FILTER(
			//         SUMMARIZE(
			//             'aws_bussola_comercial_mar',
