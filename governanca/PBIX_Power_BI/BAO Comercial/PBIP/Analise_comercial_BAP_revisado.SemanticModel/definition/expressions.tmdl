		                        [ID Ocorrência=nullable text, ID Disparo=nullable text, Natureza=nullable text,
		                         Localização=nullable text, Nome=nullable text, Descrição=nullable text,
		                         Tipo Abreviado=nullable text, Tipo específico do alarme=nullable text,
		                         #"Entrada/Saída"=nullable text, Embarcação=nullable text, IMO=nullable text,
		                         Disparo=nullable datetime]
		                }
		            }
		        ),
		    #"Renamed Columns_6" = Table.RenameColumns(#"Removed Cross-Type Close",{{"Embarcação", "Embarcação_4"}}),
		
		    #"Expanded Cross-Type Close_Saiu" = Table.ExpandTableColumn(#"Renamed Columns_6", "Data", Table.ColumnNames(#"Expanded Cross-Type Close")),
		
		    //===========
		
		    // NOVO: remover "Entrou" consecutivos por Embarcação + Nome, mantendo apenas o primeiro
		    #"Removed Consecutive Entrou" =
		        Table.Group(
		            #"Expanded Cross-Type Close_Saiu",
		            {"Embarcação", "Nome"},
		            {
		                {
		                    "Data",
		                    (tbl) =>
		                        let
		                            Sorted = Table.Sort(tbl, {{"Disparo", Order.Ascending}}),
		                            Recs = Table.ToRecords(Sorted),
		                            Init = [Kept = {}, LastWasEntrou = false],
		                            Step = (s as record, r as record) as record =>
		                                let
		                                    isEntrou = Text.Upper(Text.Trim(r[#"Entrada/Saída"])) = "ENTROU"
		                                in
		                                    if isEntrou and s[LastWasEntrou] then
		                                        // pula este "Entrou" porque o anterior também foi "Entrou"
		                                        s
		                                    else
		                                        [
		                                            Kept = s[Kept] & {r},
		                                            LastWasEntrou = isEntrou
		                                        ],
		                            Final = List.Accumulate(Recs, Init, Step),
		                            Out = Table.FromRecords(Final[Kept])
		                        in
		                            Out,
		                    type table
		                        [ID Ocorrência=nullable text, ID Disparo=nullable text, Natureza=nullable text,
		                         Localização=nullable text, Nome=nullable text, Descrição=nullable text,
		                         Tipo Abreviado=nullable text, Tipo específico do alarme=nullable text,
