	measure 'Preço P1 Simulado' = ```
			
			
			VAR tam_container = FIRSTNONBLANKVALUE(bussola_comercial[tamanho_container],SELECTEDVALUE(bussola_comercial[tamanho_container]))
			
			RETURN
			IF(
			    tam_container="20",
			    [price_p1]*(
			        AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			        // bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"} && CONTAINSSTRING(bussola_comercial[servico], "EXP"), [Valor Arm. Vazios - Preço P1],
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "EXP"), [Valor Arm. EXP 20 - Preço P1],
			        0)))*
			    IF(
			        SELECTEDVALUE(bussola_comercial[imo]) = "SIM",
			        AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "EXP"), [Valor Arm. Cheio Exp - Adicional Carga Especial (selecionado)],
			        0)),1
			        )*
			    IF(
			        SELECTEDVALUE(bussola_comercial[oog]) = "SIM",
			        AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "EXP"), [Valor Adicional OOG (selecionado)],
			        0)),1
			        ),
			    
			    IF(
			        tam_container="40",
			        [price_p1]*(AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			        // bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"} && CONTAINSSTRING(bussola_comercial[servico], "EXP"), [Valor Arm. Vazios - Preço P1],
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "EXP"), [Valor Arm. EXP 40 - Preço P1],
			        0)))*
			        IF(
			        SELECTEDVALUE(bussola_comercial[imo]) = "SIM",
