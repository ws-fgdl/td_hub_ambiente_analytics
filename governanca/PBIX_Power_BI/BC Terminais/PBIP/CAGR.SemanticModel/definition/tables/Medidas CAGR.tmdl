table 'Medidas CAGR'
	lineageTag: fe32eb30-9643-4fb5-b086-7ad91074aa33

	measure 'Preço Médio' = ```
			
			VAR ultPriceAtual = CALCULATE(
			    LASTNONBLANK(
			        contratos[valor],
			        MAX(contratos[inicio_vigencia])
			    ),
			    FILTER(
			        'contratos',
			        contratos[inicio_vigencia] = MAX(contratos[inicio_vigencia])
			    )
			)
			
			VAR AnoCorrente = MAX(Calendario1[Ano Calendario])
			
			// Verificação mais robusta se "GRUPO HMM" está filtrado
			VAR GrupoHMMEstaSendoFiltrado =
			    NOT ISEMPTY(
			        FILTER(
			            ALLSELECTED(contratos[grupo_economico_ter]), // Considera apenas os valores selecionados no filtro atual para esta coluna
			            contratos[grupo_economico_ter] = "GRUPO HMM"
			        )
			    )
			    // Alternativa que também pode ser testada se a acima falhar:
			    // VAR GrupoHMMEstaSendoFiltrado = "GRUPO HMM" IN VALUES(contratos[grupo_economico_ter])
			
			// Lógicas para calcular o preço do ano anterior (estas já sabemos que funcionam isoladamente)
			VAR AnoAnteriorParaCalculo = AnoCorrente - 1
			VAR UltimaDataNoAnoAnterior_CalcInterno =
			    CALCULATE(
			        MAX(contratos[inicio_vigencia]),
			        FILTER(
			            ALL(contratos), // Começa com todos os contratos para aplicar filtros específicos
			            contratos[inicio_vigencia] >= DATE(AnoAnteriorParaCalculo, 1, 1) &&
			            contratos[inicio_vigencia] <= DATE(AnoAnteriorParaCalculo, 12, 31) &&
			            contratos[grupo_economico_ter] = "GRUPO HMM" // Filtra explicitamente por HMM
			        ),
			        REMOVEFILTERS(Calendario1[Ano Calendario])
			    )
			
			VAR PrecoFinalDoAnoAnterior_CalcInterno =
			    IF(
			        NOT ISBLANK(UltimaDataNoAnoAnterior_CalcInterno),
			        CALCULATE(
			            LASTNONBLANK(
			                contratos[valor],
			                MAX(contratos[inicio_vigencia])
			            ),
			            FILTER(
			                ALL(contratos), // Começa com todos os contratos
			                contratos[inicio_vigencia] = UltimaDataNoAnoAnterior_CalcInterno &&
			                contratos[grupo_economico_ter] = "GRUPO HMM" // Filtra explicitamente por HMM
			            ),
			            REMOVEFILTERS(Calendario1[Ano Calendario])
			        ),
			        BLANK()
			    )
			
			// Condições para o IF Principal
			VAR CondicaoAnoCorreto = (AnoCorrente >= 2025) -- Hoje é 14/05/2025
			VAR CondicaoPrecoAtualEstaBranco = ISBLANK(ultPriceAtual)
			
			RETURN
			IF(
			    GrupoHMMEstaSendoFiltrado &&      -- Condição 1: GRUPO HMM está realmente filtrado?
			    CondicaoAnoCorreto &&             -- Condição 2: Ano 2025 ou posterior
			    CondicaoPrecoAtualEstaBranco,     -- Condição 3: Preço do ano corrente está em branco
			
			    PrecoFinalDoAnoAnterior_CalcInterno, // Se tudo OK, retorna o preço de 2024 (4500)
			
			    ultPriceAtual // Caso contrário, retorna o preço original do ano corrente
			)
			
			```
		displayFolder: Price
		lineageTag: 04c63f6c-e4d0-4fb6-a46f-068a6e58655a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

