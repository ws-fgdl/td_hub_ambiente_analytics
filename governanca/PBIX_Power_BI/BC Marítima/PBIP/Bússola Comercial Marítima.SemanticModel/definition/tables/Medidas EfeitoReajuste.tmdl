	measure PMedio_P1 =
			// Novo Preço Médio para o Período 1
			DIVIDE([FaT_P1], [Vol_P1])
		lineageTag: 62886846-7d8d-40d9-a2f7-5756cf929eb9

		formatStringDefinition = ```
