	column Tempo_vigencia_meses = ```
			ROUND((contratos[fim_vigencia] - contratos[inicio_vigencia])/30,0)
			
			```
		formatString: 0
		lineageTag: ef3b9d0f-a904-4164-bdb5-f57b9949691a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

