			        MONTH(dim_calendario[data]) = vUltimoMes &&
			        DAY(dim_calendario[data]) <= vUltimoDia
			    )
		lineageTag: a890e786-b2e8-46c0-be77-4bf4ea07ed08

		annotation PBI_FormatHint = {"isGeneralNumber":true}

