	measure ExibirAnoMesMaisRecente = ```
			
			VAR UltimaData = CALCULATE(MAX(Movimentacao_CNTR[Data]), ALL('Movimentacao_CNTR'))
			VAR UltimoAno = YEAR(UltimaData)
			VAR UltimoMes = MONTH(UltimaData)
			
			RETURN 
			    IF(
			        CALCULATE(
			            COUNTROWS('Movimentacao_CNTR'),
			            FILTER(
			                'Movimentacao_CNTR',
			                YEAR(Movimentacao_CNTR[Data]) = UltimoAno &&
			                MONTH(Movimentacao_CNTR[Data]) <= UltimoMes
			                )
			        ) > 0,
			        1,
			        0
			    )
			```
		formatString: 0
		lineageTag: 2ce0907f-67dd-46b3-9c14-62ce832fabcd

