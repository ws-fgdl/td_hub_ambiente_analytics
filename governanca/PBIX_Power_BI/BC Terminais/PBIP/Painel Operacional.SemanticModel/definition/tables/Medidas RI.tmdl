	measure Teus_ultimo_Mes_AnoAtual =
			
			VAR vUltimaData = MAX(Calendario1[Date])
			VAR vUltimoAno = YEAR(vUltimaData)
			VAR vUltimoMes = MONTH(vUltimaData)
			VAR vUltimoDia = DAY(vUltimaData)
			
			RETURN
			    CALCULATE(
			        [Vol TEU],
			        YEAR(Calendario1[Date]) = vUltimoAno &&
			        MONTH(Calendario1[Date]) = vUltimoMes &&
			        DAY(Calendario1[Date]) <= vUltimoDia
			    )
		lineageTag: a890e786-b2e8-46c0-be77-4bf4ea07ed08

