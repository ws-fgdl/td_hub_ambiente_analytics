			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"PECEM"}, "PEC",
			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"PORTOCEL"}, "RCH",
			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"RIO DE JANEIRO"}, "RIO",
			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"RIO GRANDE"}, "RIG",
			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"SALVADOR"}, "SSA",
			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"SANTAREM"}, "STM",
			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"SANTOS"}, "SSZ",
