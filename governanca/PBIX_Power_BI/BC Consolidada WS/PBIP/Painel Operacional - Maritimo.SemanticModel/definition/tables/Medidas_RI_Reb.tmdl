	measure _VolumeMedio_PYTD = ```
			
			VAR MaxData = MAX('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[DT_OPER])
			VAR AnoAnterior = YEAR(MaxData) - 1
			
			// Calcula a data correspondente no ano passado (mesmo dia e mês)
			VAR MaxDataAnoAnterior = DATE(AnoAnterior, MONTH(MaxData), DAY(MaxData))
			
			RETURN
			CALCULATE(
			    [Média], 
			    REMOVEFILTERS('_Tempo'),
			    
			    // Filtra do início do ano anterior até o mesmo dia do ano anterior
			    YEAR('_Tempo'[Data]) = AnoAnterior,
			    '_Tempo'[Data] <= MaxDataAnoAnterior
			)
			```
		lineageTag: 03ea5f87-bef7-4bf0-88d7-6719955447f4

