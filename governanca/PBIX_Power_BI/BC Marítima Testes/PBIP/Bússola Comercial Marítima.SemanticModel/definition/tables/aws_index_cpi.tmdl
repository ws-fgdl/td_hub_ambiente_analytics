table aws_index_cpi
	lineageTag: 9f625b98-a6a7-469b-902c-95e881b51466

	measure CPI_Acumulado = ```
			
			TOTALYTD(
			    [CPI_Mensal], 
			    Dim_calendario[data]
			)
			
			```
