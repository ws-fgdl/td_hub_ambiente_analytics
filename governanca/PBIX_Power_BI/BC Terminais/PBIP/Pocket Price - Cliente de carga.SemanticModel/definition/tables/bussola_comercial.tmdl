	column tabela_publica = ```
			
			VAR price = CALCULATE(
			        AVERAGE('Tabela Pública'[valor]),
			        FILTER(
			            'Tabela Pública',
			            bussola_comercial[chave1] = 'Tabela Pública'[chave]
			        ),
			        DATESBETWEEN(bussola_comercial[data_do_fim_do_evento],MIN('Tabela Pública'[inicio_vigencia]),MAX('Tabela Pública'[fim_vigencia]))
			        
			)
			
			RETURN
			SWITCH(
			    TRUE(),
			    bussola_comercial[Agrupamento Subgrupo Princing] IN {"Fiel Depósito"},price/100,
			    price
			)
			```
		formatString: #,0.0000
		lineageTag: c3484e4a-d24f-494f-aa58-66aa5e65c495
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column cod_servico = ```
			
			
			LOOKUPVALUE(
			    'tabela cod servico'[cod_servico],
			    'tabela cod servico'[chave],
			    bussola_comercial[chave1]
			    
			    )
			```
