table 'Medidas PP'
	lineageTag: 3a91aa36-363a-43ab-936a-b6e6ecb7f1cf

	measure 'Projeção Simulada' = ```
			
			var data_max = MAX(bussola_comercial[competencia])
			var result = 
			
			            IF(
			                MAX(Calendario2[Date].[Date])>data_max,
			                CALCULATE([Projeção Faturamento Simulador table], DATEADD(Calendario2[Date],-'Meses contratuais'[Período contratual],MONTH)),
			                [fat calculado table]
			            )
			
			return result
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Outras medidas
		lineageTag: b1f8fc63-cf51-4c72-9f20-44166df36184

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Projeção Faturamento Simulador' = ```
			
			
			VAR projFS = ([Simulador SBP Volume]+[SIMULADOR PP volume 2]-[volume])*(([SIMULADOR_PP t.m.]+[Simulado SBP T.M.]-[Price3]))
			+ [Faturamento Simulado Armador]
			
			VAR result = IF(AND(ISINSCOPE(bussola_comercial[servico]),SELECTEDVALUE(bussola_comercial[Agrupamento Subgrupo Princing]) <> "Fiel Depósito"),
			
			IF(
			    projFS<0,
			    0,
			    projFS
			),
			BLANK()
			)
			
			RETURN
			result
			
			
			```
		formatString: #,0.00
		displayFolder: Outras medidas
		lineageTag: 9f71a315-88bb-417d-a39a-a07d7ad3699d

	measure 'SIMULADOR_PP t.m.' = ```
			
			        [Price3]*
			        AVERAGEX(
			        'bussola_comercial',
			        1
			        + ((SWITCH (
			                TRUE (),
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Cabotagem", [Valor Básicos Cabotagem],
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Exportação", [Valor Básicos Exportação],
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Importação", [Valor Básicos Importação],
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Transbordo", [Valor Básicos Transbordo],
			                'bussola_comercial'[Agrupamento Serviço] = "Operação Navio", [Valor Operação Navio],
			                'bussola_comercial'[Agrupamento Serviço] = "Operação Navio OOG", [Valor Operação Navio OOG],
			                'bussola_comercial'[Agrupamento Serviço] = "Outros Serviços", [Valor Outros Serviços],
			                'bussola_comercial'[Agrupamento Serviço] = "Operação Navio Overtime", [Valor Operação Navio Overtime],
			                'bussola_comercial'[Agrupamento Serviço] = "Reefer", [Valor Reefer],
			                'bussola_comercial'[Agrupamento Serviço] = "Serviços de Armazém", [Valor Serviços de Armazém],
			                'bussola_comercial'[Agrupamento Serviço] = BLANK(), 0,
			                1
			            )
			        )
			    )
			        )
			```
		displayFolder: Outras medidas
		lineageTag: ab876fd2-22d0-4de9-957b-be6762551b95

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variação de Volume' =
			
			([SIMULADOR PP volume 2]/[Volume/Qtd.])-1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Outras medidas
		lineageTag: 05ac6a2b-c1ec-4034-a813-67445da6b349

	measure 'Pocket Price' =
			
			VAR PP = [Projeção Faturamento Simulador table]/[fat calculado table]-1
			
			RETURN
			IF(
			    [fat calculado table]=BLANK(),
			    BLANK(),
			    PP
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Outras medidas
		lineageTag: a58dbfa3-96de-4b08-b0c8-a73431401728

	measure 'Variação Volume' =
			((
			    (
			    ([SIMULADOR PP volume 2]+[Simulador SBP Volume])-2*[volume]
			    )
			    +[volume])/[volume])-1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Outras medidas
		lineageTag: df47c586-087b-459a-aca9-a7d5c6e79de0

	measure 'Variação Faturamento' = ([Projeção Faturamento Simulador table]/[fat calculado table])-1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Outras medidas
		lineageTag: f67b36ef-bb82-4718-9d9c-78f9b823c9d7

	measure 'Vol. Arm. Vazio' =
			
			
			VAR pContrato = FIRSTNONBLANKVALUE(bussola_comercial[periodo1_contrato],SELECTEDVALUE(bussola_comercial[periodo1_contrato]))
			
			RETURN
			ROUNDUP([volume]/pContrato,0)
		formatString: 0
		displayFolder: Outras medidas
		lineageTag: 0f1533c1-fe63-4954-a302-89d59a3f1ea8

	measure teste222 = SUM(bussola_comercial[volume])*(1+[Valor #SBP Monitoramento Cntr Reefer 2])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Outras medidas
		lineageTag: 8290fbaf-2e3d-4811-b9ad-b645a5ffeaa6

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Simulado SBP T.M.' = ```
			
			
			VAR vDolar = AVERAGEX(
			        bussola_comercial,
			        SWITCH(TRUE(),
			        //Básicos Transbordo
			               
			                'bussola_comercial'[Precficação USD] = "USD", [Valor Preço Dólar],
			                'bussola_comercial'[Precficação USD] = "USD", [Valor Preço Dólar],
			                'bussola_comercial'[Precficação USD] = "USD", [Valor Preço Dólar],
			               
			                'bussola_comercial'[Precficação USD] = "USD", [Valor Preço Dólar],
			                1
			        )
			    )
			
			RETURN
			
			    [Price3]*
			    AVERAGEX(
			        'bussola_comercial',
			        1
			        + (SWITCH (
			                TRUE (),
			                // Operação Navio
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Monitoramento Cntr Reefer",[Valor #SBP Monitoramento Cntr Reefer 2],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Armazenagem Cntr Vazios", [Valor #SBP Armazenagem Cntr Vazios],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Cargas Especiais", [Valor #SBP Cargas Especiais],
			
			                -- 🔁 BOX RATE (trocado para v2)
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Cheio CAB", [Valor #SBP Box Rate Cheio CAB v2],
			
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Out of Gauge Cargo", [Valor #SBP Out of Gauge Cargo ON],
			
			                -- 🔁 BOX RATE (trocado para v2)
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Cheio LC", [Valor #SBP Box Rate Cheio LC v2],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Vazio CAB", [Valor #SBP Box Rate Vazio CAB v2],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Vazio LC", [Valor #SBP Box Rate Vazio LC v2],
			
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Bundle", [Valor #SBP Bundle],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Hora Parada", [Valor #SBP Hora Parada],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Não Invasiva Vazios", [Valor #SBP Vistoria Não Invasiva Vazios],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Ocupação Cais Acostagem", [Valor #SBP Ocupação Cais Acostagem],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Fornecimento de Água", [Valor #SBP Fornecimento de Água],
			
			                -- 🔁 REMOÇÕES (trocado para v2)
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Remoção a Bordo Cheio", [Valor #SBP Remoção a Bordo Cheio v2],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Remoção por Terra Cheio", [Valor #SBP Remoção por Terra Cheio v2],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Remoção por Terra Vazio", [Valor #SBP Remoção por Terra Vazio v2],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Remoção a Bordo Vazio", [Valor #SBP Remoção a Bordo Vazio v2],
			
			                -- 🔁 BOX RATE (trocado para v2)
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Cheio TRA", [Valor #SBP Box Rate Cheio TRA v2],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Vazio TRA", [Valor #SBP Box Rate Vazio TRA v2],
			
			                bussola_comercial[Agrupamento Subgrupo Princing] = "Inciso XIV", [Valor #SBP Inciso XIV v2],
			                bussola_comercial[Agrupamento Subgrupo Princing] = "ISPS", [Valor #ISPS],
			                bussola_comercial[Agrupamento Subgrupo Princing] = "Outros", [Valor #SBP Outros],
			
			
			                // Outros Serviços
			               
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carga Geral", [Valor #SBP Carga Geral],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Depot (PTI, Lavagem,Handling)", [Valor #SBP Depot (PTI, Lavagem,Handling)],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Despesa Administrativa", [Valor #SBP Despesa Administrativa],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inciso XIV", [Valor #SBP Inciso XIV],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Cntr (Vistoria, Expurgo, labels)", [Valor #SBP Manuseio Cntr (Vistoria, Expurgo, labels)],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Extra/Realocações/Transferência Lote", [Valor #SBP Manuseio Extra/Realocações/Transferência Lote],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Outros", [Valor #SBP Outros OS],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr", [Valor #SBP Pesagem Cntr OS],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Transferência de Lote", [Valor #SBP Transferência de Lote],
			
			
			                //Serviços de Armazém
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Busca Cntr Vazio", [Valor #SBP Busca Cntr Vazio],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Desova Mecanizada", [Valor #SBP Desova Mecanizada],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Desova Manual", [Valor Desova Manual],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estufagem Manual", [Valor #SBP Estufagem Manual],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estufagem Mecanizada", [Valor #SBP Estufagem Mecanizada],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Cntr Vistoria", [Valor #SBP Manuseio Cntr Vistoria SA],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Outros", [Valor #SBP Outros SA],
			
			
			                //Básicos Cabotagem
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Armazenagem Cntr Cheio BC", [Valor #SBP Armazenagem Cntr Cheio BC],
			
			
			                //Básicos Exportação
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Armazenagem Carga Exportação", [Valor #SBP Armazenagem Carga Exportação],
			               
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Entrega Cntr Vazio", [Valor #SBP Entrega de Cntr Vazio],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inspeção Não Invasiva Cheio Exportação", [Valor #SBP Inspeção Não Invasiva Cheio Exportação],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "ISPS", [Valor #SBP ISPS BE],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Monitoramento Cntr Reefer", [Valor #SBP Monitoramento Cntr Reefer BE],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr", [Valor #SBP Pesagem Cntr BE],
			               
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Não Invasiva Cheio Exportação", [Valor #SBP Vistoria Não Invasiva Cheio Exportação],
			
			
			                //Básicos Transbordo
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Armazenagem Cntr Cheio BT", [Valor #SBP Armazenagem Cntr Cheio BT],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Armazenagem Cntr Vazios BT", [Valor #SBP Armazenagem Cntr Vazios BT],
			
			                -- 🔁 BOX RATE (trocado para v2)
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Cheio TRA BT", [Valor #SBP Box Rate Cheio TRA BT v2],
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Vazio TRA BT", [Valor #SBP Box Rate Vazio TRA BT v2],
			
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Bundle BT", [Valor #SBP Bundle BT],
			               
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Out of Gauge Cargo BT", [Valor #SBP Out of Gauge Cargo BT],
			
			
			                //Reefer
			               
			                'bussola_comercial'[Agrupamento Subgrupo Princing] = "Fornecimento de Energia Cntr Reefer", [Valor #SBP Fornecimento de Energia Cntr Reefer],
			
			                0
			            )
			        )
			    )
			    *
			    IF(vDolar=BLANK(),1,vDolar)
			```
		displayFolder: Outras medidas
		lineageTag: c8098e7a-d54c-4a67-9543-94035becac52

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simulador de preço' =
			
			IFERROR(IF(
			    (1+[Pocket_price2])*[Price3]<-1,
			    0,
			    (1+[Pocket_price2])*[Price3]
			),BLANK())
		formatString: #,0.00
		displayFolder: Outras medidas
		lineageTag: 9ec83143-ce69-421a-8a73-5965feaf55d0

	measure 'Volume PP' = ```
			
			SUMX(
			    FILTER(
			        'bussola_comercial',
			        'bussola_comercial'[Agrupamento Subgrupo Princing] IN {
			            "Box Rate Cheio LC", "Box Rate Vazio LC", 
			            "Box Rate Cheio CAB", "Box Rate Vazio CAB",
			            "Remoção por terra Cheio", "Remoção por terra Vazio",
			            "Remoção a Bordo Cheio", "Remoção a Bordo Vazio",
			            "Box Rate Cheio TRA", "Box Rate Vazio TRA", "Box Rate Cheio TRA BT","Box Rate Vazio TRA BT"
			        }
			    ),
			    'bussola_comercial'[volume]
			)
			
			```
		displayFolder: Outras medidas
		lineageTag: 33a41acf-98fe-47df-a5b0-01882afbad0e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tabela Pública' = ```
			SWITCH(
			    TRUE(),
			    
			    -- Para o nível de serviço, retorna o último valor negociado com base na data mais recente
			    ISINSCOPE('bussola_comercial'[servico]),
			    CALCULATE(
			    LASTNONBLANK(
			        bussola_comercial[tabela_publica],
			        MAX(bussola_comercial[data_do_inicio_do_evento])
			    ),
			    FILTER(
			        'bussola_comercial',
			        bussola_comercial[data_do_inicio_do_evento] = MAX(bussola_comercial[data_do_inicio_do_evento])
			    )
			),
			
			    -- Para os níveis de "Agrupamento Serviço" e "Agrupamento Subgrupo Princing", retorna a média do valor negociado
			    AVERAGE(bussola_comercial[tabela_publica])
			
			)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Outras medidas
		lineageTag: 7b0cd2e6-c8ec-4f5b-be07-e35ab3e9e036

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Projeção Tabela Pública' = ```
			
			var data_max = MAX(bussola_comercial[competencia])
			var result = 
			
			            IF(
			                MAX(Calendario2[Date])>data_max,
			                CALCULATE([Tabela Pública]*(1+[Pocket Price]), DATEADD(Calendario2[Date],-'Meses contratuais'[Período contratual],MONTH)),
			                [Tabela Pública]
			            )
			
			return result
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Outras medidas
		lineageTag: 4312091d-bf97-4fc4-a7a5-8d102e85da34

