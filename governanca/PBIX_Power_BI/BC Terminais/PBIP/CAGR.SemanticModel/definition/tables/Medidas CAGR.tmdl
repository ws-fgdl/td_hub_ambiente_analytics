	measure 'Inciso XIV' = ```
			
			VAR tipoServico = SELECTEDVALUE('contratos'[Tipo Inciso])
			VAR subgrupo = SELECTEDVALUE('contratos'[Agrupamento Subgrupo Princing])
			
			-- Último valor para Inciso XIV CAB
			VAR ultDataIncisoXIVCAB_CH =
			    CALCULATE(
			        MAX('contratos'[inicio_vigencia]),
			        REMOVEFILTERS(contratos[Agrupamento Subgrupo Princing]),
			        'contratos'[Tipo Inciso] = "Inciso XIV CAB CH"
			    )
			
			VAR ultDataIncisoXIVCAB_VZ =
			    CALCULATE(
			        MAX('contratos'[inicio_vigencia]),
			        REMOVEFILTERS(contratos[Agrupamento Subgrupo Princing]),
			        'contratos'[Tipo Inciso] = "Inciso XIV CAB VZ"
			    )    
			
			VAR ultPriceCAB_CH = 
			    CALCULATE(
			        LASTNONBLANK('contratos'[valor], MAX(contratos[inicio_vigencia])),
			        REMOVEFILTERS(contratos[Agrupamento Subgrupo Princing]),
			        'contratos'[Tipo Inciso] = "Inciso XIV CAB CH",
			        'contratos'[inicio_vigencia] = ultDataIncisoXIVCAB_CH
			    )
			
			VAR ultPriceCAB_VZ = 
			    CALCULATE(
			        LASTNONBLANK('contratos'[valor], MAX(contratos[inicio_vigencia])),
			        REMOVEFILTERS(contratos[Agrupamento Subgrupo Princing]),
			        'contratos'[Tipo Inciso] = "Inciso XIV CAB VZ",
			        'contratos'[inicio_vigencia] = ultDataIncisoXIVCAB_VZ
			    )
			
			-- Último valor para Inciso XIV LC
			VAR ultDataIncisoXIVLC_CH =
			    CALCULATE(
			        MAX('contratos'[inicio_vigencia]),
			        REMOVEFILTERS(contratos[Agrupamento Subgrupo Princing]),
			        'contratos'[Tipo Inciso] = "Inciso XIV LC CH"
			    )
			
			VAR ultDataIncisoXIVLC_VZ =
			    CALCULATE(
			        MAX('contratos'[inicio_vigencia]),
			        REMOVEFILTERS(contratos[Agrupamento Subgrupo Princing]),
			        'contratos'[Tipo Inciso] = "Inciso XIV LC VZ"
			    )
			
			VAR ultPriceLC_CH = 
			    CALCULATE(
			        LASTNONBLANK('contratos'[valor], MAX(contratos[inicio_vigencia])),
			        REMOVEFILTERS(contratos[Agrupamento Subgrupo Princing]),
			        'contratos'[Tipo Inciso] = "Inciso XIV LC CH",
			        'contratos'[inicio_vigencia] = ultDataIncisoXIVLC_CH
			    )
			
			VAR ultPriceLC_VZ = 
			    CALCULATE(
			        LASTNONBLANK('contratos'[valor], MAX(contratos[inicio_vigencia])),
			        REMOVEFILTERS(contratos[Agrupamento Subgrupo Princing]),
			        'contratos'[Tipo Inciso] = "Inciso XIV LC VZ",
			        'contratos'[inicio_vigencia] = ultDataIncisoXIVLC_VZ
			    )    
			
			RETURN
			    SWITCH(
			        TRUE(),
			        subgrupo IN {
			            "Box Rate Cheio LC"
			        }, ultPriceLC_CH,
			        subgrupo IN {
			            "Box Rate Vazio LC"
			        },ultPriceLC_VZ,
			        subgrupo IN {
			            "Box Rate Cheio CAB"
			        }, ultPriceCAB_CH,
			        subgrupo IN {
			            "Box Rate Vazio CAB"
			        }, ultPriceCAB_VZ,
			        BLANK()
			    )
			
			
			```
		displayFolder: Inciso/Inframar
		lineageTag: 845bd299-6281-4663-ab6b-7bc9f3bef72f

