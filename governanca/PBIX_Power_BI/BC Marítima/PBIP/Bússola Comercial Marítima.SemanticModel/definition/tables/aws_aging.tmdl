	column DIAS_ATRASO =
			
			VAR DataRef = MAX(aws_aging[dat_incl_reg])
			VAR Dias = DATEDIFF(aws_aging[dat_vencimento], DataRef, DAY)
			RETURN
			IF(Dias > 0, Dias, 0)
		formatString: 0
		lineageTag: 073d0e50-8516-486f-b22a-1da3ea7828f4
		summarizeBy: sum

