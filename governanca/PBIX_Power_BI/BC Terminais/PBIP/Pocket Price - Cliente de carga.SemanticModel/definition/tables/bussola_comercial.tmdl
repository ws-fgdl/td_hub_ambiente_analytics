			IF(
			    AND('bussola_comercial'[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio", "Armazenagem Carga Importação"},bussola_comercial[un]="TRG"),
			
			    IF(
			        bussola_comercial[periodo1_contrato] = BLANK(),
			        bussola_comercial[volume],
			        IF(
			            bussola_comercial[volume]>bussola_comercial[periodo1_contrato],bussola_comercial[periodo1_contrato],bussola_comercial[volume]
			        )
			    ),
			
			
			IF(
			    bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT","Armazenagem Cntr Cheio", "Armazenagem Carga Importação"},
			    IF(
			        bussola_comercial[periodo1_contrato] = BLANK(),
			        bussola_comercial[volume],
			        IF(
			            bussola_comercial[volume]<=bussola_comercial[periodo1_contrato],IF(bussola_comercial[volume]>0,1,0),IF(rest<=bussola_comercial[periodo1_contrato],1,0)
			        )
			    )
			    
			        ,
			    BLANK()
