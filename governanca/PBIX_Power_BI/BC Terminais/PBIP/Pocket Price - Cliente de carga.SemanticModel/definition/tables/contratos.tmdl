	column contar = ```
			COUNTX
			(FILTER(
			    contratos, contratos[concat2] = EARLIER(contratos[concat2])), 
			contratos[concat2]
			)
			```
		formatString: 0
		lineageTag: f060379f-3369-4204-8a5e-359f6c209a57
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

