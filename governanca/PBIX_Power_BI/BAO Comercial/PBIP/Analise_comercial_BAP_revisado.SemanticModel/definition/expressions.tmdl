		    #"Expanded Data" = Table.ExpandTableColumn(#"Renamed Columns2", "Data", Table.ColumnNames(#"Filtered Rows2")),
		
		
		    // NOVO: Remoção "cross-type" — descarta qualquer evento (Entrou ou Saiu) que ocorra nos X minutos após um Entrou preservado
		    #"Removed Cross-Type Close" =
		        Table.Group(
		            #"Expanded Data",
		            {"Embarcação"},
		            {
		                {
		                    "Data",
		                    (tbl) =>
		                        let
		                            Sorted = Table.Sort(tbl, {{"Disparo", Order.Ascending}}),
		                            Recs = Table.ToRecords(Sorted),
		                            Init = [Kept = {}, LastEntrou = null],
		                            Step = (s as record, r as record) as record =>
		                                let
		                                    t = r[Disparo],
		                                    isEntrou = Text.Upper(Text.Trim(r[#"Entrada/Saída"])) = "ENTROU",
		                                    withinWindow =
		                                        (s[LastEntrou] <> null)
		                                        and (Duration.TotalMinutes(t - s[LastEntrou]) <= 10)
		                                in
		                                    if withinWindow then
		                                        s
		                                    else
		                                        [
		                                            Kept = s[Kept] & {r},
		                                            LastEntrou = if isEntrou then t else s[LastEntrou]
		                                        ],
		                            Final = List.Accumulate(Recs, Init, Step),
		                            Out = Table.FromRecords(Final[Kept])
		                        in
		                            Out,
		                    type table
		                        [ID Ocorrência=nullable text, ID Disparo=nullable text, Natureza=nullable text,
		                         Localização=nullable text, Nome=nullable text, Descrição=nullable text,
		                         Tipo Abreviado=nullable text, Tipo específico do alarme=nullable text,
		                         #"Entrada/Saída"=nullable text, Embarcação=nullable text, IMO=nullable text,
		                         Disparo=nullable datetime]
		                }
		            }
		        ),
		    #"Renamed Columns3" = Table.RenameColumns(#"Removed Cross-Type Close",{{"Embarcação", "Embarcação2"}}),
		
		    #"Expanded Cross-Type Close" = Table.ExpandTableColumn(#"Renamed Columns3", "Data", Table.ColumnNames(#"Expanded Data")),
		
