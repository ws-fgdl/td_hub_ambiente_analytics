		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume PP Carga' = ```
			
			VAR _tsv =
			    CALCULATE (
			        SUM ( bussola_comercial[volume] ),
			        bussola_comercial[Agrupamento Subgrupo Princing]
			            IN {
			                "Inspeção Não Invasiva Cheio Exportação",
			                "Inspeção Não Invasiva Cheio Importação"
			            }
			    )
			VAR _trg =
			    CALCULATE (
			        SUM ( bussola_comercial[volume] ),
			        bussola_comercial[Agrupamento Subgrupo Princing] IN { "ISPS" }
			    )
			RETURN
			SWITCH (
			    TRUE(),
			    SELECTEDVALUE ( bussola_comercial[un] ) = "TRG", _trg,
			    _tsv
			)
			
			```
		lineageTag: 7d910225-fa1b-48a1-aa30-04285ab97bfb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume Simulado Carga IMP' = ```
			
			// Parâmetros de freetime
			VAR _freetime_param_default       = [Valor #Freetime]
			VAR _freetime_param_vazio_imp     = [#Param Dias Freetime Vazio Imp (selecionado)]
			VAR _freetime_param_vazio_exp     = [#Param Dias Freetime Vazio Exp (selecionado)]
			// Parâmetros de isenção
			VAR _dias_isencao_param_default   = [Valor #Dias Isenção]
			VAR _dias_isencao_param_vazio_imp = [#Param Dias Isenção Vazio Imp (selecionado)]
			VAR _dias_isencao_param_vazio_exp = [#Param Dias Isenção Vazio Exp (selecionado)]
			// Parâmetros de ajuste de volume
			VAR _perc_ajuste_volume_cheio     = [Valor #% Ajuste Vlume]
			VAR _perc_ajuste_volume_vazio     = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			
			RETURN
			SUMX
			( bussola_comercial
			, VAR _servico               = bussola_comercial[servico]
			  VAR _sub_grupo_princing    = bussola_comercial[Agrupamento Subgrupo Princing]
			  // Variáveis do tipo "flag"
			  VAR _sinalizador_cheio     = _sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT" }
			  VAR _sinalizador_vazio     = _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			  VAR _sinalizador_vazio_imp = _sinalizador_vazio //&& CONTAINSSTRING(_servico, "IMP")
			  VAR _sinalizador_vazio_exp = _sinalizador_vazio //&& CONTAINSSTRING(_servico, "EXP")
			  
			  // Para freetime e isenção: se parâmetro estiver em branco, considerar o realizado.
			  VAR _freetime_param =
			    SWITCH
			    ( TRUE()
			    , _sinalizador_vazio_imp, _freetime_param_vazio_imp
			    , _sinalizador_vazio_exp, _freetime_param_vazio_exp
			    , _freetime_param_default
			    )
			  VAR _dias_isencao_param =
			    SWITCH
			    ( TRUE()
			    , _sinalizador_vazio_imp, _dias_isencao_param_vazio_imp
			    , _sinalizador_vazio_exp, _dias_isencao_param_vazio_exp
			    , _dias_isencao_param_default
			    )
			
			  VAR _freetime = IF(ISBLANK(_freetime_param), bussola_comercial[dias_free_time], _freetime_param)
			  VAR _dias_servico = bussola_comercial[dias_servico]
			  VAR _perc_ajuste_volume =
			    SWITCH
			    ( TRUE()
			    , _sinalizador_vazio, _perc_ajuste_volume_vazio
			    , _sinalizador_cheio, _perc_ajuste_volume_cheio
			    , 0
			    )
			
			    VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao], _dias_isencao_param)
			
			  // Se dias de serviço for menor que freetime, retornar zero; caso contrário, calcular os dias de serviço considerando os de isenção.
			  VAR _dias_servico_ajustado =
			      IF ( _dias_servico <= _freetime
			         , 0
			         , VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao], _dias_isencao_param)
			           RETURN
			           IF ( _dias_isencao > _dias_servico
			              , 0
			              , _dias_servico - _dias_isencao
			              )
			         )
			
			    VAR _volume_simulado = IF(_dias_servico <= _freetime , 0, IF(_dias_servico < _dias_isencao, 0, _dias_servico - _dias_isencao))
			    
			  RETURN
			  ROUNDup(_volume_simulado* (1 + _perc_ajuste_volume), 0)
			)
			```
		lineageTag: 5526c3b8-2202-4ea4-b509-084ecf79525c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dias P1 Simulado Carga Imp' = ```
			
			// Premissas consideradas para obter os valores dos parâmetros; o percentual retorna zero quando nada foi informado; os outros retornam BLANK().
			VAR _freetime_param     = [Valor #Freetime]
			VAR _dias_isencao_param = [Valor #Dias Isenção]
			VAR _perc_ajuste_volume_cheio = [Valor #% Ajuste Vlume]
			VAR _perc_ajuste_volume_vazio = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			 
			RETURN
			SUMX
			( bussola_comercial
			, VAR _periodo1_contrato = bussola_comercial[periodo1_contrato]
			    VAR _un = bussola_comercial[un] 
			  RETURN
			  IF ( ISBLANK(_periodo1_contrato)
			     , BLANK()
			     , // Verificar a quantidade de dias em freetime. Se o parâmetro estiver em branco, considerar o realizado.
			       VAR _freetime = IF(ISBLANK(_freetime_param), if(ISBLANK(bussola_comercial[dias_free_time]),0,bussola_comercial[dias_free_time]), _freetime_param)
			       VAR _dias_servico = bussola_comercial[dias_servico]
			       VAR _sub_grupo_princing = bussola_comercial[Agrupamento Subgrupo Princing]
			       VAR _perc_ajuste_volume =
			         SWITCH
			         ( TRUE()
			         , (_sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}), _perc_ajuste_volume_vazio
			         , (_sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT", "Armazenagem Carga Importação" }), _perc_ajuste_volume_cheio
			         , 0
			         )
			       // Se dias de serviço for menor que freetime, retornar zero; caso contrário, calcular os dias de serviço considerando os de isenção.
			       VAR _dias_servico_ajustado =
			           IF ( _dias_servico <= _freetime
			              , 0
			              , VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao], _dias_isencao_param)
			                RETURN
			                IF ( _dias_isencao > _dias_servico
			                   , 0
			                   , _dias_servico - _dias_isencao
			                   )
			              )
			       RETURN 
			       IF ( _dias_servico_ajustado = 0
			          , 0
			          , VAR _volume_simulado = ROUND(_dias_servico_ajustado * (1 + _perc_ajuste_volume), 0)
			 
			            var _is_trg_armador = bussola_comercial[un] = "TRG" //&& CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			            var _is_trg_carga = bussola_comercial[un] = "TRG" && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga" //&& CONTAINSSTRING(bussola_comercial[servico], "IMP") 
			 
			            var _is_trg_vazio = bussola_comercial[un] = "TRG" && _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			 
			            var _is_tsv_armador = bussola_comercial[un] = "TSV" && RELATED(salesforce[Armador/Cliente Carga]) = "Armador" //&& CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			            var _is_tsv_carga = bussola_comercial[un] = "TSV" && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga" //&& CONTAINSSTRING(bussola_comercial[servico], "IMP")
			
			 
			 
			            RETURN
			 
			            SWITCH(
			                TRUE(),
			                    //Filtro TSV Armador e TSV Carga
			                    _is_tsv_armador || _is_tsv_carga || _is_trg_vazio, 1,
			 
			                    //Filtro TRG vazio
			                    //_is_trg_vazio && _is_trg_armador,1,
			 
			                    _is_trg_carga,IF(_volume_simulado > _periodo1_contrato, _periodo1_contrato, _volume_simulado),
			 
			                    //Filtro TRG Cheio e TRG Carga   
			                    _is_trg_armador ,IF(_volume_simulado > _periodo1_contrato, _periodo1_contrato, _volume_simulado),
			 
			                    //ELSE
			                    0
			            )
			 
			 
			        //     IF ( bussola_comercial[un] = "TSV"
			        //        , IF(_volume_simulado > 0, 1, 0)
			        //        //Filtro TRG Armador
			        //        , IF(_sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			        //        , IF(_volume_simulado > 0, 1, 0)
			 
			        //         //Filtro TRG Carga
			        //        , IF(_sub_grupo_princing IN {"Armazenagem Cntr Cheio"} && bussola_comercial[un]="TRG"
			        //        , IF(_volume_simulado > _periodo1_contrato, _periodo1_contrato, _volume_simulado)
			        //        )
			        //        )
			 
			        //   )
			     )
			)
			 
			)
			```
		lineageTag: 91c21420-77ff-47eb-8c2d-4c5a8f997a05

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dias P2 Simulado Carga Imp' = ```
			
			// Premissas consideradas para obter os valores dos parâmetros; o percentual retorna zero quando nada foi informado; os outros retornam BLANK().
			VAR _freetime_param     = [Valor #Freetime]
			VAR _dias_isencao_param = [Valor #Dias Isenção]
			VAR _perc_ajuste_volume_cheio = [Valor #% Ajuste Vlume]
			VAR _perc_ajuste_volume_vazio = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			 
			RETURN
			SUMX
			( bussola_comercial
			, VAR _periodo2_contrato = bussola_comercial[periodo2_contrato]
			  RETURN
			  IF ( ISBLANK(_periodo2_contrato)
			     , BLANK()
			     , // Verificar a quantidade de dias em freetime. Se o parâmetro estiver em branco, considerar o realizado.
			       VAR _freetime = IF(ISBLANK(_freetime_param), bussola_comercial[dias_free_time], _freetime_param)
			       VAR _dias_servico = bussola_comercial[dias_servico]
			       VAR _sub_grupo_princing = bussola_comercial[Agrupamento Subgrupo Princing]
			       VAR _perc_ajuste_volume =
			         SWITCH
			         ( TRUE()
			         , (_sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}), _perc_ajuste_volume_vazio
			         , (_sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT", "Armazenagem Carga Importação" }), _perc_ajuste_volume_cheio
			         , 0
			         )
			       // Se dias de serviço for menor que freetime, retornar zero; caso contrário, calcular os dias de serviço considerando os de isenção.
			       VAR _dias_servico_ajustado =
			           IF ( _dias_servico <= _freetime
			              , 0
			              , VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao], _dias_isencao_param)
			                RETURN
			                IF ( _dias_isencao > _dias_servico
			                   , 0
			                   , _dias_servico - _dias_isencao
			                   )
			              )
			       RETURN
			       IF ( _dias_servico_ajustado = 0
			          , 0
			          , VAR _volume_simulado = ROUND(_dias_servico_ajustado * (1 + _perc_ajuste_volume), 0)
			          
			            VAR _saldo_volume = _volume_simulado - bussola_comercial[periodo1_contrato]
			            VAR _un = bussola_comercial[un]
			 
			            var _is_trg_armador = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			            var _is_trg_carga = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "IMP") && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga"
			 
			            var _is_trg_vazio = bussola_comercial[un] = "TRG" && _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			 
			            // var _is_tsv_armador = bussola_comercial[un] = "TSV" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			
			            var _is_tsv_armador = bussola_comercial[un] = "TSV" && RELATED(salesforce[Armador/Cliente Carga]) = "Armador"
			 
			            var _is_tsv_carga = bussola_comercial[un] = "TSV" && CONTAINSSTRING(bussola_comercial[servico], "IMP") && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga"
			 
			            RETURN
			             
			          SWITCH(
			                TRUE(),
			 
			                    //Filtro TSV Armador
			                    _is_tsv_armador && _saldo_volume > 0, 1,
			 
			                    //Filtro TRG vazio
			                    _is_trg_vazio,  if(_saldo_volume > 0, ROUNDUP(DIVIDE(_saldo_volume,_periodo2_contrato),0),0),
			 
			                    //Filtro TRG Carga
			                    _is_trg_carga, if(_saldo_volume <=0,0,IF(_saldo_volume > _periodo2_contrato, _periodo2_contrato, _saldo_volume)),
			 
			                    //Filtro TRG Cheio
			                    _is_trg_armador && _saldo_volume > 0, _saldo_volume,
			                   
			                    //Filtro de TSV Carga
			                    // _is_tsv_carga && _saldo_volume > bussola_comercial[periodo1_contrato] + bussola_comercial[dias_portas_p1],1,0)
			                    _is_tsv_carga && _saldo_volume > 0,1,0)
			          )
			  )
			)
			
			
			```
		lineageTag: 136d04a5-cc11-4aac-9d3e-1a29d873702f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dias P3 Simulado Carga Imp' = ```
			
			// Premissas consideradas para obter os valores dos parâmetros; o percentual retorna zero quando nada foi informado; os outros retornam BLANK().
			VAR _freetime_param     = [Valor #Freetime]
			VAR _dias_isencao_param = [Valor #Dias Isenção]
			VAR _perc_ajuste_volume_cheio = [Valor #% Ajuste Vlume]
			VAR _perc_ajuste_volume_vazio = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			
			RETURN
			SUMX
			( bussola_comercial
			//, IF ( bussola_comercial[un] = "TRG"
			//     , BLANK()
			     , VAR _periodo3_contrato_ = bussola_comercial[periodo3_contrato]
			       RETURN
			       IF ( ISBLANK(_periodo3_contrato_)
			          , BLANK()
			          , // Verificar a quantidade de dias em freetime. Se o parâmetro estiver em branco, considerar o realizado.
			            VAR _freetime = IF(ISBLANK(_freetime_param), bussola_comercial[dias_free_time], _freetime_param)
			            VAR _dias_servico = bussola_comercial[dias_servico]
			            VAR _sub_grupo_princing = bussola_comercial[Agrupamento Subgrupo Princing]
			            VAR _perc_ajuste_volume =
			              SWITCH
			              ( TRUE()
			              , (_sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}), _perc_ajuste_volume_vazio
			              , (_sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT", "Armazenagem Carga Importação" }), _perc_ajuste_volume_cheio
			              , 0
			              )
			            // Se dias de serviço for menor que freetime, retornar zero; caso contrário, calcular os dias de serviço considerando os de isenção.
			            VAR _dias_servico_ajustado =
			                IF ( _dias_servico <= _freetime
			                   , 0
			                   , VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao], _dias_isencao_param)
			                     RETURN
			                     IF ( _dias_isencao > _dias_servico
			                        , 0
			                        , _dias_servico - _dias_isencao
			                        )
			                   )
			            RETURN
			            IF ( _dias_servico_ajustado = 0
			               , 0
			               , VAR _volume_simulado = ROUND(_dias_servico_ajustado * (1 + _perc_ajuste_volume), 0)
			               
			                 VAR _saldo_volume = _volume_simulado - bussola_comercial[periodo1_contrato] - bussola_comercial[periodo2_contrato]
			
			                 VAR _saldo_volume_TSVCarga = _saldo_volume-bussola_comercial[dias_portas_p2]
			
			            var _is_trg_armador = bussola_comercial[un] = "TRG" //&& CONTAINSSTRING(bussola_comercial[servico], "EXP")
			
			            var _is_trg_carga = bussola_comercial[un] = "TRG" && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga" //&& CONTAINSSTRING(bussola_comercial[servico], "IMP")
			
			            var _is_trg_vazio = bussola_comercial[un] = "TRG" && _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			
			            var _is_tsv_armador = bussola_comercial[un] = "TSV" && RELATED(salesforce[Armador/Cliente Carga]) = "Armador" //&& CONTAINSSTRING(bussola_comercial[servico], "EXP")
			
			            var _is_tsv_carga = bussola_comercial[un] = "TSV" && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga" //&& CONTAINSSTRING(bussola_comercial[servico], "IMP")
			
			
			
			                 RETURN
			
			SWITCH(
			                TRUE(),
			
			                     //Filtro TSV Armador
			                    _is_tsv_armador && _saldo_volume > 0, ROUNDUP(DIVIDE(_saldo_volume,_periodo3_contrato_),0),
			
			                    //Filtro TRG Carga
			                    _is_trg_carga, if(_saldo_volume<=0,0,IF(_saldo_volume > _periodo3_contrato_, _periodo3_contrato_, _saldo_volume)),
			
			                    //Filtro de TSV Carga
			                     _is_tsv_carga && _saldo_volume_TSVCarga > 0,ROUNDUP(DIVIDE(_saldo_volume_TSVCarga,_periodo3_contrato_),0)
			               
			
			
			                    // bussola_comercial[un] = "TSV" && _saldo_volume > 0, 1,
			
			                    // //Filtro TRG Armador (esse filtro está fazendo o cálculo de CARGA)
			                    // bussola_comercial[un] = "TRG" && (_sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}), _saldo_volume - (bussola_comercial[periodo1_contrato] + bussola_comercial[periodo2_contrato]),
			                    
			                    // //formula original que já estava
			                    // _saldo_volume > 0, ROUNDUP(DIVIDE(_saldo_volume, bussola_comercial[periodo3_contrato]),0)
			                    
			                    //ELSE
			                    ,0
			             
			          )
			     )
			)
			
			
			             
			//)
			)
			```
		lineageTag: 74826f10-2148-4aac-8a43-0f228efa343a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dias P4 Simulado Carga Imp' = ```
			
			// Premissas consideradas para obter os valores dos parâmetros; o percentual retorna zero quando nada foi informado; os outros retornam BLANK().
			VAR _freetime_param     = [Valor #Freetime]
			VAR _dias_isencao_param = [Valor #Dias Isenção]
			VAR _perc_ajuste_volume_cheio = [Valor #% Ajuste Vlume]
			VAR _perc_ajuste_volume_vazio = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			
			RETURN
			SUMX
			( bussola_comercial
			//, IF ( bussola_comercial[un] = "TRG"
			//     , BLANK()
			     , VAR _periodo4_contrato = bussola_comercial[periodo4_contrato]
			       RETURN
			       IF ( ISBLANK(_periodo4_contrato)
			          , BLANK()
			          , // Verificar a quantidade de dias em freetime. Se o parâmetro estiver em branco, considerar o realizado.
			            VAR _freetime = IF(ISBLANK(_freetime_param), bussola_comercial[dias_free_time], _freetime_param)
			            VAR _dias_servico = bussola_comercial[dias_servico]
			            VAR _sub_grupo_princing = bussola_comercial[Agrupamento Subgrupo Princing]
			            VAR _perc_ajuste_volume =
			              SWITCH
			              ( TRUE()
			              , (_sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}), _perc_ajuste_volume_vazio
			              , (_sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT", "Armazenagem Carga Importação"}), _perc_ajuste_volume_cheio
			              , 0
			              )
			            // Se dias de serviço for menor que freetime, retornar zero; caso contrário, calcular os dias de serviço considerando os de isenção.
			            VAR _dias_servico_ajustado =
			                IF ( _dias_servico <= _freetime
			                   , 0
			                   , VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao], _dias_isencao_param)
			                     RETURN
			                     IF ( _dias_isencao > _dias_servico
			                        , 0
			                        , _dias_servico - _dias_isencao
			                        )
			                   )
			            RETURN
			            IF ( _dias_servico_ajustado = 0
			               , 0
			               , VAR _volume_simulado = ROUND(_dias_servico_ajustado * (1 + _perc_ajuste_volume), 0)
			                 VAR _saldo_volume = _volume_simulado - bussola_comercial[periodo1_contrato] - bussola_comercial[periodo2_contrato] - bussola_comercial[periodo3_contrato]
			                 VAR _saldo_volume_TSVCarga = _saldo_volume-bussola_comercial[dias_portas_p2]
			            
			            var _is_trg_carga = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "IMP") && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga"
			
			                 RETURN
			
			SWITCH(
			                TRUE(),
			
			                   
			
			                    //Filtro TRG Carga
			                    _is_trg_carga,  if(_saldo_volume > 0,_saldo_volume,0), 0)
			
			                    
			               
			
			
			                    // bussola_comercial[un] = "TSV" && _saldo_volume > 0, 1,
			
			                    // //Filtro TRG Armador (esse filtro está fazendo o cálculo de CARGA)
			                    // bussola_comercial[un] = "TRG" && (_sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}), _saldo_volume - (bussola_comercial[periodo1_contrato] + bussola_comercial[periodo2_contrato]),
			                    
			                    // //formula original que já estava
			                    // _saldo_volume > 0, ROUNDUP(DIVIDE(_saldo_volume, bussola_comercial[periodo3_contrato]),0)
			                    
			                    //ELSE
			                    //,0
			             
			          )
			     )
			)         
			
