		                                        [
		                                            Kept = s[Kept] & {r},
		                                            LastSaiu = if isSaiu then t else s[LastSaiu]
		                                        ],
		                            Final = List.Accumulate(Recs, Init, Step),
		                            Out = Table.FromRecords(Final[Kept])
		                        in
		                            Out,
