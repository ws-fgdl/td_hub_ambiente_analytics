	partition Clientes_Somente_BC = calculated
		mode: import
		source = ```
				
				FILTER(
				    ADDCOLUMNS(
				        VALUES(aws_bussola_comercial_mar[cliente_sap]),
				        "Cliente", 
				        CALCULATE(
				            MAX(aws_bussola_comercial_mar[cliente])
				        )
				    ),
				    NOT aws_bussola_comercial_mar[cliente_sap] 
				        IN VALUES(Dim_carteira_comercial_consolidado[CODIGO_SAP])
				)
				
				```

