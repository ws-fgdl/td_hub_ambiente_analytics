	measure CAGR = ```
			
			VAR AnoMin = MIN('Calendario1'[Ano Calendario])
			VAR AnoMax = MAX('Calendario1'[Ano Calendario])
			VAR ValorInicial = 
			CALCULATE(
			    [Flag_Price], 'Calendario1'[Ano Calendario] = AnoMin)
			
			VAR ValorFinal = 
			CALCULATE(
			    [Flag_Price], 'Calendario1'[Ano Calendario] = AnoMax)
			VAR NumAnos = (AnoMax - AnoMin) 
			
			RETURN 
			IFERROR(
			    IF(
			    NumAnos > 0, 
			    ( (ValorFinal / ValorInicial) ^ (1 / NumAnos) ) - 1, 
			    BLANK()
			),
			"Verificar nulos"
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 618576f9-ac46-4b26-b673-8552990c0acc

