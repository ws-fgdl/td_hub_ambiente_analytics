	column 'AGRUPAMENTO DE LINHA' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(dataliner_consolidado[LINHA]) || dataliner_consolidado[LINHA] = "", "Não Identificado",
			    dataliner_consolidado[LINHA] IN {"ABAC / CONOSUR", "ABAC / CONOSUR / CON"}, "ABAC/CONOSUR",
			    dataliner_consolidado[LINHA] IN {"AMAZGRUPO ONE FEEDER / CX1"}, "AMAZONE FEEDER",
			    dataliner_consolidado[LINHA] IN {"AMERICAS SERVICE"}, "AMERICAS SERVICE (EXTRA CALL)",
			    dataliner_consolidado[LINHA] IN {"Atlantic North-South Service (ANS)"}, "ANS",
			    dataliner_consolidado[LINHA] IN {"ARGENTINA FEEDER III / PATAGONIA FEEDER"}, "ARGENTINA FEEDER III",
			    dataliner_consolidado[LINHA] IN {"ASAS / ESA / SEAS / ASIA / SA2 / SA3", "Far East - South America Service (ESA)"}, "ASAS (ESA/SEAS/ASIA) SL I",
			    dataliner_consolidado[LINHA] IN {"ASAX - SERVICE"}, "ASAX",
			    dataliner_consolidado[LINHA] IN {"ASIA SOUTH AMERICA EAST COAST (ASE)"}, "ASE",
			    dataliner_consolidado[LINHA] IN {"BRAZIL CABOTAGE SLING 1 / ALCT1 / SMN"}, "BRAZIL CABOTAGE SLING 1 (ALCT1)",
			    dataliner_consolidado[LINHA] IN {"BRAZIL CABOTAGE SLING 2 / ALCT 2"}, "BRAZIL CABOTAGE SLING 2 (ALCT2)",
			    dataliner_consolidado[LINHA] IN {"BRAZIL CABOTAGE SLING 3 / PARANA RIVER FEEDER"}, "BRAZIL CABOTAGE SLING 3",
			    dataliner_consolidado[LINHA] IN {"BRAZIL CABOTAGE SLING 5"}, "BRAZIL CABOTAGE SLING 5",
			    dataliner_consolidado[LINHA] IN {"BRAZIL EXPRESS 2 / MAOSHTTL"}, "BRAZIL EXPRESS 2",
			    dataliner_consolidado[LINHA] IN {"CARIOCA SERVICE"}, "CARIOCA",
			    dataliner_consolidado[LINHA] IN {"DELMAS SAMWAF"}, "SAMWAF",
			    dataliner_consolidado[LINHA] IN {"Far East - South America Service (ESA)"}, "ASAS (ESA/SEAS/ASIA) SL I",
			    dataliner_consolidado[LINHA] IN {"FIL"}, "FIL (FAR EAST-INDIA-LATIN AMERICA)",
			    dataliner_consolidado[LINHA] IN {"PACIFIC EAST COAST 2"}, "EXTRA CALL",
			    dataliner_consolidado[LINHA] IN {"FRENCH GUYANA / NORTH BRAZIL", "FRENCH GUYANA / NORTH BRAZIL / NEFGUI"}, "FRENCH GUYANA / NORTH BRAZIL",
			    dataliner_consolidado[LINHA] IN {"GS1 / USGUF / ANG / GULFEX"}, "GS1/USGUF (GULF)",
			    dataliner_consolidado[LINHA] IN {"LATIN EAST COAST EUROPE EXPRESS / LUX / EEX / ESE2"}, "LATIN EAST COAST EUROPE EXPRESS-LUX",
			    dataliner_consolidado[LINHA] IN {"MANAUS"}, "MANAUS FEEDER",
			    dataliner_consolidado[LINHA] IN {"MED-SAEC / MSE / SAM / SUC / WMED-NEW"}, "MED-SAEC/MSE",
			    dataliner_consolidado[LINHA] IN {"SPAIN / SAEC SERVICE"}, "MSC SPAIN",
			    dataliner_consolidado[LINHA] IN {"NEO BOSSA NOVA / SIRIUS", "SIRIUS"}, "NEO BOSSA/SIRIUS (BOSSA NOVA)",
			    dataliner_consolidado[LINHA] IN {"NEW ASIA I / ASE / AX2 / NEOASAS"}, "NEW ASIA I",
			    dataliner_consolidado[LINHA] IN {"NEW IPANEMA / AS2 / SX1"}, "NEW IPANEMA",
			    dataliner_consolidado[LINHA] IN {"NHX SERVICE 2"}, "NHX SERVICE 3",
			    dataliner_consolidado[LINHA] IN {"NORTH EUROPE / WEST AFRICA / SOUTH AMERICA LINE", "NORTH EUROPE/SOUTH AMERICA LINE"}, "NORTH EUROPE/WEST AFRICA/SOUTH AMERICA LINE",
			    dataliner_consolidado[LINHA] IN {"NWC / ECX", "NWC / SAECS I SERVICE", "NWC / SAECS II SERVICE"}, "NWC/ECX (MSC EUROPA)",
			    dataliner_consolidado[LINHA] IN {"NEW SAFRAN", "PLATE EXPRESS / ESE / NEOSAMBA / SAFRAN1", "SAFRAN"}, "PLATE EXPRESS",
			    dataliner_consolidado[LINHA] IN {"SAMWAF / SAT"}, "SAMWAF",
			    dataliner_consolidado[LINHA] IN {"SAN ANTONIO EXPRESS / SAEX", "SAN ANTONIO EXPRESS / SAEX / SAN ANTONIO ESTE"}, "SAN ANTONIO EXPRESS - SAEX",
			    dataliner_consolidado[LINHA] IN {"USGULF/SAEC", "USGULF/SAEC/SAX"}, "SAX",
			    dataliner_consolidado[LINHA] IN {"SEAS1"}, "SEAS2",
			    dataliner_consolidado[LINHA] IN {"SINO SOUTH AMERICA / ESA2 / SEAS2", "SINO SOUTH AMERICA / ESA3 / SEAS2"}, "SINO SOUTH AMERICA - SSA",
			    dataliner_consolidado[LINHA] IN {"SOUTH AMERICA/WEST AFRICA SERVICE"}, "SOUTH AMERICA/WEST AFRICA SERVICE",
			    dataliner_consolidado[LINHA] IN {"SOUTH ATLANTIC / PLATAMRC / PLATA / SAS"}, "SOUTH ATLANTIC (LOG-IN)",
			    dataliner_consolidado[LINHA] IN {"TANGO / SEC"}, "TANGO",
			    dataliner_consolidado[LINHA] IN {"USEC-SAEC / SUM / USA / XNS"}, "USEC-SAEC/XNS (MSC USA)",
			    dataliner_consolidado[LINHA] IN {"WMED / SAEC II SERVICE"}, "WMED",
			    dataliner_consolidado[LINHA] IN {"ZGT"}, "ZIM GULF TOUCAN",
			    dataliner_consolidado[LINHA]
			)
		lineageTag: f6a873eb-73cb-48de-9818-cd6187dae719
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'PORTO ORIGEM/DEST. SIGLA' =
			
