	measure 'Volume Proprio e Terceiros YTD' = calculate(sum('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[VOLUME]), DATEDIFF('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[COMPETENCIA], selectedvalue('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA]), MONTH) < 13, DATEDIFF('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[COMPETENCIA], selectedvalue('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA]), MONTH) >= 0, YEAR('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[COMPETENCIA]) = YEAR(selectedvalue('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA])))
		lineageTag: 4de2ebae-11fd-40ab-b0c2-789c5a6667f5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume Proprio e Terceiros YTD Orçado' = ```
			
			// 1. Pega o valor selecionado (ex: "201705")
			VAR vMaxData = MAX('_Tempo'[#Ano/Mês]) 
			
			// 2. Extrai os 4 primeiros caracteres para descobrir o Ano (ex: "2017")
			VAR vAnoSelecionado = LEFT(vMaxData, 4)
			
			RETURN
			CALCULATE(
			    SUM('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[VOLUME]),
			    
			    // Remove os filtros atuais da tabela calendário
			    REMOVEFILTERS('_Tempo'),
			    
			    // 3. Pega todos os meses onde os 4 primeiros caracteres (Ano) são iguais ao ano atual
			    LEFT('_Tempo'[#Ano/Mês], 4) = vAnoSelecionado,
			    
			    // 4. Garante que não vai somar meses além do selecionado
			    '_Tempo'[#Ano/Mês] <= vMaxData,
			    
			    // Filtro da fato
			    'Volume Próprio e Terceiros e Perfil Afretamento - Volume'[DSC_TIPO] = "ORÇADO"
			)
			```
		formatString: 0
		lineageTag: 967f8cb1-05c5-473f-bb8d-c8a8552419d0

		changedProperty = Name

