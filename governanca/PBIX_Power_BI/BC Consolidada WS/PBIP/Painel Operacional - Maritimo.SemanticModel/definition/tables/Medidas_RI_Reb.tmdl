	measure Manobras_Contagem_diaria2 = ```
			
			// 1. Encontra a última data na base para servir de referência
			VAR vUltimaDataFato = CALCULATE( 
			    MAX('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[DT_OPER]), 
			    REMOVEFILTERS('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC') 
			)
			VAR vMaxMes = MONTH(vUltimaDataFato)
			VAR vMaxAno = YEAR(vUltimaDataFato)
			VAR vMaxDia = DAY(vUltimaDataFato)
			
			// 2. Verifica se o usuário filtrou Ano ou Mês
			VAR vAnoFiltrado = ISFILTERED('_Tempo'[Ano]) 
			VAR vMesFiltrado = ISFILTERED('_Tempo'[#Mês]) 
			
			// 3. Guarda as seleções do usuário
			VAR vAnosSelecionados = VALUES('_Tempo'[Ano])
			VAR vMesesSelecionados = VALUES('_Tempo'[#Mês])
			
			RETURN
			CALCULATE(
			    [Vol_Manobra],
			    
			    KEEPFILTERS(
			        FILTER(
			            ALL('_Tempo'), 
			            
			            // Regra do Ano: Adicionado VALUE() para converter o texto da coluna em número
			            (
			                (vAnoFiltrado = TRUE() && '_Tempo'[Ano] IN vAnosSelecionados) ||
			                (vAnoFiltrado = FALSE() && VALUE('_Tempo'[Ano]) IN {vMaxAno, vMaxAno-1, vMaxAno-2})
			            )
			            &&
			            
			            // Regra do Mês: Adicionado VALUE() para converter o texto da coluna em número
			            (
			                (vMesFiltrado = TRUE() && '_Tempo'[#Mês] IN vMesesSelecionados) ||
			                (vMesFiltrado = FALSE() && VALUE('_Tempo'[#Mês]) = vMaxMes) 
			            )
			            &&
			            
			            // Trava o dia
			            DAY('_Tempo'[data]) <= vMaxDia
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: 0916d406-6495-4fef-a48c-ce361e4b24a5

	measure _VolumeMedio_MesAtual = ```
			
			VAR MaxData = MAX('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[DT_OPER])
			VAR AnoMax = YEAR(MaxData)
			VAR MesMax = MONTH(MaxData)
			
			RETURN
			CALCULATE(
			    [Média], 
			    
			    // 1. Remove os filtros que vieram de fora (tela)
			    REMOVEFILTERS('_Tempo'),
			    
			    // 2. Aplica o filtro do Mês Máximo e Ano Máximo na TABELA DIMENSÃO (_Tempo)
			    YEAR('_Tempo'[Data]) = AnoMax,
			    MONTH('_Tempo'[Data]) = MesMax
			)
			```
		lineageTag: eb33c0c8-6a19-4c0d-bc09-aa1be0d74c7c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _VolumeMedio_AnoAnterior = ```
			
			VAR MaxData = MAX('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[DT_OPER])
			
			// Subtrai 1 do ano e mantém o mesmo mês da última carga
			VAR AnoAnt = YEAR(MaxData) - 1
			VAR MesAtual = MONTH(MaxData)
			
			RETURN
			CALCULATE(
			    [Média], 
			    
			    // 1. Limpa os filtros atuais do calendário
			    REMOVEFILTERS('_Tempo'), 
			    
			    // 2. Filtra a DIMENSÃO Calendário para o mesmo mês no ano anterior
			    YEAR('_Tempo'[Data]) = AnoAnt,
			    MONTH('_Tempo'[Data]) = MesAtual
			)
			```
		lineageTag: 252bd451-e771-481c-94f2-03110a15691e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _VolumeMedio_YTD = ```
			
			VAR MaxData = MAX('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[DT_OPER])
			VAR AnoAtual = YEAR(MaxData)
			
			RETURN
			CALCULATE(
			    [Média], 
			    // 1. Limpa qualquer filtro de Mês/Ano que venha da tela
			    REMOVEFILTERS('_Tempo'),
			    
			    // 2. Filtra do início do ano até a data da última carga
			    YEAR('_Tempo'[Data]) = AnoAtual,
			    '_Tempo'[Data] <= MaxData
			)
			```
		lineageTag: 778ad768-8fef-4bd1-a8e2-841154f3c6c9

