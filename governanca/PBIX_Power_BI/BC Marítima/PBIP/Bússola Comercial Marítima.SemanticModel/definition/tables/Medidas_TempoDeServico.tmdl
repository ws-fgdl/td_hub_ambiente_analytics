table Medidas_TempoDeServico
	lineageTag: 87fe36c7-79ba-4827-bba8-e1e38eba84a1

	measure Media_TempoDeServico_ComDesloc_BaseBC = ```
			
			VAR MinutosTotais =
			    AVERAGEX(
			        aws_bussola_comercial_mar, -- Para cada linha nesta tabela...
			        
			        -- Captura as colunas separadas
			        VAR _DataInicio = aws_bussola_comercial_mar[data_do_inicio_do_evento]
			        VAR _HoraInicio = aws_bussola_comercial_mar[hora_do_inicio_do_evento]
			        VAR _DataFim = aws_bussola_comercial_mar[data_do_fim_do_evento]
			        VAR _HoraFim = aws_bussola_comercial_mar[hora_do_fim_do_evento]
			        VAR _DataCompetencia = aws_bussola_comercial_mar[competencia]
			        
			        -- Junta Data + Hora para formar o campo Data/Hora completo
			        VAR _DataInicioEvento = _DataInicio + _HoraInicio
			        VAR _DataFimEvento = _DataFim + _HoraFim
			        
			        RETURN
			            IF(
			                -- Verifica se as datas de início e fim NÃO estão em branco
			                NOT ISBLANK(_DataInicio) && NOT ISBLANK(_DataFim) &&
			                -- E verifica se o evento terminou no seu mês/ano de competência
			                YEAR(_DataFim) = YEAR(_DataCompetencia) &&
			                MONTH(_DataFim) = MONTH(_DataCompetencia),
			                
			                -- Se TODAS as condições forem VERDADEIRAS, calcula a duração em minutos
			                DATEDIFF(
			                    _DataInicioEvento, 
			                    _DataFimEvento, 
			                    MINUTE
			                ),                 
			                -- Se alguma condição for FALSA, retorna 0
			                0 
			            )
			    )    
			RETURN
			    -- Converte o total de minutos para horas
			    MinutosTotais / 60
			```
		lineageTag: 63185d29-54bc-4d60-8d36-319a2e842a3a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Media_TempoDeServico_ComDesloc_Formatada_BaseBC =
			
			VAR MediaEmHoras = [Media_TempoDeServico_ComDesloc_BaseBC] // Esta variável já está em horas (ex: 0.666...)
			VAR TotalMinutosParaFormatar = MediaEmHoras * 60 // Converte a média de horas de volta para minutos totais (ex: 0.666 * 60 = 40)
			VAR Horas = TRUNC(TotalMinutosParaFormatar / 60) // Obtém a parte inteira das horas
			VAR MinutosRestantes = ROUND(MOD(TotalMinutosParaFormatar, 60), 0) // Obtém os minutos restantes e arredonda para o número inteiro mais próximo
			RETURN
			    FORMAT(Horas, "0") & "h " & FORMAT(MinutosRestantes, "00") & "min"
		lineageTag: 793f53dd-0435-40fd-bab1-954422b9cd89

	measure Media_TempoDeServico_SemDesloc_BaseBC = ```
			
