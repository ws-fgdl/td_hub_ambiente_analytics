table db_rl_lineup_merc
	lineageTag: cd1761b6-bd34-431d-abe0-e6237a8e8f3e

	measure Cor_Categoria_Agrupamento =
			
			SWITCH(
			    SELECTEDVALUE('db_rl_lineup_merc'[DSC_AGRUPAMENTO]),
			    "CONTAINER",      "#0A192F", // Container (Azul Noite Bem Escuro)
			    "CARGA GERAL",    "#4A6572", // Carga Geral (Cinza Azulado Escuro)
			    "GRANEL LIQUIDO", "#2B580C", // Granel Líquido (Verde Escuro Fechado)
			    "DEMAIS CARGAS",  "#E0E0E0", // Demais Cargas (Cinza Muito Claro)
			    "PASSAGEIROS",    "#E5B96B", // Passageiros (Dourado Suave)
			    "RO-RO",          "#8E9AAF", // Ro-Ro (Lilás Cinzento Sóbrio)
			    "GRANEL SOLIDO",  "#155263", // Granel Sólido (Azul Petróleo Escuro)
			    "#00205B"                    // Padrão: Azul Escuro
			)
		lineageTag: eadc9c06-dd98-4b44-8e25-b1e7d4b03236

	measure Cor_Categoria =
			
			SWITCH(
			    SELECTEDVALUE('db_rl_lineup_merc'[DSC_CATEG]),
			    "CARGA GERAL",           "#4A6572", // Cinza Azulado Escuro
			    "CELULOSE",              "#9DB2BF", // Cinza Claro Azulado
			    "CONTAINER",             "#0A192F", // Azul Noite Bem Escuro
			    "DEMAIS CARGAS",         "#E0E0E0", // Cinza Muito Claro
			    "FERTILIZANTES",         "#F4C482", // Bege / Laranja Suave Pastel
			    "GRAOS",                 "#00A8CC", // Ciano / Turquesa Corporativo
			    "MINERIO",               "#1F4E79", // Azul Marinho Médio
			    "PASSAGEIROS",           "#E5B96B", // Dourado Suave
			    "PETROLEO E DERIVADOS",  "#708090", // Cinza Azulado
			    "PRODUTOS SIDERURGICOS", "#5C6B73", // Cinza Aço Fechado
			    "QUIMICOS",              "#4682B4", // Azul Aço
			    "RO-RO",                 "#8E9AAF", // Lilás Cinzento Sóbrio
			    "#708090"                           // Cor Padrão
			)
		lineageTag: c45eae6a-fead-4c34-b9a2-85c3e4116d76

