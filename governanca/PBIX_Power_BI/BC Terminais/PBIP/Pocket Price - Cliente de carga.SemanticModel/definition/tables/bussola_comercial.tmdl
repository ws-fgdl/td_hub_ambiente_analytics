	column 'Duração em dia' =
			IF(OR(bussola_comercial[data_do_fim_do_evento] = BLANK(), bussola_comercial[data_do_inicio_do_evento] = BLANK()), BLANK(),
			 IF(bussola_comercial[datafim<datainicio] = "ERRADO", BLANK(),
			 IF(DATEDIFF(bussola_comercial[data_do_inicio_do_evento], bussola_comercial[data_do_fim_do_evento], DAY) = 0, 1,
			 DATEDIFF(bussola_comercial[data_do_inicio_do_evento], bussola_comercial[data_do_fim_do_evento], DAY))))
		lineageTag: 45276dd8-5069-42fe-a559-22c9ea8218ea
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column datafim<datainicio = if(bussola_comercial[data_do_fim_do_evento]<bussola_comercial[data_do_inicio_do_evento], "ERRADO", "CERTO")
		lineageTag: f9c86881-6792-461f-9dc5-25ef1c2df9b8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Serv. Impactado/Tempo' = ```
			LOOKUPVALUE(
			    'Serviço'[Serviço é especial (carga de projeto ou salvatagem) ou é impactado por tempo?],
			    'Serviço'[Chave],
			    bussola_comercial[chave1]
			    
			    )
			```
		lineageTag: eca23eb7-9f7f-432e-8e94-5e03ee5e58f0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ticket2 = ```
			
			    IF(bussola_comercial[Serv. Impactado/Tempo]="SIM", IF(bussola_comercial[Duração em dia] = BLANK(),bussola_comercial[valor_faturado_brl],bussola_comercial[valor_faturado_brl]/bussola_comercial[Duração em dia]), bussola_comercial[valor_faturado_brl])
			```
		lineageTag: 86e8ab3a-0a7d-462d-8ec8-a338d648e5d7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

