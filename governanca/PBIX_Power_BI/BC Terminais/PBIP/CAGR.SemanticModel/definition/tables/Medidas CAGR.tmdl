	measure Reajuste_Media_IPCA_IGPM_Acumulado = ```
			
			VAR AnoMin = SELECTEDVALUE('Anos Inflação'[Ano])
			VAR AnoAtual = SELECTEDVALUE(Calendario1[Ano Calendario])
			
			-- Definição do preço inicial (2020)
			VAR PrecoInicial = CALCULATE([Flag_Price_YOY], Calendario1[Ano Calendario] = AnoMin)
			
			-- Definição dos IPCA para cada ano
			VAR Ipca2020 = CALCULATE(([IGPM YOY]+ [IPCA YOY])/2, Calendario1[Ano Calendario] = AnoMin)
			VAR Ipca2021 = CALCULATE(([IGPM YOY]+ [IPCA YOY])/2, Calendario1[Ano Calendario] = AnoMin + 1)
			VAR Ipca2022 = CALCULATE(([IGPM YOY]+ [IPCA YOY])/2, Calendario1[Ano Calendario] = AnoMin + 2)
			VAR Ipca2023 = CALCULATE(([IGPM YOY]+ [IPCA YOY])/2, Calendario1[Ano Calendario] = AnoMin + 3)
			VAR Ipca2024 = CALCULATE(([IGPM YOY]+ [IPCA YOY])/2, Calendario1[Ano Calendario] = AnoMin + 4)
			VAR Ipca2025 = CALCULATE(([IGPM YOY]+ [IPCA YOY])/2, Calendario1[Ano Calendario] = AnoMin + 5)
			VAR Ipca2026 = CALCULATE(([IGPM YOY]+ [IPCA YOY])/2, Calendario1[Ano Calendario] = AnoMin + 6)
			VAR Ipca2027 = CALCULATE(([IGPM YOY]+ [IPCA YOY])/2, Calendario1[Ano Calendario] = AnoMin + 7)
			
			-- Cálculo do reajuste acumulado ano a ano
			VAR Preco2021 = PrecoInicial * (1 + Ipca2020)
			VAR Preco2022 = Preco2021 * (1 + Ipca2021)
			VAR Preco2023 = Preco2022 * (1 + Ipca2022)
			VAR Preco2024 = Preco2023 * (1 + Ipca2023)
			VAR Preco2025 = Preco2024 * (1 + Ipca2024)
			VAR Preco2026 = Preco2025 * (1 + Ipca2025)
			VAR Preco2027 = Preco2026 * (1 + Ipca2026)
			VAR Preco2028 = Preco2027 * (1 + Ipca2027)
			
			RETURN 
			    SWITCH(
			        TRUE(),
			        SELECTEDVALUE(Calendario1[Ano Calendario]) = AnoMin, Preco2021,
			        SELECTEDVALUE(Calendario1[Ano Calendario]) = AnoMin + 1, Preco2022,
			        SELECTEDVALUE(Calendario1[Ano Calendario]) = AnoMin + 2, Preco2023,
			        SELECTEDVALUE(Calendario1[Ano Calendario]) = AnoMin + 3, Preco2024,
			        SELECTEDVALUE(Calendario1[Ano Calendario]) = AnoMin + 4, Preco2025,
			        SELECTEDVALUE(Calendario1[Ano Calendario]) = AnoMin + 5, Preco2026,
			        SELECTEDVALUE(Calendario1[Ano Calendario]) = AnoMin + 6, Preco2027,
			        SELECTEDVALUE(Calendario1[Ano Calendario]) = AnoMin + 7, Preco2028,
			        BLANK()
			    )
			```
