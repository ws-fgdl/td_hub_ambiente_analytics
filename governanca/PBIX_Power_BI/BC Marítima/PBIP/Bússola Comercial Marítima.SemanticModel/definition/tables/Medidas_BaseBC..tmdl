	measure Faturamento_YTM_BaseBC = ```
			
			VAR vDataMaxSelecionada = MAXX(ALLSELECTED(aws_bussola_comercial_mar), aws_bussola_comercial_mar[competencia])
			
			VAR vMesLimite = MONTH(vDataMaxSelecionada)
			VAR vDiaLimite = DAY(vDataMaxSelecionada)
			
			RETURN
			    CALCULATE(
			        [Flag_Faturamento_BaseBC],
			        KEEPFILTERS(
			            Dim_calendario[numero_mes] < vMesLimite || 
			            (Dim_calendario[numero_mes] = vMesLimite
			        )
			    ))
			```
		lineageTag: 1942f0a4-0bda-4cb4-8c15-0eb778ae957a

		formatStringDefinition = ```
				VAR Valor = SELECTEDMEASURE()
				VAR ValorAbs = ABS(Valor) -- Analisamos o "tamanho" do número independente do sinal
				VAR Selecao = SELECTEDVALUE(Flag_faturamento[Faturamento])
				VAR Prefixo = IF(Selecao = "R$", "R$ ", "$ ")
				
				RETURN
				    SWITCH( TRUE(),
				        ValorAbs >= 1000000000, 
				            Prefixo & "#,##0,,,.0 ""B"";-" & Prefixo & "#,##0,,,.0 ""B""",
				        
				        ValorAbs >= 1000000,    
				            Prefixo & "#,##0,,.0 ""M"";-" & Prefixo & "#,##0,,.0 ""M""",
				        
				        ValorAbs >= 1000,       
				            Prefixo & "#,##0,.0 ""K"";-" & Prefixo & "#,##0,.0 ""K""",
				        
				        -- Para valores entre -999 e 999
				        Prefixo & "#,##0;-" & Prefixo & "#,##0"
				    )
				```

	measure Faturamento_YTM_CY_BaseBC = ```
			
			-- 1. Pega o limite (Ex: Outubro) baseado no seu segmentador
			VAR vDataMaxSlicer = MAXX(ALLSELECTED(aws_bussola_comercial_mar), aws_bussola_comercial_mar[competencia])
			VAR vMesLimite = MONTH(vDataMaxSlicer)
			VAR vDiaLimite = DAY(vDataMaxSlicer)
			
			-- 2. Pega o ano que está na linha da tabela (ou no contexto)
			VAR vAnoContexto = MAX(Dim_calendario[ano_calendario])
			
			RETURN
			CALCULATE(
			    [Flag_Faturamento_BaseBC],
			    KEEPFILTERS(Dim_calendario[ano_calendario] = vAnoContexto),
			    KEEPFILTERS(
			        Dim_calendario[numero_mes] < vMesLimite || 
			        (Dim_calendario[numero_mes] = vMesLimite)
			    ),
			    -- Limpa filtros de mês/dia que venham das linhas da tabela para permitir o acumulado
			    REMOVEFILTERS(Dim_calendario[numero_mes])
			)
			
			
			// VAR vAnoCorrenteDoContexto = YEAR(MAX(Dim_calendario[data]))
