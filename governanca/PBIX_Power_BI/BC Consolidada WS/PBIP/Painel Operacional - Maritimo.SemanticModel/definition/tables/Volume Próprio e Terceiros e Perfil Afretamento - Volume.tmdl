		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var Volume Mês' =
			
			DIVIDE(
			    CALCULATE(
			        SUM('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[VOLUME]),
			        'Volume Próprio e Terceiros e Perfil Afretamento - Volume'[DSC_TIPO] = "REALIZADO"
			    ),
			    CALCULATE(
			        SUM('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[VOLUME]),
			        'Volume Próprio e Terceiros e Perfil Afretamento - Volume'[DSC_TIPO] <> "REALIZADO"
			    )
			) - 1
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2fa83e2d-f00c-46ed-abe2-7e659942ce04

		changedProperty = Name

		changedProperty = FormatString

