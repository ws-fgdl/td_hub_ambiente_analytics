	measure %_CAR_sobre_Fat = ```
			
			VAR Acumulado12Meses = 
			    CALCULATE(
			        [FaturamentoBRL_BaseBC],
			        ALL(aws_bussola_comercial_mar[competencia]),
			        DATESINPERIOD(
			            aws_bussola_comercial_mar[competencia],
			            LASTDATE(aws_bussola_comercial_mar[competencia]),
			            -12,
			            MONTH
			        )
			    )   
			RETURN
			    // 1. Verifica se a medida de vencidos está vazia. Se sim, retorna vazio e esconde a linha.
			    IF(
			        ISBLANK([val_montante_transacao_vencido]),
			        BLANK(),
			        
			        // 2. Se houver dívida, faz a divisão. Se o faturamento for zero, retorna 0 (0,00%).
			        DIVIDE(
			            [val_montante_transacao_vencido], 
			            Acumulado12Meses, 
			            0
			        )
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Faixa_Vencimento
		lineageTag: 058af8a8-dc1e-44af-8b83-e4d9f563c1ae

	measure Total_Invoice_Atraso =
			
			CALCULATE(
			    DISTINCTCOUNT(aws_aging[num_referencia]),
			    aws_aging[DIAS_ATRASO] > 0 // Garante que só vai contar o que já passou da data de vencimento
			
			)
		formatString: 0
		lineageTag: fb249823-8e77-4b8e-9b9c-859c592e1f6b

	measure Valor_LateFee =
			
			SUMX(
			    // Aplica a regra apenas se o atraso for maior que o gap de 6 dias
			    FILTER(aws_aging, aws_aging[DIAS_ATRASO] > 6),
			    IF(
			        aws_aging[DIAS_ATRASO] <= 30,
			        aws_aging[val_montante_transacao] * 0.01, // 1% para atrasos até 30 dias
			        aws_aging[val_montante_transacao] * 0.02  // 2% para atrasos a partir de 31 dias
			    )
			)
		lineageTag: 5405d3bb-c711-4511-91a3-1ddd6a37e6a7

