	measure IUSD = ```
			
			VAR PrimeiroMes = 
			CALCULATE(
			        [Dolar Fechamento Mes],
			        ALL(Calendario1),
			        MONTH(Calendario1[Date]) = MONTH(MINX(ALLSELECTED(Calendario1),Calendario1[Date])),
			        YEAR(Calendario1[Date]) = YEAR(MINX(ALLSELECTED(Calendario1),Calendario1[Date]))
			)
			RETURN
			IF( DIVIDE([Dolar Fechamento Mes]-PrimeiroMes,PrimeiroMes) = -1, BLANK(),DIVIDE([Dolar Fechamento Mes]-PrimeiroMes,PrimeiroMes))
			```
		lineageTag: b36c0db1-3f19-496f-b6e4-70174cdf2426

	measure 'Dolar Fechamento Mes' = ```
			
			VAR menorData = MIN(Calendario1[Date].[Date])
			VAR maiorMes = MONTH(LASTDATE(Calendario1[Date]))
			VAR maiordia = DAY(LASTDATE('df_dolar_ptaxvenda'[Data]))
			VAR maiorAno = YEAR(LASTDATE(Calendario1[Date]))
			
			
			RETURN
			
			IF( DATE(maiorAno, maiorMes,1) < SELECTEDVALUE(Calendario1[Date]), BLANK(),CALCULATE(
			        LASTNONBLANKVALUE('df_dolar_ptaxvenda'[Valor],MAX('df_dolar_ptaxvenda'[Valor])),
			        MONTH(Calendario1[Date]) = maiorMes && YEAR(Calendario1[Date]) = maiorAno && DAY(Calendario1[Date]) = maiordia
			        
			    )
			)
			```
		lineageTag: d261a9e6-3cc6-45c6-b9f6-373fd2ac2212

