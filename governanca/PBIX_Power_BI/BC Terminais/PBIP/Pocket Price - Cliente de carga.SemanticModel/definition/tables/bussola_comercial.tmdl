				let
				    Origem = PowerPlatform.Dataflows([]),
				    #"Navegação 1" = Origem{[Id = "Workspaces"]}[Data],
				    #"Navegação 2" = #"Navegação 1"{[workspaceId = "bcd54b55-e85f-4c30-a169-bfbf18f90f30"]}[Data],
