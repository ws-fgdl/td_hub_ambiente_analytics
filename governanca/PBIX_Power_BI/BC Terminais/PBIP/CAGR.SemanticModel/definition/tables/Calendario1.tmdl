		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Calendario1 = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2017, 1, 1 ), TODAY()),
				    "Mês/Ano", FORMAT ( [Date], "YYYY/MM" ), 
				    "Ano Calendario", YEAR([Date]),
				    "Nome Mes", FORMAT([Date],"mmmm"),
				    "Numero Mes", MONTH([Date]),
				    "Dia da Semana", FORMAT([Date], "dddd"),
				    "Numero do Dia da Semana", WEEKDAY([Date]),
				    "Trimestre", "T" & TRUNC((MONTH([Date])-1)/3)+1
				   
				    
				)
				```

	annotation PBI_Id = f282dda7f5a84bfd991c54b962571c92

