	measure 'Price teste' =
			
			CALCULATE(
			    [Flag_Price],
			    REMOVEFILTERS(Calendario1[Ano Calendario]),
			    DATEADD(Calendario1[date], -1, YEAR)
			)
		formatString: #,0.00
		displayFolder: Price
		lineageTag: 4c11c917-2a29-48a0-a441-0763ccecc037

	measure percent_price = ```
			
			VAR _un = SELECTEDVALUE(UN[UN])
			VAR _grupo_economico = SELECTEDVALUE(SalesForce_Unificada[grupo_economico])
			VAR _razao_social = SELECTEDVALUE(dim_carteira_comercial[razao_social])
			VAR _ano_calendario = SELECTEDVALUE(Calendario1[Ano Calendario])
			VAR _sub_categoria = SELECTEDVALUE(contratos[Agrupamento Subgrupo Princing])
			
			VAR _valor_padrao = 
			    IF(
			        ISBLANK([Preço Médio]),
			        BLANK(),
			        AVERAGE(table_percent_price[percent_price])
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        _ano_calendario = 2026, 1,
			        _ano_calendario = BLANK(), BLANK(),
			        -- Condição 1: TRG
			        _un = "TRG" && _grupo_economico = "GRUPO LOG-IN", 0.8775,
			        _un = "TRG" && _grupo_economico = "GRUPO CMA CGM" && _sub_categoria = "Box Rate Cheio CAB", 0.8775,
			        _un = "TRG" && _grupo_economico = "GRUPO CMA CGM" && _sub_categoria = "Box Rate Vazio CAB", 0.8775,
			        _un = "TRG" && _grupo_economico = "GRUPO MAERSK" && _sub_categoria = "Box Rate Cheio CAB", 0.8775,
			        _un = "TRG" && _grupo_economico = "GRUPO MAERSK" && _sub_categoria = "Box Rate Vazio CAB", 0.8775,
			        
			        -- Condição 2: TSV
			        _un = "TSV" && _razao_social = "MERCOSUL LINE NAVEGACAO E LOGISTICALTDA", 0.8575,
			        _un = "TSV" && _grupo_economico = "GRUPO LOG-IN", 0.8575,
			        _un = "TSV" && _grupo_economico = "GRUPO CMA CGM" && _sub_categoria = "Box Rate Cheio CAB", 0.8575,
			        _un = "TSV" && _grupo_economico = "GRUPO CMA CGM" && _sub_categoria = "Box Rate Vazio CAB", 0.8575,
			        _un = "TSV" && _grupo_economico = "GRUPO MAERSK" && _sub_categoria = "Box Rate Cheio CAB", 0.8575,
			        _un = "TSV" && _grupo_economico = "GRUPO MAERSK" && _sub_categoria = "Box Rate Vazio CAB", 0.8575,
			        
			        -- Caso não atenda a nenhuma das exceções acima
			        _valor_padrao
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Price
		lineageTag: 130b0e77-b652-4424-9b2a-64f61fada4cd

