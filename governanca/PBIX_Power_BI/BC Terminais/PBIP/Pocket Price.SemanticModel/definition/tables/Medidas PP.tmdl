	measure price_p3_simulado =
			
			[price_p3]*(1+ [Valor Arm. Vazios - Preço P3 - EXP])
		formatString: #,0.00
		displayFolder: Preço
		lineageTag: e31c2f83-e18c-4ac8-b252-607cd6ad46d2

	measure 'Faturamento Simulado Armador 2' = ```
			
			/* ===============================
			   0) CAPTURA “GERAL” (se quiser usar fallback)
			   =============================== */
			VAR _freetime_param_default           = [#Param Dias Freetime (selecionado)]
			VAR _freetime_param_vazio_exp         = [#Param Dias Freetime Vazio Exp (selecionado)]
			VAR _dias_isencao_param_default       = [#Param Dias Isenção (selecionado)]
			VAR _dias_isencao_param_vazio_exp     = [#Param Dias Isenção Vazio Exp (selecionado)]
			VAR _perc_ajuste_volume_cheio         = [#Param % ajuste volume Arm Cntr Cheio (selecionado)]
			VAR _perc_ajuste_volume_vazio         = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			
			VAR _param_valor_arm_vazio_default_p1 = [Valor Arm. Vazios - Preço P1]
			VAR _param_valor_arm_vazio_default_p2 = [Valor Arm. Vazios - Preço P2]
			VAR _param_valor_arm_vazio_default_p3 = [Valor Arm. Vazios - Preço P3]
			
			VAR _param_valor_arm_vazio_exp_p1     = [#Arm. Vazios Exportação - Preço P1 (selecionado)]
			VAR _param_valor_arm_vazio_exp_p2     = [#Arm. Vazios Exportação - Preço P2 (selecionado)]
			VAR _param_valor_arm_vazio_exp_p3     = [#Arm. Vazios Exportação - Preço P3 (selecionado)]
			
			VAR _param_valor_arm_exp20_p1         = [Valor Arm. EXP 20 - Preço P1]
			VAR _param_valor_arm_exp20_p2         = [Valor Arm. EXP 20 - Preço P2]
			VAR _param_valor_arm_exp20_p3         = [Valor Arm. EXP 20 - Preço P3]
			VAR _param_valor_arm_exp40_p1         = [Valor Arm. EXP 40 - Preço P1]
			VAR _param_valor_arm_exp40_p2         = [Valor Arm. EXP 40 - Preço P2]
			VAR _param_valor_arm_exp40_p3         = [Valor Arm. EXP 40 - Preço P3]
			
			VAR _param_valor_ad_ogg               = [Valor Adicional OOG (selecionado)]
			VAR _param_valor_arm_cheio_exp_ad_carg_especial =
			    [Valor Arm. Cheio Exp - Adicional Carga Especial (selecionado)]
			
			RETURN
			SUMX(
			    bussola_comercial,
			
			    /* ===============================
			       1) VARIÁVEIS DA LINHA
			       =============================== */
			    VAR _un                 = bussola_comercial[un]
			    VAR _tam_container      = bussola_comercial[tamanho_container]
			    VAR _imo                = bussola_comercial[imo]
			    VAR _oog                = bussola_comercial[oog]
			    VAR _sub_grupo_princing = bussola_comercial[Agrupamento Subgrupo Princing]
			    VAR _tabela_publica     = bussola_comercial[tabela_publica]
			    VAR _periodo1_contrato  = bussola_comercial[periodo1_contrato]
			    VAR _periodo2_contrato  = bussola_comercial[periodo2_contrato]
			    VAR _periodo3_contrato  = bussola_comercial[periodo3_contrato]
			    VAR _preco1             = COALESCE(bussola_comercial[price_p1], _tabela_publica, 0)
			    VAR _preco2             = COALESCE(bussola_comercial[price_p2], _tabela_publica, 0)
			    VAR _preco3             = COALESCE(bussola_comercial[price_p3], _tabela_publica, 0)
			    VAR _dias_servico       = bussola_comercial[dias_servico]
			    VAR _servico            = bussola_comercial[servico]
			
			    /* ===============================
			       2) DETECÇÃO DE BLOCO
			       =============================== */
			    VAR _isEXP = CONTAINSSTRING(UPPER(_servico), "EXP")
			    VAR _isCAB = CONTAINSSTRING(UPPER(_servico), "CAB")
			    VAR _isTRA = CONTAINSSTRING(UPPER(_servico), "TRA")
			
			    /* ===============================
			       3) FLAGS
			       =============================== */
			    VAR _sinalizador_cheio = _sub_grupo_princing IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"}
			    VAR _sinalizador_vazio = _sub_grupo_princing IN {"Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"}
			    VAR _sinalizador_vazio_exp = _sinalizador_vazio
			
			    /* ==========================================================
			       4) PARÂMETROS POR BLOCO (LIDOS COM REMOVEFILTERS DO FATO)
			       ========================================================== */
			
			    /* --------- Freetime (default) --------- */
			    VAR _ft_default_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([#Param Dias Freetime (selecionado) - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([#Param Dias Freetime (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([#Param Dias Freetime (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _freetime_param_default
			        )
			
			    /* --------- Freetime (vazio exp) --------- */
			    VAR _ft_vazio_exp_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([#Param Dias Freetime Vazio (selecionado) - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([#Param Dias Freetime Vazio (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([#Param Dias Freetime Vazio (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _freetime_param_vazio_exp
			        )
			
			    /* --------- Isenção (default) --------- */
			    VAR _isenc_default_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([#Param Dias Isenção (selecionado) - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([#Param Dias Isenção (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([#Param Dias Isenção (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _dias_isencao_param_default
			        )
			
			    /* --------- Isenção (vazio exp) --------- */
			    VAR _isenc_vazio_exp_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor #Param Dias Isenção Vazio (selecionado) - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([#Param Dias Isenção Vazio (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([#Param Dias Isenção Vazio (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _dias_isencao_param_vazio_exp
			        )
			
			    /* --------- % Ajuste volume (cheio / vazio) --------- */
			    VAR _aj_vol_cheio_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([#Param % ajuste volume Arm Cntr Cheio (selecionado) - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([#Param % ajuste volume Arm Cntr Cheio (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([#Param % ajuste volume Arm Cntr Cheio (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _perc_ajuste_volume_cheio
			        )
			
			    VAR _aj_vol_vazio_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([#Param % ajuste volume Arm Cntr Vazio (selecionado) - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([#Param % ajuste volume Arm Cntr Vazio (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([#Param % ajuste volume Arm Cntr Vazio (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _perc_ajuste_volume_vazio
			        )
			
			    /* --------- Ajustes preço VAZIO (default e exp) --------- */
			    // VAR _vaz_def_p1_blk =
			    //     COALESCE(
			    //         SWITCH(TRUE(),
			    //             _isEXP, CALCULATE([Valor Arm. Vazios - Preço P1 - EXP], REMOVEFILTERS(bussola_comercial)),
			    //             _isCAB, CALCULATE([Valor Arm. Vazios - Preço P1 - CAB], REMOVEFILTERS(bussola_comercial)),
			    //             _isTRA, CALCULATE([Valor Arm. Vazios - Preço P1 - TRA], REMOVEFILTERS(bussola_comercial))
			    //         ),
			    //         _param_valor_arm_vazio_default_p1
			    //     )
			
			    // VAR _vaz_def_p2_blk =
			    //     COALESCE(
			    //         SWITCH(TRUE(),
			    //             _isEXP, CALCULATE([Valor Arm. Vazios - Preço P2 - EXP], REMOVEFILTERS(bussola_comercial)),
			    //             _isCAB, CALCULATE([Valor Arm. Vazios - Preço P2 - CAB], REMOVEFILTERS(bussola_comercial)),
			    //             _isTRA, CALCULATE([Valor Arm. Vazios - Preço P2 - TRA], REMOVEFILTERS(bussola_comercial))
			    //         ),
			    //         _param_valor_arm_vazio_default_p2
			    //     )
			
			    // VAR _vaz_def_p3_blk =
			    //     COALESCE(
			    //         SWITCH(TRUE(),
			    //             _isEXP, CALCULATE([Valor Arm. Vazios - Preço P3 - EXP], REMOVEFILTERS(bussola_comercial)),
			    //             _isCAB, CALCULATE([Valor Arm. Vazios - Preço P3 - CAB], REMOVEFILTERS(bussola_comercial)),
			    //             _isTRA, CALCULATE([Valor Arm. Vazios - Preço P3 - TRA], REMOVEFILTERS(bussola_comercial))
			    //         ),
			    //         _param_valor_arm_vazio_default_p3
			    //     )
			
			    VAR _vaz_exp_p1_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. Vazios - Preço P1 - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([#Arm. Vazios - Preço P1 (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([#Arm. Vazios - Preço P1 (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_vazio_exp_p1
			        )
			
			    VAR _vaz_exp_p2_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. Vazios - Preço P2 - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([#Arm. Vazios - Preço P2 (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([#Arm. Vazios - Preço P2 (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_vazio_exp_p2
			        )
			
			    VAR _vaz_exp_p3_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. Vazios - Preço P3 - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([#Arm. Vazios - Preço P3 (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([#Arm. Vazios - Preço P3 (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_vazio_exp_p3
			        )
			
			    /* --------- Ajustes preço CHEIO 20/40 --------- */
			    VAR _cheio20_p1_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. 20 - Preço P1 - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([Valor Arm. 20 - Preço P1 - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([Valor Arm. 20 - Preço P1 - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_exp20_p1
			        )
			
			    VAR _cheio20_p2_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. 20 - Preço P2 - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([Valor Arm. 20 - Preço P2 - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([Valor Arm. 20 - Preço P2 - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_exp20_p2
			        )
			
			    VAR _cheio20_p3_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. 20 - Preço P3 - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([Valor Arm. 20 - Preço P3 - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([Valor Arm. 20 - Preço P3 - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_exp20_p3
			        )
			
			    VAR _cheio40_p1_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. 40 - Preço P1 - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([Valor Arm. 40 - Preço P1 - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([Valor Arm. 40 - Preço P1 - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_exp40_p1
			        )
			
			    VAR _cheio40_p2_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. 40 - Preço P2 - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([Valor Arm. 40 - Preço P2 - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([Valor Arm. 40 - Preço P2 - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_exp40_p2
			        )
			
			    VAR _cheio40_p3_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. 40 - Preço P3 - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([Valor Arm. 40 - Preço P3 - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([Valor Arm. 40 - Preço P3 - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_exp40_p3
			        )
			
			    /* --------- Adicionais --------- */
			    VAR _ad_ogg_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Adicional OOG (selecionado) - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([Valor Adicional OOG (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([Valor Adicional OOG (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_ad_ogg
			        )
			
			    VAR _ad_cesp_blk =
			        COALESCE(
			            SWITCH(TRUE(),
			                _isEXP, CALCULATE([Valor Arm. Cheio Exp - Adicional Carga Especial (selecionado) - EXP], REMOVEFILTERS(bussola_comercial)),
			                _isCAB, CALCULATE([Valor Arm. Cheio - Adicional Carga Especial (selecionado) - CAB], REMOVEFILTERS(bussola_comercial)),
			                _isTRA, CALCULATE([Valor Arm. Cheio - Adicional Carga Especial (selecionado) - TRA], REMOVEFILTERS(bussola_comercial))
			            ),
			            _param_valor_arm_cheio_exp_ad_carg_especial
			        )
			
			    /* ===============================
			       5) APLICAÇÃO FT/ISENÇÃO
			       =============================== */
			    VAR _freetime_param =
			        SWITCH(TRUE(),
			            _sinalizador_vazio_exp, _ft_vazio_exp_blk,
			            _ft_default_blk
			        )
			
			    VAR _dias_isencao_param =
			        SWITCH(TRUE(),
			            _sinalizador_vazio_exp, _isenc_vazio_exp_blk,
			            _isenc_default_blk
			        )
			
			    VAR _freetime     = IF(ISBLANK(_freetime_param),     bussola_comercial[dias_free_time], _freetime_param)
			    VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao],   _dias_isencao_param)
			
			    VAR _dias_servico_ajustado =
			        IF(_dias_servico <= _freetime, 0,
			            IF(_dias_isencao > _dias_servico, 0, _dias_servico - _dias_isencao)
			        )
			
			    /* ===============================
			       6) AJUSTE VOLUME
			       =============================== */
			    VAR _perc_ajuste_volume =
			        SWITCH(TRUE(),
			            _sinalizador_vazio, _aj_vol_vazio_blk,
			            _sinalizador_cheio, _aj_vol_cheio_blk,
			            0
			        )
			    VAR _volume_simulado = ROUND(_dias_servico_ajustado * (1 + _perc_ajuste_volume), 0)
			
			    /* ===============================
			       7) PREÇOS SIMULADOS
			       =============================== */
			    VAR _preco1_simulado =
			        IF(_preco1 = 0, BLANK(),
			            VAR _percentual =
			                (1 + SWITCH(TRUE(),
			                    _sinalizador_vazio_exp,                        _vaz_exp_p1_blk,
			                    // _sinalizador_vazio,                            _vaz_def_p1_blk,
			                    _sinalizador_cheio && (_tam_container="20"),   _cheio20_p1_blk,
			                    _sinalizador_cheio && (_tam_container="40"),   _cheio40_p1_blk,
			                    0
			                )) *
			                (1 + IF(_imo="SIM" && _sinalizador_cheio, COALESCE(_ad_cesp_blk, bussola_comercial[Adic_carga_especial]), 0)) *
			                (1 + IF(_oog="SIM" && _sinalizador_cheio, COALESCE(_ad_ogg_blk,  bussola_comercial[Adic_oog]), 0))
			            RETURN _preco1 * _percentual
			        )
			
			    VAR _preco2_simulado =
			        IF(_preco2 = 0, BLANK(),
			            VAR _percentual =
			                (1 + SWITCH(TRUE(),
			                    _sinalizador_vazio_exp,                        _vaz_exp_p2_blk,
			                    // _sinalizador_vazio,                            _vaz_def_p2_blk,
			                    _sinalizador_cheio && (_tam_container="20"),   _cheio20_p2_blk,
			                    _sinalizador_cheio && (_tam_container="40"),   _cheio40_p2_blk,
			                    0
			                )) *
			                (1 + IF(_imo="SIM" && _sinalizador_cheio, COALESCE(_ad_cesp_blk, bussola_comercial[Adic_carga_especial]), 0)) *
			                (1 + IF(_oog="SIM" && _sinalizador_cheio, COALESCE(_ad_ogg_blk,  bussola_comercial[Adic_oog]), 0))
			            RETURN _preco2 * _percentual
			        )
			
			    VAR _preco3_simulado =
			        IF(_preco3 = 0 || _un = "TRG", BLANK(),
			            VAR _percentual =
			                (1 + SWITCH(TRUE(),
			                    _sinalizador_vazio_exp,                        _vaz_exp_p3_blk,
			                    // _sinalizador_vazio,                            _vaz_def_p3_blk,
			                    _sinalizador_cheio && (_tam_container="20"),   _cheio20_p3_blk,
			                    _sinalizador_cheio && (_tam_container="40"),   _cheio40_p3_blk,
			                    0
			                )) *
			                (1 + IF(_imo="SIM" && _sinalizador_cheio, COALESCE(_ad_cesp_blk, bussola_comercial[Adic_carga_especial]), 0)) *
			                (1 + IF(_oog="SIM" && _sinalizador_cheio, COALESCE(_ad_ogg_blk,  bussola_comercial[Adic_oog]), 0))
			            RETURN _preco3 * _percentual
			        )
			
			    /* ===============================
			       8) DIAS P1/P2/P3 (tua lógica)
			       =============================== */
			    VAR _dias_p1_simulado =
			        IF(ISBLANK(_periodo1_contrato), BLANK(),
			            IF(_dias_servico_ajustado = 0, 0,
			                IF(_un = "TSV" || _sinalizador_vazio,
			                    IF(_volume_simulado > 0, 1, 0),
			                    IF(_volume_simulado > _periodo1_contrato, _periodo1_contrato, _volume_simulado)
			                )
			            )
			        )
			
			    VAR _dias_p2_simulado =
			        IF(ISBLANK(_periodo2_contrato), BLANK(),
			            IF(_dias_servico_ajustado = 0, 0,
			                VAR _saldo_volume = _volume_simulado - _periodo1_contrato
			                RETURN IF(_saldo_volume > 0,
			                    SWITCH(TRUE(),
			                        _un = "TSV", 1,
			                        _un = "TRG" && _sinalizador_vazio, ROUNDUP(DIVIDE(_saldo_volume, _periodo2_contrato), 0),
			                        _saldo_volume
			                    ),
			                    0
			                )
			            )
			        )
			
			    VAR _dias_p3_simulado =
			        IF(_un = "TRG", BLANK(),
			            IF(ISBLANK(_periodo3_contrato), BLANK(),
			                IF(_dias_servico_ajustado = 0, 0,
			                    VAR _saldo_volume = _volume_simulado - _periodo1_contrato - _periodo2_contrato
			                    RETURN IF(_saldo_volume > 0, ROUNDUP(DIVIDE(_saldo_volume, _periodo3_contrato), 0), 0)
			                )
			            )
			        )
			
			    RETURN
			        _dias_p1_simulado * _preco1_simulado +
			        _dias_p2_simulado * _preco2_simulado +
			        _dias_p3_simulado * _preco3_simulado
			)
			
			```
		displayFolder: Faturamento
		lineageTag: 55407ece-8399-4679-bee8-4e44151a2f07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Preço P1 Simulado TRA' = ```
			
			
			VAR tam_container = FIRSTNONBLANKVALUE(bussola_comercial[tamanho_container],SELECTEDVALUE(bussola_comercial[tamanho_container]))
			
			RETURN
			IF(
			    tam_container="20",
			    [price_p1]*(
			        AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			        // bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"} && CONTAINSSTRING(bussola_comercial[servico], "TRA"), [Valor Arm. Vazios - Preço P1],
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "TRA"), [Valor Arm. 20 - Preço P1 - TRA],
			        0)))*
			    IF(
			        SELECTEDVALUE(bussola_comercial[imo]) = "SIM",
			        AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "TRA"), [Valor Arm. Cheio - Adicional Carga Especial (selecionado) - TRA],
			        0)),1
			        )*
			    IF(
			        SELECTEDVALUE(bussola_comercial[oog]) = "SIM",
			        AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "TRA"), [Valor Adicional OOG (selecionado)],
			        0)),1
			        ),
			    
			    IF(
			        tam_container="40",
			        [price_p1]*(AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			        // bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"} && CONTAINSSTRING(bussola_comercial[servico], "TRA"), [Valor Arm. Vazios - Preço P1],
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "TRA"), [Valor Arm. 40 - Preço P1 - TRA],
			        0)))*
			        IF(
			        SELECTEDVALUE(bussola_comercial[imo]) = "SIM",
			        AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "TRA"), [Valor Arm. Cheio - Adicional Carga Especial (selecionado) - TRA],
			        0)),1
			        )*
			    IF(
			        SELECTEDVALUE(bussola_comercial[oog]) = "SIM",
			        AVERAGEX(bussola_comercial,1+
			        SWITCH(TRUE(),
			         bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"} && CONTAINSSTRING(bussola_comercial[servico], "TRA"), [Valor Adicional OOG (selecionado)],
			        0)),1
			        ),
			        [price_p1])
			)
			```
