	column Cod_SAP_PossuiNaBussola__ = ```
			
			VAR ClienteAtual =  aws_bussola_comercial_mar[cliente_sap]
			RETURN
			    IF (
			        NOT ISBLANK (
			            LOOKUPVALUE (
			                aws_salesforce[codigo_sap], // Coluna que queremos encontrar
			                aws_salesforce[codigo_sap], ClienteAtual // Coluna de pesquisa e valor atual
			            )
			        ),
			        "SIM",
			        "NAO"
			    )
			
			```
		lineageTag: 294ae2cc-0e4b-42a5-9677-92ce4849e17e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Servico_com_TCP_HIDROVIAS = ```
			
			VAR IsManobraEspecialNao = 'aws_bussola_comercial_mar'[manobra_especial] = "NAO"
			
			VAR Cond1 =
			    'aws_bussola_comercial_mar'[filial] = "SALVADOR" &&
			    'aws_bussola_comercial_mar'[cliente] IN {
			        "SULNORTE SERVICOS MARITIMOS LTDA", 
			        "SULNORTE SERVICOS MARITIMOS"
			    } &&
			    'aws_bussola_comercial_mar'[divisao] IN {
			        "TEMADRE", 
			        "(SEM DIVISÃO COMERCIAL)"
			    }
			
			VAR Cond2 =
			    'aws_bussola_comercial_mar'[filial] = "SAO SEBASTIAO" &&
			    'aws_bussola_comercial_mar'[cliente] = "PETROLEO BRASILEIRO S A PETROBRAS"
			
			VAR Cond3 =
			    'aws_bussola_comercial_mar'[filial] IN {"TROMBETAS", "VILA DO CONDE"} &&
			    'aws_bussola_comercial_mar'[cliente] IN {
			        "HIDROVIAS DO BRASIL - CABOTAGEM LTDA", 
			        "HIDROVIAS DO BRASIL - CABOTAGEM LTD DA"
			    }
			
			VAR Cond4 =
			    'aws_bussola_comercial_mar'[filial] = "PECEM" &&
			    'aws_bussola_comercial_mar'[cliente] = "PETROLEO BRASILEIRO S A PETROBRAS"
			
			VAR Resultado = 
			    IF(
			        IsManobraEspecialNao,
			        SWITCH(
			            TRUE(),
			            Cond3, "HIDROVIAS",
			            Cond1 || Cond2 || Cond4, "TCP",
			            'aws_bussola_comercial_mar'[servico]
			        ),
			        'aws_bussola_comercial_mar'[servico]
			    )
			
			RETURN 
			    IF(
			        Resultado = BLANK() || LEN(TRIM(Resultado)) = 0,
			        "FATURAMENTO AVULSO",
			        Resultado
			    )
			
			```
		lineageTag: d90bf66f-cfd0-4717-8022-1f952edbba25
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Dono_manobra_agrupado = ```
			
			SWITCH(
			    TRUE(),    
			    -- WILSON SONS (Inclui SAVEIROS CAMUYRANO)
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "WILSON SONS"), "WILSON SONS",
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "CAMUYRANO"), "WILSON SONS",
			    -- VALE
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "VALE"), "VALE",
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "DOCENAVE"), "VALE",
			    -- SVITZER
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "SVITZER"), "SVITZER",
			    -- SULNORTE
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "SULNORTE"), "SULNORTE",
			    -- SAAM (Inclui TUGBRASIL)
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "SAAM"), "SAAM",
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "TUGBRASIL"), "SAAM",
			    -- SAMARCO
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "SAMARCO"), "SAMARCO",
			    -- CAMORIM (Inclui STARNAV)
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "CAMORIM"), "CAMORIM",
			    CONTAINSSTRING('aws_bussola_comercial_mar'[dono_manobra], "STARNAV"), "CAMORIM",    
			    -- CONSORCIO DE REBOCADORES DA BAIA (Aqui é bom ser exato se o nome é único)
			    'aws_bussola_comercial_mar'[dono_manobra] = "CONSORCIO DE REBOCADORES DA BAIA", "CONSORCIO DE REBOCADORES",    
			    -- Valor Padrão (ELSE)
			    "DEMAIS"
			)
			```
		lineageTag: f2fd51af-c4ad-4f69-b867-c9b5683f1291
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Operador_agrupado = ```
			
			SWITCH(
			    TRUE(),    
			    -- WILSON SONS (Inclui SAVEIROS CAMUYRANO)
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "WILSON SONS"), "WILSON SONS",
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "CAMUYRANO"), "WILSON SONS",
			    -- VALE
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "VALE"), "VALE",
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "DOCENAVE"), "VALE",
			    -- SVITZER
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "SVITZER"), "SVITZER",
			    -- SULNORTE
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "SULNORTE"), "SULNORTE",
			    -- SAAM (Inclui TUGBRASIL)
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "SAAM"), "SAAM",
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "TUGBRASIL"), "SAAM",
			    -- SAMARCO
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "SAMARCO"), "SAMARCO",
			    -- CAMORIM (Inclui STARNAV)
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "CAMORIM"), "CAMORIM",
			    CONTAINSSTRING('aws_bussola_comercial_mar'[operador], "STARNAV"), "CAMORIM",    
			    -- CONSORCIO DE REBOCADORES DA BAIA (Aqui é bom ser exato se o nome é único)
			    'aws_bussola_comercial_mar'[operador] = "CONSORCIO DE REBOCADORES DA BAIA", "CONSORCIO DE REBOCADORES",    
			    -- Valor Padrão (ELSE)
			    "DEMAIS"
			)
			```
		lineageTag: d856ad85-d290-4139-bd9b-6c5f3974f75b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Afretamento = IF(aws_bussola_comercial_mar[Operador_agrupado]<>aws_bussola_comercial_mar[Dono_manobra_agrupado],TRUE(),FALSE())
