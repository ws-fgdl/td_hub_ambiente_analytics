	column periodo2 = ```
			
			var _dias_p1_realizado = IF(bussola_comercial[volume] > bussola_comercial[periodo1_contrato], bussola_comercial[periodo1_contrato], bussola_comercial[volume])
			
			var _saldo_volume1 = bussola_comercial[volume] - _dias_p1_realizado 
			
			var rest = bussola_comercial[volume]-(bussola_comercial[volume]-(bussola_comercial[volume]-bussola_comercial[periodo1_contrato]))
			
			var rest2 = rest - (rest-bussola_comercial[periodo2_contrato])
			
			var _sub_grupo_princing = bussola_comercial[Agrupamento Subgrupo Princing]
			
			//variável para verificar contexto 
			
			            var _is_trg_armador = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			            var _is_trg_carga = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "IMP") && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga"
			 
			            var _is_trg_vazio = bussola_comercial[un] = "TRG" && _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			 
			            // var _is_tsv_armador = bussola_comercial[un] = "TSV" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			
			            var _is_tsv_armador = bussola_comercial[un] = "TSV" && RELATED(salesforce[Armador/Cliente Carga]) = "Armador"
			 
			            var _is_tsv_carga = bussola_comercial[un] = "TSV" && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga"
			            // && CONTAINSSTRING(bussola_comercial[servico], "IMP")
			
			RETURN
			
			    SWITCH(
			    TRUE(),
			
			        //CONDIÇÃO TRG ARMADOR
			    //_is_trg_armador,  IF(_saldo_volume1 > bussola_comercial[periodo2_contrato], bussola_comercial[periodo2_contrato], -_saldo_volume1),
			
			     //CONDIÇÃO TSV ARMADOR
			    _is_tsv_armador, IF(_saldo_volume1 > 0,1,0),
			
			    //CONDIÇÃO TRG VAZIO
			    _is_trg_vazio, ROUNDUP(DIVIDE(_saldo_volume1,bussola_comercial[periodo2_contrato]),0),
			
			    //CONDIÇÃO TRG CHEIO 
			    _is_trg_armador, _saldo_volume1,
			
			    //CONDIÇÃO TRG CARGA
			    _is_trg_carga, IF(_saldo_volume1 > bussola_comercial[periodo2_contrato], bussola_comercial[periodo2_contrato],  _saldo_volume1),
			
			    //CONDIÇÃO TSV CARGA
			    // _is_tsv_carga, IF(_saldo_volume1 > bussola_comercial[periodo1_contrato] + bussola_comercial[dias_portas_p1],1,0),
			    _is_tsv_carga && _saldo_volume1 > 0,1,
			
			
			     //ORIGINAL
			    // AND('bussola_comercial'[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio"}, 
			    //     bussola_comercial[un] = "TRG" &&
			    //     bussola_comercial[periodo2_contrato] <> BLANK()),
			
			    //     IF(_is_tsv,
			    //         IF(rest > bussola_comercial[periodo2_contrato], 
			    //            IF(rest2 < 0, 0, rest2), 
			    //            IF(rest < 0, 0, rest)),
			    //         IF(rest < 0, 0, rest)),
			
			    //     IF(rest < 0, 0, rest),
			    
			    // AND('bussola_comercial'[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT", "Armazenagem Cntr Cheio"},
			    //     bussola_comercial[periodo2_contrato] <> BLANK()),
			    //     IF(_is_tsv,
			    //         IF(rest > bussola_comercial[periodo2_contrato], 
			    //            ROUNDUP(IF(rest - (rest - bussola_comercial[periodo2_contrato]) <= bussola_comercial[periodo2_contrato], 1, 0), 0), 
			    //            ROUNDUP(IF(rest > 0, 
			    //                      IF(AND(rest / bussola_comercial[periodo2_contrato] > 1, bussola_comercial[periodo3_contrato] = BLANK()), 
			    //                         rest / bussola_comercial[periodo2_contrato], 
			    //                         1), 
			    //                      0), 0)),
			    //         IF(rest > 0, 
			    //            ROUNDUP(IF(AND(rest / bussola_comercial[periodo2_contrato] > 1, bussola_comercial[periodo3_contrato] = BLANK()), 
			    //                      rest / bussola_comercial[periodo2_contrato], 
			    //                      1), 0), 
			    //            0)),
			    
			    //ELSE
			    BLANK()
			)
			```
		lineageTag: 67b1e0b3-1455-444c-9220-ffe52556a9ab
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column periodo3 = ```
			
			
			--SE([@[Saldo Volume P2 realizado]] <= 0, 0, ARREDONDAR.PARA.CIMA([@[Saldo Volume P2 realizado]] / [@[periodo3_contrato]], 0))
			
			VAR rest = (bussola_comercial[volume] - (bussola_comercial[periodo1_contrato] + bussola_comercial[periodo2_contrato]))
			
			VAR rest2 = (bussola_comercial[volume] - (bussola_comercial[periodo1] + bussola_comercial[periodo2]))
			
			VAR _DIAS_P1_REALIZADO = IF(bussola_comercial[volume] > bussola_comercial[periodo1_contrato], bussola_comercial[periodo1_contrato], bussola_comercial[volume])
			
			VAR _SALDO_VOLUME_P1 = bussola_comercial[volume] - _DIAS_P1_REALIZADO
			
			VAR _DIAS_P2_REALIZADO = IF(bussola_comercial[volume] <= bussola_comercial[periodo1_contrato], 0, IF(bussola_comercial[periodo2_contrato] < _SALDO_VOLUME_P1, bussola_comercial[periodo2_contrato], _SALDO_VOLUME_P1))
			
			VAR _SALDO_VOLUME_P2 = bussola_comercial[volume] - _DIAS_P1_REALIZADO - _DIAS_P2_REALIZADO
			
			var _is_trg_carga = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "IMP") && RELATED(salesforce[Armador/Cliente Carga]) = "Cliente Carga"
			
			var _is_tsv = bussola_comercial[un] = "TSV"
			RETURN
			IF(
			    // CONDIÇÃO TRG ARMADOR
			    //_is_trg_armador, 0,
			    
			    // CONDIÇÃO TRG CARGA
			    _is_trg_carga,
			        IF(_SALDO_VOLUME_P2 <= bussola_comercial[periodo3_contrato], _SALDO_VOLUME_P2, bussola_comercial[periodo3_contrato]),
			
			    // CONDIÇÃO TSV 
			    IF(_is_tsv,
			        IF(_SALDO_VOLUME_P2 > 0,ROUNDUP(DIVIDE(_SALDO_VOLUME_P2,bussola_comercial[periodo3_contrato]),0),0),
			        
			        //ORIGINAL
			        IFERROR(
			            IF(
			                AND('bussola_comercial'[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio", "Armazenagem Carga Importação"}, bussola_comercial[un] = "TRG"),
			                IF(rest2 < 0, 0, rest2),
			                
			                IF('bussola_comercial'[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT", "Armazenagem Cntr Cheio", "Armazenagem Carga Importação"},
			                    IF(bussola_comercial[periodo2] > 1, 
			                        BLANK(),
			                        ROUNDUP(
			                            IF(rest > 0, 
			                                rest / ROUNDUP(
			                                    IF(bussola_comercial[periodo3_contrato] = BLANK(),
			                                        IF(bussola_comercial[periodo2_contrato] = BLANK(),
			                                            bussola_comercial[periodo1_contrato],
			                                            bussola_comercial[periodo2_contrato]),
			                                        bussola_comercial[periodo3_contrato]),
			                                    0),
			                                0),
			                            0)
			                    ),
			                    0
			                )
			            ),
			            0
			        )
			    )
			)
			```
		lineageTag: ae898658-01de-4036-af38-b0abfcdd49a1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

