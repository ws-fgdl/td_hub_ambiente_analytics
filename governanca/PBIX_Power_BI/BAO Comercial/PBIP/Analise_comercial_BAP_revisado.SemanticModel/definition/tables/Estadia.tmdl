		sourceColumn: Total Hours

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Estadia","TableItemName":"Total Hours (bins)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column 'Total Hours (bins)' =
			IF(
				ISBLANK('Estadia'[Total Hours]),
				BLANK(),
				IF(
					'Estadia'[Total Hours] >= 0,
					ROUNDDOWN('Estadia'[Total Hours] / 3, 0) * 3,
					ROUNDUP('Estadia'[Total Hours] / 3, 0) * 3
				)
			)
		formatString: 0
		lineageTag: 5a56deb8-ff8a-4322-9db8-75d1899c40c9
		summarizeBy: none

