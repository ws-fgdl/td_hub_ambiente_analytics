			    dataliner_consolidado[PORTO EMBARQUE/DESCARGA] IN {"SALVADOR"}, "SSA",
			    dataliner_consolidado[PORTO EMBARQUE/DESCARGA] IN {"SANTAREM"}, "STM",
			    dataliner_consolidado[PORTO EMBARQUE/DESCARGA] IN {"SANTOS"}, "SSZ",
