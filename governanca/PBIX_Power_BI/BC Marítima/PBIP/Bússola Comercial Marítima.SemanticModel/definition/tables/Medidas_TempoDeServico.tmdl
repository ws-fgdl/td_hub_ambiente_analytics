	measure TempoDeServico_ComDesloc_Formatada =
			
			VAR TotalHoras = [TempoDeServico_ComDesloc] // Pega o valor da sua medida que já está em horas (ex: 2.5)
			VAR TotalMinutosParaFormatar = TotalHoras * 60 // Converte o total de horas de volta para minutos totais (ex: 2.5 * 60 = 150)
			VAR HorasInteiras = TRUNC(TotalMinutosParaFormatar / 60) // Calcula as horas inteiras (ex: TRUNC(150 / 60) = 2)
			VAR MinutosRestantes = ROUND(MOD(TotalMinutosParaFormatar, 60), 0) // Calcula os minutos restantes e arredonda (ex: MOD(150, 60) = 30)
			RETURN
			    FORMAT(HorasInteiras, "0") & "h " & FORMAT(MinutosRestantes, "00") & "min"
