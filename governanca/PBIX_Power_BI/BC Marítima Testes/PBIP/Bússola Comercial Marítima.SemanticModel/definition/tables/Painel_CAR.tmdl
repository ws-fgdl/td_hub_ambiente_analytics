table Painel_CAR
	lineageTag: 89583bb2-7f6c-4e6a-ba09-bb10817a8608

	measure Total_Vencidos = ```
			
			SWITCH(
			    SELECTEDVALUE(
			        Painel_CAR[Range]
			    ),
			    "Up 5 Days", [up_5_days],
			    "6 to 15 Days", [6_to_15_days],
			    "16 to 30 Days", [16_to_30_days],
			    "31 to 90 Days", [31_to_90_days],
			    "91 to 180 Days", [91_to_180_days],
			    "+180 Days", [180+_days],
			    BLANK()
			)
			
			```
		lineageTag: 17cfcbad-b038-4853-9c63-dc81d8fbe54d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

