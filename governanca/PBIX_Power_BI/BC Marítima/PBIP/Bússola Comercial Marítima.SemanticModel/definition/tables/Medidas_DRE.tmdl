			    [Tempo_ComDesloc_Filial_Mes], 
			    0
			)
			RETURN [Soma_Custo_Ebitda] * Perc_Participacao
			```
		lineageTag: 488bdaed-ef06-4324-8583-4938eff0f0e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

