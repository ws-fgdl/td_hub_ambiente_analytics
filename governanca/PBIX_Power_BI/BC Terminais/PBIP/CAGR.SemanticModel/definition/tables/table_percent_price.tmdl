	column id_mod_ano = table_percent_price[Modalidade]&table_percent_price[Ano]
		lineageTag: 48aab962-2c0a-4e18-b6f2-7669fcda1bff
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition table_percent_price = calculated
		mode: import
		source =
				
				VAR Anos =
				    GENERATESERIES(2018, 2026, 1)
				
				VAR Regras =
				    DATATABLE(
				        "Status", STRING,
				        "Modalidade", STRING,
				        "UN", STRING,
				        "percent_price", DOUBLE,
				        {
				            {"Cheio", "Box Rate Cheio CAB", "TRG", 0.8775},
				            {"Vazio", "Box Rate Vazio CAB", "TRG", 0.8775},
				            {"Cheio", "Box Rate Cheio LC",  "TRG", 0.97},
				            {"Vazio", "Box Rate Vazio LC",  "TRG", 0.97},
				            {"Cheio", "Box Rate Cheio TRA BT", "TRG", 0.97},
				            {"Vazio", "Box Rate Vazio TRA BT", "TRG", 0.97},
				
				            {"Cheio", "Box Rate Cheio CAB", "TSV", 0.8575},
				            {"Vazio", "Box Rate Vazio CAB", "TSV", 0.8575},
				            {"Cheio", "Box Rate Cheio LC",  "TSV", 0.95},
				            {"Vazio", "Box Rate Vazio LC",  "TSV", 0.95},
				            {"Cheio", "Box Rate Cheio TRA", "TSV", 0.95},
				            {"Vazio", "Box Rate Vazio TRA", "TSV", 0.95}
				        }
				    )
				
				RETURN
				SELECTCOLUMNS(
				    CROSSJOIN(Anos, Regras),
				    "Ano", [Value],
				    "Status", [Status],
				    "Modalidade", [Modalidade],
				    "UN", [UN],
				    "percent_price", [percent_price]
				)

	annotation PBI_Id = 9da4e7bd3c234bcbb76a2d10ab4f4528

