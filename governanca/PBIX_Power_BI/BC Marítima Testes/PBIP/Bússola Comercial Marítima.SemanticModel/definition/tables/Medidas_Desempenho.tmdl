table Medidas_Desempenho
	lineageTag: 342da163-0b96-4b3f-8287-ea517e33842a

	measure PrecoMedio_Inflacionado_IPCA_Anual = ```
			
			VAR AnoAtual = MAX(Dim_calendario[ano_calendario])
			VAR AnoPrimeiraVenda = 
			    CALCULATE(
			        MIN(Dim_calendario[ano_calendario]),
			        FILTER(
			            ALLSELECTED(Dim_calendario),
			            [PrecoMedio_BaseBC] > 0
			        )
			    )
			VAR PrecoBase_AnoInicial = 
			    CALCULATE(
			        [PrecoMedio_BaseBC],
			        Dim_calendario[ano_calendario] = AnoPrimeiraVenda,
			        ALL(Dim_calendario)
			    )
			VAR FatorAcumulado = 
			    IF(
			        AnoAtual < AnoPrimeiraVenda,
			        BLANK(),
			        IF(
			            AnoAtual == AnoPrimeiraVenda,
			            1,
			            PRODUCTX(
			                FILTER(
			                    CALCULATETABLE(
			                        VALUES(Dim_calendario[ano_calendario]), 
			                        ALLSELECTED(Dim_calendario)
			                    ),
			                    Dim_calendario[ano_calendario] > AnoPrimeiraVenda && 
			                    Dim_calendario[ano_calendario] <= AnoAtual
			                ),
			                CALCULATE(
			                    (1 + [IPCA_Mensal]),
			                    ALLEXCEPT(Dim_calendario, Dim_calendario[ano_calendario])
			                )
			            )
			        )
			    )
			RETURN
			    IF(NOT(ISBLANK(AnoPrimeiraVenda)), PrecoBase_AnoInicial * FatorAcumulado)
			```
		lineageTag: c26a89c9-2442-4cbc-93fd-3e05c02a3619

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PrecoMedio_Inflacionado_IPCA_Mensal = ```
			
			VAR DataAtual = MAX(Dim_calendario[data])
			VAR DataInicioContexto = 
			    CALCULATE(
			        MIN(Dim_calendario[data]),
			        FILTER(
			            ALLSELECTED(Dim_calendario),
			            NOT(ISBLANK([PrecoMedio_BaseBC])) && [PrecoMedio_BaseBC] > 0
			        )
			    )
			VAR PrecoInicial = 
			    CALCULATE(
			        [PrecoMedio_BaseBC],
			        Dim_calendario[data] = DataInicioContexto
			    )
			VAR FatorAcumulado = 
			    IF(
			        DataAtual < DataInicioContexto,
			        BLANK(),
			        IF(
			            DataAtual = DataInicioContexto,
			            1,
			            PRODUCTX(
			                FILTER(
			                    SUMMARIZE(ALLSELECTED(Dim_calendario), Dim_calendario[ano_calendario], Dim_calendario[numero_mes], Dim_calendario[data]), 
			                    Dim_calendario[data] > DataInicioContexto && 
			                    Dim_calendario[data] <= DataAtual
			                ),
			                (1 + [IPCA_Mensal])
			            )
			        )
			    )
			RETURN
			    IF(NOT(ISBLANK(DataInicioContexto)), PrecoInicial * FatorAcumulado)
			```
		lineageTag: 848e248e-0fc4-4e73-b10a-b604ac5c93b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PrecoMedio_Inflacionado_Dinamico_IPCA = ```
			
			IF(
			    ISINSCOPE(Dim_calendario[numero_mes]), 
			    [PrecoMedio_Inflacionado_IPCA_Mensal],
			    [PrecoMedio_Inflacionado_IPCA_Anual]
			)
			```
		lineageTag: 934003f1-3aec-44cb-88cd-d00e1b18a55d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Percentual_Diferenca_Inflacionado_CPI = ```
			
			VAR PrecoAtual = [PrecoMedio_BaseBC]
			VAR PrecoInflacionado = [PrecoMedio_Inflacionado_Dinamico_CPI]
			
			RETURN 
			IF(
			    PrecoInflacionado <> 0,
			    DIVIDE(PrecoAtual - PrecoInflacionado, PrecoInflacionado, 0),
			    BLANK()
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d1f09a00-7ff6-4186-a893-9b8742a99bcc

	measure Percentual_Diferenca_Inflacionado_IPCA = ```
			
			VAR PrecoAtual = [PrecoMedio_BaseBC]
			VAR PrecoInflacionado = [PrecoMedio_Inflacionado_Dinamico_IPCA]
			
			RETURN 
			IF(
			    PrecoInflacionado <> 0,
			    DIVIDE(PrecoAtual - PrecoInflacionado, PrecoInflacionado, 0),
			    BLANK()
			)
			
			```
