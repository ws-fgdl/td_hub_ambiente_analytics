				    #"Tipo Alterado" =
				        Table.TransformColumnTypes(
				            Navegação,
				            {{"competencia", type date}, {"data_do_inicio_do_evento", type date}, {"data_do_fim_do_evento", type date}}
				        ),
				
				    DataAtual = Date.From(DateTime.LocalNow()),
				    DataInicio = Date.AddMonths(DataAtual, -12),
				
				    #"Últimos 12 Meses" =
				        Table.SelectRows(
				            #"Tipo Alterado",
				            each
				                [data_do_inicio_do_evento] <> null
				                and [data_do_inicio_do_evento] >= DataInicio
				                and [data_do_inicio_do_evento] <= DataAtual
				        ),
				    Personalizar1 = Table.TransformColumnTypes(#"Últimos 12 Meses", { {"competencia", type date}, {"data_do_inicio_do_evento", type date}, {"data_do_fim_do_evento", type date}}),
				    Personalizar2 = Table.RemoveColumns(Personalizar1, {"divisao", "n_doc_nf", "valor_da_nf", "valor_provisionado", "commodity", "container"}),
				    #"Linhas Filtradas1" = Table.SelectRows(Personalizar2, each ([situacao_pf] = "FATURADO" or [situacao_pf] = "ISENTO"))
				in
				    #"Linhas Filtradas1"

