	measure %TIF_Afretamento_BaseMovimentacao =
			
			[FaturamentoTIF_BaseMovimentacao]
			/ CALCULATE(
			    [FaturamentoTIF_BaseMovimentacao],
			    ALL(
			        aws_movimentacao_portuaria[dono]
			    ),
			    ALL
			    (aws_movimentacao_portuaria[operador]
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
