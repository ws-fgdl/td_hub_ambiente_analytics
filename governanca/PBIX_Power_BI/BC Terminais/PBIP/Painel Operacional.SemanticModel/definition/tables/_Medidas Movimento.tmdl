	measure Teus_ultimo_Mes_AnoAnterior_oficial =
			
			VAR vUltimaData = MAX('_Medidas Movimento'[Data Movimento])
			VAR vUltimoAno = YEAR(vUltimaData)-1
			VAR vUltimoMes = MONTH(vUltimaData)
			VAR vUltimoDia = DAY(vUltimaData)
			
			RETURN
			    CALCULATE(
			        '_Medidas Movimento'[Teus],
			        FILTER(
			            ALL('_Medidas Movimento'),
			            YEAR('_Medidas Movimento'[Data Movimento]) = vUltimoAno &&
			            MONTH('_Medidas Movimento'[Data Movimento]) = vUltimoMes &&
			            DAY('_Medidas Movimento'[Data Movimento]) <= vUltimoDia
			        )
			    )
		lineageTag: cf7c98ea-e11b-4d4f-a97f-b70e2f9ebeb6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Vol_YTM_AnoAnterior_oficial = ```
			
			VAR vUltimaData = MAX('_Medidas Movimento'[Data Movimento]) // Última data presente na base
			RETURN
			CALCULATE(
			    '_Medidas Movimento'[Teus],
			    FILTER(
			        ALL('_Medidas Movimento'),
			        YEAR('_Medidas Movimento'[Data Movimento]) = YEAR(vUltimaData) - 1 && // Filtro para o ano anterior
			       '_Medidas Movimento'[Data Movimento] <= DATE(YEAR(vUltimaData) - 1, 
			        MONTH(vUltimaData), 
			        DAY(vUltimaData)) // Filtro para o dia correspondente ao último dia presente na base, mas no ano anterior
			    )
			)
			```
		lineageTag: f30d28b9-bc0e-411b-b506-9dca0dd6987d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Vol_YTM_AnoAnterior_oficial2 = ```
			
			VAR vUltimaData = MAX(_Tempo[Data]) // Última data presente na base
			RETURN
			CALCULATE(
			    '_Medidas Movimento'[Teus],
			    FILTER(
			        ALL(_Tempo),
			        _Tempo[#Ano] = YEAR(vUltimaData) - 1 && // Filtro para o ano anterior
			        _Tempo[Data] <= DATE(YEAR(vUltimaData) - 1, 
			        MONTH(vUltimaData), 
			        DAY(vUltimaData)) // Filtro para o dia correspondente ao último dia presente na base, mas no ano anterior
			    )
			)
			```
		lineageTag: 8c6e90a5-e503-420a-809a-8d910f618469

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Teus_ultimo_Mes_AnoAnterior_oficial2 = ```
			
			VAR vUltimaData = MAX(_Tempo[Data])
			VAR vUltimoAno = YEAR(vUltimaData)-1
			VAR vUltimoMes = MONTH(vUltimaData)
			VAR vUltimoDia = DAY(vUltimaData)
			
			RETURN
			    CALCULATE(
			        '_Medidas Movimento'[Teus],
			
			            
			            YEAR(_Tempo[Data]) = vUltimoAno ,
			            MONTH(_Tempo[Data]) = vUltimoMes ,
			            DAY(_Tempo[Data]) <= vUltimoDia
			        )
			    
			```
		lineageTag: 4d1ee49e-9d27-40fc-91f8-87c9b8fcd910

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure teus_ytd_ano_anterior = ```
			
			var data_max = (year(today()) -1) *10000 + month(today())*100 + day(today()) 
			var data_min = (year(today()) -1) *10000 + 100 + 1 
			
			return calculate(sum('_Medidas Movimento'[QTD_TEUS]),_Tempo[TEMPO_ID] >=data_min ,_Tempo[TEMPO_ID]<=data_max)
			```
		lineageTag: a34f715a-f6c0-4e74-8587-25fed1edfcd0

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure teus_mes_ano_anterior = ```
			
			var data_max = (year(today()) -1) *10000 + month(today())*100 + day(today()) 
			var data_min = (year(today()) -1) *10000 + month(today())*100 + 1 
			
			return CALCULATE(sum('_Medidas Movimento'[QTD_TEUS]),
			_Tempo[TEMPO_ID]>=data_min,
			 _Tempo[TEMPO_ID] <= data_max
