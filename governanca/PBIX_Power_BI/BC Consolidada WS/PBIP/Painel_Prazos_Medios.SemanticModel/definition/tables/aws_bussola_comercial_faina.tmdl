	column Data_Inicio_Evento =
			
			VAR EventoAtual = aws_bussola_comercial_faina[evento]
			
			RETURN
			CALCULATE(
			    MIN(aws_bussola_comercial_mar[data_do_inicio_do_evento]),
			    aws_bussola_comercial_mar[os] = EventoAtual
			)
