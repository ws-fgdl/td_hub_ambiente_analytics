	column valor_minimo_periodo1 = ```
			
			
			VAR Valor_Min_Contrato = CALCULATE(
			        AVERAGE(contratos[valor_minimo_periodo]),
			        FILTER(
			            Contratos,
			            contratos[id_periodo] = bussola_comercial[id_p1]
			        )
			    )
			
			VAR Valor_Min_TabP = CALCULATE(
			        AVERAGE('Tabela Pública'[valor_minimo_periodo]),
			        FILTER(
			            'Tabela Pública',
			            'Tabela Pública'[id_periodo] = bussola_comercial[id_p1]
			        )
			)
			
			VAR valor_min_tabela = 
