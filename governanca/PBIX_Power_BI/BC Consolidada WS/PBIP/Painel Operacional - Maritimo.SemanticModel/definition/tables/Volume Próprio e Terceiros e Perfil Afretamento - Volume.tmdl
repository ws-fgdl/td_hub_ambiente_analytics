	measure _VolumeProprioTerceiro_MesAtual = ```
			
			VAR DataSelecionada = MAX('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES])
			VAR AnoMax = YEAR(DataSelecionada)
			VAR MesMax = MONTH(DataSelecionada)
			
			RETURN
			CALCULATE(
			    [Volume Proprio e Terceiros], 
			    -- Mudamos para ALL para garantir que NENHUMA coluna desta tabela de competência bloqueie o cálculo
			    ALL('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'),
			    YEAR('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]) = AnoMax,
			    MONTH('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]) = MesMax
			)
			
			
			// VAR DataSelecionada = 
			// SELECTEDVALUE(
			//     'Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES], 
			//     MAX('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[COMPETENCIA])
			// )
			
			// VAR AnoMax = YEAR(DataSelecionada)
			// VAR MesMax = MONTH(DataSelecionada)
			
			// RETURN
			// CALCULATE(
			//     [Volume Proprio e Terceiros], 
			//     REMOVEFILTERS('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]),
			//     YEAR('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]) = AnoMax,
			//     MONTH('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]) = MesMax
			// )
			
			
			```
		lineageTag: 0d200798-7a1f-4188-9951-435841de253e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _VolumeProprioTerceiro_MesAnterior = ```
			
			VAR DataSelecionada = MAX('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES])
			
			-- Extraímos o Ano e Mês atuais (sabemos que isso funciona no seu modelo)
			VAR AnoAtual = YEAR(DataSelecionada)
			VAR MesAtual = MONTH(DataSelecionada)
			
			-- Calculamos o mês e ano anterior matematicamente
			-- Se o mês for Janeiro (1), volta para Dezembro (12) e subtrai 1 do ano. 
			-- Caso contrário, só subtrai 1 do mês.
			VAR MesAnterior = IF(MesAtual = 1, 12, MesAtual - 1)
			VAR AnoAnterior = IF(MesAtual = 1, AnoAtual - 1, AnoAtual)
			
			RETURN
			CALCULATE(
			    [Volume Proprio e Terceiros], 
			    -- Limpa a tabela de competência
			    ALL('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'),
			    -- Filtra usando a mesma lógica que dá certo na sua medida de Mês Atual
			    YEAR('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]) = AnoAnterior,
			    MONTH('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]) = MesAnterior
			)
			
			// VAR DataSelecionada = 
			// SELECTEDVALUE(
			//     'Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES], 
			//     MAX('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[COMPETENCIA])
			// )
			// VAR DataMesAnterior = EOMONTH(DataSelecionada, -1)
			
			// VAR AnoAnterior = YEAR(DataMesAnterior)
			// VAR MesAnterior = MONTH(DataMesAnterior)
			
			// RETURN
			// CALCULATE(
			//     [Volume Proprio e Terceiros], 
			//     REMOVEFILTERS('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]),
			//     YEAR('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]) = AnoAnterior,
			//     MONTH('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA_ANOMES]) = MesAnterior
			// )
			```
		formatString: 0
		lineageTag: bf67e9e3-99d8-48c8-aa06-254d76eaa5d4

