	measure 'Perfil Afretamento' = EXTERNALMEASURE("Perfil Afretamento", DOUBLE, "DirectQuery para AS – Modelo Rebocadores")
		formatString: #,0.0
		lineageTag: 6f3eb545-0631-4496-befc-033c166ddf0c
		sourceLineageTag: f27b7a0c-5dd3-491e-ae57-4509d2365083
		dataCategory: Uncategorized

	measure 'Perfil Afretamento 13' = ```
			
			CALCULATE(
			    [Perfil Afretamento], 
			    DATEDIFF(
			        'Volume Próprio e Terceiros e Perfil Afretamento - Perfil Afretamento'[COMPETENCIA], 
			        SELECTEDVALUE(
			            'Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA]
			        ), 
			        MONTH
			    ) < 13, 
			    DATEDIFF(
			        'Volume Próprio e Terceiros e Perfil Afretamento - Perfil Afretamento'[COMPETENCIA], 
			        SELECTEDVALUE(
			            'Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA]), 
			            MONTH
			    ) >= 0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
