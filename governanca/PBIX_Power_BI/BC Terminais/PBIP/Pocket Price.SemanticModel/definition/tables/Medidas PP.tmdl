		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dias P1 Simulado (Blocos)' = ```
			
			/* ---- Parâmetros GERAIS (fallback) ---- */
			VAR _ft_default =
			    CALCULATE ( [#Param Dias Freetime (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			VAR _isenc_default =
			    CALCULATE ( [#Param Dias Isenção (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			VAR _perc_cheio_default =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			VAR _perc_vazio_default =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			
			/* ---- Parâmetros POR BLOCO (avaliados fora do contexto da linha) ---- */
			VAR _ft_exp =
			    CALCULATE ( [#Param Dias Freetime (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) )
			VAR _ft_cab =
			    CALCULATE ( [#Param Dias Freetime (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) )
			VAR _ft_tra =
			    CALCULATE ( [#Param Dias Freetime (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			
			VAR _isenc_exp =
			    CALCULATE ( [#Param Dias Isenção (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) )
			VAR _isenc_cab =
			    CALCULATE ( [#Param Dias Isenção (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) )
			VAR _isenc_tra =
			    CALCULATE ( [#Param Dias Isenção (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			
			VAR _perc_cheio_exp =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) )
			VAR _perc_cheio_cab =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) )
			VAR _perc_cheio_tra =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			
			VAR _perc_vazio_exp =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) )
			VAR _perc_vazio_cab =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) )
			VAR _perc_vazio_tra =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			
			RETURN
			SUMX (
			    bussola_comercial,
			    VAR _un  = bussola_comercial[un]
			    VAR _sub = bussola_comercial[Agrupamento Subgrupo Princing]
			    VAR _p1  = bussola_comercial[periodo1_contrato]
			
			    VAR _is_cheio = _sub IN { "Armazenagem Cntr Cheio", "Armazenagem Cntr Cheio BT" }
			    VAR _is_vazio = _sub IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT" }
			
			    /* --- bloco (EXP/CAB/TRA) --- */
			    VAR _serv = UPPER ( bussola_comercial[servico] )
			    VAR _isEXP = CONTAINSSTRING ( _serv, "EXP" )
			    VAR _isCAB = CONTAINSSTRING ( _serv, "CAB" )
			    VAR _isTRA = CONTAINSSTRING ( _serv, "TRA" )
			
			    /* --- seleciona parâmetros por bloco, com fallback pro geral --- */
			    VAR _ft_blk =
			        COALESCE (
			            SWITCH ( TRUE(), _isEXP, _ft_exp, _isCAB, _ft_cab, _isTRA, _ft_tra ),
			            _ft_default
			        )
			    VAR _isenc_blk =
			        COALESCE (
			            SWITCH ( TRUE(), _isEXP, _isenc_exp, _isCAB, _isenc_cab, _isTRA, _isenc_tra ),
			            _isenc_default
			        )
			
			    VAR _perc_cheio_blk =
			        COALESCE (
			            SWITCH ( TRUE(), _isEXP, _perc_cheio_exp, _isCAB, _perc_cheio_cab, _isTRA, _perc_cheio_tra ),
			            _perc_cheio_default,
			            0
			        )
			    VAR _perc_vazio_blk =
			        COALESCE (
			            SWITCH ( TRUE(), _isEXP, _perc_vazio_exp, _isCAB, _perc_vazio_cab, _isTRA, _perc_vazio_tra ),
			            _perc_vazio_default,
			            0
			        )
			
			    /* -------- 1) Volume simulado (freetime / isenção / %) -------- */
			    VAR _dias_servico = COALESCE ( bussola_comercial[dias_servico], 0 )
			    VAR _ft_real      = COALESCE ( bussola_comercial[dias_free_time], 0 )
			    VAR _isenc_real   = COALESCE ( bussola_comercial[dias_isencao], 0 )
			
			    VAR _freetime    = IF ( ISBLANK ( _ft_blk ), _ft_real, _ft_blk )
			    VAR _dias_isencao = IF ( ISBLANK ( _isenc_blk ), _isenc_real, _isenc_blk )
			
			    VAR _dias_servico_ajustado =
			        IF (
			            _dias_servico <= _freetime,
			            0,
			            IF ( _dias_isencao >= _dias_servico, 0, _dias_servico - _dias_isencao )
			        )
			
			    VAR _perc =
			        SWITCH ( TRUE(),
			            _is_vazio, _perc_vazio_blk,
			            _is_cheio, _perc_cheio_blk,
			            0
			        )
			
			    VAR _volume_simulado = ROUND ( _dias_servico_ajustado * ( 1 + _perc ), 0 )
			
			    /* -------- 2) Regra ESPELHO do teu periodo1 -------- */
			    VAR _caso_trg_cheio = ( _un = "TRG" ) && _is_cheio
			
			    RETURN
			        IF (
			            _caso_trg_cheio,
			            IF ( ISBLANK ( _p1 ), _volume_simulado, MIN ( _volume_simulado, _p1 ) ),
			            IF (
			                _sub IN {
			                    "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT",
			                    "Armazenagem Cntr Cheio",  "Armazenagem Cntr Cheio BT"
			                },
			                IF (
			                    ISBLANK ( _p1 ),
			                    _volume_simulado,
			                    IF ( _volume_simulado <= _p1, IF ( _volume_simulado > 0, 1, 0 ), 1 )
			                ),
			                BLANK ()
			            )
			        )
			)
			
			```
		displayFolder: Backup/Teste
		lineageTag: d5b4d373-95e7-4010-ba0e-5a47d6adfc17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dias P2 Simulado (Blocos)' = ```
			
			SUMX (
			    bussola_comercial,
			    VAR _un      = bussola_comercial[un]
			    VAR _servico = bussola_comercial[servico]
			    VAR _servU   = UPPER ( _servico )
			    VAR _sub     = bussola_comercial[Agrupamento Subgrupo Princing]
			
			    VAR _p1 = bussola_comercial[periodo1_contrato]
			    VAR _p2 = bussola_comercial[periodo2_contrato]
			
			    VAR _is_cheio = _sub IN { "Armazenagem Cntr Cheio", "Armazenagem Cntr Cheio BT" }
			    VAR _is_vazio = _sub IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT" }
			
			    /* -------------------------------
			       1) BLOCO (EXP/CAB/TRA) p/ parâmetros
			       ------------------------------- */
			    VAR _blkEXP = CONTAINSSTRING ( _servU, "EXP" )
			    VAR _blkCAB = CONTAINSSTRING ( _servU, "CAB" )
			    VAR _blkTRA = CONTAINSSTRING ( _servU, "TRA" )
			
			    /* -------------------------------
			       2) Parâmetros por bloco (com fallback no geral)
			       ------------------------------- */
			    VAR _ft_blk =
			        COALESCE (
			            SWITCH (
			                TRUE(),
			                _blkEXP, CALCULATE ( [#Param Dias Freetime (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) ),
			                _blkCAB, CALCULATE ( [#Param Dias Freetime (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) ),
			                _blkTRA, CALCULATE ( [#Param Dias Freetime (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			            ),
			            CALCULATE ( [#Param Dias Freetime (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			        )
			
			    VAR _isenc_blk =
			        COALESCE (
			            SWITCH (
			                TRUE(),
			                _blkEXP, CALCULATE ( [#Param Dias Isenção (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) ),
			                _blkCAB, CALCULATE ( [#Param Dias Isenção (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) ),
			                _blkTRA, CALCULATE ( [#Param Dias Isenção (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			            ),
			            CALCULATE ( [#Param Dias Isenção (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			        )
			
			    VAR _perc_cheio_blk =
			        COALESCE (
			            SWITCH (
			                TRUE(),
			                _blkEXP, CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) ),
			                _blkCAB, CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) ),
			                _blkTRA, CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			            ),
			            CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado)], REMOVEFILTERS ( bussola_comercial ) ),
			            0
			        )
			
			    VAR _perc_vazio_blk =
			        COALESCE (
			            SWITCH (
			                TRUE(),
			                _blkEXP, CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) ),
			                _blkCAB, CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) ),
			                _blkTRA, CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			            ),
			            CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado)], REMOVEFILTERS ( bussola_comercial ) ),
			            0
			        )
			
			    /* -------------------------------
			       3) Volume simulado (freetime/isenção/%)
			       ------------------------------- */
			    VAR _dias_servico = COALESCE ( bussola_comercial[dias_servico], 0 )
			    VAR _ft_real      = COALESCE ( bussola_comercial[dias_free_time], 0 )
			    VAR _isenc_real   = COALESCE ( bussola_comercial[dias_isencao], 0 )
			
			    VAR _freetime     = IF ( ISBLANK ( _ft_blk ), _ft_real, _ft_blk )
			    VAR _dias_isencao = IF ( ISBLANK ( _isenc_blk ), _isenc_real, _isenc_blk )
			
			    VAR _dias_servico_ajustado =
			        IF (
			            _dias_servico <= _freetime,
			            0,
			            IF ( _dias_isencao >= _dias_servico, 0, _dias_servico - _dias_isencao )
			        )
			
			    VAR _perc =
			        SWITCH ( TRUE(),
			            _is_vazio, _perc_vazio_blk,
			            _is_cheio, _perc_cheio_blk,
			            0
			        )
			
			    VAR _volume_simulado =
			        ROUND ( _dias_servico_ajustado * ( 1 + _perc ), 0 )
			
			    /* -------------------------------
			       4) >>> AQUI é o pulo do gato <<<
			          SALDO do P2 IGUAL à tua coluna:
			          dias_p1 = MIN(volume, periodo1_contrato)
			          saldo   = volume - dias_p1
			       ------------------------------- */
			    VAR _dias_p1_sim =
			        IF ( _volume_simulado > _p1, _p1, _volume_simulado )
			
			    VAR _saldo_volume1 =
			        _volume_simulado - _dias_p1_sim
			
			    /* -------------------------------
			       5) Mesmas condições da tua coluna
			       ------------------------------- */
			    VAR _arm_carga = RELATED ( salesforce[Armador/Cliente Carga] )
			
			    VAR _is_trg_armador =
			        _un = "TRG" && CONTAINSSTRING ( _servU, "EXP" )
			
			    VAR _is_trg_carga =
			        _un = "TRG"
			            && CONTAINSSTRING ( _servU, "IMP" )
			            && _arm_carga = "Cliente Carga"
			
			    VAR _is_trg_vazio =
			        _un = "TRG"
			            && _sub IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT" }
			
			    VAR _is_tsv_armador =
			        _un = "TSV" && _arm_carga = "Armador"
			
			    VAR _is_tsv_carga =
			        _un = "TSV"
			            && CONTAINSSTRING ( _servU, "IMP" )
			            && _arm_carga = "Cliente Carga"
			
			    RETURN
			        SWITCH (
			            TRUE(),
			            _is_tsv_armador, IF ( _saldo_volume1 > 0, 1, 0 ),
			            _is_trg_vazio,   ROUNDUP ( DIVIDE ( _saldo_volume1, _p2 ), 0 ),
			            _is_trg_armador, _saldo_volume1,
			            _is_trg_carga,   IF ( _saldo_volume1 > _p2, _p2, _saldo_volume1 ),
			            _is_tsv_carga && _saldo_volume1 > 0, 1,
			            BLANK ()
			        )
			)
			
			```
		displayFolder: Backup/Teste
		lineageTag: 97a97b69-d59c-4d92-b4da-a13b50536330

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dias P3 Simulado (blocos)' = ```
			
			VAR _ft_default     = [#Param Dias Freetime (selecionado)]
			VAR _isenc_default  = [#Param Dias Isenção (selecionado)]
			
			VAR _aj_cheio_default =
			    [#Param % ajuste volume Arm Cntr Cheio (selecionado)]
			VAR _aj_vazio_default =
			    [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			
			RETURN
			SUMX (
			    bussola_comercial,
			    VAR _un      = bussola_comercial[un]
			    VAR _servico = bussola_comercial[servico]
			    VAR _sub     = bussola_comercial[Agrupamento Subgrupo Princing]
			
			    VAR _isEXP = CONTAINSSTRING ( UPPER ( _servico ), "EXP" )
			    VAR _isCAB = CONTAINSSTRING ( UPPER ( _servico ), "CAB" )
			    VAR _isTRA = CONTAINSSTRING ( UPPER ( _servico ), "TRA" )
			
			    VAR _isVazio = _sub IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT" }
			    VAR _isCheio = _sub IN { "Armazenagem Cntr Cheio", "Armazenagem Cntr Cheio BT" }
			
			    /* -----------------------------
			       CONTRATOS (garantir numérico)
			       ----------------------------- */
			    VAR _p1 = VALUE ( bussola_comercial[periodo1_contrato] )
			    VAR _p2 = VALUE ( bussola_comercial[periodo2_contrato] )
			    VAR _p3 = VALUE ( bussola_comercial[periodo3_contrato] )
			
			    /* -----------------------------------------
			       PARAMETROS POR BLOCO (EXP/CAB/TRA)
			       usando REMOVEFILTERS pra não “morrer” no row context
			       ----------------------------------------- */
			    VAR _ft_blk =
			        COALESCE (
			            SWITCH (
			                TRUE (),
			                _isEXP, CALCULATE ( [#Param Dias Freetime (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) ),
			                _isCAB, CALCULATE ( [#Param Dias Freetime (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) ),
			                _isTRA, CALCULATE ( [#Param Dias Freetime (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			            ),
			            _ft_default
			        )
			
			    VAR _isenc_blk =
			        COALESCE (
			            SWITCH (
			                TRUE (),
			                _isEXP, CALCULATE ( [#Param Dias Isenção (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) ),
			                _isCAB, CALCULATE ( [#Param Dias Isenção (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) ),
			                _isTRA, CALCULATE ( [#Param Dias Isenção (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			            ),
			            _isenc_default
			        )
			
			    VAR _aj_cheio_blk =
			        COALESCE (
			            SWITCH (
			                TRUE (),
			                _isEXP, CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) ),
			                _isCAB, CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) ),
			                _isTRA, CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			            ),
			            _aj_cheio_default
			        )
			
			    VAR _aj_vazio_blk =
			        COALESCE (
			            SWITCH (
			                TRUE (),
			                _isEXP, CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado) - EXP], REMOVEFILTERS ( bussola_comercial ) ),
			                _isCAB, CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado) - CAB], REMOVEFILTERS ( bussola_comercial ) ),
			                _isTRA, CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado) - TRA], REMOVEFILTERS ( bussola_comercial ) )
			            ),
			            _aj_vazio_default
			        )
			
			    /* -----------------------------
			       FREETIME / ISENÇÃO / VOLUME SIMULADO
			       ----------------------------- */
			    VAR _dias_servico = bussola_comercial[dias_servico]
			
			    VAR _freetime =
			        IF (
			            ISBLANK ( _ft_blk ),
			            COALESCE ( bussola_comercial[dias_free_time], 0 ),
			            _ft_blk
			        )
			
			    VAR _dias_isencao =
			        IF ( ISBLANK ( _isenc_blk ), bussola_comercial[dias_isencao], _isenc_blk )
			
			    VAR _dias_servico_ajustado =
			        IF (
			            _dias_servico <= _freetime,
			            0,
			            IF ( _dias_isencao > _dias_servico, 0, _dias_servico - _dias_isencao )
			        )
			
			    VAR _perc_ajuste_volume =
			        SWITCH ( TRUE (), _isVazio, _aj_vazio_blk, _isCheio, _aj_cheio_blk, 0 )
			
			    VAR _volume_simulado =
			        ROUND ( _dias_servico_ajustado * ( 1 + _perc_ajuste_volume ), 0 )
			
			    /* -----------------------------
			       CONTEXTOS (iguais aos da sua COLUNA)
			       ----------------------------- */
			    VAR _is_trg_carga =
			        _un = "TRG"
			            && CONTAINSSTRING ( _servico, "IMP" )
			            && RELATED ( salesforce[Armador/Cliente Carga] ) = "Cliente Carga"
			
			    VAR _is_tsv = _un = "TSV"
			
			    /* -----------------------------
			       PARTES “REALIZADAS” (iguais à sua COLUNA periodo3)
			       baseadas no VOLUME (aqui, volume_simulado)
			       ----------------------------- */
			    VAR _DIAS_P1_REALIZADO =
			        IF ( _volume_simulado > _p1, _p1, _volume_simulado )
			
			    VAR _SALDO_VOLUME_P1 =
			        _volume_simulado - _DIAS_P1_REALIZADO
			
			    VAR _DIAS_P2_REALIZADO =
			        IF (
			            _volume_simulado <= _p1,
			            0,
			            IF ( _p2 < _SALDO_VOLUME_P1, _p2, _SALDO_VOLUME_P1 )
			        )
			
			    VAR _SALDO_VOLUME_P2 =
			        _volume_simulado - _DIAS_P1_REALIZADO - _DIAS_P2_REALIZADO
			
			    /* -----------------------------
			       REPLICANDO rest / rest2 da sua COLUNA
			       (mas com volume_simulado e p1/p2 simulados)
			       ----------------------------- */
			    VAR rest =
			        ( _volume_simulado - ( _p1 + _p2 ) )
			
			    /* periodo1 simulado (mesma lógica da sua coluna periodo1) */
			    VAR _p1_rest = _volume_simulado - _p1
			    VAR _periodo1_sim =
			        IF (
			            AND ( _sub IN { "Armazenagem Cntr Cheio" }, _un = "TRG" ),
			            IF ( _p1 = BLANK(), _volume_simulado, IF ( _volume_simulado > _p1, _p1, _volume_simulado ) ),
			            IF (
			                _sub IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT", "Armazenagem Cntr Cheio" },
			                IF (
			                    _p1 = BLANK(),
			                    _volume_simulado,
			                    IF (
			                        _volume_simulado <= _p1,
			                        IF ( _volume_simulado > 0, 1, 0 ),
			                        IF ( _p1_rest <= _p1, 1, 0 )
			                    )
			                ),
			                BLANK ()
			            )
			        )
			
			    /* periodo2 simulado (mesma lógica da sua coluna periodo2) */
			    VAR _dias_p1_real_col =
			        IF ( _volume_simulado > _p1, _p1, _volume_simulado )
			    VAR _saldo_volume1 =
			        _volume_simulado - _dias_p1_real_col
			
			    VAR _sub_grupo_princing = _sub
			
			    VAR _is_trg_armador =
			        _un = "TRG" && CONTAINSSTRING ( _servico, "EXP" )
			
			    VAR _is_trg_vazio =
			        _un = "TRG"
			            && _sub_grupo_princing IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT" }
			
			    VAR _is_tsv_armador =
			        _un = "TSV" && RELATED ( salesforce[Armador/Cliente Carga] ) = "Armador"
			
			    VAR _is_tsv_carga =
			        _un = "TSV"
			            && CONTAINSSTRING ( _servico, "IMP" )
			            && RELATED ( salesforce[Armador/Cliente Carga] ) = "Cliente Carga"
			
			    VAR _periodo2_sim =
			        SWITCH (
			            TRUE (),
			            _is_tsv_armador, IF ( _saldo_volume1 > 0, 1, 0 ),
			            _is_trg_vazio, ROUNDUP ( DIVIDE ( _saldo_volume1, _p2 ), 0 ),
			            _is_trg_armador, _saldo_volume1,
			            _is_trg_carga, IF ( _saldo_volume1 > _p2, _p2, _saldo_volume1 ),
			            _is_tsv_carga && _saldo_volume1 > 0, 1,
			            BLANK ()
			        )
			
			    VAR rest2 =
			        ( _volume_simulado - ( _periodo1_sim + _periodo2_sim ) )
			
			    /* -----------------------------
			       AGORA: a lógica da sua COLUNA periodo3 (idêntica)
			       com correção de erro na divisão
			       ----------------------------- */
			    VAR _expr_original =
			        IF (
			            AND ( _sub IN { "Armazenagem Cntr Cheio" }, _un = "TRG" ),
			            IF ( rest2 < 0, 0, rest2 ),
			            IF (
			                _sub IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT", "Armazenagem Cntr Cheio" },
			                IF (
			                    _periodo2_sim > 1,
			                    BLANK (),
			                    VAR _denomBase =
			                        IF (
			                            _p3 = BLANK (),
			                            IF ( _p2 = BLANK (), _p1, _p2 ),
			                            _p3
			                        )
			                    VAR _denom = ROUNDUP ( _denomBase, 0 )
			                    RETURN
			                        ROUNDUP (
			                            IF ( rest > 0, DIVIDE ( rest, _denom, 0 ), 0 ),
			                            0
			                        )
			                ),
			                0
			            )
			        )
			
			    VAR _resultado =
			        IF (
			            _is_trg_carga,
			            IF ( _SALDO_VOLUME_P2 <= _p3, _SALDO_VOLUME_P2, _p3 ),
			            IF (
			                _is_tsv,
			                IF ( _SALDO_VOLUME_P2 > 0, ROUNDUP ( DIVIDE ( _SALDO_VOLUME_P2, _p3 ), 0 ), 0 ),
			                IFERROR ( _expr_original, 0 )
			            )
			        )
			
			    RETURN _resultado
			)
			
			```
		displayFolder: Backup/Teste
		lineageTag: b8f412ff-0a04-4c25-a01f-d4efd3810a63

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Faturamento Realizado Armador' = ```
			
			SUMX
			( bussola_comercial
			, 
			VAR _sub_grupo_princing    = bussola_comercial[Agrupamento Subgrupo Princing]
			VAR _sinalizador_cheio     = _sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT" }
			VAR _imo                   = bussola_comercial[imo]
			VAR _oog                   = bussola_comercial[oog]
			
			VAR _perc_adicional = 
			             // Parâmetro IMO
			             ( 1 +
			               SWITCH
			               ( TRUE()
			               , _imo = "SIM" && _sinalizador_cheio, bussola_comercial[Adic_carga_especial]
			               , 0
			               )
			             ) *
			             // Parâmetro OOG
			             ( 1 +
			               SWITCH
			               ( TRUE()
			               , _oog = "SIM" && _sinalizador_cheio, bussola_comercial[Adic_oog]
			               , 0
			               )
			             )
			
			
			RETURN
			  ( ('bussola_comercial'[price_p1] * _perc_adicional * 'bussola_comercial'[periodo1])
			   +('bussola_comercial'[price_p2] * _perc_adicional * 'bussola_comercial'[periodo2])
			   +('bussola_comercial'[price_p3] * _perc_adicional * 'bussola_comercial'[periodo3])
			  )
			)
			 
			```
		displayFolder: Faturamento
		lineageTag: fd09d89b-91a3-47fa-aac8-234135a66817

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Faturamento Simulado Armador' = ```
			
			VAR _freetime_param_default           = [#Param Dias Freetime (selecionado)]
			VAR _freetime_param_vazio_imp         = [#Param Dias Freetime Vazio Imp (selecionado)]
			VAR _freetime_param_vazio_exp         = [#Param Dias Freetime Vazio Exp (selecionado)]
			VAR _dias_isencao_param_default       = [#Param Dias Isenção (selecionado)]
			VAR _dias_isencao_param_vazio_imp     = [#Param Dias Isenção Vazio Imp (selecionado)]
			VAR _dias_isencao_param_vazio_exp     = [#Param Dias Isenção Vazio Exp (selecionado)]
			VAR _perc_ajuste_volume_cheio         = [#Param % ajuste volume Arm Cntr Cheio (selecionado)]
			VAR _perc_ajuste_volume_vazio         = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			VAR _param_valor_arm_vazio_default_p1 = [Valor Arm. Vazios - Preço P1]
			VAR _param_valor_arm_vazio_default_p2 = [Valor Arm. Vazios - Preço P2]
			VAR _param_valor_arm_vazio_default_p3 = [Valor Arm. Vazios - Preço P3]
			VAR _param_valor_arm_vazio_imp_p1     = [#Arm. Vazios Importação - Preço P1 (selecionado)]
			VAR _param_valor_arm_vazio_imp_p2     = [#Arm. Vazios Importação - Preço P2 (selecionado)]
			VAR _param_valor_arm_vazio_imp_p3     = [#Arm. Vazios Importação - Preço P3 (selecionado)]
			VAR _param_valor_arm_vazio_exp_p1     = [#Arm. Vazios Exportação - Preço P1 (selecionado)]
			VAR _param_valor_arm_vazio_exp_p2     = [#Arm. Vazios Exportação - Preço P2 (selecionado)]
			VAR _param_valor_arm_vazio_exp_p3     = [#Arm. Vazios Exportação - Preço P3 (selecionado)]
			VAR _param_valor_arm_exp20_p1         = [Valor Arm. EXP 20 - Preço P1]
			VAR _param_valor_arm_exp20_p2         = [Valor Arm. EXP 20 - Preço P2]
			VAR _param_valor_arm_exp20_p3         = [Valor Arm. EXP 20 - Preço P3]
			VAR _param_valor_arm_exp40_p1         = [Valor Arm. EXP 40 - Preço P1]
			VAR _param_valor_arm_exp40_p2         = [Valor Arm. EXP 40 - Preço P2]
			VAR _param_valor_arm_exp40_p3         = [Valor Arm. EXP 40 - Preço P3]
			VAR _param_valor_ad_ogg               = [Valor Adicional OOG (selecionado)]
			VAR _param_valor_arm_cheio_exp_ad_carg_especial = [Valor Arm. Cheio Exp - Adicional Carga Especial (selecionado)]
			
			RETURN
			SUMX(
			    bussola_comercial,
			    VAR _un                 = bussola_comercial[un]
			    VAR _tam_container      = bussola_comercial[tamanho_container]
			    VAR _imo                = bussola_comercial[imo]
			    VAR _oog                = bussola_comercial[oog]
			    VAR _sub_grupo_princing = bussola_comercial[Agrupamento Subgrupo Princing]
			    VAR _tabela_publica     = bussola_comercial[tabela_publica]
			    VAR _periodo1_contrato  = bussola_comercial[periodo1_contrato]
			    VAR _periodo2_contrato  = bussola_comercial[periodo2_contrato]
			    VAR _periodo3_contrato  = bussola_comercial[periodo3_contrato]
			    VAR _preco1             = COALESCE(bussola_comercial[price_p1], _tabela_publica, 0)
			    VAR _preco2             = COALESCE(bussola_comercial[price_p2], _tabela_publica, 0)
			    VAR _preco3             = COALESCE(bussola_comercial[price_p3], _tabela_publica, 0)
			    VAR _dias_servico       = bussola_comercial[dias_servico]
			    VAR _servico            = bussola_comercial[servico]
			
			    /* -------------------------------
			       1) DETECÇÃO DE BLOCO (EXP/CAB/TRA)
			       ------------------------------- */
			    VAR _isEXP = CONTAINSSTRING ( UPPER(_servico), "EXP" )
			    VAR _isCAB = CONTAINSSTRING ( UPPER(_servico), "CAB" )
			    VAR _isTRA = CONTAINSSTRING ( UPPER(_servico), "TRA" )
			
			    /* -------------------------------
			       2) FLAGS DE TIPO (mantidos)
			       ------------------------------- */
			    VAR _sinalizador_cheio     = _sub_grupo_princing IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Cheio BT"}
			    VAR _sinalizador_vazio     = _sub_grupo_princing IN {"Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"}
			    VAR _sinalizador_vazio_imp = _sinalizador_vazio   // ajuste fino se precisar no futuro
			    VAR _sinalizador_vazio_exp = _sinalizador_vazio
			
			    /* -------------------------------
			       3) PARÂMETROS “POR BLOCO”
			       Cada COALESCE usa: bloco > geral (fallback)
			       Crie as measures bloco abaixo (EXP/CAB/TRA).
			       ------------------------------- */
			    -- Freetime
			    VAR _ft_default_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Param Dias Freetime (selecionado) - EXP],
			            _isCAB, [#Param Dias Freetime (selecionado) - CAB],
			            _isTRA, [#Param Dias Freetime (selecionado) - TRA]
			        ),
			        _freetime_param_default
			    )
			    VAR _ft_vazio_imp_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Param Dias Freetime Vazio Imp (selecionado)],
			            _isCAB, [#Param Dias Freetime Vazio (selecionado) - CAB],
			            _isTRA, [#Param Dias Freetime Vazio (selecionado) - TRA]
			        ),
			        _freetime_param_vazio_imp
			    )
			    VAR _ft_vazio_exp_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Param Dias Freetime Vazio Exp (selecionado)],
			            _isCAB, [#Param Dias Freetime Vazio (selecionado) - CAB],
			            _isTRA, [#Param Dias Freetime Vazio (selecionado) - TRA]
			        ),
			        _freetime_param_vazio_exp
			    )
			
			    -- Isenção
			    VAR _isenc_default_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Param Dias Isenção (selecionado) - EXP],
			            _isCAB, [#Param Dias Isenção (selecionado) - CAB],
			            _isTRA, [#Param Dias Isenção (selecionado) - TRA]
			        ),
			        _dias_isencao_param_default
			    )
			    VAR _isenc_vazio_imp_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Param Dias Isenção Vazio Imp (selecionado)],
			            _isCAB, [#Param Dias Isenção Vazio (selecionado) - CAB],
			            _isTRA, [#Param Dias Isenção Vazio (selecionado) - TRA]
			        ),
			        _dias_isencao_param_vazio_imp
			    )
			    VAR _isenc_vazio_exp_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Param Dias Isenção Vazio Exp (selecionado)],
			            _isCAB, [#Param Dias Isenção Vazio (selecionado) - CAB],
			            _isTRA, [#Param Dias Isenção Vazio (selecionado) - TRA]
			        ),
			        _dias_isencao_param_vazio_exp
			    )
			
			    -- % Ajuste de volume
			    VAR _aj_vol_cheio_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Param % ajuste volume Arm Cntr Cheio (selecionado) - EXP],
			            _isCAB, [#Param % ajuste volume Arm Cntr Cheio (selecionado) - CAB],
			            _isTRA, [#Param % ajuste volume Arm Cntr Cheio (selecionado) - TRA]
			        ),
			        _perc_ajuste_volume_cheio
			    )
			    VAR _aj_vol_vazio_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Param % ajuste volume Arm Cntr Vazio (selecionado)],
			            _isCAB, [#Param % ajuste volume Arm Cntr Vazio (selecionado) - CAB],
			            _isTRA, [#Param % ajuste volume Arm Cntr Vazio (selecionado) - TRA]
			        ),
			        _perc_ajuste_volume_vazio
			    )
			
			    -- Ajustes de preço (Vazios: default/imp/exp)
			    VAR _vaz_def_p1_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. Vazios - Preço P1],
			            _isCAB, [Valor Arm. Vazios - Preço P1 - CAB],
			            _isTRA, [Valor Arm. Vazios - Preço P1 - TRA]
			        ),
			        _param_valor_arm_vazio_default_p1
			    )
			    VAR _vaz_def_p2_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. Vazios - Preço P2],
			            _isCAB, [Valor Arm. Vazios - Preço P2 - CAB],
			            _isTRA, [Valor Arm. Vazios - Preço P2 - TRA]
			        ),
			        _param_valor_arm_vazio_default_p2
			    )
			    VAR _vaz_def_p3_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. Vazios - Preço P3],
			            _isCAB, [Valor Arm. Vazios - Preço P3 - CAB],
			            _isTRA, [Valor Arm. Vazios - Preço P3 - TRA]
			        ),
			        _param_valor_arm_vazio_default_p3
			    )
			    VAR _vaz_imp_p1_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Arm. Vazios Importação - Preço P1 (selecionado)],
			            _isCAB, [#Arm. Vazios - Preço P1 (selecionado) - CAB],
			            _isTRA, [#Arm. Vazios - Preço P1 (selecionado) - TRA]
			        ),
			        _param_valor_arm_vazio_imp_p1
			    )
			    VAR _vaz_imp_p2_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Arm. Vazios Importação - Preço P2 (selecionado)],
			            _isCAB, [#Arm. Vazios - Preço P2 (selecionado) - CAB],
			            _isTRA, [#Arm. Vazios - Preço P2 (selecionado) - TRA]
			        ),
			        _param_valor_arm_vazio_imp_p2
			    )
			    VAR _vaz_imp_p3_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Arm. Vazios Importação - Preço P3 (selecionado)],
			            _isCAB, [#Arm. Vazios - Preço P3 (selecionado) - CAB],
			            _isTRA, [#Arm. Vazios - Preço P3 (selecionado) - TRA]
			        ),
			        _param_valor_arm_vazio_imp_p3
			    )
			    VAR _vaz_exp_p1_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Arm. Vazios Exportação - Preço P1 (selecionado)],
			            _isCAB, [#Arm. Vazios - Preço P1 (selecionado) - CAB],
			            _isTRA, [#Arm. Vazios - Preço P1 (selecionado) - TRA]
			        ),
			        _param_valor_arm_vazio_exp_p1
			    )
			    VAR _vaz_exp_p2_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Arm. Vazios Exportação - Preço P2 (selecionado)],
			            _isCAB, [#Arm. Vazios - Preço P2 (selecionado) - CAB],
			            _isTRA, [#Arm. Vazios - Preço P2 (selecionado) - TRA]
			        ),
			        _param_valor_arm_vazio_exp_p2
			    )
			    VAR _vaz_exp_p3_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [#Arm. Vazios Exportação - Preço P3 (selecionado)],
			            _isCAB, [#Arm. Vazios - Preço P3 (selecionado) - CAB],
			            _isTRA, [#Arm. Vazios - Preço P3 (selecionado) - TRA]
			        ),
			        _param_valor_arm_vazio_exp_p3
			    )
			
			    -- Ajustes de preço (Cheio: 20/40)
			    VAR _cheio20_p1_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. 20 - Preço P1 - EXP],
			            _isCAB, [Valor Arm. 20 - Preço P1 - CAB],
			            _isTRA, [Valor Arm. 20 - Preço P1 - TRA]
			        ),
			        _param_valor_arm_exp20_p1
			    )
			    VAR _cheio20_p2_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. 20 - Preço P2 - EXP],
			            _isCAB, [Valor Arm. 20 - Preço P2 - CAB],
			            _isTRA, [Valor Arm. 20 - Preço P2 - TRA]
			        ),
			        _param_valor_arm_exp20_p2
			    )
			    VAR _cheio20_p3_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. 20 - Preço P3 - EXP],
			            _isCAB, [Valor Arm. 20 - Preço P3 - CAB],
			            _isTRA, [Valor Arm. 20 - Preço P3 - TRA]
			        ),
			        _param_valor_arm_exp20_p3
			    )
			    VAR _cheio40_p1_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. 40 - Preço P1 - EXP],
			            _isCAB, [Valor Arm. 40 - Preço P1 - CAB],
			            _isTRA, [Valor Arm. 40 - Preço P1 - TRA]
			        ),
			        _param_valor_arm_exp40_p1
			    )
			    VAR _cheio40_p2_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. 40 - Preço P2 - EXP],
			            _isCAB, [Valor Arm. 40 - Preço P2 - CAB],
			            _isTRA, [Valor Arm. 40 - Preço P2 - TRA]
			        ),
			        _param_valor_arm_exp40_p2
			    )
			    VAR _cheio40_p3_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. 40 - Preço P3 - EXP],
			            _isCAB, [Valor Arm. 40 - Preço P3 - CAB],
			            _isTRA, [Valor Arm. 40 - Preço P3 - TRA]
			        ),
			        _param_valor_arm_exp40_p3
			    )
			
			    -- Adicionais (IMO / OOG)
			    VAR _ad_ogg_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Adicional OOG (selecionado) - EXP],
			            _isCAB, [Valor Adicional OOG (selecionado) - CAB],
			            _isTRA, [Valor Adicional OOG (selecionado) - TRA]
			        ),
			        _param_valor_ad_ogg
			    )
			    VAR _ad_cesp_blk = COALESCE(
			        SWITCH(TRUE(),
			            _isEXP, [Valor Arm. Cheio Exp - Adicional Carga Especial (selecionado) - EXP],
			            _isCAB, [Valor Arm. Cheio - Adicional Carga Especial (selecionado) - CAB],
			            _isTRA, [Valor Arm. Cheio - Adicional Carga Especial (selecionado) - TRA]
			        ),
			        _param_valor_arm_cheio_exp_ad_carg_especial
			    )
			
			    /* -------------------------------
			       4) FREETIME / ISENÇÃO APLICADOS
			       ------------------------------- */
			    VAR _freetime_param =
			        SWITCH ( TRUE(),
			            _sinalizador_vazio_imp, _ft_vazio_imp_blk,
			            _sinalizador_vazio_exp, _ft_vazio_exp_blk,
			            _ft_default_blk
			        )
			    VAR _dias_isencao_param =
			        SWITCH ( TRUE(),
			            _sinalizador_vazio_imp, _isenc_vazio_imp_blk,
			            _sinalizador_vazio_exp, _isenc_vazio_exp_blk,
			            _isenc_default_blk
			        )
			    VAR _freetime     = IF ( ISBLANK(_freetime_param),     bussola_comercial[dias_free_time], _freetime_param )
			    VAR _dias_isencao = IF ( ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao],   _dias_isencao_param )
			
			    VAR _dias_servico_ajustado =
			        IF ( _dias_servico <= _freetime, 0,
			            IF ( _dias_isencao > _dias_servico, 0, _dias_servico - _dias_isencao )
			        )
			
			    /* -------------------------------
			       5) AJUSTE DE VOLUME POR BLOCO
			       ------------------------------- */
			    VAR _perc_ajuste_volume =
			        SWITCH ( TRUE(),
			            _sinalizador_vazio, _aj_vol_vazio_blk,
			            _sinalizador_cheio, _aj_vol_cheio_blk,
			            0
			        )
			    VAR _volume_simulado = ROUND ( _dias_servico_ajustado * ( 1 + _perc_ajuste_volume ), 0 )
			
			    /* -------------------------------
			       6) PREÇOS P1/P2/P3 COM AJUSTES
			       ------------------------------- */
			    VAR _preco1_simulado =
			        IF ( _preco1 = 0, BLANK(),
			            VAR _percentual =
			                ( 1 + SWITCH(TRUE(),
			                        _sinalizador_vazio_exp,                        _vaz_exp_p1_blk,
			                        _sinalizador_vazio_imp,                        _vaz_imp_p1_blk,
			                        _sinalizador_vazio,                            _vaz_def_p1_blk,
			                        _sinalizador_cheio && (_tam_container="20"),   _cheio20_p1_blk,
			                        _sinalizador_cheio && (_tam_container="40"),   _cheio40_p1_blk,
			                        0
			                    )
			                ) *
			                ( 1 + SWITCH(TRUE(),
			                        _imo="SIM" && _sinalizador_cheio, COALESCE(_ad_cesp_blk, bussola_comercial[Adic_carga_especial]),
			                        0
			                    )
			                ) *
			                ( 1 + SWITCH(TRUE(),
			                        _oog="SIM" && _sinalizador_cheio, COALESCE(_ad_ogg_blk,  bussola_comercial[Adic_oog]),
			                        0
			                    )
			                )
			            RETURN _preco1 * _percentual
			        )
			
			    VAR _preco2_simulado =
			        IF ( _preco2 = 0, BLANK(),
			            VAR _percentual =
			                ( 1 + SWITCH(TRUE(),
			                        _sinalizador_vazio_exp,                        _vaz_exp_p2_blk,
			                        _sinalizador_vazio_imp,                        _vaz_imp_p2_blk,
			                        _sinalizador_vazio,                            _vaz_def_p2_blk,
			                        _sinalizador_cheio && (_tam_container="20"),   _cheio20_p2_blk,
			                        _sinalizador_cheio && (_tam_container="40"),   _cheio40_p2_blk,
			                        0
			                    )
			                ) *
			                ( 1 + SWITCH(TRUE(),
			                        _imo="SIM" && _sinalizador_cheio, COALESCE(_ad_cesp_blk, bussola_comercial[Adic_carga_especial]),
			                        0
			                    )
			                ) *
			                ( 1 + SWITCH(TRUE(),
			                        _oog="SIM" && _sinalizador_cheio, COALESCE(_ad_ogg_blk,  bussola_comercial[Adic_oog]),
			                        0
			                    )
			                )
			            RETURN _preco2 * _percentual
			        )
			
			    VAR _preco3_simulado =
			        IF ( _preco3 = 0 || _un = "TRG", BLANK(),
			            VAR _percentual =
			                ( 1 + SWITCH(TRUE(),
			                        _sinalizador_vazio_exp,                        _vaz_exp_p3_blk,
			                        _sinalizador_vazio_imp,                        _vaz_imp_p3_blk,
			                        _sinalizador_vazio,                            _vaz_def_p3_blk,
			                        _sinalizador_cheio && (_tam_container="20"),   _cheio20_p3_blk,
			                        _sinalizador_cheio && (_tam_container="40"),   _cheio40_p3_blk,
			                        0
			                    )
			                ) *
			                ( 1 + SWITCH(TRUE(),
			                        _imo="SIM" && _sinalizador_cheio, COALESCE(_ad_cesp_blk, bussola_comercial[Adic_carga_especial]),
			                        0
			                    )
			                ) *
			                ( 1 + SWITCH(TRUE(),
			                        _oog="SIM" && _sinalizador_cheio, COALESCE(_ad_ogg_blk,  bussola_comercial[Adic_oog]),
			                        0
			                    )
			                )
			            RETURN _preco3 * _percentual
			        )
			
			    /* -------------------------------
			       7) DIAS P1/P2/P3 (mantém tua lógica)
			       ------------------------------- */
			    VAR _dias_p1_simulado =
			        IF ( ISBLANK(_periodo1_contrato), BLANK(),
			            IF ( _dias_servico_ajustado = 0, 0,
			                IF ( _un = "TSV" || _sinalizador_vazio,
			                    IF ( _volume_simulado > 0, 1, 0 ),
			                    IF ( _volume_simulado > _periodo1_contrato, _periodo1_contrato, _volume_simulado )
			                )
			            )
			        )
			
			    VAR _dias_p2_simulado =
			        IF ( ISBLANK(_periodo2_contrato), BLANK(),
			            IF ( _dias_servico_ajustado = 0, 0,
			                VAR _saldo_volume = _volume_simulado - _periodo1_contrato
			                RETURN
			                    IF ( _saldo_volume > 0,
			                        SWITCH(TRUE(),
			                            _un = "TSV", 1,
			                            _un = "TRG" && _sinalizador_vazio, ROUNDUP(DIVIDE(_saldo_volume, _periodo2_contrato), 0),
			                            _saldo_volume
			                        ),
			                        0
			                    )
			            )
			        )
			
			    VAR _dias_p3_simulado =
			        IF ( _un = "TRG", BLANK(),
			            IF ( ISBLANK(_periodo3_contrato), BLANK(),
			                IF ( _dias_servico_ajustado = 0, 0,
			                    VAR _saldo_volume = _volume_simulado - _periodo1_contrato - _periodo2_contrato
			                    RETURN IF ( _saldo_volume > 0, ROUNDUP(DIVIDE(_saldo_volume, _periodo3_contrato), 0), 0 )
			                )
			            )
			        )
			
			    RETURN
			        _dias_p1_simulado * _preco1_simulado +
			        _dias_p2_simulado * _preco2_simulado +
			        _dias_p3_simulado * _preco3_simulado
			)
			
			```
		displayFolder: Faturamento
		lineageTag: 9c78f6ee-33b9-401e-ab7b-b095f44d6c6e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Δ Fat. Armazenagem Armador' = [Faturamento Simulado Armador 2] - [Faturamento Realizado Armador]
