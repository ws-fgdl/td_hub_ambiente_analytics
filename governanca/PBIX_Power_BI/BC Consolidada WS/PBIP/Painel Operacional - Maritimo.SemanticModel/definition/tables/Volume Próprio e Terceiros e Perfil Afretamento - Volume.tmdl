			    // Remove os filtros atuais da tabela calendário
			    REMOVEFILTERS('_Tempo'),
			    
			    // 3. Pega todos os meses onde os 4 primeiros caracteres (Ano) são iguais ao ano atual
			    LEFT('_Tempo'[#Ano/Mês], 4) = vAnoSelecionado,
			    
			    // 4. Garante que não vai somar meses além do selecionado
			    '_Tempo'[#Ano/Mês] <= vMaxData,
			    
			    // Filtro da fato
