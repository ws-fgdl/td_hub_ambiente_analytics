table Selecao_ShareConcorrente
	lineageTag: 69288f83-b0d0-495f-81b3-72322743b4f1

	measure Cor_Share_Dinamica = ```
			
			VAR CategoriaAtual = 
			    COALESCE(
			        SELECTEDVALUE('Dim_DonoManobra'[Dono_Demais]),
			        SELECTEDVALUE('Dim_Operador'[Operador_Demais])
			    )
			
			RETURN
			SWITCH(
			    CategoriaAtual,
			    "WS", "#118DFF",
			    "SVITZER", "#893395",
			    "SAAM", "#E8D166",
			    "SULNORTE", "#999999",
			    "CAMORIM", "#D64550",
			    "VALE", "#73361C",
			    "DEMAIS", "#001C43",
			    "#708090" -- Cor Padrão
			)
			```
		lineageTag: d1db755d-d875-4a2e-ba8f-e9ca979ff96f

