	measure 'Consignação média mov' = EXTERNALMEASURE("Consignação média mov", DOUBLE, "DirectQuery para AS – Modelo Operações Portuárias")
		lineageTag: 8bcac8d5-5fae-4ae8-a6c7-dd5ebe80b2fa
