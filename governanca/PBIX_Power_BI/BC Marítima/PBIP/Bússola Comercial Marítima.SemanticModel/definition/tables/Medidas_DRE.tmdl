table Medidas_DRE
	lineageTag: fa6ea7fd-92f7-4093-aafe-911bc0fe386a

	measure Tempo_ComDesloc_Horas =
			
			CALCULATE(
			    SUM(aws_bussola_comercial_mar[duracao_evento_minutos]) / 60,
			    aws_bussola_comercial_mar[flag_anomes_datafim_competencia] = 1
			)
		lineageTag: 9e07ce38-a90a-4141-a943-b446ece03dc4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Tempo_SemDesloc_Horas =
			
			CALCULATE(
			    SUM(aws_bussola_comercial_mar[duracao_operacao_minutos]) / 60,
			    aws_bussola_comercial_mar[flag_anomes_datafim_competencia] = 1
			)
		lineageTag: 00331c1b-b88e-459b-acad-692fa94eca52

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Volume_Filial_Mes = ```
			
			CALCULATE(
			    [VolumeManobra_BaseBC],
			    REMOVEFILTERS('Dim_Cliente'), 
			    REMOVEFILTERS('db_rl_lineup_merc') 
			    // Se tiver filial e data no visual, NÃO remova os filtros delas!
			)
			```
		lineageTag: 0c725248-5341-478e-91d7-b521b8ae9010

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Tempo_ComDesloc_Filial_Mes =
			
			CALCULATE(
			    [Tempo_ComDesloc_Horas],
			    REMOVEFILTERS('Dim_Cliente'),
			    REMOVEFILTERS('db_rl_lineup_merc')
			)
		lineageTag: 4652ac2e-1c27-4ac1-97d7-7de0d3645e95

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Tempo_SemDesloc_Filial_Mes =
			
			CALCULATE(
			    [Tempo_SemDesloc_Horas],
			    REMOVEFILTERS('Dim_Cliente'),
			    REMOVEFILTERS('db_rl_lineup_merc')
			)
		lineageTag: 21ba8824-c143-465f-b7d2-e30e38d95289

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Custo_Alocado_Volume = ```
			
			VAR Perc_Participacao = 
			DIVIDE(
			    [VolumeManobra_BaseBC], 
			    [Volume_Filial_Mes], 
			    0
			)
			RETURN [Soma_Custo_Ebitda] * Perc_Participacao
			```
		lineageTag: 5f264938-cace-42b1-bcf4-5e1695212c2a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Custo_Alocado_Tempo_ComDesloc = ```
			
			VAR Perc_Participacao = 
