table Medidas
	lineageTag: f832a188-1886-4f40-b075-367b102c6128

	measure 'Acumulado qntd navio MTD' =
			
			
			VAR vUltimoDiaContexto = MAX(dim_calendario[data])
			VAR vAcumulado =
			CALCULATE(
			    DISTINCTCOUNT(aws_movimentacao_cntr[operacao_por_navio]),
			        ALL(dim_calendario),
			        dim_calendario[data] <= vUltimoDiaContexto
			    )
			
			RETURN
			vAcumulado
		formatString: 0
		lineageTag: c328018f-4625-417e-b93b-67c8dfe6f87e

	measure 'Acumulado Vol cntnr MTD' = ```
			
			
			VAR vUltimoDiaContexto = MAX(dim_calendario[data])
			VAR vAcumulado =
			CALCULATE(
			    [Volume de Container],
			        ALL(dim_calendario),
			        dim_calendario[data] <= vUltimoDiaContexto
			    )
			
			RETURN
			vAcumulado
			
			```
		lineageTag: f0ef45f3-8e99-4afc-9c3d-ec67c7718d91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure blank = BLANK()
		formatString: 0
		lineageTag: 6c4f8924-0709-4eb0-be1f-e5d4003a96fd

	measure 'Consignação Média' = ```
			
			
			    [Volume de Container] / DISTINCTCOUNT(aws_movimentacao_cntr[operacao_por_navio])
			    
			  
			```
		lineageTag: 315b4e42-b943-4ed6-83fc-0bc2c916890f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Consignação Média Acumulada' = ```
			
			 
			VAR vUltimaData = CALCULATE( 
			    MAX(dim_calendario[data]), 
			    ALLSELECTED(dim_calendario)  // Para responder aos filtros visuais aplicados
			)
			VAR vUltimoMesContexto = MONTH(MAXX(ALL(dim_calendario),dim_calendario[data]))
			VAR vUltimoMesContexto2 = MONTH(vUltimaData)
			VAR vUltimoAno = YEAR(vUltimaData)
			
			RETURN
			 CALCULATE(
			    ([Acumulado Vol cntnr MTD] / [Acumulado qntd navio MTD]),
			    
			    // Filtro para pegar os últimos três anos, utilizando VALUES para garantir valores únicos por ano
			    FILTER(
			        dim_calendario, 
			        dim_calendario[Ano_calendario] IN VALUES(dim_calendario[Ano_calendario]) &&
			        dim_calendario[Ano_calendario] IN {vUltimoAno, vUltimoAno-1, vUltimoAno-2}
			    ))
			    // Filtro para pegar apenas os dias até o último dia do mês
			
			
			
			
			
			
			```
		lineageTag: 8a8298f8-8bf3-4673-ab99-18ff24bd8c91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure data0 =
			
			MAXX(ALL(aws_movimentacao_cntr), aws_movimentacao_cntr[data])
		formatString: Short Date
		lineageTag: 7e82f267-6d70-438f-84e7-596a84babff5

	measure FiltroTresAnos = ```
			
			VAR DataMaxima = CALCULATE(MAX(aws_movimentacao_cntr[data]), ALL(dim_calendario))
			VAR AnoAtual = YEAR(DataMaxima)
			VAR AnoDaLinha = MAX(dim_calendario[ano_calendario]) -- Ou sua coluna de ano correspondente
			
			RETURN
			IF(
			    AnoDaLinha >= AnoAtual - 2 && AnoDaLinha <= AnoAtual, 
			    1, 
			    0
			)
			```
		formatString: 0
		lineageTag: 8a37c590-1e7f-4c66-a8ba-8bedcbbd5001

	measure 'Navio Vol YTM 2024' =
			
			CALCULATE(
			    DISTINCTCOUNT(aws_movimentacao_cntr[operacao_por_navio]),
			    DATESYTD(dim_calendario[data])
			)
		formatString: 0
		lineageTag: 3b7f309b-eb9d-4551-a416-51b7ea10a29a

	measure 'Qntd navio_ultimo_mes_2023' =
			
			VAR vUltimaData = MAX(dim_calendario[data])
			VAR vUltimoAno = YEAR(vUltimaData)-1
			VAR vUltimoMes = MONTH(vUltimaData)
			VAR vUltimoDia = DAY(vUltimaData)-1
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(aws_movimentacao_cntr[operacao_por_navio]),
			        YEAR(dim_calendario[data]) = vUltimoAno &&
			        MONTH(dim_calendario[data]) = vUltimoMes &&
			        DAY(dim_calendario[data]) <= vUltimoDia
			    )
		formatString: 0
		lineageTag: 07a8eb8c-ffee-497a-a484-f86993c16454

	measure 'Navio YTM 2023' =
			
			VAR vUltimaData = MAX(dim_calendario[data])
			VAR vUltimoAno = YEAR(vUltimaData) - 1
			VAR vUltimoDia = DAY(vUltimaData) - 1
			VAR vUltimoMes = MONTH(vUltimaData)
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(aws_movimentacao_cntr[operacao_por_navio]),
			    FILTER(
			        ALL('dim_calendario'),
			        'dim_calendario'[ano_calendario] = vUltimoAno &&
			        'dim_calendario'[data] <= DATE(vUltimoAno, vUltimoMes, vUltimoDia)
			    )
			)
		formatString: 0
		lineageTag: e0d1c8ff-03c5-4870-a645-834e5584f294

	measure 'Qntd navio_ultimo_mes_2024' =
			
			VAR vUltimaData = MAX(dim_calendario[data])
			VAR vUltimoAno = YEAR(vUltimaData)
			VAR vUltimoMes = MONTH(vUltimaData)
			VAR vUltimoDia = DAY(vUltimaData)
			
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(aws_movimentacao_cntr[operacao_por_navio]),
			        YEAR(dim_calendario[data]) = vUltimoAno &&
			        MONTH(dim_calendario[data]) = vUltimoMes &&
			        DAY(dim_calendario[data]) <= vUltimoDia
			    )
		formatString: 0
		lineageTag: 8c8a9f5f-5236-42c7-bf3b-832777799fd2

	measure 'Teus Contagem diária' = ```
			
			VAR vUltimaData = CALCULATE( 
			    MAX(dim_calendario[data]), 
			    ALLSELECTED(dim_calendario)  // Para responder aos filtros visuais aplicados
			)
			VAR vUltimoMesContexto = MONTH(MAXX(ALL(dim_calendario),dim_calendario[data]))
			VAR vUltimoMesContexto2 = MONTH(vUltimaData)
			VAR vUltimoAno = YEAR(vUltimaData)
			
			RETURN
			CALCULATE(
			    [Vol TEU],
			    // Filtro para pegar o volume apenas para o último mês
			    FILTER(
			        dim_calendario, 
			        dim_calendario[numero_mes] = vUltimoMesContexto2
			    ),
			    // Filtro para pegar os últimos três anos, utilizando VALUES para garantir valores únicos por ano
			    FILTER(
			        dim_calendario, 
			        dim_calendario[ano_calendario] IN VALUES(dim_calendario[ano_calendario]) &&
			        dim_calendario[ano_calendario] IN {vUltimoAno, vUltimoAno-1, vUltimoAno-2}
			    ),
			    // Filtro para pegar apenas os dias até o último dia do mês
			    FILTER(
			        dim_calendario, 
			        IF(
			            dim_calendario[numero_mes] = vUltimoMesContexto,
			            DAY(dim_calendario[data]) <= DAY(vUltimaData) - 1,
			            TRUE()
			        )
			    )
			)
			```
		lineageTag: 1a5fa467-d7ac-43a6-a4f9-e16630db8a00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Teus_ultimo_Mes_AnoAnterior = ```
			
			VAR vUltimaData = MAX(dim_calendario[data])
			VAR vUltimoAno = YEAR(vUltimaData) - 1
			VAR vUltimoMes = MONTH(vUltimaData)
			// Adicionado o "- 1" abaixo para alinhar com a outra medida
			VAR vUltimoDia = DAY(vUltimaData) - 1 
			
			RETURN
			    CALCULATE(
			        [Vol TEU],
			        FILTER(
			            ALL(dim_calendario),
			            YEAR(dim_calendario[data]) = vUltimoAno &&
			            MONTH(dim_calendario[data]) = vUltimoMes &&
			            DAY(dim_calendario[data]) <= vUltimoDia
			        )
			    )
			```
		lineageTag: 97703dc8-6b27-432b-a6b8-82c1957a044a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

