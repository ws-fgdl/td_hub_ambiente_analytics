	measure Volume_Manobra_Atual_DataFim =
			
			VAR vUltimaData = MAX('aws_bussola_comercial_mar'[data_do_fim_do_evento])
			VAR vAno = YEAR(vUltimaData)
			VAR vMes = MONTH(vUltimaData)
			
			VAR vVolume =
			    CALCULATE(
			        [Vol_Manobra],
			        FILTER(
			            ALL('dim_calendario'[Data]),
			            YEAR('dim_calendario'[Data]) = vAno &&
			            MONTH('dim_calendario'[Data]) = vMes
			        ),
			        USERELATIONSHIP('dim_calendario'[Data], 'aws_bussola_comercial_mar'[data_do_fim_do_evento])
			    )
			
			RETURN
			    IF(ISBLANK(vVolume), 0, vVolume)
		displayFolder: DataFim
		lineageTag: 615d23b1-2579-4f8c-8d62-35d33ea30d0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

