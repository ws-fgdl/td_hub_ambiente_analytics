	column Afretamento_Ajustado =
			
			VAR DonoPadronizado = RELATED( Dim_DonoManobra[Dono_Padronizado] )
			VAR OperadorPadronizado = RELATED( dim_operador[operador_padronizado] )
			
			// Limpa a coluna [compartilhada] para evitar erros com "s" minúsculo ou espaços
			VAR CompartilhadaLimpa = UPPER( TRIM( aws_movimentacao_portuaria[compartilhada] ) )
			
			RETURN
			IF(
			    AND(
			        OperadorPadronizado <> DonoPadronizado,
			        CompartilhadaLimpa <> "S"
			    ),
			    "S",
			    "N"
			)
		lineageTag: e2291cf0-51cf-4ade-8182-ed03b47db862
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Localizador = aws_movimentacao_portuaria[navio]&aws_movimentacao_portuaria[data_manobra]
		lineageTag: 188d65c9-0f5c-475e-a7b8-d6ec7e08f184
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Tomador_Ajustada = IF(aws_movimentacao_portuaria[tomador]="",aws_movimentacao_portuaria[pagador],aws_movimentacao_portuaria[tomador])
