	measure 'Fat calculado 2' = ```
			
			VAR vDolar = AVERAGEX(
			        bussola_comercial,
			        SWITCH(TRUE(),
			        //Básicos Transbordo
			                
			                'bussola_comercial'[Precficação USD] = "USD", [Valor Preço Dólar],
			                1
			        )
			    )
			
			RETURN
			
			IF(
			AND(ISINSCOPE('bussola_comercial'[servico]),SELECTEDVALUE(bussola_comercial[Agrupamento Subgrupo Princing]) <> "Fiel Depósito"),
			[Price] * IF(vDolar=BLANK(),1,vDolar) *
			[Volume/Qtd.] //Quantidade
			,
			BLANK() // Retorna em branco caso contrário
			)
