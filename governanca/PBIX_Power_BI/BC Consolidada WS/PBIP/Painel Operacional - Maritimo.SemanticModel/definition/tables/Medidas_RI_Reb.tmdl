	measure Manobras_Contagem_diária = ```
			
			// 1. Descobre a última data de carga da base
			VAR vUltimaData = CALCULATE( MAX('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[DT_OPER]), REMOVEFILTERS() )
			VAR vUltimoMes = MONTH(vUltimaData)  
			VAR vUltimoDia = DAY(vUltimaData)    
			VAR vUltimoAno = YEAR(vUltimaData)   
			
			RETURN
			CALCULATE(
			    [Vol_Manobra],
			    KEEPFILTERS(
			        FILTER(
			            ALL('_Tempo'), 
			            
			            // Regra 1: Pega apenas os 3 anos desejados
			            YEAR('_Tempo'[data]) IN {vUltimoAno, vUltimoAno-1, vUltimoAno-2} &&
			            
			            // Regra 2: A Mágica do Total
			            (
			                // Se for o mês da última carga (ex: Maio), trava no dia da carga (ex: <= 17)
			                (MONTH('_Tempo'[data]) = vUltimoMes && DAY('_Tempo'[data]) <= vUltimoDia)
			                ||
			                // OU, se for qualquer outro mês do passado, deixa passar todos os dias livremente
			                (MONTH('_Tempo'[data]) <> vUltimoMes)
			            )
			        )
			    )
			)
			
			// Manobras_Contagem_diária = 
			// // 1. Encontra a última data na base para servir de referência
			// VAR vUltimaData = CALCULATE( 
			//     MAX('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[DT_OPER]), 
			//     REMOVEFILTERS('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC') 
			// )
			// VAR vUltimoMes = MONTH(vUltimaData)
			// VAR vUltimoAno = YEAR(vUltimaData)
			// VAR vUltimoDia = DAY(vUltimaData)
			
			// RETURN
			// CALCULATE(
			//     [Vol_Manobra],
			    
			//     // 2. KEEPFILTERS garante que a matriz não fique com o mesmo número repetido
			//     KEEPFILTERS(
			//         FILTER(
			//             ALL('_Tempo'), 
			//             // Pega apenas o mês atual da última carga
			//             MONTH('_Tempo'[data]) = vUltimoMes &&
			            
			//             // Pega o ano atual e os dois anteriores
			//             YEAR('_Tempo'[data]) IN {vUltimoAno, vUltimoAno-1, vUltimoAno-2} &&
			            
			//             // Trava para não mostrar dias no futuro (além da última carga)
			//             DAY('_Tempo'[data]) <= vUltimoDia
			//         )
			//     )
			// )
			```
		lineageTag: b4cdb563-1c1a-47c7-9258-6d11bfec3644

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ExibirAnoMesMaisRecente = ```
			
			VAR UltimaData = CALCULATE(MAX('aws_bussola_comercial_mar'[competencia]), ALL('aws_bussola_comercial_mar'))
			VAR UltimoAno = YEAR(UltimaData)
			VAR UltimoMes = MONTH(UltimaData)
			VAR UltimoDia = DAY(UltimaData)
			
			RETURN 
			    IF(
			        CALCULATE(
			            COUNTROWS('aws_bussola_comercial_mar'),
			            FILTER(
			                'aws_bussola_comercial_mar',
			                'aws_bussola_comercial_mar'[competencia] <= DATE(UltimoAno, UltimoMes, UltimoDia)
			                )
			        ) > 0,
			        1,
			        0
			    )
			```
		formatString: 0
		lineageTag: 806e9d60-3339-4759-87b8-0d34f9be467c

