table aws_pmvpmr
	lineageTag: 947ae10b-318e-41b9-b62d-7b9ebdb25f09

	column UN = ```
			
			// A coluna UN é criada para classificar os códigos de empresa SAP em diferentes unidades de negócio (UN).
			SWITCH(
			    TRUE(),  // Inicia a função SWITCH, permitindo avaliar várias condições.    
			    aws_pmvpmr[cod_empr_sap] = "W014", "REB",  
			    aws_pmvpmr[cod_empr_sap] = "W015", "TRG",
			    aws_pmvpmr[cod_empr_sap] = "W017", "TSC",    
			    aws_pmvpmr[cod_empr_sap] = "W018", "TSV",
			    BLANK() // Se nenhum dos códigos acima corresponder, retorna BLANK() (valor em branco).
			)
			```
		lineageTag: 50dc2ed5-bd67-4239-a743-3ad4c70c34ab
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

