	measure PMO_Media_Dias_Atraso =
			
			CALCULATE(
			    AVERAGE(aws_aging[DIAS_ATRASO]),
			    aws_aging[DIAS_ATRASO] > 0
			)
		formatString: 0
		lineageTag: e3c5ab69-1167-4f6a-b258-7becad8c4afd

