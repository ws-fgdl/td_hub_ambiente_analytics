table aws_movimentacao_portuaria
	lineageTag: 91efb2e5-6b3e-4a25-b812-4001d757bd20

	measure PrecoMedio_TESTE =
			
			DIVIDE(
			    [FaturamentoTIF_TESTE],
			    [VolumeTIF_TESTE],
			    0
			)
		lineageTag: 78138b93-b63e-4aab-ae89-b134c0cdf42c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FaturamentoTIF_TESTE = SUM(aws_movimentacao_portuaria[Valor_Faturado_tif])
		lineageTag: b74d5e65-f5fe-4bc0-b60e-6f0bf81836be

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure VolumeTIF_TESTE = SUM(aws_movimentacao_portuaria[Volume])
		formatString: 0
		lineageTag: 5a13b126-18a2-4c32-a463-8ca69a9cfaeb

	measure RankingHistoricoTIF_TESTE =
			
			RANKX(
			    ALL(
			        aws_movimentacao_portuaria[DONA]
			    ),
			    [FaturamentoTIF_TESTE]
			)
		formatString: 0
		lineageTag: ac32d04c-6510-41cd-ae5a-42ad72a6fdd2

