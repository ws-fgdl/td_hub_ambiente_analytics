	measure Vol_YTM_AnoAtual = ```
			
			VAR vUltimaData = MAX('dim_calendario'[data]) // Última data presente na base
			RETURN
			CALCULATE(
			    [Vol TEU],
			    FILTER(
			        ALL('dim_calendario'),
			        'dim_calendario'[ano_calendario] = YEAR(vUltimaData) && // Filtro para o ano anterior
			        'dim_calendario'[data] <= DATE(YEAR(vUltimaData), 
			        MONTH(vUltimaData), 
			        DAY(vUltimaData)) // Filtro para o dia correspondente ao último dia presente na base, mas no ano anterior
			    )
			)
			```
		lineageTag: 8bc0fb5d-e94f-4ce7-8463-0cc28ba52630

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Vol_YTM_AnoAnterior = ```
			
			VAR vUltimaData = MAX('dim_calendario'[data]) // Última data presente na base
			RETURN
			CALCULATE(
			    [Vol TEU],
			    FILTER(
			        ALL('dim_calendario'),
			        'dim_calendario'[ano_calendario] = YEAR(vUltimaData) - 1 && // Filtro para o ano anterior
			        'dim_calendario'[data] <= DATE(YEAR(vUltimaData) - 1, 
			        MONTH(vUltimaData), 
			        DAY(vUltimaData)) // Filtro para o dia correspondente ao último dia presente na base, mas no ano anterior
			    )
			)
			
			```
		lineageTag: c6739534-5968-4311-b2af-80f9f42df465

		annotation PBI_FormatHint = {"isGeneralNumber":true}

