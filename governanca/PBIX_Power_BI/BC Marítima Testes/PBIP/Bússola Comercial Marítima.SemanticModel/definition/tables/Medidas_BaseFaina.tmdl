		formatString: 0
		lineageTag: 8f4f8efd-2c0c-46fe-8e95-2a2fcfd57069

	measure Faturamento_YTD_BaseFaina =
			
			VAR DataMax = MAX('Dim_calendario'[data])
			VAR AnoAtual = YEAR(DataMax)
			
			RETURN
			CALCULATE(
			    [Flag_Faturamento_BaseFaina],
			    FILTER(
			        ALL('Dim_calendario'),
			        'Dim_calendario'[ano_calendario] = AnoAtual &&
			        'Dim_calendario'[data] <= DataMax
			    )
			)
		lineageTag: 5da5c1d7-6762-4e60-885d-03142a01b684

		annotation PBI_FormatHint = {"isGeneralNumber":true}

