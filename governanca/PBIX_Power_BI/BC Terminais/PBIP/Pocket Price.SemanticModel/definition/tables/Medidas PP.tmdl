			```
		formatString: 0
		displayFolder: Backup/Teste
		lineageTag: 782dedf3-5be6-499c-a4bc-05ceea6b2614

	measure 'Dias P1 Simulado 2' = ```
			
			VAR _freetime_param =
			    CALCULATE ( [#Param Dias Freetime (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			VAR _dias_isencao_param =
			    CALCULATE ( [#Param Dias Isenção (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			VAR _perc_cheio =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Cheio (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			VAR _perc_vazio =
			    CALCULATE ( [#Param % ajuste volume Arm Cntr Vazio (selecionado)], REMOVEFILTERS ( bussola_comercial ) )
			
			RETURN
			SUMX (
			    bussola_comercial,
			    VAR _un = bussola_comercial[un]
			    VAR _sub = bussola_comercial[Agrupamento Subgrupo Princing]
			    VAR _p1 = bussola_comercial[periodo1_contrato]
			
			    VAR _is_trg = _un = "TRG"
			    VAR _is_tsv = _un = "TSV"
			
			    VAR _is_cheio = _sub IN { "Armazenagem Cntr Cheio", "Armazenagem Cntr Cheio BT" }
			    VAR _is_vazio = _sub IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT" }
			
			    /* --------- 1) Volume simulado (freetime / isenção / %) --------- */
			    VAR _dias_servico = COALESCE ( bussola_comercial[dias_servico], 0 )
			    VAR _ft_real = COALESCE ( bussola_comercial[dias_free_time], 0 )
			    VAR _isenc_real = COALESCE ( bussola_comercial[dias_isencao], 0 )
			
			    VAR _freetime = IF ( ISBLANK ( _freetime_param ), _ft_real, _freetime_param )
			    VAR _dias_isencao = IF ( ISBLANK ( _dias_isencao_param ), _isenc_real, _dias_isencao_param )
			
			    VAR _dias_servico_ajustado =
			        IF (
			            _dias_servico <= _freetime,
			            0,
			            IF ( _dias_isencao >= _dias_servico, 0, _dias_servico - _dias_isencao )
			        )
			
			    VAR _perc =
			        SWITCH (
			            TRUE(),
			            _is_vazio, COALESCE ( _perc_vazio, 0 ),
			            _is_cheio, COALESCE ( _perc_cheio, 0 ),
			            0
			        )
			
			    VAR _volume_simulado = ROUND ( _dias_servico_ajustado * ( 1 + _perc ), 0 )
			
			    /* --------- 2) Regra ESPELHO do seu periodo1 (coluna) --------- */
			
			    // Caso 1: TRG + Cheio -> MIN(volume, periodo1) (ou volume se periodo1 blank)
			    VAR _caso_trg_cheio = _is_trg && _is_cheio
			
			    RETURN
			        IF (
			            _caso_trg_cheio,
			            IF ( ISBLANK ( _p1 ), _volume_simulado, MIN ( _volume_simulado, _p1 ) ),
			
			            // Caso 2: Vazios (e também Cheio fora do TRG, como você colocou no IN)
			            IF (
			                _sub IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT", "Armazenagem Cntr Cheio", "Armazenagem Cntr Cheio BT" },
			                IF (
			                    ISBLANK ( _p1 ),
			                    _volume_simulado,
			                    IF ( _volume_simulado <= _p1, IF ( _volume_simulado > 0, 1, 0 ), 1 )
			                ),
			                BLANK()
			            )
			        )
			)
			
			```
		displayFolder: Dias Simulado
		lineageTag: 65919211-f080-4e2c-ae41-95bb48d28565

