	measure Resultado_Volume = [Receita_Liquida] + [Custo_Alocado_Volume]
		lineageTag: b37ec345-1b77-47a3-8bb9-d58c8026a572

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Margem_Volume_% = ```
			
			DIVIDE(
			    [Resultado_Volume], 
			    [Receita_Liquida], 
			    0
			)
			```
		formatString: 0.0%;-0.0%;0.0%
