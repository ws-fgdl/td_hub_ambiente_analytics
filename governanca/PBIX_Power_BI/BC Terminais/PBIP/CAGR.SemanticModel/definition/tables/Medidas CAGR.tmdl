	measure 'IGPM Período' = ```
			
			VAR ano = YEAR(MAX(Calendario1[Date]))
			VAR MES = MONTH(MAXX(ALL(Calendario1),Calendario1[Date]))
			VAR ano2 = YEAR(MAXX(ALL(Calendario1[Date]), Calendario1[Date]))
			var ipca_dezembro = CALCULATE(
			    MAX('df_indices_mercado'[Acum. 12 meses IGPM]), 
			    MONTH(Calendario1[Date]) = SELECTEDVALUE('Meses CAGR'[Número do Mês]) && YEAR(Calendario1[Date]) = ano
			)
			return 
			ipca_dezembro
			// if( ipca_dezembro = BLANK(), 
			// 3.53/100, ipca_dezembro)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Índices
		lineageTag: 868d6a3c-384f-4085-9c8e-2cac05239104

