	measure FaturamentoTIF_Arvore_BaseMovimentacao =
			
			sum(
			    aws_movimentacao_portuaria[valor_tif]
			)
		lineageTag: e5afbe15-ee0c-4d57-ad58-47043cfcc4f4

		formatStringDefinition = ```
				-- 1. CÁLCULO DA PORCENTAGEM (Sua lógica de hierarquia)
				VAR vValorAtual = SELECTEDMEASURE()
				
				VAR vValorTotal = 
				    SWITCH( TRUE(),
				        ISINSCOPE(Dim_Operador[Operador_Demais]), 
				        CALCULATE(SELECTEDMEASURE(), ALLSELECTED(Dim_Operador[Operador_Demais])),
				
				        ISINSCOPE(Dim_DonoManobra[Dono_Demais]), 
				        CALCULATE(SELECTEDMEASURE(), ALLSELECTED(Dim_DonoManobra[Dono_Demais])),
				
				        CALCULATE(SELECTEDMEASURE(), ALLSELECTED())
				    )
				
				VAR vPerc = DIVIDE(vValorAtual, vValorTotal)
				VAR vPercTexto = " (" & FORMAT(vPerc, "0.00%") & ")" -- Ex: " (12.50%)"
				
				-- 2. LÓGICA DE ESCALA (K, M, B) E NEGATIVOS
				VAR vValorAbs = ABS(vValorAtual)
				
				RETURN
				    SWITCH( TRUE(),
				        vValorAbs >= 1000000000, 
				            "$ #,##0,,,.0 ""B" & vPercTexto & """;-$ #,##0,,,.0 ""B" & vPercTexto & """",        
				        vValorAbs >= 1000000,    
				            "$ #,##0,,.0 ""M" & vPercTexto & """;-$ #,##0,,.0 ""M" & vPercTexto & """",        
				        vValorAbs >= 1000,       
				            "$ #,##0,.0 ""K" & vPercTexto & """;-$ #,##0,.0 ""K" & vPercTexto & """",        
				        -- Para valores menores que 1000
				        "$ #,##0""" & vPercTexto & """;-$ #,##0""" & vPercTexto & """"
				    )
				```

	measure %_tug_fleet =
			
