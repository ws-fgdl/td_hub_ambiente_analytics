	column grupo_economico_ter =
			
			
			LOOKUPVALUE(dim_carteira_comercial[grupo_economico],
			dim_carteira_comercial[codigo_sap],
			contratos[cod_cliente_sap]
			)
		lineageTag: bdd42115-a091-4dc4-ab72-53b08554de6b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Agrupamento Subgrupo Princing' = ```
			LOOKUPVALUE(
			    'dim_servico'[Sub Grupo Pricing],
			    'dim_servico'[id_servico],
			    contratos[chave]
			    
			    )
			```
		lineageTag: d952f3fd-fc87-4349-a27d-00bd6d4e9f47
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column id_mod_ano = contratos[Agrupamento Subgrupo Princing]&YEAR(contratos[inicio_vigencia])
