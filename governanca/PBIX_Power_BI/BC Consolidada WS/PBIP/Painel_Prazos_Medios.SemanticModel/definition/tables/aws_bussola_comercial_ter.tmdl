	column Chave_pmf = ```
			
			VAR Prefixo = 
			    SWITCH(
			        TRUE(),
			        aws_bussola_comercial_ter[un] = "TRG", "W015",
			        aws_bussola_comercial_ter[un] = "TSV", "W018"
			    )
			RETURN
			    IF(
			        ISBLANK(Prefixo),
			        BLANK(),
			        Prefixo & 
			        YEAR(aws_bussola_comercial_ter[competencia]) & 
			        aws_bussola_comercial_ter[n_doc_nf]
			    )
			```
		lineageTag: 8424756e-5ba5-429f-bbf6-e410ed3e77bb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

