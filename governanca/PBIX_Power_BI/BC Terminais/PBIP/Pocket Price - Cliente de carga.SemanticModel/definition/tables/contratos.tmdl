	column 'Contagem de Repetições' =
			
			COUNTROWS(
			    FILTER(
			        'contratos',
			        'contratos'[cod_contrato] = EARLIER('contratos'[cod_contrato])
			    )
			)
		formatString: 0
		lineageTag: 983f1354-f0f5-4607-bcdc-9f697a7b0b12
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

