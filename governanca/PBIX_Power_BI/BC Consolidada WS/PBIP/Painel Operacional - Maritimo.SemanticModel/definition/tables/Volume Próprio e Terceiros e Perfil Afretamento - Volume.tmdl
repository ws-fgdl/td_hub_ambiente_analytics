	measure 'Var Volume' = EXTERNALMEASURE("Var Volume", DOUBLE, "DirectQuery para AS – Modelo Rebocadores")
		lineageTag: ce75baf8-98ad-4a73-a261-1bd99061389e
		sourceLineageTag: 5be1bb04-4bea-4784-89a2-fdcf729e9a8c
		dataCategory: Uncategorized

	measure 'Volume Proprio e Terceiros' =
			
			VAR vCompetenciaSelecionada = SELECTEDVALUE('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA])
			
			RETURN
			CALCULATE(
			    SUM('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[VOLUME]),
			    REMOVEFILTERS('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'),
			    KEEPFILTERS(
			        FILTER(
			            ALL('Volume Próprio e Terceiros e Perfil Afretamento - Volume'),
			            DATEDIFF('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[COMPETENCIA], vCompetenciaSelecionada, MONTH) < 13 &&
			            DATEDIFF('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[COMPETENCIA], vCompetenciaSelecionada, MONTH) >= 0
			        )
			    )
			)
		lineageTag: 37dff22b-5f53-4969-8f01-9daea76133e5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume Proprio e Terceiros Mês' =
			
			VAR vCompetenciaSelecionada = SELECTEDVALUE('Volume Próprio e Terceiros e Perfil Afretamento - Competencia'[COMPETENCIA])
			
			RETURN
			CALCULATE(
			    SUM('Volume Próprio e Terceiros e Perfil Afretamento - Volume'[VOLUME]),
			    'Volume Próprio e Terceiros e Perfil Afretamento - Volume'[COMPETENCIA] = vCompetenciaSelecionada
			)
			
			
			
			
