		displayFolder: Faturamento
		lineageTag: 2acd0081-efcf-4d8c-bc62-2f712d59f170

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Periodo1_Ajustado = ```
			
			SUMX (
			    bussola_comercial,
			    VAR _volume = bussola_comercial[volume]
			    VAR rest =
			        _volume
			            - ( _volume - ( _volume - bussola_comercial[periodo1_contrato] ) )
			
			    VAR _resultadoLinha =
			        IF (
			            AND (
			                bussola_comercial[Agrupamento Subgrupo Princing]
			                    IN { "Armazenagem Cntr Cheio" },
			                bussola_comercial[un] = "TRG"
			            ),
			            -- Bloco TRG Cheio
			            IF (
			                ISBLANK ( bussola_comercial[periodo1_contrato] ),
			                _volume,
			                IF (
			                    _volume > bussola_comercial[periodo1_contrato],
			                    bussola_comercial[periodo1_contrato],
			                    _volume
			                )
			            ),
			            -- Bloco Vazios / Cheio genérico
			            IF (
			                bussola_comercial[Agrupamento Subgrupo Princing]
			                    IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT",
			                         "Armazenagem Cntr Cheio" },
			                IF (
			                    ISBLANK ( bussola_comercial[periodo1_contrato] ),
			                    _volume,
			                    IF (
			                        _volume <= bussola_comercial[periodo1_contrato],
			                        IF ( _volume > 0, 1, 0 ),
			                        IF ( rest <= bussola_comercial[periodo1_contrato], 1, 0 )
			                    )
			                ),
			                BLANK ()
			            )
			        )
			    RETURN
			        _resultadoLinha
			)
			
			```
		displayFolder: Dias Simulado
		lineageTag: bfe946ad-0b2c-4a1a-93f5-a5bb5b0c28bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Periodo2_Ajustado = ```
			
			SUMX (
			    bussola_comercial,
			    VAR _volume               = bussola_comercial[volume]
			    VAR _dias_p1_realizado    =
			        IF (
			            _volume > bussola_comercial[periodo1_contrato],
			            bussola_comercial[periodo1_contrato],
			            _volume
			        )
			    VAR _saldo_volume1        = _volume - _dias_p1_realizado
			    VAR rest                  =
			        _volume
			            - ( _volume - ( _volume - bussola_comercial[periodo1_contrato] ) )
			    VAR rest2                 = rest - ( rest - bussola_comercial[periodo2_contrato] )
			    VAR _sub_grupo_princing   = bussola_comercial[Agrupamento Subgrupo Princing]
			
			    VAR _is_trg_armador =
			        bussola_comercial[un] = "TRG"
			            && CONTAINSSTRING ( bussola_comercial[servico], "EXP" )
			
			    VAR _is_trg_carga =
			        bussola_comercial[un] = "TRG"
			            && CONTAINSSTRING ( bussola_comercial[servico], "IMP" )
			            && RELATED ( salesforce[Armador/Cliente Carga] ) = "Cliente Carga"
			
			    VAR _is_trg_vazio =
			        bussola_comercial[un] = "TRG"
			            && _sub_grupo_princing
			                IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT" }
			
			    VAR _is_tsv_armador =
			        bussola_comercial[un] = "TSV"
			            && RELATED ( salesforce[Armador/Cliente Carga] ) = "Armador"
			
			    VAR _is_tsv_carga =
			        bussola_comercial[un] = "TSV"
			            && CONTAINSSTRING ( bussola_comercial[servico], "IMP" )
			            && RELATED ( salesforce[Armador/Cliente Carga] ) = "Cliente Carga"
			
			    VAR _resultadoLinha =
			        SWITCH (
			            TRUE (),
			
			            -- TSV Armador
			            _is_tsv_armador, IF ( _saldo_volume1 > 0, 1, 0 ),
			
			            -- TRG Vazio
			            _is_trg_vazio,
			                ROUNDUP (
			                    DIVIDE ( _saldo_volume1, bussola_comercial[periodo2_contrato] ),
			                    0
			                ),
			
			            -- TRG Cheio (Armador)
			            _is_trg_armador, _saldo_volume1,
			
			            -- TRG Carga
			            _is_trg_carga,
			                IF (
			                    _saldo_volume1 > bussola_comercial[periodo2_contrato],
			                    bussola_comercial[periodo2_contrato],
			                    _saldo_volume1
			                ),
			
			            -- TSV Carga
			            _is_tsv_carga && _saldo_volume1 > 0, 1,
			
			            -- Default
			            BLANK ()
			        )
			    RETURN
			        _resultadoLinha
			)
			
			```
		displayFolder: Dias Simulado
		lineageTag: 372fabad-8203-4ef9-a215-f6b04a97ee13

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Periodo3_Ajustado = ```
			
			SUMX (
			    bussola_comercial,
			    VAR _volume      = bussola_comercial[volume]
			
			    VAR rest =
			        _volume
			            - ( bussola_comercial[periodo1_contrato]
			                + bussola_comercial[periodo2_contrato] )
			
			    VAR rest2 =
			        _volume
			            - ( bussola_comercial[periodo1] + bussola_comercial[periodo2] )
			
			    VAR _DIAS_P1_REALIZADO =
			        IF (
			            _volume > bussola_comercial[periodo1_contrato],
			            bussola_comercial[periodo1_contrato],
			            _volume
			        )
			
			    VAR _SALDO_VOLUME_P1 = _volume - _DIAS_P1_REALIZADO
			
			    VAR _DIAS_P2_REALIZADO =
			        IF (
			            _volume <= bussola_comercial[periodo1_contrato],
			            0,
			            IF (
			                bussola_comercial[periodo2_contrato] < _SALDO_VOLUME_P1,
			                bussola_comercial[periodo2_contrato],
			                _SALDO_VOLUME_P1
			            )
			        )
			
			    VAR _SALDO_VOLUME_P2 =
			        _volume - _DIAS_P1_REALIZADO - _DIAS_P2_REALIZADO
			
			    VAR _is_trg_carga =
			        bussola_comercial[un] = "TRG"
			            && CONTAINSSTRING ( bussola_comercial[servico], "IMP" )
			            && RELATED ( salesforce[Armador/Cliente Carga] ) = "Cliente Carga"
			
			    VAR _is_tsv = bussola_comercial[un] = "TSV"
			
			    VAR _resultadoLinha =
			        IF (
			            -- TRG Carga
			            _is_trg_carga,
			                IF (
			                    _SALDO_VOLUME_P2 <= bussola_comercial[periodo3_contrato],
			                    _SALDO_VOLUME_P2,
			                    bussola_comercial[periodo3_contrato]
			                ),
			
			            -- TSV
			            IF (
			                _is_tsv,
			                IF (
			                    _SALDO_VOLUME_P2 > 0,
			                    ROUNDUP (
			                        DIVIDE ( _SALDO_VOLUME_P2, bussola_comercial[periodo3_contrato] ),
			                        0
			                    ),
			                    0
			                ),
			                -- Fallback original
			                IFERROR (
			                    IF (
			                        AND (
			                            bussola_comercial[Agrupamento Subgrupo Princing]
			                                IN { "Armazenagem Cntr Cheio" },
			                            bussola_comercial[un] = "TRG"
			                        ),
			                        IF ( rest2 < 0, 0, rest2 ),
			                        IF (
			                            bussola_comercial[Agrupamento Subgrupo Princing]
			                                IN { "Armazenagem Cntr Vazios",
			                                     "Armazenagem Cntr Vazios BT",
			                                     "Armazenagem Cntr Cheio" },
			                            IF (
			                                bussola_comercial[periodo2] > 1,
			                                BLANK (),
			                                ROUNDUP (
			                                    IF (
			                                        rest > 0,
			                                        rest
			                                            / ROUNDUP (
			                                                IF (
			                                                    ISBLANK ( bussola_comercial[periodo3_contrato] ),
			                                                    IF (
			                                                        ISBLANK ( bussola_comercial[periodo2_contrato] ),
			                                                        bussola_comercial[periodo1_contrato],
			                                                        bussola_comercial[periodo2_contrato]
			                                                    ),
			                                                    bussola_comercial[periodo3_contrato]
			                                                ),
			                                                0
			                                            ),
			                                        0
			                                    ),
			                                    0
			                                )
			                            ),
			                            0
			                        )
			                    ),
			                    0
			                )
			            )
			        )
			    RETURN
			        _resultadoLinha
			)
			
			```
