				  "kind": 2
				}

		annotation SummarizationSetBy = Automatic

	column 'Volume Pedido'
		isHidden
		formatString: 0
		lineageTag: 59e5cd24-596b-4b78-a8cc-3faae6e6d095
		summarizeBy: sum
		sourceColumn: [Value3]

		annotation SummarizationSetBy = Automatic

	partition pVolume = calculated
		mode: import
		source =
				{
				    ("Portcalls", NAMEOF('Medidas_BaseBC.'[Contagem_Portcall_BaseBC]), 0),
				    ("Tugboats", NAMEOF('Medidas_BaseBC.'[VolumeManobra_BaseBC]), 1)
				}

	annotation PBI_Id = e8436ba59c0e4f67b49f88f16032fcbe

