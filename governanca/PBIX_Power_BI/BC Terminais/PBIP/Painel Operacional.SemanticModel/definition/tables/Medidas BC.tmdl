	measure 'IPCA Acum 12m' = ```
			
			 VAR  IPCA12m = CALCULATE(
			        PRODUCTX(
			            FILTER(
			                ALL(Calendario1[Date].[Date]),
			                Calendario1[Date].[Date] <= MAX(Calendario1[Date])
			            ),
			            (1+[IPCA SUM]/100)
			        )-1,
			        DATEADD(Calendario1[Date],-1,YEAR))
			RETURN
			IF(IPCA12m = 0,BLANK(),IPCA12m)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c9435465-8fdc-45bb-936f-bd6ca6e45f42

