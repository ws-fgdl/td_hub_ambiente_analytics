	measure Escala_BaseFaina =
			
			CALCULATE(
			    DISTINCTCOUNT(aws_bussola_comercial_faina[evento]),
			    Dim_Servico[Servico_Padronizado] = "MANOBRA DE ATRACACAO"
			)
		formatString: 0
		lineageTag: 7f84e601-0177-4570-a0ac-90de609f2423

	measure FaturamentoUSD_Ref_BaseFaina = SUM(aws_bussola_comercial_faina[val_tab_ref])
		lineageTag: 4b6380e7-28f5-44cb-a5f5-f4d151d0ffc0

		formatStringDefinition = ```
				VAR Valor = SELECTEDMEASURE()
				VAR ValorAbs = ABS(Valor) -- Analisamos o "tamanho" do número independente do sinal
				VAR Selecao = SELECTEDVALUE(Flag_faturamento[Faturamento])
				VAR Prefixo = IF(Selecao = "R$", "R$ ", "$ ")
				
				RETURN
				    SWITCH( TRUE(),
				        ValorAbs >= 1000000000, 
				            Prefixo & "#,##0,,,.0 ""B"";-" & Prefixo & "#,##0,,,.0 ""B""",
				        
				        ValorAbs >= 1000000,    
				            Prefixo & "#,##0,,.0 ""M"";-" & Prefixo & "#,##0,,.0 ""M""",
				        
				        ValorAbs >= 1000,       
				            Prefixo & "#,##0,.0 ""K"";-" & Prefixo & "#,##0,.0 ""K""",
				        
				        -- Para valores entre -999 e 999
				        Prefixo & "#,##0;-" & Prefixo & "#,##0"
				    )
				```

	measure Avg_Tugs_YTD =
			
			DIVIDE(
			    [VolumeManobra_YTD_BaseFaina],
			    [Escala_YTD_BseFaina],
			    0
			)
		lineageTag: 332f0843-9f14-4ef0-a001-cc957b2c209d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FaturamentoUSD_Sort_MSC_BaseBC = ```
			
			VAR FaturamentoReal = [Faturamento_YTD_BaseFaina] // Use a sua medida de Faturamento aqui
			VAR ClienteAtual = SELECTEDVALUE(Dim_Cliente[Grupo Econômico]) // Coloque a coluna de nome do cliente aqui
			VAR EhMSC = CONTAINSSTRING(UPPER(ClienteAtual), "MSC")
			
			RETURN
			IF(
			    EhMSC, 
			    FaturamentoReal + 999999999999, // Adiciona trilhões para garantir o 1º lugar
			    FaturamentoReal // Para os outros, mantém o valor normal
			)
			```
		lineageTag: f1095dd5-2330-4891-9449-64521337cae7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FaturamentoPTAX_BaseFaina = SUM(aws_bussola_comercial_faina[valor_ptax])
		lineageTag: 4fcd8b78-2476-49d3-b293-9a3a908ce7d0

