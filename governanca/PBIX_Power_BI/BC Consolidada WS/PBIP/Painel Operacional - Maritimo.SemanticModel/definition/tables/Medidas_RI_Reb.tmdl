table Medidas_RI_Reb
	lineageTag: e1d15099-acd7-4445-a29c-629caf3a4bfd

	measure Vol_Manobra = SUM('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[RL_DW_FATO_CUBO_REBOC_VOLUME.VOLUME])
		formatString: #,0
		lineageTag: b587a68c-3590-49bf-b0f7-db91662936d0

	measure Volume_Manobra_Atual =
			
			VAR vUltimaData = MAX('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[DT_OPER])
			VAR vUltimoAno = YEAR(vUltimaData)
			VAR vUltimoMes = MONTH(vUltimaData)
			
			RETURN
			    CALCULATE(
			        [Vol_Manobra],
			            YEAR(_Tempo[data]) = vUltimoAno &&
			            MONTH(_Tempo[data]) = vUltimoMes
			        )
		formatString: 0
		displayFolder: Competencia
		lineageTag: c7b1c2df-0a43-4ca1-a685-f914f63c7d40

	measure Volume_Manobra_Mes_Atual_AnoAnterior = ```
			
			VAR vUltimaData = MAX('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[DT_OPER])
			VAR vUltimoAnoAnterior = YEAR(vUltimaData) - 1
			VAR vInicioMesAnoAnterior = DATE(vUltimoAnoAnterior, MONTH(vUltimaData), 1)
			
			RETURN
			    CALCULATE(
			        [Vol_Manobra],
			        FILTER(
			            ALL(_Tempo),
			            _Tempo[data] >= vInicioMesAnoAnterior &&
			            _Tempo[data] <= EDATE(vUltimaData, -12)
			        )
			    )
			
			```
		formatString: #,0
		displayFolder: Competencia
		lineageTag: bdae0b99-80fa-4ab5-9ba1-2a159e12df38

	measure VolManobra_X_MediaDWT = ```
			
			SUMX( 
			    -- Itera apenas sobre as faixas únicas, o que é muito mais rápido do que iterar a tabela inteira
			    VALUES('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[FAIXA_DWT]), 
			    
			    VAR FaixaAtual = 'CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[FAIXA_DWT]
			    
			    -- Substitui o "-" por "|" para transformar o texto em um "caminho" (path) que o DAX consegue ler
			    VAR StringSubst = SUBSTITUTE(FaixaAtual, "-", "|")
			    
			    -- Extrai o primeiro valor e o segundo valor do texto e os converte para número
			    VAR LimiteInferior = VALUE(TRIM(PATHITEM(StringSubst, 1)))
			    VAR LimiteSuperior = VALUE(TRIM(PATHITEM(StringSubst, 2)))
			    
			    -- Calcula a média da faixa
			    VAR MediaDaFaixa = DIVIDE(LimiteInferior + LimiteSuperior, 2)
			    
			    -- Calcula o volume total especificamente para essa faixa no contexto atual
			    VAR VolumeDaFaixa = CALCULATE(SUM('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[RL_DW_FATO_CUBO_REBOC_VOLUME.VOLUME]))
			    
			    -- Retorna a multiplicação do volume pela média da faixa
			    RETURN 
			    VolumeDaFaixa * MediaDaFaixa
			)
			```
		lineageTag: 25702ef4-7f10-4057-bde6-cd92e071d96d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Soma_VolManobra_X_MediaDWT =
			
			// Esta medida calcula a soma do produto de 'VolManobra_X_MediaDWT' para cada linha na tabela 'aws_bussola_comercial'
			SUMX('aws_bussola_comercial_mar', [VolManobra_X_MediaDWT])
		lineageTag: 228249f4-5896-45c3-aec0-f836907ab3af

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Resultado_Volume_Media = ```
			
			DIVIDE(
			    -- Numerador: Medida ajustada que já faz a ponderação correta
			    [VolManobra_X_MediaDWT],  
			    
			    -- Denominador: Soma total do volume no contexto atual
			    SUM('CUBOS_NOVOS - RL_DW_FATO_CUBO_REBOC'[RL_DW_FATO_CUBO_REBOC_VOLUME.VOLUME]),  
			    
			    -- Valor alternativo em caso de erro/divisão por zero
			    0  
			)
			```
		lineageTag: 4f367e86-be2f-4fde-b12c-a303ba2bfa24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

