		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Faturamento Simulado Carga 2' = ```
			
			// Parâmetros de freetime
			VAR _freetime_param_default           = [Valor #Freetime]
			VAR _freetime_param_vazio_imp         = [#Param Dias Freetime Vazio Imp (selecionado)]
			VAR _freetime_param_vazio_exp         = [#Param Dias Freetime Vazio Exp (selecionado)]
			// Parâmetros de isenção
			VAR _dias_isencao_param_default       = [Valor #Dias Isenção]
			VAR _dias_isencao_param_vazio_imp     = [#Param Dias Isenção Vazio Imp (selecionado)]
			VAR _dias_isencao_param_vazio_exp     = [#Param Dias Isenção Vazio Exp (selecionado)]
			// Parâmetros de ajuste de volume
			VAR _perc_ajuste_volume_cheio         = [Valor #% Ajuste Vlume]
			VAR _perc_ajuste_volume_vazio         = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			VAR _perc_ajuste_cif                  = [Valor #% ajuste CIF Cheio Imp]
			VAR _perc_ajuste_gris                 = [Valor #% GRIS]
			
			// Parâmetros de valor mínimo
			VAR _param_valor_min_p1               = [Valor #Val Min P1]
			VAR _param_valor_min_p2               = [Valor #Val Min P2]
			VAR _param_valor_min_p3               = [Valor #Val Min P3]
			VAR _param_valor_min_p4               = [Valor #Val Min P4]
			
			
			// Parâmetros de cif
			VAR _param_cif_p1                     = [Valor #% CIF por dia P1]
			VAR _param_cif_p2                     = [Valor #% CIF por dia P2]
			VAR _param_cif_p3                     = [Valor #% CIF por dia P3]
			VAR _param_cif_p4                     = [Valor % CIF por dia P4]
			
			
			// Outros parâmetros de ajuste de preços
			VAR _param_valor_ad_ogg               = [Valor #Arm. Cheio Imp - Adicional OOG]
			VAR _param_valor_arm_cheio_imp_ad_carg_especial = [Valor #Arm. Cheio Imp - Adicional Carga Especial] 
			
			
			
			RETURN
			SUMX
			( bussola_comercial
			, // Valores dos campos
			  VAR _un                    = bussola_comercial[un]
			  VAR _tam_container         = bussola_comercial[tamanho_container]
			  VAR _cif                   = bussola_comercial[cif]
			  VAR _imo                   = bussola_comercial[imo]
			  VAR _oog                   = bussola_comercial[oog]
			  VAR _sub_grupo_princing    = bussola_comercial[Agrupamento Subgrupo Princing]
			  VAR _tabela_publica        = bussola_comercial[tabela_publica]
			  VAR _periodo1_contrato     = bussola_comercial[periodo1_contrato]
			  VAR _periodo2_contrato     = bussola_comercial[periodo2_contrato]
			  VAR _periodo3_contrato     = bussola_comercial[periodo3_contrato]
			  VAR _preco1                = COALESCE(bussola_comercial[price_p1], _tabela_publica, 0)
			  VAR _preco2                = COALESCE(bussola_comercial[price_p2], _tabela_publica, 0)
			  VAR _preco3                = COALESCE(bussola_comercial[price_p3], _tabela_publica, 0)
			  VAR _dias_servico          = bussola_comercial[dias_servico]
			  VAR _servico               = bussola_comercial[servico]
			  VAR _volume                = bussola_comercial[volume]
			  VAR _perc_cif_1            = bussola_comercial[perc_cif_periodo1]
			  VAR _perc_cif_2            = bussola_comercial[perc_cif_periodo2]
			  VAR _perc_cif_3            = bussola_comercial[perc_cif_periodo3]
			  VAR _perc_cif_4            = bussola_comercial[perc_cif_periodo4]
			
			  //calculo de contrato_min
			  VAR _valor_min_1           = if(ISBLANK(_param_valor_min_p1), bussola_comercial[valor_minimo_periodo1],_param_valor_min_p1)
			  VAR _valor_min_2           = if(ISBLANK(_param_valor_min_p2), bussola_comercial[valor_minimo_periodo2],_param_valor_min_p2)
			  VAR _valor_min_3           = if(ISBLANK(_param_valor_min_p3), bussola_comercial[valor_minimo_periodo3],_param_valor_min_p3)
			  VAR _valor_min_4           = if(ISBLANK(_param_valor_min_p4), bussola_comercial[valor_minimo_periodo4],_param_valor_min_p4)
			  VAR _periodo1              = bussola_comercial[periodo1]
			  VAR _periodo2              = bussola_comercial[periodo2]
			  VAR _periodo3              = bussola_comercial[periodo3]
			  VAR _periodo4              = bussola_comercial[periodo4]
			  // Variáveis do tipo "flag"
			  VAR _sinalizador_cheio     = _sub_grupo_princing IN {"Armazenagem Cntr Cheio" , "Armazenagem Cntr Cheio BT" }
			  VAR _sinalizador_vazio     = _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			  VAR _sinalizador_vazio_imp = _sinalizador_vazio && CONTAINSSTRING(_servico, "IMP")
			  VAR _sinalizador_vazio_exp = _sinalizador_vazio && CONTAINSSTRING(_servico, "EXP")
			
			  // Para freetime e isenção: se parâmetro estiver em branco, considerar o realizado.
			  VAR _freetime_param =  _freetime_param_default
			    // SWITCH
			    // ( TRUE()
			    // , _sinalizador_vazio_imp, _freetime_param_vazio_imp
			    // , _sinalizador_vazio_exp, _freetime_param_vazio_exp
			    // , _freetime_param_default
			    // )
			  
			  VAR _dias_isencao_param =  _dias_isencao_param_default
			    // SWITCH
			    // ( TRUE()
			    // , _sinalizador_vazio_imp, _dias_isencao_param_vazio_imp
			    // , _sinalizador_vazio_exp, _dias_isencao_param_vazio_exp
			    // , _dias_isencao_param_default
			    // )
			  
			  VAR _freetime     = IF(ISBLANK(_freetime_param)    , bussola_comercial[dias_free_time], _freetime_param)
			  
			  VAR _dias_isencao = IF(ISBLANK(_dias_isencao_param), bussola_comercial[dias_isencao]  , _dias_isencao_param)
			
			  //Parâmetro de dias simulado
			 
			  VAR _is_trg_armador = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			  VAR _is_trg_carga = bussola_comercial[un] = "TRG" && CONTAINSSTRING(bussola_comercial[servico], "IMP")
			 
			  VAR _is_trg_vazio = bussola_comercial[un] = "TRG" && _sub_grupo_princing IN {"Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}
			 
			  VAR _is_tsv_armador = bussola_comercial[un] = "TSV" && CONTAINSSTRING(bussola_comercial[servico], "EXP")
			 
			  VAR _is_tsv_carga = bussola_comercial[un] = "TSV" && CONTAINSSTRING(bussola_comercial[servico], "IMP")
			
			  // Calcular dias de serviço considerando freetime e isenção
			  VAR _dias_servico_ajustado =
			    IF ( _dias_servico <= _freetime
			        , 0
			        , IF ( _dias_isencao > _dias_servico
			            , 0
			            , _dias_servico - _dias_isencao
			            )
			        )
			  // Aplicar ajuste de volume
			  VAR _perc_ajuste_volume = _perc_ajuste_volume_cheio
			  //   SWITCH
			  //   ( TRUE()
			  //   , (_sinalizador_vazio), _perc_ajuste_volume_vazio
			  //   , (_sinalizador_cheio), _perc_ajuste_volume_cheio
			  //   , 0
			  //   )
			  
			  
			  //VAR _volume_simulado =  _dias_servico_ajustado
			  VAR _volume_simulado = ROUND(_dias_servico_ajustado * (1 + _perc_ajuste_volume), 0)
			  
			/* Ajuste Christiano Chamma em 17/12/2025 - não estava utilizando volume_simulado abaixo e sim volume
			  VAR _saldo_volume = _volume - bussola_comercial[periodo1_contrato]
			  VAR _saldo_volume_p3 = _volume - bussola_comercial[periodo1_contrato] - bussola_comercial[periodo2_contrato]
			*/  
			  VAR _saldo_volume_temp = _volume_simulado - bussola_comercial[periodo1_contrato]
			  VAR _saldo_volume = if(_saldo_volume_temp < 0, 0, _saldo_volume_temp)
			  VAR _saldo_volume_p3_temp = _volume_simulado - bussola_comercial[periodo1_contrato] - bussola_comercial[periodo2_contrato]
			  VAR _saldo_volume_p3 = if(_saldo_volume_p3_temp < 0, 0, _saldo_volume_p3_temp)
			
			  VAR _saldo_volume_TSVCarga_temp = _saldo_volume_p3-bussola_comercial[dias_portas_p2]
			  VAR _saldo_volume_TSVCarga = if(_saldo_volume_TSVCarga_temp < 0, 0, _saldo_volume_TSVCarga_temp)
			
			
			VAR _dias_p1_simulado =
			
			SWITCH(
			    TRUE(),
			        //Filtro TSV Armador e TSV Carga
			         _is_tsv_carga, 1,
			
			        //Filtro TRG Cheio e TRG Carga   
			        _is_trg_carga ,IF(_volume_simulado > _periodo1_contrato, _periodo1_contrato, _volume_simulado),
			
			        //ELSE
			        0)
			
			
			  VAR _dias_p2_simulado =
			    
			    SWITCH(
			      TRUE(),
			
			        //Filtro TRG Carga
			        _is_trg_carga, IF(_saldo_volume > _periodo2_contrato, _periodo2_contrato, _saldo_volume),
			     
			        //Filtro de TSV Carga
			          _is_tsv_carga && _saldo_volume > bussola_comercial[periodo1_contrato] + bussola_comercial[dias_portas_p1],1,0)
			
			/* Ajuste Christiano Chamma em 17/12/2025 - ver OS 32589553 deveria dar 1 no dias_periodo3 e estava dando 0
			  VAR _dias_p3_simulado =
			
			    SWITCH(
			      TRUE();
			
			      //Filtro TRG Carga
			      _is_trg_carga; IF(_saldo_volume_p3 > _periodo3_contrato; _periodo3_contrato; 0);
			
			      //Filtro de TSV Carga
			        _is_tsv_carga && _saldo_volume_TSVCarga > 0;ROUNDUP(DIVIDE(_saldo_volume_TSVCarga;_periodo3_contrato);0)) */       
			  VAR _dias_p3_simulado =
			
			    SWITCH(
			      TRUE(),
			
			      //Filtro TRG Carga
			      _is_trg_carga, IF(_saldo_volume_p3 > _periodo3_contrato, _periodo3_contrato, _saldo_volume_p3),
			
			      //Filtro de TSV Carga
			        _is_tsv_carga && _saldo_volume_TSVCarga > 0,ROUNDUP(DIVIDE(_saldo_volume_TSVCarga,_periodo3_contrato),0))
			
			/* Ajuste Christiano Chamma em 17/12/2025 - não estava utilizando volume_simulado abaixo e sim volume
			  VAR _saldo_volume_TRG = [volume] -_periodo1_contrato - _periodo2_contrato - _periodo3_contrato
			*/
			  VAR _saldo_volume_TRG_temp = _volume_simulado -_periodo1_contrato - _periodo2_contrato - _periodo3_contrato
			  VAR _saldo_volume_TRG = if(_saldo_volume_TRG_temp < 0, 0, _saldo_volume_TRG_temp)
			  
			//Foi criada ontem 02/02/2025
			
			    VAR _dias_p4_simulado = IF(_saldo_volume_TRG > 0, _saldo_volume_TRG, 0)
			  
			    VAR _cif_simulado = _cif * (1 + _perc_ajuste_cif + _perc_ajuste_gris)
			
			    VAR _min_contrato_simulado =    
			       IF(_periodo4 > 0, _valor_min_4, IF(_periodo3 > 0 , _valor_min_3, IF(_periodo2 > 0, _valor_min_2, _valor_min_1)))
			
			       VAR _cif_total_simulado = _cif_simulado  * ((_dias_p1_simulado * IF(ISBLANK(_param_cif_p1), _perc_cif_1,_param_cif_p1)) + (_dias_p2_simulado * IF(ISBLANK(_param_cif_p2),_perc_cif_2,_param_cif_p2)) + (_dias_p3_simulado * IF(ISBLANK(_param_cif_p3),_perc_cif_3,_param_cif_p3)) + ( _dias_p4_simulado * IF(ISBLANK(_param_cif_p4),_perc_cif_4,_param_cif_p4)))
			
			    VAR _cif_simu_add = _cif_total_simulado * (1 + IF(_oog = "SIM", COALESCE(_param_valor_ad_ogg,bussola_comercial[Adic_oog]), 0) + IF( _imo = "SIM", COALESCE(_param_valor_arm_cheio_imp_ad_carg_especial,bussola_comercial[Adic_carga_especial]),0))
			
			    VAR _faturamento_simulado = IF(_dias_servico_ajustado <= 0,
			0,
			IF(_cif_simu_add > _min_contrato_simulado, _cif_simu_add, _min_contrato_simulado))
			 
			  VAR teste = 
			_cif_simulado  * ((0 * _dias_p1_simulado * IF(ISBLANK(_param_cif_p1), _perc_cif_1,_param_cif_p1)) + (0 * _dias_p2_simulado * IF(ISBLANK(_param_cif_p2),_perc_cif_2,_param_cif_p2)) + (1 * _dias_p3_simulado * IF(ISBLANK(_param_cif_p3),_perc_cif_3,_param_cif_p3)) + (0 * _dias_p4_simulado * IF(ISBLANK(_param_cif_p4),_perc_cif_4,_param_cif_p4)))
			
			 RETURN 
			 _faturamento_simulado
			)
			
			
			```
