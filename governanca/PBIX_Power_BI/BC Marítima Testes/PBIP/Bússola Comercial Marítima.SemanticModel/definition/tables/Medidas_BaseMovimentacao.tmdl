	measure PrecoMedio_YTM_BaseMovimentacao =
			
			VAR vUltimoAno = YEAR(MAX(aws_movimentacao_portuaria[competencia]))
			VAR vUltimoMesContexto = MONTH(MAXX(ALL(aws_movimentacao_portuaria), aws_movimentacao_portuaria[competencia]))
			VAR vDia = DAY(MAXX(ALL(aws_movimentacao_portuaria), aws_movimentacao_portuaria[competencia]))
			
			RETURN
			    CALCULATE(
			        [PrecoMedio_Concorrente],
			        FILTER(
			            Dim_calendario,
			            Dim_calendario[data] <= DATE(vUltimoAno,vUltimoMesContexto,vDia)
			        )
			    )
		lineageTag: f4fe2fe0-0569-4a1a-a5f8-32efbb7fd7e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

