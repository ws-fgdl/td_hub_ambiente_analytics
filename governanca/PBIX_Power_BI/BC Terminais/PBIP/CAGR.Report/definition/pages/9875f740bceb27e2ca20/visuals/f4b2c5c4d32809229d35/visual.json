                      "color": "#ffffff"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4) O valor selecionado no filtro  'Ano Base Inflação' não pode ser menor do que o ano mínimo selecionado no período estudado pelo filtro 'Ano' na parte lateral direita do painel;",
                    "textStyle": {
                      "color": "#ffffff"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
