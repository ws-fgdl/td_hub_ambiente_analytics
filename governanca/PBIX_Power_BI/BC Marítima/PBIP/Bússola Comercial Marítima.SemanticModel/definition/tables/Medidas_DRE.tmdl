	measure Perfil =
			
			DIVIDE(
			    [Total_ImportosEfetivos],
			    [Total_Receita_Bruta_AposDesconto],
			    0
			)
		lineageTag: 09d56209-7b97-4d85-bd2e-9702704f4eb0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_ImportosEfetivos =
			
			ABS(
			    CALCULATE(
			        SUM(aws_dre_reb[realizado_dolar]),
			        aws_dre_reb[linha_agrupadas] = "Impostos Efetivos"
			    )
			)
		lineageTag: 479e35de-f0cb-4332-99e6-946544e9c7ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Receita_Bruta_AposDesconto =
			
			CALCULATE(
			    SUM(aws_dre_reb[realizado_dolar]),
			    aws_dre_reb[linha_agrupadas] = "Receita Bruta (após descontos)"
			)
		lineageTag: 5735728f-fead-4838-92e5-1df1487fb3d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Soma_Custo_Ebitda =
			
			CALCULATE(
			    SUM(aws_dre_reb[realizado_dolar]),
			    FILTER(
			        aws_dre_reb, // Itera sobre a tabela aws_dre_reb
			        NOT(aws_dre_reb[linha_agrupadas] IN {"Receita Líquida", "Receita Bruta (após descontos)", "Impostos Efetivos"})
			    )
			)
		lineageTag: e04a4a46-c73d-4bbb-a52b-eda6f32ff695

