	measure FaturamentoTIF_YTM_BaseMovimentacao = ```
			
			VAR vUltimoAno = YEAR(MAX(aws_bussola_comercial_mar[competencia]))
			VAR vUltimoMesContexto = MONTH(MAXX(ALL(aws_bussola_comercial_mar), aws_bussola_comercial_mar[competencia]))-1
			VAR vDia = DAY(MAXX(ALL(aws_bussola_comercial_mar), aws_bussola_comercial_mar[competencia]))
			
			RETURN
			    CALCULATE(
			        [FaturamentoTIF_BaseMovimentacao],
			        FILTER(
			            Dim_calendario,
			            Dim_calendario[data] <= DATE(vUltimoAno,vUltimoMesContexto,vDia)
			        )
			    )
			
			```
		lineageTag: dccb650f-8acb-4376-9e57-c2a130c69736

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %Variacao_FaturamentoTIF_YTM_BaseMovimentacao = ```
			
			VAR AnoAtual = MAX(Dim_calendario[ano_calendario])
			VAR PrimeiroAnoSelecionado =
			    CALCULATE(
			        MIN(Dim_calendario[ano_calendario]),
			        ALLSELECTED(Dim_calendario)
			    )
			VAR FatAtual = [FaturamentoTIF_YTM_BaseMovimentacao]
			VAR FatAnterior =
			    IF(
			        AnoAtual > PrimeiroAnoSelecionado,
			        CALCULATE(
			            [FaturamentoTIF_YTM_BaseMovimentacao],
			            FILTER(
			                ALL(Dim_calendario),
			                Dim_calendario[ano_calendario] = AnoAtual - 1
			            )
			        )
			    )
			RETURN
			    IF(
			        ISBLANK(FatAnterior) || ISBLANK(FatAtual),
			        BLANK(),
			        DIVIDE(FatAtual - FatAnterior, FatAnterior, 0)
			    )
			
			```
		lineageTag: 3035db55-8cdd-43e9-9e51-361d3f9b88c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

