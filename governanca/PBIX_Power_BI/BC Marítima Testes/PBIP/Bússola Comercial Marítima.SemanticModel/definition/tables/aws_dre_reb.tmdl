table aws_dre_reb
	lineageTag: e3909fb6-d7ac-4966-a459-12b75f674807

	measure Media_Tempo_Servico_Cliente =
			
			AVERAGE(
			    aws_bussola_comercial_mar[Duracao_Servico]
			    )
		displayFolder: Medidas_Rateio
		lineageTag: ff6bbf39-6b98-44c5-a349-6bef9b70f37e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TempoServico_GrupoEcono_ComDeslocamento =
			
			CALCULATE(
			    Medidas_TempoDeServico[TempoDeServico_ComDesloc],
			        ALL(
			            Dim_Cliente[Grupo Econômico]
			            ) // Remove o filtro de cliente, mantendo o filtro de filial
			)
		formatString: 0
		displayFolder: View_Tempo\TempoServico
		lineageTag: 43625c0e-c779-4e66-9d08-c2beeb35c698

	measure Tempo_Total_Servico_Todos_Clientes_Filial =
			
			CALCULATE(
			    SUM(
			        aws_bussola_comercial_mar[Duracao_Servico]
			        ),
			        ALL(
			            aws_bussola_comercial_mar[cliente]
			            ) // Remove o filtro de cliente, mantendo o filtro de filial
			)
		formatString: 0
		displayFolder: Medidas_Rateio
		lineageTag: 0bc62589-7258-4aed-9380-e31d59d06438

	measure Rateio_CustoTempo_GrupoEcon_ComDeslocamento =
			
			VAR varTempoCliente = [TempoDeServico_ComDesloc]
			VAR varTempoTotalFilial = [TempoServico_GrupoEcono_ComDeslocamento]
			VAR varRealizadoTotalFilialContexto = [Soma_Custo_Ebitda] // Esta medida já considera o filtro de filial
			RETURN
			IF(
			    NOT ISBLANK(varTempoTotalFilial) && varTempoTotalFilial <> 0, // Evita divisão por zero ou blank
			    (varTempoCliente / varTempoTotalFilial) * varRealizadoTotalFilialContexto,
			    0 // Ou BLANK() se preferir não mostrar zero
			)
		displayFolder: View_Tempo\Rateio
		lineageTag: f64d2116-7430-458d-a356-77d58b7eb9f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rateio_Realizado_Dolar_Cliente =
			
			VAR varTempoCliente = [TempoDeServico_ComDesloc]
			VAR varTempoTotalFilial = [Tempo_Total_Servico_Todos_Clientes_Filial]
			VAR varRealizadoTotalFilialContexto = [Total_Custo_DRE] // Esta medida já considera o filtro de filial
			RETURN
			IF(
			    NOT ISBLANK(varTempoTotalFilial) && varTempoTotalFilial <> 0, // Evita divisão por zero ou blank
			    (varTempoCliente / varTempoTotalFilial) * varRealizadoTotalFilialContexto,
			    0 // Ou BLANK() se preferir não mostrar zero
			)
		displayFolder: Medidas_Rateio
		lineageTag: 7de18447-735c-4b25-978f-310779b520dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Custo_DRE =
			
			SUM(
			    aws_dre_reb[realizado_dolar]
			)
		displayFolder: Medidas_Rateio
		lineageTag: c0927320-0169-4b04-b132-af99a352dfcb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rateio_Custo_Linha_DRE_por_Cliente =
			
			// Esta medida espera estar num contexto onde aws_dre_reb[linhe_dre] e aws_bussola_comercial_mar[cliente] estão presentes
			// ou filtrados.
			VAR CustoDaLinhaDREnoContexto = [Total_Custo_DRE] // [Custo DRE] = SUM(aws_dre_reb[realizado_dolar]), já filtrado pela linhe_dre do contexto.
			VAR ProporcaoTempoClienteNaFilial =
			    DIVIDE(
			        [TempoDeServico_ComDesloc], // Medida já existente
			        [Tempo_Total_Servico_Todos_Clientes_Filial] // Medida já existente
			    )
			RETURN
			IF(
			    NOT ISBLANK(ProporcaoTempoClienteNaFilial) && ProporcaoTempoClienteNaFilial > 0,
			    ProporcaoTempoClienteNaFilial * CustoDaLinhaDREnoContexto,
			    0
			)
		displayFolder: Medidas_Rateio
		lineageTag: 482212ff-1ea0-4e3e-a569-fb5e98336d6a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Custo_DRE_Periodo_Anterior_MoM = ```
			
			CALCULATE(
			    [Total_Custo_DRE], 
			    DATEADD(
			        Dim_calendario[data], 
			        -1, 
			        MONTH
			    )
			)
			
			```
		displayFolder: Medidas_Rateio
		lineageTag: 13883775-35f7-4cb5-be7e-7fe1867f4c58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Custo_DRE_Periodo_Anterior_YoY = ```
			
			CALCULATE(
			    [Total_Custo_DRE], 
			    SAMEPERIODLASTYEAR(
			        Dim_calendario[data]
			    )
			)
			
			```
		displayFolder: Medidas_Rateio
		lineageTag: 159fd247-54b7-40aa-a8ca-b96a1f39f0d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

