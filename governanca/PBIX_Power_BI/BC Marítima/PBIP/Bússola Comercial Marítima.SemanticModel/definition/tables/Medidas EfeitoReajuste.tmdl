	measure Vol_P1 = ```
			// Novo Volume para o Período 1
			VAR Periodo1_Selecionado = VALUES('Calendario P1'[Data])
			RETURN
			CALCULATE(
			    [VolumeManobra_BaseBC], --[VolumeManobra_TipoData], 
			    KEEPFILTERS('Dim_calendario'[data] IN Periodo1_Selecionado)
			)
			```
		lineageTag: 5dbe21ef-6df1-4e0c-8cd7-d47a85c7ef39

		formatStringDefinition =
				VAR Valor = SELECTEDMEASURE()
				VAR ValorAbs = ABS(Valor) -- Pega o valor sem o sinal para a comparação
				RETURN
				    SWITCH( TRUE(),
				        ValorAbs >= 1000000000, "#,##0,,,.0 ""B"";-#,##0,,,.0 ""B""",
				        ValorAbs >= 1000000,    "#,##0,,.0 ""M"";-#,##0,,.0 ""M""",
				        ValorAbs >= 1000,       "#,##0,.0 ""K"";-#,##0,.0 ""K""",
				        "#,##0;-#,##0" -- Para valores menores que 1000
				    )

	measure Vol_P2 = ```
