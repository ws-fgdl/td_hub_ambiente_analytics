	measure 'Efeito Preço' = ([PMedio_P2] - [PMedio_P1]) * [Vol_P2]
		lineageTag: 184c8f10-7570-4f39-9fea-b94ae34c4856

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure %_P1vsP2 =
			
			VAR Periodo1 = [PMedio_P1]
			VAR Periodo2 = [PMedio_P2]
			
			RETURN
			    DIVIDE(
			        (Periodo2 - Periodo1),
			        Periodo1,
			        BLANK()
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2a6cbdbe-d2be-4aa0-abf2-7d2bcdbc68c9

	measure %_Agregado_Cartao_FINAL =
			
			CALCULATE(
			    [%_P1vsP2],
			    FILTER(
			        SUMMARIZE(
			            'aws_bussola_comercial_mar',
			            aws_bussola_comercial_mar[grupo_acordo],
			            'Dim_Cliente'[Grupo Econômico],
			            Dim_Filial[Filial_agrupado],
			            Dim_Divisao[divisao],
			            aws_bussola_comercial_mar[FAIXA_DWT_2025]
			        ),
			        // CONDIÇÃO DE FILTRO ORIGINAL
			        ( [PMedio_P1] > 0 && [PMedio_P2] > 0 )
			        &&
			        // CONDIÇÃO DE SEGURANÇA PARA IGNORAR RELACIONAMENTOS EM BRANCO
			        NOT ISBLANK('Dim_Cliente'[Grupo Econômico])
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 03213e48-2ed1-4649-bca4-0af2c6d63c9b

