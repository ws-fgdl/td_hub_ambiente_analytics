	measure '% ∆ Negociado x Media IPCA IGPM' = ```
			
			VAR AnoMin = MIN('Calendario1'[Ano Calendario])
			VAR AnoMax = MAX('Calendario1'[Ano Calendario])
			VAR ValorFinalIpca = 
			CALCULATE(
			    [Reajuste_Media_IPCA_IGPM_Acumulado], 'Calendario1'[Ano Calendario] = AnoMax)
			
			VAR ValorFinal = 
			CALCULATE(
			    [Flag_Price], 'Calendario1'[Ano Calendario] = AnoMax)
			VAR NumAnos = (AnoMax - AnoMin) 
			
			RETURN 
			IFERROR(
			    (ValorFinal - ValorFinalIpca)/ValorFinal,
			"Verificar nulos"
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Índices
		lineageTag: 6719704a-a9f1-4d00-87ee-4632d96c86f7

	measure 'Reajuste IPCA' = [Preço YOY]*(1+[IPCA Período])
