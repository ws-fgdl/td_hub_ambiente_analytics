	measure 'FRETE ACUM Partindo de Zero' = ```
			
			VAR AcumuladoOriginal = 
			    CALCULATE(
			        PRODUCTX(
			            FILTER(
			                ALL(Calendario1[Date].[Date]),
			                Calendario1[Date].[Date] <= MAX(Calendario1[Date])
			            ),
			            (1+[FRETE SUM]/100)
			        )-1
			    )
			
			VAR ValorInicial = 
			    CALCULATE(
			        PRODUCTX(
			            FILTER(
			                ALL(Calendario1[Date].[Date]),
			                Calendario1[Date].[Date] = MIN(Calendario1[Date])
			            ),
			            (1+[FRETE SUM]/100)
			        )-1
			    )
			
			RETURN
			    IF(AcumuladoOriginal - ValorInicial = 0 , BLANK(),AcumuladoOriginal - ValorInicial)
			```
		lineageTag: 71db26bd-92b7-45e2-806c-37221e3bf53c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

