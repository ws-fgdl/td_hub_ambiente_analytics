	measure Periodo3_Simulado = ```
			
			VAR _freetime_param_default       = [#Param Dias Freetime (selecionado)]
			VAR _freetime_param_vazio_imp     = [#Param Dias Freetime Vazio Imp (selecionado)]
			VAR _freetime_param_vazio_exp     = [#Param Dias Freetime Vazio Exp (selecionado)]
			VAR _dias_isencao_param_default   = [#Param Dias Isenção (selecionado)]
			VAR _dias_isencao_param_vazio_imp = [#Param Dias Isenção Vazio Imp (selecionado)]
			VAR _dias_isencao_param_vazio_exp = [#Param Dias Isenção Vazio Exp (selecionado)]
			VAR _perc_ajuste_volume_cheio     = [#Param % ajuste volume Arm Cntr Cheio (selecionado)]
			VAR _perc_ajuste_volume_vazio     = [#Param % ajuste volume Arm Cntr Vazio (selecionado)]
			
			VAR _has_param =
			    NOT (
			        ISBLANK ( _freetime_param_default ) &&
			        ISBLANK ( _freetime_param_vazio_imp ) &&
			        ISBLANK ( _freetime_param_vazio_exp ) &&
			        ISBLANK ( _dias_isencao_param_default ) &&
			        ISBLANK ( _dias_isencao_param_vazio_imp ) &&
			        ISBLANK ( _dias_isencao_param_vazio_exp ) &&
			        _perc_ajuste_volume_cheio = 0 &&
			        _perc_ajuste_volume_vazio = 0 &&
			        ISBLANK ( [#Param Dias Freetime (selecionado) - EXP] ) &&
			        ISBLANK ( [#Param Dias Freetime (selecionado) - CAB] ) &&
			        ISBLANK ( [#Param Dias Freetime (selecionado) - TRA] ) &&
			        ISBLANK ( [#Param Dias Freetime Vazio (selecionado) - CAB] ) &&
			        ISBLANK ( [#Param Dias Freetime Vazio (selecionado) - TRA] ) &&
			        ISBLANK ( [#Param Dias Isenção (selecionado) - EXP] ) &&
			        ISBLANK ( [#Param Dias Isenção (selecionado) - CAB] ) &&
			        ISBLANK ( [#Param Dias Isenção (selecionado) - TRA] ) &&
			        ISBLANK ( [#Param Dias Isenção Vazio (selecionado) - CAB] ) &&
			        ISBLANK ( [#Param Dias Isenção Vazio (selecionado) - TRA] )
			    )
			RETURN
			IF (
			    NOT _has_param,
			    [Periodo3_Ajustado],
			    SUMX (
			        bussola_comercial,
			        VAR _un                 = bussola_comercial[un]
			        VAR _servico            = bussola_comercial[servico]
			        VAR _sub_grupo_princing = bussola_comercial[Agrupamento Subgrupo Princing]
			        VAR _dias_servico       = bussola_comercial[dias_servico]
			        VAR _periodo1_contrato  = bussola_comercial[periodo1_contrato]
			        VAR _periodo2_contrato  = bussola_comercial[periodo2_contrato]
			        VAR _periodo3_contrato  = bussola_comercial[periodo3_contrato]
			
			        VAR _isEXP = CONTAINSSTRING ( UPPER ( _servico ), "EXP" )
			        VAR _isCAB = CONTAINSSTRING ( UPPER ( _servico ), "CAB" )
			        VAR _isTRA = CONTAINSSTRING ( UPPER ( _servico ), "TRA" )
			
			        VAR _sinalizador_cheio =
			            _sub_grupo_princing IN { "Armazenagem Cntr Cheio", "Armazenagem Cntr Cheio BT" }
			        VAR _sinalizador_vazio =
			            _sub_grupo_princing IN { "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT" }
			        VAR _sinalizador_vazio_imp = _sinalizador_vazio
			        VAR _sinalizador_vazio_exp = _sinalizador_vazio
			
			        VAR _ft_default_blk =
			            COALESCE (
			                SWITCH (
			                    TRUE (),
			                    _isEXP, [#Param Dias Freetime (selecionado) - EXP],
			                    _isCAB, [#Param Dias Freetime (selecionado) - CAB],
			                    _isTRA, [#Param Dias Freetime (selecionado) - TRA]
			                ),
			                _freetime_param_default
			            )
			        VAR _ft_vazio_imp_blk =
			            COALESCE (
			                SWITCH (
			                    TRUE (),
			                    _isEXP, [#Param Dias Freetime Vazio Imp (selecionado)],
			                    _isCAB, [#Param Dias Freetime Vazio (selecionado) - CAB],
			                    _isTRA, [#Param Dias Freetime Vazio (selecionado) - TRA]
			                ),
			                _freetime_param_vazio_imp
			            )
			        VAR _ft_vazio_exp_blk =
			            COALESCE (
			                SWITCH (
			                    TRUE (),
			                    _isEXP, [#Param Dias Freetime Vazio Exp (selecionado)],
			                    _isCAB, [#Param Dias Freetime Vazio (selecionado) - CAB],
			                    _isTRA, [#Param Dias Freetime Vazio (selecionado) - TRA]
			                ),
			                _freetime_param_vazio_exp
			            )
			
			        VAR _isenc_default_blk =
			            COALESCE (
			                SWITCH (
			                    TRUE (),
			                    _isEXP, [#Param Dias Isenção (selecionado) - EXP],
			                    _isCAB, [#Param Dias Isenção (selecionado) - CAB],
			                    _isTRA, [#Param Dias Isenção (selecionado) - TRA]
			                ),
			                _dias_isencao_param_default
			            )
			        VAR _isenc_vazio_imp_blk =
			            COALESCE (
			                SWITCH (
			                    TRUE (),
			                    _isEXP, [#Param Dias Isenção Vazio Imp (selecionado)],
			                    _isCAB, [#Param Dias Isenção Vazio (selecionado) - CAB],
			                    _isTRA, [#Param Dias Isenção Vazio (selecionado) - TRA]
			                ),
			                _dias_isencao_param_vazio_imp
			            )
			        VAR _isenc_vazio_exp_blk =
			            COALESCE (
			                SWITCH (
			                    TRUE (),
			                    _isEXP, [#Param Dias Isenção Vazio Exp (selecionado)],
			                    _isCAB, [#Param Dias Isenção Vazio (selecionado) - CAB],
			                    _isTRA, [#Param Dias Isenção Vazio (selecionado) - TRA]
			                ),
			                _dias_isencao_param_vazio_exp
			            )
			
			        VAR _aj_vol_cheio_blk =
			            COALESCE (
			                SWITCH (
			                    TRUE (),
			                    _isEXP, [#Param % ajuste volume Arm Cntr Cheio (selecionado) - EXP],
			                    _isCAB, [#Param % ajuste volume Arm Cntr Cheio (selecionado) - CAB],
			                    _isTRA, [#Param % ajuste volume Arm Cntr Cheio (selecionado) - TRA]
			                ),
			                _perc_ajuste_volume_cheio
			            )
			        VAR _aj_vol_vazio_blk =
			            COALESCE (
			                SWITCH (
			                    TRUE (),
			                    _isEXP, [#Param % ajuste volume Arm Cntr Vazio (selecionado)],
			                    _isCAB, [#Param % ajuste volume Arm Cntr Vazio (selecionado) - CAB],
			                    _isTRA, [#Param % ajuste volume Arm Cntr Vazio (selecionado) - TRA]
			                ),
			                _perc_ajuste_volume_vazio
			            )
			
			        VAR _freetime_param =
			            SWITCH (
			                TRUE (),
			                _sinalizador_vazio_imp, _ft_vazio_imp_blk,
			                _sinalizador_vazio_exp, _ft_vazio_exp_blk,
			                _ft_default_blk
			            )
			        VAR _dias_isencao_param =
			            SWITCH (
			                TRUE (),
			                _sinalizador_vazio_imp, _isenc_vazio_imp_blk,
			                _sinalizador_vazio_exp, _isenc_vazio_exp_blk,
			                _isenc_default_blk
			            )
			
			        VAR _freetime =
			            IF ( ISBLANK ( _freetime_param ), bussola_comercial[dias_free_time], _freetime_param )
			        VAR _dias_isencao =
			            IF ( ISBLANK ( _dias_isencao_param ), bussola_comercial[dias_isencao], _dias_isencao_param )
			
			        VAR _dias_servico_ajustado =
			            IF (
			                _dias_servico <= _freetime,
			                0,
			                IF ( _dias_isencao > _dias_servico, 0, _dias_servico - _dias_isencao )
			            )
			
			        VAR _perc_ajuste_volume =
			            SWITCH (
			                TRUE (),
			                _sinalizador_vazio, _aj_vol_vazio_blk,
			                _sinalizador_cheio, _aj_vol_cheio_blk,
			                0
			            )
			        VAR _volume_simulado =
			            ROUND ( _dias_servico_ajustado * ( 1 + _perc_ajuste_volume ), 0 )
			
			        VAR _dias_p3_simulado =
			            IF (
			                _un = "TRG",
			                BLANK (),
			                IF (
			                    ISBLANK ( _periodo3_contrato ),
			                    BLANK (),
			                    IF (
			                        _dias_servico_ajustado = 0,
			                        0,
			                        VAR _saldo_volume =
			                            _volume_simulado - _periodo1_contrato - _periodo2_contrato
			                        RETURN
			                            IF (
			                                _saldo_volume > 0,
			                                ROUNDUP ( DIVIDE ( _saldo_volume, _periodo3_contrato ), 0 ),
			                                0
			                            )
			                    )
			                )
			            )
			        RETURN
			            _dias_p3_simulado
			    )
			)
			
			```
		displayFolder: Dias Simulado
		lineageTag: 9e81f84d-d57c-44d0-8a6c-72b85e79e31b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simulador de Preço2' = ```
			
			
			VAR vDolar = AVERAGEX(
			        bussola_comercial,
			        SWITCH(TRUE(),
			        //Básicos Transbordo
			                
			                'bussola_comercial'[Precficação USD] = "USD", [Valor Preço Dólar],
			                1
			        )
			    )
			
			VAR pDolarAgrp = (1 +(([Projeção Faturamento Simulador table]/[fat calculado table])-1))*[Price3]
			VAR pDolarServ = (1 +(([Projeção Faturamento Simulador table]/[fat calculado table])-1))*[Price3]*(vDolar)
			
			RETURN
			IF(ISINSCOPE(bussola_comercial[servico]),
			pDolarServ,
			pDolarAgrp)
			
			```
		displayFolder: Outras medidas
		lineageTag: 15da2103-045b-4786-a90d-e0d64bf8b7bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

