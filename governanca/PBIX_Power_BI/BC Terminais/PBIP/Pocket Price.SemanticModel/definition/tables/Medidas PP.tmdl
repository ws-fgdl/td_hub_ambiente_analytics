	measure 'Faturamento Simulado Fiel Depósito' = ```
			
			VAR _cif = [Cif]
			VAR _p   = [Preço FD Simulado]
			VAR _min = COALESCE([Valor Mínimo Fiel Depósito],[Valor Mínimo FD])
			VAR _fat = _cif * _p
			RETURN
			IF(
			    OR(ISBLANK(_cif), ISBLANK(_p)),
			    BLANK(),
			    IF(_min > _fat, _min, _fat)
			)
			
			```
