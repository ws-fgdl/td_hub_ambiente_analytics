table Medidas_Comparative
	lineageTag: fdae6b78-3de0-4663-a7e8-5a2634bc4b4a

	measure Faturamento_comparativo_BaseBC =
			
			VAR v1 = SELECTEDVALUE(TabelaComparativa1[Grupo Econômico])
			VAR v2 = SELECTEDVALUE(TabelaComparativa2[Grupo Econômico])
			RETURN
			CALCULATE(
			    [Flag_Faturamento_BaseBC], --[Faturamento_TipoData],
			    KEEPFILTERS(Dim_Cliente[Grupo Econômico] IN {v1,v2}))
		lineageTag: d94026b3-d97a-4cc9-beb1-9807b0773e19

		formatStringDefinition = ```
				VAR Valor = SELECTEDMEASURE()
				VAR ValorAbs = ABS(Valor) -- Analisamos o "tamanho" do número independente do sinal
				VAR Selecao = SELECTEDVALUE(Flag_faturamento[Faturamento])
				VAR Prefixo = IF(Selecao = "R$", "R$ ", "$ ")
				
				RETURN
				    SWITCH( TRUE(),
				        ValorAbs >= 1000000000, 
				            Prefixo & "#,##0,,,.0 ""B"";-" & Prefixo & "#,##0,,,.0 ""B""",
				        
				        ValorAbs >= 1000000,    
				            Prefixo & "#,##0,,.0 ""M"";-" & Prefixo & "#,##0,,.0 ""M""",
				        
				        ValorAbs >= 1000,       
				            Prefixo & "#,##0,.0 ""K"";-" & Prefixo & "#,##0,.0 ""K""",
				        
				        -- Para valores entre -999 e 999
				        Prefixo & "#,##0;-" & Prefixo & "#,##0"
				    )
				```

