	measure Status_Resultado_Tempo_vs_MediaTotal_SemDeslocamento =
			
			-- 1. Pega o resultado para o cliente da linha atual
			VAR ResultadoClienteAtual = [Resultado_View_Tempo_GrupoEcon_SemDeslocamento]
			
			-- 2. Calcula o resultado para o TOTAL GERAL de todos os clientes visíveis na matriz
			VAR ResultadoTotalGeral =
			    CALCULATE(
			        [Resultado_View_Tempo_GrupoEcon_SemDeslocamento],
			        ALLSELECTED(Dim_Cliente[Grupo Econômico])
			    )
			RETURN
			-- 3. Compara o resultado do cliente com o resultado do total geral
			IF(
			    NOT ISBLANK(ResultadoClienteAtual),
			    SWITCH(
			        TRUE(),
			        ResultadoClienteAtual > ResultadoTotalGeral, "▲", // Acima do Resultado Total
			        ResultadoClienteAtual < ResultadoTotalGeral, "▼", // Abaixo do Resultado Total
			        "▬"  // Exatamente igual ao Resultado Total
			    )
			)
		lineageTag: 72b767ce-3da1-4b6e-8dd8-3087c4418606

	measure Cor_Status_Tempo_SemDeslocamento =
			
			-- 1. Pega o resultado para o cliente da linha atual
			VAR ResultadoClienteAtual = [Resultado_View_Tempo_GrupoEcon_SemDeslocamento]
			
			-- 2. Calcula o resultado para o TOTAL GERAL (média ponderada)
			VAR ResultadoTotalGeral =
			    CALCULATE(
			        [Resultado_View_Tempo_GrupoEcon_SemDeslocamento],
			        ALLSELECTED(Dim_Cliente[Grupo Econômico])
			    )
			RETURN
			-- 3. Compara o cliente com o total geral e retorna a cor correspondente
			IF(
			    NOT ISBLANK(ResultadoClienteAtual),
			    SWITCH(
			        TRUE(),
			        ResultadoClienteAtual > ResultadoTotalGeral, "#118D57", // Verde para "Acima do Total"
			        ResultadoClienteAtual < ResultadoTotalGeral, "#D93644", // Vermelho para "Abaixo do Total"
			        "#DAA520"  // Amarelo para "Exatamente igual ao Total"
			    )
			)
		displayFolder: View_Tempo
		lineageTag: 892528f1-2579-4e4e-8332-0b937b9732c9

