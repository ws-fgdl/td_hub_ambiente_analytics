	column etl_updated_at
		dataType: dateTime
		formatString: General Date
		lineageTag: 50ce2742-19a5-4138-9e5e-a0f1c1421027
		summarizeBy: none
		sourceColumn: etl_updated_at

		variation Variation
			isDefault
			relationship: f6405ada-113b-4954-8a95-c7a9c1e6844b
			defaultHierarchy: LocalDateTable_9c3fc37c-10da-48f9-8619-efcdb9af5f8b.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	partition contratos = m
		mode: import
		source = ```
				let
				    // 0) Origem do Dataflow
				    Fonte = PowerPlatform.Dataflows([]),
				    Workspaces = Fonte{[Id="Workspaces"]}[Data],
				    #"Workspace Selecionado" = Workspaces{[workspaceId = "bcd54b55-e85f-4c30-a169-bfbf18f90f30"]}[Data],
				    #"Dataflow Selecionado" = #"Workspace Selecionado"{[dataflowId = "de5727a2-174c-41e9-9d76-23723162b58d"]}[Data],
				    contratos_ = #"Dataflow Selecionado"{[entity = "bg_contratos", version = ""]}[Data],
				
				    // 1) Limpeza de vigências nulas
				    #"Linhas Filtradas"  = Table.SelectRows(contratos_, each [inicio_vigencia] <> null and [inicio_vigencia] <> ""),
				    #"Linhas Filtradas1" = Table.SelectRows(#"Linhas Filtradas",  each [fim_vigencia]     <> null and [fim_vigencia]     <> ""),
				
				    // 2) Renomeia e trata o valor
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Linhas Filtradas1", {{"valor_numerico", "valor"}}),
				    #"Valor Substituído"    = Table.ReplaceValue(#"Colunas Renomeadas", ".", ",", Replacer.ReplaceText, {"valor"}),
				    #"Tipo Alterado"        = Table.TransformColumnTypes(#"Valor Substituído", {{"valor", type number}}),
				
				    // 3) Cria chave de combinação para mescla
				    #"Personalização Adicionada" = Table.AddColumn(
				        #"Tipo Alterado",
				        "Personalizar",
				        each [servico] & [un]
				    ),
				
				    // 4) Mescla com dim_servico e expande Sub Grupo Pricing
				    #"Consultas Mescladas" = Table.NestedJoin(
				        #"Personalização Adicionada",
				        {"Personalizar"},
				        dim_servico,
				        {"Chave-Bussola"},
				        "dim_servico",
				        JoinKind.LeftOuter
				    ),
				    #"dim_servico Expandido" = Table.ExpandTableColumn(
				        #"Consultas Mescladas",
				        "dim_servico",
				        {"Sub Grupo Pricing"},
				        {"Agrupamento Subgrupo Princing 2"}
				    ),
				
				    // 5) Exclui cliente SAP 30000581
				    clientesFiltrados      = Table.SelectRows(#"dim_servico Expandido", each ([cod_cliente_sap] <> 30000581) and ([Agrupamento Subgrupo Princing 2] = "Box Rate Cheio CAB" or 
				    [Agrupamento Subgrupo Princing 2] = "Box Rate Cheio LC" or [Agrupamento Subgrupo Princing 2] = "Box Rate Cheio TRA" or [Agrupamento Subgrupo Princing 2] = "Box Rate Cheio TRA BT" or 
				    [Agrupamento Subgrupo Princing 2] = "Box Rate Vazio CAB" or [Agrupamento Subgrupo Princing 2] = "Box Rate Vazio LC" or [Agrupamento Subgrupo Princing 2] = "Box Rate Vazio TRA" or 
				    [Agrupamento Subgrupo Princing 2] = "Box Rate Vazio TRA BT" or [Agrupamento Subgrupo Princing 2] = "Inciso XIV")),
				
				    // 6) Mantém somente cod_servico permitidos em TSV + Box Rate/Inciso
				    codigosPermitidos      = {6221,6225,6233,6235,6220,6224,6232,6234,6227,6229,6223,6231,6226,6228,6222,6230,6293,6295,6289,6291,6292,6294,6288,6290},
				    contratosFiltrados1    = Table.SelectRows(
				        clientesFiltrados,
				        each not (
				            [un] = "TSV" and
				            (
				                Text.Contains([Agrupamento Subgrupo Princing 2], "Box Rate") or
				                Text.Contains([Agrupamento Subgrupo Princing 2], "Inciso")
				            ) and
				            not List.Contains(codigosPermitidos, [cod_servico])
				        )
				    ),
				
				    // 7) Remove cod_cliente_sap 40000272 e 40000274 em mesmas , e o cliente 30000031 - Tabela Publica ONE
				    clientesExcluidos      = {40000274, 30000031 },
				    contratosFiltrados2    = Table.SelectRows(
				        contratosFiltrados1,
				        each not (
				            [un] = "TSV" and
				            (
				                Text.Contains([Agrupamento Subgrupo Princing 2], "Box Rate") or
				                Text.Contains([Agrupamento Subgrupo Princing 2], "Inciso")
				            ) and
				            List.Contains(clientesExcluidos, [cod_cliente_sap])
				        )
				    ),
				
				    // 8) Remove cliente 40000272 se servico contém ' CAB', ou 50000222 se contém ' IMP'/' EXP' - ETAPA COMENTADA DEVIDO AO FILTRO DE RAZÃO SOCIAL (TESTE)
				    // contratosFiltrados8    = Table.SelectRows(
				    //     contratosFiltrados2,
				    //     each not (
				    //         [un] = "TSV" and
				    //         (
				    //             Text.Contains([Agrupamento Subgrupo Princing 2], "Box Rate") or
				    //             Text.Contains([Agrupamento Subgrupo Princing 2], "Inciso")
				    //         ) and
				    //         (
				    //             (Text.Contains([servico], " CAB")   and [cod_cliente_sap] = 40000272)
				    //             or
				    //             ((Text.Contains([servico], " IMP") or Text.Contains([servico], " EXP")) and [cod_cliente_sap] = 50000222)
				    //         )
				    //     )
				    // ),
				
				    // 9) Remove cod_contrato 430502 e 430503 se cliente_sap = 50000111 LOG-IN
				    contratosFiltrados9    = Table.SelectRows(
				        contratosFiltrados2,
				        each not (
				            [un] = "TSV" and
				            (
				                Text.Contains([Agrupamento Subgrupo Princing 2], "Box Rate") or
				                Text.Contains([Agrupamento Subgrupo Princing 2], "Inciso")
				            ) and
				            [cod_cliente_sap] = 50000111
				            and
				            List.Contains({430502, 430503, 432214}, [cod_contrato])
				            or 
				            [cod_cliente_sap] = 50000515 and
				            List.Contains({430502, 430503, 432214}, [cod_contrato])
				        )
				    ),
				
				    // 10a) Adiciona uma nova coluna temporária com a lógica de atualização para cod_cliente_sap
				
				    #"Coluna cod_cliente_sap Temporaria Adicionada" = Table.AddColumn(contratosFiltrados9, "TEMP_Novo_cod_cliente_sap", each
				        let
				            // Pega o valor original da coluna 'cod_cliente_sap' da linha atual.
				            // Verifique se o nome da coluna é realmente 'cod_cliente_sap'.
				            valorOriginalClienteSap = Record.FieldOrDefault(_, "cod_cliente_sap", null),
				
				            // Pega o valor da coluna 'un'. Verifique o nome exato.
				            un_val = Record.FieldOrDefault(_, "un", null),
				
				            // Pega o valor da coluna 'cod_contrato'. Verifique o nome exato e se é numérico.
				            cod_contrato_val = Record.FieldOrDefault(_, "cod_contrato", null)
				        in
				            if un_val = "TSV" then
				                if List.Contains({373854, 386439, 393017}, cod_contrato_val) then 40000272
				                else if cod_contrato_val = 361793 then 30000069
				                else if cod_contrato_val = 382601 then 50000120
				                else if List.Contains({363030, 385074, 389408}, cod_contrato_val) then 50000222
				                else if List.Contains({380281, 389473}, cod_contrato_val) then 40000278
				                else if List.Contains({362253, 385861, 389137}, cod_contrato_val) then 50000111
				                else if List.Contains({364848, 384246}, cod_contrato_val) then 30000062
				                else if List.Contains({418796, 430760}, cod_contrato_val) then 50000515
				                else valorOriginalClienteSap // Mantém o valor original se un = "TSV" mas nenhuma condição de cod_contrato for atendida
				            else valorOriginalClienteSap, // Mantém o valor original se un <> "TSV"
				        type number // Define o tipo da nova coluna temporária como número
				    ),
				
				    // 10b) Remove a coluna original "cod_cliente_sap"
				    //      Verifique se o nome da coluna a ser removida é exatamente "cod_cliente_sap"
				    #"Antiga cod_cliente_sap Removida" = Table.RemoveColumns(#"Coluna cod_cliente_sap Temporaria Adicionada", {"cod_cliente_sap"}),
				
				    // 10c) Renomeia a nova coluna temporária para ser a "cod_cliente_sap" oficial
				    #"Nova cod_cliente_sap Renomeada" = Table.RenameColumns(#"Antiga cod_cliente_sap Removida", {{"TEMP_Novo_cod_cliente_sap", "cod_cliente_sap"}}),
				
				    // 11) Duplicar linhas do cod_contrato 387470 com inicio_vigencia ajustado para 2019, 2020 e 2021
				    linhasOriginais387470 = Table.SelectRows(#"Nova cod_cliente_sap Renomeada", each [cod_contrato] = 387470), // CMA CGM
				    linhasOriginais422924 = Table.SelectRows(#"Nova cod_cliente_sap Renomeada", each [cod_contrato] = 422924), 
				
				    duplicado387470_2019 = Table.TransformColumns(linhasOriginais387470, {{"inicio_vigencia", each #date(2019, 9, 19), type date}}),
				    duplicado387470_2020 = Table.TransformColumns(linhasOriginais387470, {{"inicio_vigencia", each #date(2020, 9, 19), type date}}),
				    duplicado387470_2021 = Table.TransformColumns(linhasOriginais387470, {{"inicio_vigencia", each #date(2021, 9, 19), type date}}),
				
				    duplicado422924_2024 = Table.TransformColumns(linhasOriginais422924, {{"inicio_vigencia", each #date(2024, 9, 1), type date}}),
				
				    // 12) Duplicar linhas do cod_contrato 396286 com inicio_vigencia ajustado para 2019, 2020 e 2021
				    linhasOriginais396286 = Table.SelectRows(#"Nova cod_cliente_sap Renomeada", each [cod_contrato] = 396286), // GRUPO ONE
				
				    duplicado396286_2019 = Table.TransformColumns(linhasOriginais396286, {{"inicio_vigencia", each #date(2019, 4, 1), type date}}),
				    duplicado396286_2020 = Table.TransformColumns(linhasOriginais396286, {{"inicio_vigencia", each #date(2020, 4, 1), type date}}),
				    duplicado396286_2021 = Table.TransformColumns(linhasOriginais396286, {{"inicio_vigencia", each #date(2021, 4, 1), type date}}),
				
				    // Junta todos com a tabela original
				    DuplicacoesFinais = Table.Combine({
				        #"Nova cod_cliente_sap Renomeada",
				        duplicado387470_2019, duplicado387470_2020, duplicado387470_2021, duplicado422924_2024,
				        duplicado396286_2019, duplicado396286_2020, duplicado396286_2021
				    }),
				
				    
				    
				    #"Tipo Alterado1" = Table.TransformColumnTypes(DuplicacoesFinais,{{"inicio_vigencia", type date}}),
				
				    // 13) Remove cod_contrato 387116 se cliente_sap = 50000120 MAERSK Aliança
				    contratosFiltrados13    = Table.SelectRows(
				        #"Tipo Alterado1",
				        each not (
				            [un] = "TSV" and
				            (
				                Text.Contains([Agrupamento Subgrupo Princing 2], "Box Rate Cheio CAB") or
				                Text.Contains([Agrupamento Subgrupo Princing 2], "Inciso")
				            ) and
				            [cod_cliente_sap] = 50000120
				            and
				            List.Contains({387116}, [cod_contrato])
				        )
				    )
				
				
				in
				    contratosFiltrados13
				```

	annotation PBI_NavigationStepName = Navegação

