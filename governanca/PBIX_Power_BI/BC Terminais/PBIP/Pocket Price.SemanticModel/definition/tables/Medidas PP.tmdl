		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'SIMULADOR PP volume 2' = ```
			
			var vVolume = sumX (
			        'bussola_comercial',
			        'bussola_comercial'[volume]
			        * (
			            1
			            + SWITCH (
			                TRUE (),
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Cabotagem", [Valor Básicos Cabotagem vol],
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Exportação", [Valor #SPP Básicos Exportação vol],
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Importação", [Valor #SPP Básicos Importação vol],
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Transbordo", [Valor #SPP Básicos Transbordo],
			                'bussola_comercial'[Agrupamento Serviço] = "Operação Navio", [Valor #SPP Operação Navio vol],
			                'bussola_comercial'[Agrupamento Serviço] = "Operação Navio OOG", [Valor #SPP Operação Navio OOG vol],
			                'bussola_comercial'[Agrupamento Serviço] = "Outros Serviços", [Valor #SPP Outros Serviços vol],
			                'bussola_comercial'[Agrupamento Serviço] = "Operação Navio Overtime", [Valor #SPP Operação Navio Overtime vol],
			                'bussola_comercial'[Agrupamento Serviço] = "Reefer", [Valor #SPP Reefer vol],
			                'bussola_comercial'[Agrupamento Serviço] = "Serviços de Armazém", [Valor #SPP Serviços de Armazém vol],
			                'bussola_comercial'[Agrupamento Serviço] = BLANK(), 0,
			                0
			            )
			            
			
			        )
			        
			        )
			RETURN
			IF(vVolume<0,0,vVolume)
			    
			
			```
		displayFolder: Outras medidas
		lineageTag: 1a789f2a-4c00-4a54-84a8-f91a9563f40e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simulador SBP Volume' = ```
			
