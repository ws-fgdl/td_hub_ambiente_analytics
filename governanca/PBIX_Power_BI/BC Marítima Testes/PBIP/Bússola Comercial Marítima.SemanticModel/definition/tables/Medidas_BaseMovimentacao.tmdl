	measure PrecoMedio_Concorrente =
			
			DIVIDE(
			    [FaturamentoTIF_BaseMovimentacao],
			    [VolumeManobra_BaseMovimentacao],
			    0
			)
		lineageTag: ea6e09db-fafd-4947-a886-7d0abc61a5c9

