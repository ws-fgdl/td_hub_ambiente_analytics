	column Data_Fim_Manobra = ```
			
			VAR ChaveAtual = 'aws_pmvpmr'[chave_pmf]
			    
			VAR DataFaina = 
			    CALCULATE(
			        MAX(aws_bussola_comercial_faina[Data_fim_Evento]),
			        FILTER(
			            aws_bussola_comercial_faina,
			            aws_bussola_comercial_faina[Chave_pmf] = ChaveAtual
			        )
			    )
			
			VAR DataTer = 
			    CALCULATE(
			        MAX(aws_bussola_comercial_ter[data_do_fim_do_evento]),
			        FILTER(
			            aws_bussola_comercial_ter,
			            aws_bussola_comercial_ter[Chave_pmf] = ChaveAtual
			        )
			    )
			
			RETURN
			    COALESCE(DataFaina, DataTer)
			```
		formatString: Short Date
		lineageTag: 09be4f88-082e-4e5f-815f-5c4d72dc84b8
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 1d1cbf84-2f5c-4bfc-93e2-78124345a8dd
			defaultHierarchy: LocalDateTable_8a14539e-3c6b-4b20-96e4-31893cc36cfb.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column Data_Inicio_Manobra = ```
			
			VAR ChaveAtual = 'aws_pmvpmr'[Chave_pmf]
			    
			VAR DataFaina = 
			    CALCULATE(
			        MIN(aws_bussola_comercial_faina[Data_Inicio_Evento]),
			        FILTER(
			            aws_bussola_comercial_faina,
			            aws_bussola_comercial_faina[Chave_pmf] = ChaveAtual
			        )
			    )
			
			VAR DataTer = 
			    CALCULATE(
			        MIN(aws_bussola_comercial_ter[data_do_Inicio_do_evento]),
			        FILTER(
			            aws_bussola_comercial_ter,
			            aws_bussola_comercial_ter[Chave_pmf] = ChaveAtual
			        )
			    )
			
			RETURN
			    COALESCE(DataFaina, DataTer)
			```
		formatString: Short Date
		lineageTag: a169867f-e54b-458f-8ef7-c325ae5802db
		summarizeBy: none

