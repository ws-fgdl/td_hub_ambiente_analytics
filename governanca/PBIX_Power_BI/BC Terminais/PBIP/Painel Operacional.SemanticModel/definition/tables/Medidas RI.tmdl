	measure 'Vol TEU' = ```
			SUM(Movimentacao_CNTR[QNT TEU])
			
			```
		lineageTag: a9685b08-1ed2-4334-b123-82df97a23cef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Teus_YTM = ```
			
			VAR vUltimoAno = YEAR(MAX(Calendario1[Date]))
			VAR vUltimoMesContexto = MONTH(MAXX(ALL(Calendario1), Calendario1[Date]))
			
			RETURN
			SUMX(
			    VALUES(Calendario1[Ano Calendario]),
			    CALCULATE( 
			        [Vol TEU],
			        FILTER(
			            Calendario1,
			            Calendario1[Ano Calendario] = Calendario1[Ano Calendario] &&
			            Calendario1[Numero Mes] <= vUltimoMesContexto
			        )
			    )
			)
			```
		lineageTag: 04adcadc-b764-47bf-b141-387a53fdd247

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Vol_YTM_AnoAnterior = ```
			
			VAR vUltimaData = MAX('Calendario1'[Date]) // Última data presente na base
			RETURN
			CALCULATE(
			    [Vol TEU],
			    FILTER(
			        ALL('Calendario1'),
			        'Calendario1'[Ano Calendario] = YEAR(vUltimaData) - 1 && // Filtro para o ano anterior
			        'Calendario1'[Date] <= DATE(YEAR(vUltimaData) - 1, 
			        MONTH(vUltimaData), 
			        DAY(vUltimaData)) // Filtro para o dia correspondente ao último dia presente na base, mas no ano anterior
			    )
			)
			
			```
		lineageTag: c6739534-5968-4311-b2af-80f9f42df465

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Vol_YTM_AnoAtual = ```
			
			VAR vUltimaData = MAX('Calendario1'[Date]) // Última data presente na base
