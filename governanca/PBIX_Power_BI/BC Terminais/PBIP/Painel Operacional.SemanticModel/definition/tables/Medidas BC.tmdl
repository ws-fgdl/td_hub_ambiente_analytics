	measure 'delta vision firstyear vs. last year' = (([lastyear vision]-[firstyear vision])/[firstyear vision])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 09ac1d9f-df14-4828-9ed3-c497da5df1a2

	measure 'lastyear vision' = ```
			
			VAR maiorData = max(Calendario1[Date].[Date])
			VAR maiorMes = MONTH(MAXX(ALLSELECTED(Calendario1),Calendario1[Date]))
			VAR maiorAno = YEAR(MAXX(ALLSELECTED(Calendario1),Calendario1[Date]))
			
			RETURN
			
			IF( DATE(maiorAno,maiorMes,1) < SELECTEDVALUE(Calendario1[Date]), BLANK(),CALCULATE(
			        [Flag_Vision],
			        YEAR(Calendario1[Date]) = maiorAno
			        
			    )
			)
			```
		lineageTag: 88eccfdf-2a7f-46a6-9aa5-86036ffb3084

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'firstyear vision' = ```
			
