			VAR vUltimaData = MAX('aws_bussola_comercial_mar'[data_do_fim_do_evento])
			VAR vDataInicioAnterior = DATE(YEAR(vUltimaData) - 1, 1, 1)
			VAR vDataFimAnterior = DATE(YEAR(vUltimaData) - 1, MONTH(vUltimaData), DAY(vUltimaData))
			
			RETURN
			    CALCULATE(
			        [Vol_Manobra],
			        DATESBETWEEN(
			            'dim_calendario'[data],
			            vDataInicioAnterior,
			            vDataFimAnterior
			        ),
			        USERELATIONSHIP('dim_calendario'[data], 'aws_bussola_comercial_mar'[data_do_fim_do_evento])
			    )
		formatString: #,0
		displayFolder: DataFim
		lineageTag: c11e726a-9af3-460b-ae5f-670c983aa299

	measure Media_Dwt_Acumulado_YTM_DataFim =
			
			VAR vUltimaData = MAX('aws_bussola_comercial_mar'[data_do_fim_do_evento])
			VAR vUltimoAno = YEAR(vUltimaData)
			VAR vUltimoMes = MONTH(vUltimaData)
			
			RETURN
			    CALCULATE(
			        [Resultado_Volume_Media],
			        KEEPFILTERS(
			            FILTER(
			                ALL('dim_calendario'),
			                YEAR('dim_calendario'[data]) = vUltimoAno &&
			                MONTH('dim_calendario'[data]) <= vUltimoMes
			            )
			        ),
			        USERELATIONSHIP('dim_calendario'[data], 'aws_bussola_comercial_mar'[data_do_fim_do_evento])
			    )
