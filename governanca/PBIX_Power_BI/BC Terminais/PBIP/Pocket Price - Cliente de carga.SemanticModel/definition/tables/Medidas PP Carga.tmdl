	measure 'Simulação Volume Grupo' = ```
			
			var vVolume = sumX (
			        'bussola_comercial',
			        'bussola_comercial'[volume]
			        * (
			            1
			            + SWITCH (
			                TRUE (),
			             //   'bussola_comercial'[Agrupamento Serviço] = "Básicos Cabotagem", [Valor Vol Básicos Cabotagem],
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Exportação", [Valor #Vol Básicos Exportação],
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Importação", [Valor #Vol Básicos Importação],
			             //   'bussola_comercial'[Agrupamento Serviço] = "Básicos Transbordo", [Valor Vol Básicos Transbordo],
			                'bussola_comercial'[Agrupamento Serviço] = "Operação Navio", [Valor #Vol Operação Navio],
			                'bussola_comercial'[Agrupamento Serviço] = "Operação Navio OOG", [Valor #Vol Operação Navio OOG],
			                'bussola_comercial'[Agrupamento Serviço] = "Outros Serviços", [Valor #Vol Outros Serviços],
			                'bussola_comercial'[Agrupamento Serviço] = "Reefer", [Valor #Vol Reefer],
			                'bussola_comercial'[Agrupamento Serviço] = "Serviços de Armazém", [Valor #Vol Serviços de Armazém],
			                'bussola_comercial'[Agrupamento Serviço] = BLANK(), 0,
			                0
			            )
			            
			
			        )
			        
			        )
			RETURN
			IF(vVolume<0,0,vVolume)
			```
