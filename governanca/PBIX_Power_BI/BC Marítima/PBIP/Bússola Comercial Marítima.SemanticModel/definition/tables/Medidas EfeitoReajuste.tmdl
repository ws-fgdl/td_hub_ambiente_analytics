	measure 'Efeito Preço Ajustado' =
			
			SUMX(SUMMARIZE(aws_bussola_comercial_mar,Dim_Filial[Filial_agrupado],Dim_Divisao[divisao],Dim_Cliente[Grupo Econômico],aws_bussola_comercial_mar[grupo_acordo],aws_bussola_comercial_mar[faixa_dwt_2025]),([PMedio_P2] - [PMedio_P1]) * [Vol_P2])
			
			// SUMX(
			//     KEEPFILTERS(VALUES(aws_bussola_comercial_mar[FAIXA_DWT_2025])),
			//     ([PMedio_P2] - [PMedio_P1]) * [Vol_P2]
			// )
		lineageTag: 035bb5a8-7846-4e6a-a638-8929c944a430

