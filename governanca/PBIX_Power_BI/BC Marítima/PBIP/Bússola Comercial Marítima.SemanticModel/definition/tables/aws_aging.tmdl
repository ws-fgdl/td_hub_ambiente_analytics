	column UN = ```
			
			// A coluna UN é criada para classificar os códigos de empresa SAP em diferentes unidades de negócio (UN).
			SWITCH(
			    TRUE(),  // Inicia a função SWITCH, permitindo avaliar várias condições.
			    'aws_aging'[cod_empresa_sap] = "W004", "AGE",//AGENCIA    
			    'aws_aging'[cod_empresa_sap] = "W010", "EST",//ESTALEIRO  
			    'aws_aging'[cod_empresa_sap] = "W014", "REB",//REBOCADOR
			    'aws_aging'[cod_empresa_sap] = "W015", "TRG",//TECON RIO GRADNE
			    'aws_aging'[cod_empresa_sap] = "W018", "TSV",//TECON SALVADOR
			    'aws_aging'[cod_empresa_sap] = "W017", "TSC",//TERMINAL SANTA CLARA
			    "Outras UNs" // Se nenhum dos códigos acima corresponder, retorna "Outras UNs".
			    // 002 foi substi pela 0014 saiu, 005 nao pode ser considerado, 0014 possui reb e base de apoio (divide o saldo da base apoio)
			    // baixa parcial 
			)
			```
		lineageTag: 967ef46f-e38f-4d23-b010-fab89e657224
		summarizeBy: none
		sortByColumn: UN_Ordenada

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Ordenar_FaixaVencimento = ```
			
			VAR Dias = 
			DATEDIFF(
			    aws_aging[dat_vencimento],
			    TODAY(),
			    DAY
			)
			RETURN 
			SWITCH(
			    TRUE(),
			    Dias >= 0 && Dias <= 5, 5,
			    Dias >= 6 && Dias <= 30, 6,
			    Dias >= 31 && Dias <= 90, 30,
			    Dias >= 91 && Dias <= 180, 90,
			    188
			)
			
			```
		formatString: 0
		lineageTag: cfc3c6bf-6821-4a7b-a404-3c9725b9306e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column UN_Ordenada = ```
			
			SWITCH(
			    TRUE(),
			    'aws_aging'[cod_empresa_sap] = "W014", 1,  // REB em primeiro
			    'aws_aging'[cod_empresa_sap] = "W004", 2,  // AGE
			    'aws_aging'[cod_empresa_sap] = "W010", 3,  // EST
			    'aws_aging'[cod_empresa_sap] = "W015", 4,  // TRG
			    'aws_aging'[cod_empresa_sap] = "W018", 5,  // TSV
			    'aws_aging'[cod_empresa_sap] = "W017", 6,  // TSC
			    7  // "Outras UNs"
			)
			
			```
		formatString: 0
		lineageTag: 685b01d0-3093-4a65-918f-5e1b9fc4a5fd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Cod_SAP_PossuiNaBussola =
			
			VAR ClienteAtual = aws_aging[cod_cliente_sap]
			RETURN
			    IF (
			        NOT ISBLANK (
			            LOOKUPVALUE (
			                aws_bussola_comercial_mar[cliente_sap], // Coluna que queremos encontrar
			                aws_bussola_comercial_mar[cliente_sap], ClienteAtual // Coluna de pesquisa e valor atual
			            )
			        ),
			        "SIM",
			        "NAO"
			    )
		lineageTag: c70142ac-f043-4487-b6f7-b241c25f4715
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

