table Medidas_Aging
	lineageTag: 848fac6c-89b7-46b6-850f-22be40439913

	measure val_montante_transacao_vencido =
			
			CALCULATE(
			    SUM(aws_aging[val_montante_transacao]),
			    aws_aging[DIAS_ATRASO] > 0
			)
		lineageTag: bc1cdd34-a65a-4081-a1f0-a9669b02a4e3

		formatStringDefinition = ```
				VAR Valor = SELECTEDMEASURE()
				VAR ValorAbs = ABS(Valor) -- Analisamos o "tamanho" do número independente do sinal
				
				-- Captura a moeda no contexto atual da tabela aws_aging
				VAR MoedaAtual = SELECTEDVALUE(aws_aging[tip_moeda])
				
				-- Define o prefixo com base no valor da coluna. 
				-- O terceiro argumento (branco ou "R$ ") é o padrão caso haja múltiplas moedas no mesmo contexto (ex: linha de Total)
				VAR Prefixo = 
				    SWITCH( TRUE(),
				        MoedaAtual = "BRL", "R$ ",
				        MoedaAtual = "USD", "$ ",
				        "R$ " -- Valor padrão para os totais ou quando não houver filtro claro
				    )
				
				RETURN
				    SWITCH( TRUE(),
				        ValorAbs >= 1000000000, 
				            Prefixo & "#,##0,,,.0 ""B"";-" & Prefixo & "#,##0,,,.0 ""B""",
				        
				        ValorAbs >= 1000000,    
				            Prefixo & "#,##0,,.0 ""M"";-" & Prefixo & "#,##0,,.0 ""M""",
				        
				        ValorAbs >= 1000,       
				            Prefixo & "#,##0,.0 ""K"";-" & Prefixo & "#,##0,.0 ""K""",
				        
				        -- Para valores menores
				        Prefixo & "#,##0.00;-" & Prefixo & "#,##0.00"
				    )
				```

	measure val_montante_transacao = SUM(aws_aging[val_montante_transacao])
		lineageTag: 35305e10-e946-4bd0-8772-de22a19b07d6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure val_montante_interno_brl_vencido = ```
			
			VAR DataReferencia = 
			    CALCULATE(
			        MAX(aws_aging[dat_incl_reg]), 
			        REMOVEFILTERS(aws_aging)
			    )
			RETURN
			CALCULATE(
			    SUM(aws_aging[val_montante_interno]),
			    FILTER(
			        aws_aging,
			        DATEDIFF(aws_aging[dat_vencimento], DataReferencia, DAY) >= 1
			    )
			)
			```
		lineageTag: 658d20aa-3149-4145-b9fd-1c2907e17f95

		annotation PBI_FormatHint = {"isGeneralNumber":true}

