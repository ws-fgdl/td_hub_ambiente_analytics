	measure ExibirAnoMesMaisRecente_datafim = ```
			
			VAR UltimaData = CALCULATE(MAX('aws_bussola_comercial_mar'[data_do_fim_do_evento]), ALL('aws_bussola_comercial_mar'))
			
			// A função EDATE subtrai exatamente 1 mês da data completa de forma segura
			VAR DataMenosUmMes = EDATE(UltimaData, -1) 
			
			RETURN 
			    IF(
			        CALCULATE(
			            COUNTROWS('aws_bussola_comercial_mar'),
			            'aws_bussola_comercial_mar'[data_do_fim_do_evento] <= DataMenosUmMes
			        ) > 0,
			        1,
			        0
			    )
			```
		formatString: 0
		lineageTag: 434f79a9-8b1a-4906-9499-5fa83a1939df

