			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"FORTALEZA"}, "FOR",
			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"IMBITUBA"}, "IBB",
			    dataliner_consolidado[PORTO ORIGEM/DESTINO] IN {"ITAGUAI"}, "IGI",
