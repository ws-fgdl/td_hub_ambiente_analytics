	measure Volume_Comparativo =
			
			VAR v1 = SELECTEDVALUE(TabelaComparativa1[Grupo Econômico])
			VAR v2 = SELECTEDVALUE(TabelaComparativa2[Grupo Econômico])
			RETURN
			CALCULATE(
			    [Flag_Volume_BaseBC], --[Escala_TipoData],
			    KEEPFILTERS(Dim_Cliente[Grupo Econômico] IN {v1,v2}))
		lineageTag: 97e13e08-24df-4c8b-8c6e-1b19229da617

		formatStringDefinition =
				VAR Valor = SELECTEDMEASURE()
				VAR ValorAbs = ABS(Valor) -- Pega o valor sem o sinal para a comparação
				RETURN
				    SWITCH( TRUE(),
				        ValorAbs >= 1000000000, "#,##0,,,.0 ""B"";-#,##0,,,.0 ""B""",
				        ValorAbs >= 1000000,    "#,##0,,.0 ""M"";-#,##0,,.0 ""M""",
				        ValorAbs >= 1000,       "#,##0,.0 ""K"";-#,##0,.0 ""K""",
				        "#,##0;-#,##0" -- Para valores menores que 1000
				    )

	measure Volume_Ano_Anterior = ```
			
			CALCULATE(
			    [Volume_Comparativo], 
			    PARALLELPERIOD('Dim_calendario'[data], -1, YEAR)
			)
			
			```
		lineageTag: 3a1964ff-f635-444b-9e1c-c9331b2fbbc3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rótulo_com_Indicador_(vs Ano Anterior)' = ```
			
			VAR Indicador = 
			    IF(
			        ISBLANK([Volume_Ano_Anterior]), 
			        BLANK(), 
			        DIVIDE([Volume_Comparativo], [Volume_Ano_Anterior]) - 1
			    )
			RETURN
			    IF(
			        ISBLANK(Indicador), 
			        BLANK(),  // Retorna em branco quando não há ano anterior
			        SWITCH(
			            TRUE(),
			            Indicador <= 0, FORMAT(Indicador, "0% ⮟"),
			            Indicador > 0, FORMAT(Indicador, "+0% ⮝")
			        )
			    )
			
			```
		lineageTag: 2f27a471-8038-47d7-97c9-6db7e05d1370

	measure _Indicador_Numerico_vs_AnoAnterior =
			
			VAR VolumeAtual = [Volume_Comparativo]
			VAR VolumeAnterior = [Volume_Ano_Anterior]
			VAR Indicador =
			    IF(
			        ISBLANK(VolumeAnterior),
			        BLANK(),
			        DIVIDE(VolumeAtual - VolumeAnterior, VolumeAnterior) // Retorna o valor numérico da variação
			    )
			RETURN
			Indicador
		lineageTag: 3d2d23e8-ff70-42cd-903b-46ab9facb8b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

