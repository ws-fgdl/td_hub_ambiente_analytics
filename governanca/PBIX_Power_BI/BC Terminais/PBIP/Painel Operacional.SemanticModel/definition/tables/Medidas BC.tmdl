	measure 'Projeção Faturamento Pessimista' = ```
			
			var data_max = MAX(Calendario1[Date])
			var result = 
			            IF(
			                MAX(Calendario2[Date])>data_max,
			                CALCULATE([Flag_T.M.]*([IPCA Acum 12M previsto])*[Vol. Pessimista table],DATEADD(Calendario2[Date],-1,YEAR)),
			                [Faturamento]
			            )
			return result
			```
		lineageTag: 3be60e65-cf85-4527-9b34-e5aa3b8cff12

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vol. Otimista' = ```
			
			CALCULATE(
			MAXX(
			    ADDCOLUMNS(
			        SUMMARIZE(
			            Calendario2,
			            Calendario2[Date].[Ano]
			            
			        ),
			        "volume",
			        [Flag_Vol]
			    )
			    ,If([volume]>1, [volume], BLANK())
			),
			Calendario2[Numero Mes] = SELECTEDVALUE(Calendario2[Numero Mes]),
			ALL(Calendario2)
			)
			```
		formatString: 0
		lineageTag: 7e29b458-d5b2-4bc9-b369-0812fb05ccc5

	measure 'Vol. Otimista table' =
			
			// Medida para somar os valores dos maiores/menores volumes também anualmente
			SUMX(
			    VALUES(Calendario2[Numero Mes]),
			    [Vol. Otimista]
			)
		formatString: 0
		lineageTag: 345dfe3a-8230-4168-b0b3-51c482803ea3

	measure 'Vol. Pessimista' = ```
			
