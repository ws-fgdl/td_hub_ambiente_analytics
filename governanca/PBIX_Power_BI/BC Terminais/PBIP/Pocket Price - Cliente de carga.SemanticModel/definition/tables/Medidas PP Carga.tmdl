table 'Medidas PP Carga'
	lineageTag: 3a7176a6-7792-47f6-bb9b-501a78c49ef9

	measure 'fat calculado isinscope' =
			IF(
			AND(ISINSCOPE('bussola_comercial'[servico]),
			AND(SELECTEDVALUE(bussola_comercial[Agrupamento Subgrupo Princing]) <> "Fiel Depósito", SELECTEDVALUE(bussola_comercial[Agrupamento Subgrupo Princing]) <> "Armazenagem Cntr Cheio")),
			[Price] *[Volume/Qtd.] //Quantidade
			,
			BLANK() // Retorna em branco caso contrário
			)
		lineageTag: 3c576ac9-3bc5-42e0-a6c5-a1fd73634c86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'fat calculado final' =
			
			SUMX(VALUES(bussola_comercial[servico]),
			[fat calculado isinscope]  + [Faturamento Realizado Carga] + [Faturamento Realizado Carga Exp]
			)
		lineageTag: a4fcbe78-3b04-43ef-a89c-2c036df66f1b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simulalação Preço Subgrupo' = ```
			
			
			[Price3] *
			AVERAGEX(
			    'bussola_comercial',
			    1 +
			        SWITCH (
			            TRUE (),
			
			            //-------------------------------------------
			            // BÁSICOS IMPORTAÇÃO
			            //-------------------------------------------
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Não Invasiva Cheio Importação", [Valor #Vistoria Não Invasiva Cheio Importação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inspeção Não Invasiva Cheio Importação", [Valor #Inspeção Não Invasiva Cheio Importação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Levante Cntr Importação", [Valor #Levante Cntr Importação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carga de Projeto", [Valor #Carga de Projeto],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr Importação Recepção", [Valor #Pesagem Cntr Importação Recepção],
			
			            -- Separação Importação/Exportação
			            AND('bussola_comercial'[Agrupamento Serviço] = "Básicos Importação",'bussola_comercial'[Agrupamento Subgrupo Princing] = "ISPS"), [Valor #ISPS Importação],
			            AND('bussola_comercial'[Agrupamento Serviço] = "Básicos Importação",'bussola_comercial'[Agrupamento Subgrupo Princing] = "Presença de Carga"), [Valor #Presença de Carga Importação],
			            AND('bussola_comercial'[Agrupamento Serviço] = "Básicos Importação",'bussola_comercial'[Agrupamento Subgrupo Princing] = "Gerenciamento de Risco Importação"), [Valor #Gerenciamento de Risco Importação],
			            
			
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Utilização de Área Especial", [Valor #Utilização de Área Especial],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Não Invasiva LCL", [Valor #Vistoria Não Invasiva LCL],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Entrega Cntr Vazio", [Valor #Entrega Cntr Vazia],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "ISPS LCL", [Valor #ISPS LCL],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "DSA", [Valor #DSA],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carregamento Manual", [Valor #Carregamento Manual],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carregamento Mecanizado", [Valor #Carregamento Mecanizado],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr Importação Recepção LCL", [Valor #Pesagem Cntr Importação Recepção LCL],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estufagem Cntr", [Valor #Estufagem Cntr],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Outros Importação", [Valor #Outros Importação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inspeção Não Invasiva Vazio Importação", [Valor #Inspeção Não Invasiva Vazio Importação],
			
			
			            //-------------------------------------------
			            // BÁSICOS EXPORTAÇÃO
			            //-------------------------------------------
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Não Invasiva Cheio Exportação", [Valor #Vistoria Não Invasiva Cheio Exportação],
			            AND('bussola_comercial'[Agrupamento Serviço] = "Básicos Exportação",'bussola_comercial'[Agrupamento Subgrupo Princing] = "ISPS"), [Valor #ISPS Exportação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inspeção Não Invasiva Cheio Exportação", [Valor #Inspeção Não Invasiva Cheio Exportação],
			
			            -- Separação Importação/Exportação
			            AND('bussola_comercial'[Agrupamento Serviço] = "Básicos Exportação",'bussola_comercial'[Agrupamento Subgrupo Princing] = "Presença de Carga"), [Valor #Presença de Carga Exportação],
			            AND('bussola_comercial'[Agrupamento Serviço] = "Básicos Exportação",'bussola_comercial'[Agrupamento Subgrupo Princing] = "Gerenciamento de Risco Exportação"), [Valor #Gerenciamento de Risco Exportação],
			            AND('bussola_comercial'[Agrupamento Serviço] = "Básicos Exportação",'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estremação Cntr"), [Valor #Estremação Cntr],
			            
			
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Exportação CCT", [Valor #Pesagem Exportação CCT],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estremação Cntr", [Valor #Estremação Cntr],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr", [Valor #Pesagem Cntr],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Monitoramento Cntr Reefer Exportação", [Valor #Monitoramento Cntr Reefer Exportação],
			
			
			            //-------------------------------------------
			            // OUTROS SERVIÇOS
			            //-------------------------------------------
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carga Geral", [Valor #Carga Geral],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Extra/Realocações/Transferência Lote", [Valor #Manuseio Extra/Realocações/Transferência Lote],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Transferência de Lote", [Valor #Transferência de Lote],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Outros", [Valor #Outros],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr", [Valor #Pesagem Cntr],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Agendamento", [Valor #Agendamento],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Despesa Administrativa", [Valor #Despesa Administrativa],
			            AND('bussola_comercial'[Agrupamento Serviço] = "Outros Serviços",'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Cntr Vistoria"), [Valor #Manuseio Cntr Vistoria],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carga de Projeto", [Valor #Carga de Projeto],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Overtime", [Valor #Overtime],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Cntr (Vistoria, Expurgo, labels)", [Valor #Manuseio Cntr (Vistoria, Expurgo, labels)],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Registro Fotográfico", [Valor #Registro Fotográfico],
			
			
			            //-------------------------------------------
			            // SERVIÇOS DE ARMAZÉM
			            //-------------------------------------------
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Desconsolidação LCL", [Valor #Desconsolidação LCL],
			            AND('bussola_comercial'[Agrupamento Serviço] = "Serviços de Armazém",'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Cntr Vistoria"), [Valor #Manuseio Cntr Vistoria 2],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estufagem Mecanizada", [Valor #Estufagem Mecanizada],
			            AND('bussola_comercial'[Agrupamento Serviço] = "Serviços de Armazém",'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estremação Cntr"), [Valor #Estremação Cntr Importação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Desova Mecanizada", [Valor #Desova Mecanizada],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Levante Carga Importação Mecanizada", [Valor #Levante Carga Importação Mecanizada],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Desova Manual", [Valor #Desova Manual],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estufagem Manual", [Valor #Estufagem Manual],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Invasiva em Plataforma", [Valor #Vistoria Invasiva em Plataforma],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Levante Carga Importação Manual", [Valor #Levante Carga Importação Manual],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Busca Cntr Vazio", [Valor #Busca Cntr Vazio],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Outros Armazém", [Valor #Outros Armazém],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Carga Importação", [Valor #Manuseio Carga Importação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Registro Fotográfico Armazém", [Valor #Registro Fotográfico Armazém],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Mercadoria Importação", [Valor #Pesagem Mercadoria Importação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Levante Carga Exportação", [Valor #Levante Carga Exportação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Entrega Cntr Vazio Armazém", [Valor #Entrega Cntr Vazio Armazém],
			
			
			            //-------------------------------------------
			            // OPERAÇÃO NAVIO
			            //-------------------------------------------
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inciso XIV", [Valor #Inciso XIV],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Cheio LC", [Valor #Box Rate Cheio LC],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Outros Operação Navio", [Valor #Outros Operação Navio],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Vazio LC", [Valor #Box Rate Vazio LC],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Ocupação Cais Acostagem", [Valor #Ocupação Cais Acostagem],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Armazenagem Cntr Vazios", [Valor #Armazenagem Cntr Vazios],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carga de Projeto", [Valor #Carga de Projeto],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carga Geral", [Valor #Carga Geral],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Remoção por Terra Cheio", [Valor #Remoção por Terra Cheio],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Cargas Especiais", [Valor #Cargas Especiais],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "ISPS Operação Navio", [Valor #ISPS Operação Navio],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Cheio TRA", [Valor #Box Rate Cheio TRA],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Fornecimento de Água", [Valor #Fornecimento de Água],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Vazio TRA", [Valor #Box Rate Vazio TRA],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Remoção por Terra Vazio", [Valor #Remoção por Terra Vazio],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Out of Gauge Cargo", [Valor #Out of Gauge Cargo],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Não Invasiva Vazios", [Valor #Vistoria Não Invasiva Vazios],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Remoção a Bordo Vazio", [Valor #Remoção a Bordo Vazio],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Cheio CAB", [Valor #Box Rate Cheio CAB],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Box Rate Vazio CAB", [Valor #Box Rate Vazio CAB],
			
			
			            //-------------------------------------------
			            // REEFER
			            //-------------------------------------------
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Fornecimento de Energia Cntr Reefer", [Valor #Fornecimento de Energia Cntr Reefer],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Monitoramento Cntr Reefer", [Valor #Monitoramento Cntr Reefer],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inspeção Cntr", [Valor #Inspeção Cntr],
			
			            
			            //-------------------------------------------
			            // OPERAÇÃO NAVIO OOG
			            //-------------------------------------------
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Out of Gauge Cargo OOG", [Valor #Out of Gauge Cargo OOG],
			
			
			            //-------------------------------------------
			            // DEFAULT
			            //-------------------------------------------
			            0
			        )
			)
			
			```
		lineageTag: 00100ed0-5cda-46c3-9b2c-0f2b7f62ae10

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Pocket_price_1 =
			
			VAR projFS = ([volume])*(([Simulalação Preço Subgrupo]
			+ [Simulação Preço Grupo]
			))-[fat calculado final]
			
			RETURN
			projFS/[fat calculado final]-1
		lineageTag: 972aa1e2-5041-4b32-b958-740526c01c3b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simulador de Preço Carga' =
			
			IFERROR(IF(
			    (1+[Pocket_price_1])*[Price3]<-1,
			    0,
			    (1+[Pocket_price_1])*[Price3]
			),BLANK())
		lineageTag: cdcba3ff-405a-47ac-803f-062ed1ec426d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simulação Preço Grupo' = ```
			
			[Price3] *
			AVERAGEX(
			    'bussola_comercial',
			    1 +
			        (
			            SWITCH (
			                TRUE (),
			
			                // -------- Grupos principais conforme aparecem na matriz --------
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Importação", [Valor #Básicos Importação],
			                'bussola_comercial'[Agrupamento Serviço] = "Básicos Exportação", [Valor #Básicos Exportação],
			                'bussola_comercial'[Agrupamento Serviço] = "Outros Serviços", [Valor #Outros Serviços],
			                'bussola_comercial'[Agrupamento Serviço] = "Reefer", [Valor #Reefer],
			                'bussola_comercial'[Agrupamento Serviço] = "Operação Navio", [Valor #Operação Navio],
			                'bussola_comercial'[Agrupamento Serviço] = "Serviços de Armazém", [Valor #Serviços de Armazém],
			             //   'bussola_comercial'[Agrupamento Serviço] = "Básicos Cabotagem", [Valor Básicos Cabotagem],
			             //   'bussola_comercial'[Agrupamento Serviço] = "Básicos Transbordo", [Valor Básicos Transbordo],
			                 'bussola_comercial'[Agrupamento Serviço] = "Operação Navio OOG", [Valor #Operação Navio OOG],
			
			                // -------- Caso não encontre o grupo --------
			                BLANK(), 0,
			
			                // -------- Default --------
			                1
			            )
			        )
			)
			
			```
		lineageTag: 304c9e18-9094-4dd7-857a-66b7625b6b86

	measure 'Simulalação Volume Subgrupo' = ```
			
			
			var vVolume = SUMX(
			        'bussola_comercial',
			        'bussola_comercial'[volume]
			        * (
			            1
			            + SWITCH (
			                TRUE (),
			            //-------------------------------------------
			            // BÁSICOS IMPORTAÇÃO
			            //-------------------------------------------
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Não Invasiva Cheio Importação", [Valor #Vol Vistoria Não Invasiva Cheio Importação],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inspeção Não Invasiva Cheio Importação", [Valor #Vol Inspeção Não Invasiva Cheio Importação],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Levante Cntr Importação", [Valor #Vol Levante Cntr Importação],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carga de Projeto", [Valor #Vol Carga de Projeto],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr Importação Recepção", [Valor #Vol Pesagem Cntr Importação Recepção],
			
			            // -- Separação Importação/Exportação
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "ISPS Importação", [Valor #Vol ISPS Importação],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Presença de Carga Importação", [Valor #Vol Presença de Carga Importação],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Gerenciamento de Risco Importação", [Valor #Vol Gerenciamento de Risco Importação],
			
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Utilização de Área Especial", [Valor #Vol Utilização de Área Especial],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Não Invasiva LCL", [Valor #Vol Vistoria Não Invasiva LCL],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Entrega Cntr Vazia", [Valor #Vol Entrega Cntr Vazia],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "ISPS LCL", [Valor #Vol ISPS LCL],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "DSA", [Valor #Vol DSA],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carregamento Manual", [Valor #Vol Carregamento Manual],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carregamento Mecanizado", [Valor #Vol Carregamento Mecanizado],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr Importação Recepção LCL", [Valor #Vol Pesagem Cntr Importação Recepção LCL],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estufagem Cntr", [Valor #Vol Estufagem Cntr],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Outros Importação", [Valor #Vol Outros Importação],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inspeção Não Invasiva Vazio Importação", [Valor #Vol Inspeção Não Invasiva Vazio Importação],
			
			
			            //-------------------------------------------
			            // BÁSICOS EXPORTAÇÃO
			            //-------------------------------------------
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Vistoria Não Invasiva Cheio Exportação", [Valor #Vol Vistoria Não Invasiva Cheio Exportação],
			            AND('bussola_comercial'[Agrupamento Serviço] = "Básicos Exportação",'bussola_comercial'[Agrupamento Subgrupo Princing] = "ISPS"), [Valor #Vol ISPS Exportação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Inspeção Não Invasiva Cheio Exportação", [Valor #Vol Inspeção Não Invasiva Cheio Exportação],
			
			            -- Separação Importação/Exportação
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Presença de Carga Exportação", [Valor #Vol Presença de Carga Exportação],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Gerenciamento de Risco Exportação", [Valor #Vol Gerenciamento de Risco Exportação],
			
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Exportação CCT", [Valor #Vol Pesagem Exportação CCT],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Estremação Cntr", [Valor #Vol Estremação Cntr],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr", [Valor #Vol Pesagem Cntr],
			            'bussola_comercial'[Agrupamento Subgrupo Princing] = "Monitoramento Cntr Reefer Exportação", [Valor #Vol Monitoramento Cntr Reefer Exportação]
			
			
			            //-------------------------------------------
			            // OUTROS SERVIÇOS
			            //-------------------------------------------
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carga Geral", [Valor #Vol Carga Geral],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Extra/Realocações/Transferência Lote", [Valor #Vol Manuseio Extra/Realocações/Transferência Lote],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Transferência de Lote", [Valor #Vol Transferência de Lote],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Outros", [Valor #Vol Outros],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Pesagem Cntr", [Valor #Vol Pesagem Cntr],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Agendamento", [Valor #Vol Agendamento],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Despesa Administrativa", [Valor #Vol Despesa Administrativa],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Cntr Vistoria", [Valor #Vol Manuseio Cntr Vistoria],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Carga de Projeto", [Valor #Vol Carga de Projeto],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Overtime", [Valor #Vol Overtime],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Cntr (Vistoria, Expurgo, labels)", [Valor #Vol Manuseio Cntr (Vistoria, Expurgo, labels)],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Registro Fotográfico", [Valor #Vol Registro Fotográfico],
			
			
			            // //-------------------------------------------
			            // // SERVIÇOS DE ARMAZÉM
			            // //-------------------------------------------
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Desconsolidação LCL", [Valor #Vol Desconsolidação LCL],
			            // 'bussola_comercial'[Agrupamento Subgrupo Princing] = "Manuseio Cntr Vistoria", [Valor #Vol Manuseio Cntr Vistoria],
