	column id_serv_contrato = bussola_comercial[contrato_id]&bussola_comercial[cod_servico]&bussola_comercial[un]
		lineageTag: d0673269-03bc-4b95-9b23-4f60f5755f53
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column valor_negociado = ```
			
			
			VAR lookup_default = CALCULATE(
			        AVERAGE(contratos[valor]),
			        FILTER(
			            Contratos,
			            Contratos[id_serv_contrato] = bussola_comercial[id_serv_contrato]
			        )
			    )
			
			var lookup_reefer = CALCULATE(
			        MAX(contratos[valor]),
			        FILTER(
			            Contratos,
			            Contratos[id_serv_contrato] = bussola_comercial[id_serv_contrato]
			        )
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"}, BLANK(),
			    bussola_comercial[Agrupamento Serviço] IN {"Reefer"},lookup_reefer,
			    bussola_comercial[Agrupamento Subgrupo Princing] IN {"Fiel Depósito"},lookup_default/100,
			    lookup_default
			)
			 
			    // IF(bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT"},
			    
			    // BLANK(),
			
			    // IF(bussola_comercial[Agrupamento Serviço] IN {"Reefer"},
			
			    // CALCULATE(
			    //     MAX(contratos[valor]),
			    //     FILTER(
			    //         Contratos,
			    //         Contratos[id_serv_contrato] = bussola_comercial[id_serv_contrato]
			    //     )
			    // ),
			
			    // CALCULATE(
			    //     AVERAGE(contratos[valor]),
			    //     FILTER(
			    //         Contratos,
			    //         Contratos[id_serv_contrato] = bussola_comercial[id_serv_contrato]
			    //     )
			    // )
			
			    // ))
			
			```
		lineageTag: cec22aa1-3a25-4de9-947f-11c3b9c140d4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column flag_isencao =
			
			LOOKUPVALUE(contratos[flag_isencao],
			contratos[id_serv_contrato],
			bussola_comercial[id_serv_contrato]
			)
		lineageTag: ab93688b-2c32-465a-a5e5-aaa0f596db02
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column dias_isencao =
			
			VAR p_Cont = LOOKUPVALUE(contratos[dias_isencao],
			contratos[id_serv_contrato],
			bussola_comercial[id_serv_contrato]
			)
			
			VAR p_table = LOOKUPVALUE('Tabela Pública'[dias_isencao],
			'Tabela Pública'[id_serv_contrato],
			bussola_comercial[id_serv_contrato]
			)
			
			RETURN
			IF( p_Cont = BLANK(), p_table, p_Cont)
		lineageTag: bbbc0078-c4ca-471d-a08b-79638d305a5d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column volume = ```
			
			
			VAR _dias_servico   = 'bussola_comercial'[dias_servico]
			VAR _dias_isencao   = 'bussola_comercial'[dias_isencao]
			VAR _dias_free_time = 'bussola_comercial'[dias_free_time]
			
			RETURN
			IF ( 'bussola_comercial'[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio", "Armazenagem Cntr Vazios", "Armazenagem Cntr Vazios BT", "Fornecimento de Energia Cntr Reefer", "Monitoramento Cntr Reefer", "Armazenagem Carga Importação"}
			   , IF (_dias_free_time >= _dias_servico
			        , 0
			        , VAR _dias_servico_ajustado = _dias_servico - _dias_isencao
			          RETURN IF(_dias_servico_ajustado < 0, 0, _dias_servico_ajustado)
			        )
			   , 'bussola_comercial'[qtd]
			   )
			
			// VAR vDif = 'bussola_comercial'[dias_servico]-bussola_comercial[dias_isencao]
			
			// RETURN
			// IF('bussola_comercial'[Agrupamento Subgrupo Princing] IN { "Fornecimento de Energia Cntr Reefer", "Monitoramento Cntr Reefer"},
			// IF(vDif<0,0,vDif),
			
			// IF('bussola_comercial'[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT"},
			// IF(vDif<0,0,vDif),
			    
			// 'bussola_comercial'[qtd])
			// )
			
			```
		lineageTag: 6549ab91-b0a8-4fc5-ba42-8d6a6f198879
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column tipo_precificacao = ```
			//Campo para definir se o serviço possui o contrato ou não
			
			VAR pContrato = LOOKUPVALUE(contratos[id_serv_contrato], // Variável que procura se o serviço possui contrato
			contratos[id_serv_contrato],
			bussola_comercial[id_serv_contrato])
			
			RETURN
			IF(pContrato = BLANK(),  //Lógica para identificar quando o serviço possui contrato
			"Tabela Pública",
			"Possui contrato"
			)
			
			```
		lineageTag: 5a7189ac-efdd-43b3-820e-6271a09be2db
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

