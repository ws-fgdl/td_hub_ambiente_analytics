table aws_salesforce
	lineageTag: 7a1cf133-ba6d-43d2-871d-8e865ed85ca3

	column Grupo_Economico_DimCarteira =
			
			VAR CodigoSAPSalesforce = 'aws_salesforce'[codigo_sap]
			VAR GrupoEconomicoDimCarteira_Valor =
			    LOOKUPVALUE (
			        Dim_carteira_comercial_consolidado[GrupoEconomico],
			        Dim_carteira_comercial_consolidado[CODIGO_SAP_Padronizado], CodigoSAPSalesforce
			    )
			VAR GrupoEconomicoSalesforce_Valor = 'aws_salesforce'[grupo_economico]
			VAR GrupoComercialSalesforce_Valor = 'aws_salesforce'[grupo_comercial]
			VAR RazaoSocialSalesforce_Valor = 'aws_salesforce'[razao_social]
			
			RETURN
			    IF (
			        -- Prioridade 1: Verifica GrupoEconomico da dim_carteira
			        NOT ISBLANK(GrupoEconomicoDimCarteira_Valor) && LEN(TRIM(GrupoEconomicoDimCarteira_Valor)) > 0,
			        UPPER(GrupoEconomicoDimCarteira_Valor),
			        -- Se Prioridade 1 é vazia/nula, verifica os campos do salesforce
			        IF (
			            -- Prioridade 2: Verifica Grupo Economico do salesforce
			            NOT ISBLANK(GrupoEconomicoSalesforce_Valor) && LEN(TRIM(GrupoEconomicoSalesforce_Valor)) > 0,
			            UPPER(GrupoEconomicoSalesforce_Valor),
			            -- Se Prioridade 2 é vazia/nula, verifica Grupo Comercial do salesforce
			            IF (
			                -- Prioridade 3: Verifica Grupo Comercial do salesforce
			                NOT ISBLANK(GrupoComercialSalesforce_Valor) && LEN(TRIM(GrupoComercialSalesforce_Valor)) > 0,
			                UPPER(GrupoComercialSalesforce_Valor),
			                -- Se Prioridade 3 é vazia/nula, usa Razão Social do salesforce (Fallback)
			                IF (
			                    NOT ISBLANK(RazaoSocialSalesforce_Valor) && LEN(TRIM(RazaoSocialSalesforce_Valor)) > 0,
			                    UPPER(RazaoSocialSalesforce_Valor),
			                    -- Se tudo estiver vazio/nulo, explicitamente retorna BLANK()
			                    BLANK()
			                )
			            )
			        )
			    )
		lineageTag: a3a5ac9a-0502-4ae4-b623-1a8eb40a44c9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

