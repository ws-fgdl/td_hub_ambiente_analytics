	measure Total_Rateio_CustoxVolume =
			
			DIVIDE(
			    CALCULATE(
			        SUM(aws_dre_reb[realizado_dolar]),
			        aws_dre_reb[linha_agrupadas] <> "Receita Líquida" &&
			        aws_dre_reb[linha_agrupadas] <> "Receita Bruta (após descontos)" &&
			        aws_dre_reb[linha_agrupadas] <> "Impostos Efetivos"
			    ),
			    CALCULATE(
			        SUM(aws_bussola_comercial_mar[volume])
			    ),
			    0
			)
		lineageTag: 6517c169-c2ac-4c6d-bd7f-466c52453665

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Resultado_View_VolumeFixo_GrupoEcono =
			
			[Preco_Liquido_Volume] + [Rateio_Custo_VolumeFixo_GrupoEcon]
		displayFolder: View_VolumeFixo\Resultado
		lineageTag: 028771ad-66d2-4f2e-8bf5-a7455820ab83

		formatStringDefinition =
				VAR Valor = SELECTEDMEASURE()
				VAR ValorAbs = ABS(Valor) -- Pega o valor sem o sinal para a comparação
				RETURN
				    SWITCH( TRUE(),
				        ValorAbs >= 1000000000, "$ #,##0,,,.0 ""B"";-$ #,##0,,,.0 ""B""",
				        ValorAbs >= 1000000,    "$ #,##0,,.0 ""M"";-$ #,##0,,.0 ""M""",
				        ValorAbs >= 1000,       "$ #,##0,.0 ""K"";-$ #,##0,.0 ""K""",
				        "$ #,##0;-$ #,##0" -- Para valores menores que 1000
				    )

	measure Margem_VolumeFixo_GrupoEcon =
			
			DIVIDE(
			    [Resultado_View_VolumeFixo_GrupoEcono],
			    [Preco_Liquido_Volume],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: View_VolumeFixo\Margem
		lineageTag: e4cc717b-77c1-4767-871f-f5d3ed99ef19

