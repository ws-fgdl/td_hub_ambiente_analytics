		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Simulador de Volume Carga' = (1+[Variação Volume Carga])*[volume]
		formatString: #,0
		lineageTag: c9ea7d40-2729-4c16-9f09-cda15c7eebae

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Projeção Faturamento Simulador Carga' = ```
			
			
			VAR projFS =
			    ([Simulação Volume Grupo] + [Simulalação Volume Subgrupo] - [volume]) *
			    ([Simulalação Preço Subgrupo] + [Simulação Preço Grupo] - [Price3])
			    + [Faturamento Simulado Carga]
			
			VAR result =
			    IF(
			AND(ISINSCOPE('bussola_comercial'[servico]),
			AND(AND(SELECTEDVALUE(bussola_comercial[Agrupamento Subgrupo Princing]) <> "Fiel Depósito", SELECTEDVALUE(bussola_comercial[Agrupamento Subgrupo Princing]) <> "Armazenagem Cntr Cheio"),SELECTEDVALUE(bussola_comercial[Agrupamento Subgrupo Princing]) <> "Armazenagem Carga Importação")),
			
			        IF(
			            projFS < 0,
			            0,
			            projFS
			        ),
			        BLANK()
			    )
			
			RETURN
			result
			
			```
		lineageTag: cecaf1cc-2960-40f2-a7d1-d6d402dd2e87

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Projeção Faturamento Simulador Final' =
			
			
			SUMX(VALUES(bussola_comercial[servico]),
			[Projeção Faturamento Simulador Carga] + [Faturamento Simulado Carga Exp] + [Faturamento Simulado Carga 2]
			)
		lineageTag: 133a5f12-f027-4a7d-9886-23b08a8b3ba8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Projeção Simulada Carga' = ```
			
			var data_max = MAX(bussola_comercial[competencia])
			var result = 
			
			            IF(
			                MAX(Calendario2[Date])>data_max,
			                CALCULATE([Projeção Faturamento Simulador Final], DATEADD(Calendario2[Date],-'Meses contratuais'[Período contratual],MONTH)),
			                [fat calculado final]
			            )
			
			return result
			```
