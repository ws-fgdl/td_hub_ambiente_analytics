	measure 'Navios Contagem diária' = ```
			
			VAR vUltimaData = CALCULATE( 
			    MAX(Calendario1[Date]), 
			    ALLSELECTED(Calendario1)  // Para responder aos filtros visuais aplicados
			)
			VAR vUltimoMesContexto = MONTH(MAXX(ALL(Calendario1),Calendario1[Date]))
			VAR vUltimoMesContexto2 = MONTH(vUltimaData)
			VAR vUltimoAno = YEAR(vUltimaData)
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(Movimentacao_CNTR[OPERAÇÃO POR NAVIO]),
			    // Filtro para pegar o volume apenas para o último mês
			    FILTER(
			        Calendario1, 
			        Calendario1[Numero Mes] = vUltimoMesContexto2
			    ),
			    // Filtro para pegar os últimos três anos, utilizando VALUES para garantir valores únicos por ano
			    FILTER(
			        Calendario1, 
			        Calendario1[Ano Calendario] IN VALUES(Calendario1[Ano Calendario]) &&
			        Calendario1[Ano Calendario] IN {vUltimoAno, vUltimoAno-1, vUltimoAno-2}
			    ),
			    // Filtro para pegar apenas os dias até o último dia do mês
			    FILTER(
			        Calendario1, 
			        IF(
			            Calendario1[Numero Mes] = vUltimoMesContexto,
			            DAY(Calendario1[Date]) <= DAY(vUltimaData) - 1,
			            TRUE()
			        )
			    )
			)
			```
		formatString: 0
		lineageTag: ddf3a5c0-071d-4be0-8c3d-ccbf8c9d3b82

	measure 'Consignação Média Acumulada' = ```
			
			 
			VAR vUltimaData = CALCULATE( 
			    MAX(Calendario1[Date]), 
			    ALLSELECTED(Calendario1)  // Para responder aos filtros visuais aplicados
			)
			VAR vUltimoMesContexto = MONTH(MAXX(ALL(Calendario1),Calendario1[Date]))
			VAR vUltimoMesContexto2 = MONTH(vUltimaData)
			VAR vUltimoAno = YEAR(vUltimaData)
			
			RETURN
			 CALCULATE(
			    ([Acumulado Vol cntnr MTD] / [Acumulado qntd navio MTD]),
			    
			    // Filtro para pegar os últimos três anos, utilizando VALUES para garantir valores únicos por ano
			    FILTER(
			        Calendario1, 
			        Calendario1[Ano Calendario] IN VALUES(Calendario1[Ano Calendario]) &&
			        Calendario1[Ano Calendario] IN {vUltimoAno, vUltimoAno-1, vUltimoAno-2}
			    ))
			    // Filtro para pegar apenas os dias até o último dia do mês
			
			
			
			
			
			
			```
