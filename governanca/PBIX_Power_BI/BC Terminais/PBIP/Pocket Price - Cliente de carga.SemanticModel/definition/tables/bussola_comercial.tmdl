			SWITCH(
			    TRUE(),
			        bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT", "Armazenagem Carga Importação"},
			        IF(
			            Valor_Min_Contrato = BLANK(),
			                Valor_Min_TabP,
