	measure Revenue_Port_Service = ```
			
			VAR AnosSelecionados = 
			    VALUES(
			        Calendario[Date].[Ano]
			    )
			VAR MinAno = 
			    MIN(
			        Calendario[Date].[Ano]
			    )
			VAR MaxAno = 
			    MAX(
			        Calendario[Date].[Ano]
			    )
			VAR TotalAnos = 
			    COUNTROWS(
			        ALL(
			            Calendario[Date].[Ano]
			        )
			    )
			VAR AnosFiltrados = 
			    COUNTROWS(
			        AnosSelecionados
			    )
			
			RETURN 
			    IF(
			        AnosFiltrados = TotalAnos, 
			        "All Years",
			        IF(
			            AnosFiltrados = 1,
			            "" & FORMAT(
			                SELECTEDVALUE(
			                    Calendario[Date].[Ano]
			                ), 
			                "0"
			            ),
			            "" & FORMAT(
			                MinAno, 
			                "0"
			            ) & " - " & FORMAT(
			                MaxAno, 
			                "0"
			            )
			        )
			    )
			
			```
		lineageTag: 497f8424-8695-46a8-bb2f-dd24fe62921d

