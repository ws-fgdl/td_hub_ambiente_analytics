table Medidas_BaseMovimentacao
	lineageTag: 3e93e827-06e9-40b4-9b56-07eb2f7dfb9a

	measure FaturamentoTIF_BaseMovimentacao =
			
			SUM(
			    aws_movimentacao_portuaria[valor_tif]
			)
		lineageTag: ae2294ed-91ce-49a6-9fa6-f37150634bd0

		formatStringDefinition = ```
				VAR Valor = SELECTEDMEASURE()
				VAR ValorAbs = ABS(Valor) -- Analisamos o "tamanho" do número independente do sinal
				
				RETURN
				    SWITCH( TRUE(),
				        ValorAbs >= 1000000000, 
				            "#,##0,,,.0 ""B"";-" & "#,##0,,,.0 ""B""",
				        
				        ValorAbs >= 1000000,    
				            "#,##0,,.0 ""M"";-" & "#,##0,,.0 ""M""",
				        
				        ValorAbs >= 1000,       
				            "#,##0,.0 ""K"";-" & "#,##0,.0 ""K""",
				        
				        -- Para valores entre -999 e 999
				        "#,##0;-" & "#,##0"
				    )
				```

	measure RankingHistorico_PorDono_BaseMovimentacao =
			
