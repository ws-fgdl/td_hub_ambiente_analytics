	column Personalizar
		dataType: string
		lineageTag: 1c1998fb-1900-4a42-839a-05f6141fb275
		summarizeBy: none
		sourceColumn: Personalizar

		annotation SummarizationSetBy = Automatic

	column 'Box Rate' = ```
			
			VAR tipoInciso = LOOKUPVALUE(
			    'Inciso XIV'[Tipo_Inciso_XIV],
			    'Inciso XIV'[chave],
			    contratos[chave]
			    
			    )
			
			RETURN
			IF( tipoInciso = "Inciso XIV CAB",
			"Box Rate CAB",
			    IF(tipoInciso = "Inciso XIV LC",
			    "Box Rate LC",
			        IF(contratos[Agrupamento Subgrupo Princing] IN {"Box Rate Vazio CAB", "Box Rate Cheio CAB"},
			        "Box Rate CAB",
			            IF(contratos[Agrupamento Subgrupo Princing] IN {"Box Rate Cheio LC", "Box Rate Cheio TRA", "Box Rate Vazio LC", "Box Rate Cheio TRA BT", "Box Rate Vazio TRA", "Box Rate Vazio TRA BT"},
			            "Box Rate LC",
			            BLANK())
			        )
			    )
			)
			```
		lineageTag: 7afbac80-e845-42d7-9c56-5fbac9977be5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Tipo Inciso' = ```
			
			LOOKUPVALUE(
			    'Inciso XIV'[Tipo_Inciso_XIV],
			    'Inciso XIV'[chave],
			    contratos[chave]
			    
			    )
			```
		lineageTag: 077b7db5-8dda-4ea6-895b-29ba164faeda
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

