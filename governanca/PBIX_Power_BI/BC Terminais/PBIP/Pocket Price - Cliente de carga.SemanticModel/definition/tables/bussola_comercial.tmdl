	column valor_minimo_periodo2 = ```
			
			
			var _valor_minimo_periodo2 = 
			IF(bussola_comercial[Agrupamento Subgrupo Princing] IN {"Armazenagem Cntr Cheio","Armazenagem Cntr Vazios","Armazenagem Cntr Vazios BT", "Armazenagem Carga Importação"},
