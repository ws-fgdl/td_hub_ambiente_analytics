	column pb_tipo_de_cliente = ```
			
			IF(
			    LOOKUPVALUE(
			        'dim_gsht_carteira_comercial'[ARMADOR/CLIENTE CARGA], 
			        'dim_gsht_carteira_comercial'[CODIGO_SAP_Padronizado], 
			        aws_salesforce[codigo_sap]
			    ) = BLANK(), "Cliente Carga", 
			    LOOKUPVALUE(
			        'dim_gsht_carteira_comercial'[Armador/Cliente Carga], 
			        'dim_gsht_carteira_comercial'[CODIGO_SAP_Padronizado], 
			        aws_salesforce[codigo_sap]
			    )
			)
			```
