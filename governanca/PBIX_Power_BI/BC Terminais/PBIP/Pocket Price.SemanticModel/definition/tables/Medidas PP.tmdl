	measure 'Tipo Price' =
			
			
			var ultPrice = CALCULATE(
			    LASTNONBLANK(
			        bussola_comercial[valor_negociado],
			        MAX(bussola_comercial[data_do_inicio_do_evento])
			    ),
			    FILTER(
			        'bussola_comercial',
			        bussola_comercial[data_do_inicio_do_evento] = MAX(bussola_comercial[data_do_inicio_do_evento])
			    )
			)
			
			var ultTP = CALCULATE(
			    LASTNONBLANK(
			        bussola_comercial[tabela_publica],
			        MAX(bussola_comercial[data_do_inicio_do_evento])
			    ),
			    FILTER(
			        'bussola_comercial',
			        bussola_comercial[data_do_inicio_do_evento] = MAX(bussola_comercial[data_do_inicio_do_evento])
			    )
			)
			
			RETURN
			
			IF(
			    ultPrice<>BLANK(),
			    "Contrato",
			    IF(
			        ultTP<>BLANK(),
			        "Tabela",
			        BLANK())
			)
		displayFolder: Outras medidas
