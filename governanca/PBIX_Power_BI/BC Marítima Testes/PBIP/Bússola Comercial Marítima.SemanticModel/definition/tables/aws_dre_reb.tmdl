	measure TempoServico_GrupoEcon_MF = ```
			// Média no total da tabela 
			VAR MediaHorasNoTotal =
			    AVERAGEX(
			        VALUES(aws_salesforce[Grupo_Economico_DimCarteira]), // Itera sobre cada Grupo Econômico
			        [TempoDeServico_ComDesloc]             // Calcula a duração em horas para cada um
			    )                                              // E depois tira a média dessas durações
			VAR TotalMinutosParaFormatar =
			    IF(
			        HASONEVALUE(aws_salesforce[Grupo_Economico_DimCarteira]),
			        [TempoDeServico_ComDesloc] * 60, // Para linhas de detalhe, usa a duração original
			        MediaHorasNoTotal * 60                // Para a linha de total, usa a média das horas calculada
			    )
			VAR HorasInteiras = TRUNC(TotalMinutosParaFormatar / 60)
			VAR MinutosRestantes = ROUND(MOD(TotalMinutosParaFormatar, 60), 0)
			RETURN
			IF(
			    NOT ISBLANK(TotalMinutosParaFormatar), // Adicionado para evitar erro se o resultado for BLANK
			    FORMAT(HorasInteiras, "0") & "h " & FORMAT(MinutosRestantes, "00") & "min",
			    BLANK() // Ou "0h 00min" ou o que preferir se for BLANK
			)
			```
		displayFolder: View_Tempo\TempoServico
		lineageTag: 33697d0e-2b4a-4916-98a0-d532210daed2

	measure Receita_Hora_GrupoMediaNoTotal =
			
			IF(
			    HASONEVALUE(aws_salesforce[Grupo_Economico_DimCarteira]), // Verifica se está em uma linha de detalhe de Grupo Econômico
			    [Remuneracao_Hora_ComDeslocamento_BaseBC],         // Se sim, usa o cálculo original da Receita/Hora
			    AVERAGEX(                                       // Se não (ou seja, está na linha de Total)
			        VALUES(aws_salesforce[Grupo_Economico_DimCarteira]),  // Itera sobre cada Grupo Econômico distinto
			        [Remuneracao_Hora_ComDeslocamento_BaseBC]      // Calcula a Receita/Hora para cada grupo e depois tira a média
			    )
			)
		displayFolder: View_Tempo
